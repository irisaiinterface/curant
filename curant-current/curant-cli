# --- Background job support (slow tools shouldn't block the whole watcher) ---
# relay() is a one-shot process the watcher waits on — a tool call that
# takes several minutes (Veo) would block Curant from handling any other
# message for that entire time. These functions let a slow tool instead
# hand off to a detached subprocess and return immediately with a
# "started" message; the watcher's existing polling loop picks up the
# result once it's actually done and delivers it as a follow-up.

def _create_background_job(tool_name, arguments, apple_id):
    with closing(get_local_db()) as conn:
        cursor = conn.execute(
            "INSERT INTO background_jobs (tool_name, arguments, apple_id, status) VALUES (?, ?, ?, 'pending')",
            (tool_name, json.dumps(arguments), apple_id),
        )
        conn.commit()
        return cursor.lastrowid


def _get_background_job(job_id):
    with closing(get_local_db()) as conn:
        row = conn.execute("SELECT * FROM background_jobs WHERE id = ?", (job_id,)).fetchone()
        return dict(row) if row else None


def _update_background_job(job_id, status, result_path=None, result_text=None, error=None):
    with closing(get_local_db()) as conn:
        conn.execute(
            "UPDATE background_jobs SET status=?, result_path=?, result_text=?, error=?, "
            "completed_at=CURRENT_TIMESTAMP WHERE id=?",
            (status, result_path, result_text, error, job_id),
        )
        conn.commit()


STALE_JOB_TIMEOUT_MINUTES = 15  # generous margin above Veo's own ~10-minute internal
                                  # timeout — long enough that a genuinely slow but still-
                                  # working generation isn't falsely killed, short enough
                                  # that a crashed subprocess doesn't leave a customer
                                  # waiting forever with no explanation
BACKGROUND_JOB_MAX_AGE_DAYS = 30  # delivered jobs have no reason to stick around
                                    # indefinitely — same retention principle already
                                    # applied to generated files, just a longer window
                                    # since these rows are just metadata, not files


def _mark_stale_jobs_failed():
    """
    A background job's subprocess can die without ever updating its own
    row — a Mac restart mid-generation, a killed process, anything that
    doesn't get a clean chance to call _update_background_job. Without
    this, that job stays 'running' forever: invisible to
    get_undelivered_completed_jobs() (which only looks at 'done'/
    'failed'), so the customer never finds out and the row never gets
    cleaned up either. Called before every check for undelivered jobs,
    so a stuck job surfaces as a real, honest failure within
    STALE_JOB_TIMEOUT_MINUTES instead of silently vanishing.
    """
    cutoff = (datetime.now() - timedelta(minutes=STALE_JOB_TIMEOUT_MINUTES)).strftime("%Y-%m-%d %H:%M:%S")
    with closing(get_local_db()) as conn:
        conn.execute(
            "UPDATE background_jobs SET status='failed', error='Timed out — the background "
            "process may have been interrupted (e.g. the Mac restarted mid-generation).', "
            "completed_at=CURRENT_TIMESTAMP WHERE status='running' AND created_at < ?",
            (cutoff,),
        )
        conn.commit()


def prune_old_background_jobs():
    """Delivered job rows older than BACKGROUND_JOB_MAX_AGE_DAYS get
    removed — same data-minimization principle already applied to
    generated files and message history, just a longer window since
    these rows are lightweight metadata rather than files."""
    cutoff = (datetime.now() - timedelta(days=BACKGROUND_JOB_MAX_AGE_DAYS)).strftime("%Y-%m-%d %H:%M:%S")
    with closing(get_local_db()) as conn:
        conn.execute(
            "DELETE FROM background_jobs WHERE delivered = 1 AND completed_at < ?", (cutoff,)
        )
        conn.commit()


def get_undelivered_completed_jobs():
    """Called by curant-watcher.py on each polling cycle — jobs that
    finished (successfully or not) but haven't been delivered to the
    customer yet. Checks for stuck/stale jobs and prunes old delivered
    ones first, so this function is the one place both housekeeping
    tasks happen without the watcher needing its own separate schedule."""
    _mark_stale_jobs_failed()
    prune_old_background_jobs()
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT * FROM background_jobs WHERE status IN ('done', 'failed') AND delivered = 0"
        ).fetchall()
        return [dict(r) for r in rows]


def mark_job_delivered(job_id):
    with closing(get_local_db()) as conn:
        conn.execute("UPDATE background_jobs SET delivered = 1 WHERE id = ?", (job_id,))
        conn.commit()


def pending_background_jobs_cmd():
    """Prints undelivered completed jobs as JSON — curant-watcher.py
    calls this each polling cycle to check what's ready to deliver."""
    print(json.dumps(get_undelivered_completed_jobs()))


def decrypt_for_delivery_cmd(encrypted_path):
    """Decrypts a generated file (from background_jobs.result_path) to a
    short-lived plaintext temp file and prints its path — same pattern
    relay() already uses for synchronous generations, just invoked
    separately here since the watcher, not relay(), is what's doing the
    delivering for an async job."""
    try:
        plaintext_bytes = decrypt_generated_file(encrypted_path)
        ext = os.path.basename(encrypted_path).split(".")[-2]
        fd, temp_path = tempfile.mkstemp(suffix=f".{ext}")
        with os.fdopen(fd, "wb") as f:
            f.write(plaintext_bytes)
        print(temp_path)
    except Exception as e:
        print(f"Decryption failed: {e}", file=sys.stderr)
        print("")  # empty stdout — watcher checks for this and reports delivery failure


def mark_job_delivered_cmd(job_id):
    mark_job_delivered(job_id)


def run_background_job_cmd(job_id):
    """
    Entry point for the detached subprocess spawned by an async tool
    call — does the actual slow work and records the result. This is
    what `curant-cli run-background-job <id>` executes.
    """
    job = _get_background_job(job_id)
    if not job:
        print(f"No such job: {job_id}", file=sys.stderr)
        sys.exit(1)

    _update_background_job(job_id, "running")
    config = load_config()
    arguments = json.loads(job["arguments"])

    if job["tool_name"] == "generate_video":
        path, error = _generate_video_veo_sync(arguments.get("prompt", ""), config)
        if error:
            _update_background_job(job_id, "failed", error=error)
        else:
            log_generation_cost("veo")
            _update_background_job(job_id, "done", result_path=path)
    elif job["tool_name"] == "fill_and_submit_form":
        # The ONLY place this actually runs — relay()'s hybrid wrapper
        # (fill_and_submit_form_hybrid) only ever polls this job's
        # status, it never calls fill_and_submit_form() itself. That's
        # what guarantees the form only ever gets submitted once,
        # regardless of whether the customer's reply ends up answering
        # synchronously (the fast, common case) or asynchronously (a
        # slow site).
        result, error = fill_and_submit_form(
            arguments.get("url", ""), arguments.get("field_values", {}), arguments.get("submit_selector", ""),
            confirmed=arguments.get("confirmed", False),
        )
        if error:
            _update_background_job(job_id, "failed", error=error)
        else:
            _update_background_job(job_id, "done", result_text=result.get("result_text", ""))
    else:
        _update_background_job(job_id, "failed", error=f"Unknown background job type: {job['tool_name']}")


def _generate_video_veo_sync(prompt, config):
    """
    The actual Veo work — synchronous, slow (several minutes), meant to
    run inside the detached background job subprocess, never directly
    inside relay() itself. Verified before writing this:
      - Veo IS available via the simpler Gemini API (not just the much
        heavier Vertex AI, which needs a GCP project + service account) —
        confirmed against Google's own current docs and the real,
        installable `google-genai` Python SDK.
      - Veo 2.0 is deprecated as of June 30, 2026 — already past as of
        when this was built. Targets veo-3.1-generate-preview, the
        current model, not the deprecated one.
      - The real SDK pattern is async: submit via generate_videos(),
        poll via operations.get() until done, then download the
        resulting video bytes — same shape as FLUX's submit/poll
        pattern, different vendor.
    A customer's own Gemini API key is used here (config["api_keys"]["veo"]),
    same BYOK model as every other generation service.
    """
    api_key = get_api_key(config, "veo")
    if not api_key:
        return None, "No Google Gemini API key set for video generation. Run: curant-cli set-api-key <key> --provider veo"
    try:
        from google import genai
        client = genai.Client(api_key=api_key)
        operation = client.models.generate_videos(
            model="veo-3.1-generate-preview",
            prompt=prompt,
        )
        for _ in range(60):  # up to ~10 minutes — video generation is slow
            time.sleep(10)
            operation = client.operations.get(operation)
            if operation.done:
                break
        else:
            return None, "Video generation timed out waiting for a result."

        if not operation.response or not operation.response.generated_videos:
            return None, "Veo reported done but returned no video."

        video = operation.response.generated_videos[0]
        video_bytes = client.files.download(file=video.video)
        return _save_generated_bytes(video_bytes, "mp4"), None
    except Exception as e:
        return None, f"Veo call failed: {e}"


def generate_video_veo_async(prompt, config, apple_id):
    """
    The actual tool entrypoint used from execute_tool_call now — spawns
    a detached subprocess to do the slow work and returns immediately
    with a "started" message, rather than blocking relay() (and the
    whole watcher) for several minutes. start_new_session=True is what
    makes this survive after relay()'s own process exits — without it,
    the OS would likely terminate the child alongside its parent.
    """
    job_id = _create_background_job("generate_video", {"prompt": prompt}, apple_id)
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "run-background-job", str(job_id)],
            start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        _update_background_job(job_id, "failed", error=f"Could not start background job: {e}")
        return f"Couldn't start video generation: {e}"
    return (f"Started generating your video — this takes several minutes, "
            f"I'll send it to you as soon as it's ready.")





