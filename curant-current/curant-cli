def save_message(role, content, provider=None, urgency=None):
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO messages (role, content, provider, urgency) VALUES (?, ?, ?, ?)",
            (role, content, provider, urgency),
        )
        # Data minimization: keep only enough raw history for conversational
        # continuity. Anything durable should already be promoted into
        # `memories` by update_memories_from_exchange. Grace gets a larger
        # retention window -- see MESSAGE_HISTORY_KEEP_GRACE.
        conn.execute(
            """DELETE FROM messages WHERE id NOT IN (
                   SELECT id FROM messages ORDER BY id DESC LIMIT ?
               )""",
            (_message_history_keep(),),
        )
        conn.execute(
            "DELETE FROM messages WHERE created_at < datetime('now', ?)",
            (f"-{_message_history_max_age_hours()} hours",),
        )
        conn.commit()


