IMAGE_MIME_TYPES = {
    ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png",
    ".gif": "image/gif", ".webp": "image/webp", ".heic": "image/heic",
    ".bmp": "image/bmp", ".tiff": "image/tiff",
}


def build_image_message_content(provider, image_path, text):
    """
    Builds a provider-shaped content array for a message that includes an
    image — both Anthropic and OpenAI accept an array of content blocks
    instead of a plain string, but the block shape for an image genuinely
    differs between them, so this is the one place that difference is
    handled, same pattern as the system-prompt handling in _call_openai.
    Falls back to plain text (no image block) if the file can't be read
    or the extension isn't recognized, rather than failing the whole
    message over an attachment problem.
    """
    import base64
    ext = os.path.splitext(image_path)[1].lower()
    mime_type = IMAGE_MIME_TYPES.get(ext)
    if not mime_type:
        return text or "[Sent an image in an unrecognized format]"
    try:
        with open(image_path, "rb") as f:
            image_b64 = base64.b64encode(f.read()).decode()
    except Exception as e:
        return (text or "") + f"\n[Couldn't read the attached image: {e}]"

    if provider == "anthropic":
        return [
            {"type": "image", "source": {"type": "base64", "media_type": mime_type, "data": image_b64}},
            {"type": "text", "text": text or "What's in this image?"},
        ]
    elif provider == "openai":
        return [
            {"type": "text", "text": text or "What's in this image?"},
            {"type": "image_url", "image_url": {"url": f"data:{mime_type};base64,{image_b64}"}},
        ]
    else:
        return text or "[Image attached — this provider doesn't have image support wired up]"


def build_system_prompt(config, memories, people, live_context, extra_instruction=None,
                        active_provider=None, is_first_message=False, urgency=None):
    persona_prompt = PERSONAS.get(config.get("persona", "curant"), PERSONAS["curant"])
    addons = config.get("unlocked_addons", [])

    system_parts = [persona_prompt]
    if config.get("instructions"):
        system_parts.append(f"Standing instructions from this customer: {config['instructions']}")
    if memories:
        system_parts.append("What you've learned about this customer so far:\n" + "\n".join(f"- {m}" for m in memories))
    if live_context:
        system_parts.append(
            "Live context from their device right now (calendar/reminders — "
            "use this naturally, don't just recite it back):\n" + live_context
        )
    if people:
        people_str = "\n".join(f"- {p['name']} ({p['relationship']}): {p['note']}" for p in people)
        system_parts.append(f"People who matter to this customer:\n{people_str}")
    if addons:
        system_parts.append(f"Unlocked add-ons: {', '.join(addons)}. You may use these capabilities.")
    else:
        system_parts.append("Base plan only — do not offer autonomous sending or other locked features; suggest unlocking the relevant add-on instead.")
    system_parts.append(
        "You never send anything (email, messages) without explicit confirmation from the customer first, "
        "unless they've specifically set up an approved recurring auto-send task."
    )
    system_parts.append(
        "Know the difference between a decision you should make and one that belongs to the customer. "
        "If a request calls for real judgment outside what you should decide unilaterally — a legal, "
        "medical, financial, or otherwise high-stakes call; something you're genuinely unsure about; "
        "or anything where being wrong would be costly or hard to undo — say so plainly and hand the "
        "decision back to them, rather than answering confidently anyway. This isn't the same as the "
        "capability-gap case below (something no tool or reasoning covers at all) — this is about "
        "things you technically COULD answer but shouldn't decide on someone's behalf. A brief, honest "
        "'this one's your call, here's what I'd weigh' beats a confident guess every time."
    )
    if "browser_automation" in addons:
        system_parts.append(
            "You can browse webpages (browse_page — read-only, no confirmation needed) and fill in and "
            "submit forms on them (fill_and_submit_form). The second one has a real effect — it can create "
            "an account or submit real data somewhere — so ONLY call it after the customer has explicitly "
            "confirmed in a prior message, never in the same turn you first mention it. Use browse_page "
            "first to see what fields exist before filling anything in. This will always refuse payment or "
            "sensitive-ID fields (card numbers, CVV, SSN) no matter what — never try to work around that, "
            "tell the customer those need to be entered by a person directly."
        )
    system_parts.append(
        "If the customer asks for something you genuinely can't do (no tool covers it, and it's not "
        "something you can just help with by reasoning/writing), say so plainly, then let them know "
        "Curant can build custom things like that for a quote — they'd need to call in for that, "
        "it's not something available for free. Log it with log_capability_gap so it's tracked."
    )
    system_parts.append(
        "If asked what you can help with, or what Curant does, give a real, specific answer reflecting "
        "actual breadth — writing and communication, research, math and data, legal/government paperwork, "
        "explaining medical/health info in plain language, budgeting and financial questions, calendar and "
        "life admin, home and family logistics, career and professional development, trades and real estate "
        "questions, event planning, and civic/accessibility topics — not a vague 'I can help with anything.' "
        "Mention a couple of concrete examples rather than reciting the whole list. If you have specialist "
        "tools available (image/voice/video generation, or connected MCP servers), mention those too."
    )
    if is_first_message:
        system_parts.append(
            "This is the very first message this customer has ever sent you. Introduce yourself naturally — "
            "your persona name and a genuine sense of what you're good for — without it reading like a canned "
            "feature list or a corporate welcome email. Keep it brief; they can always ask for more."
        )
    if urgency == "urgent":
        system_parts.append(
            "This specific message reads as urgent or time-sensitive (based on wording/formatting, not a "
            "confirmed emergency). Respond quickly and directly — skip small talk, lead with the most useful "
            "information or action first. This is about tone and pacing only; use your own judgment about the "
            "actual content exactly as you always would, this flag doesn't override that."
        )
    if active_provider:
        system_parts.append(
            f"This specific reply is being generated via {active_provider}. If the customer asks which AI "
            "is answering, or which model is currently handling their messages, answer honestly using this — "
            "don't guess or deflect."
        )
    if extra_instruction:
        system_parts.append(extra_instruction)
    return "\n\n".join(system_parts)


# ── Local front-door layer ───────────────────────────────────────────────────
# A small local model (via Ollama, running on the customer's own Mac)
# sitting IN FRONT OF Claude, never instead of it — Claude stays the
# actual reasoning brain for everything that matters. This layer only
# handles a few narrow, low-stakes jobs before anything reaches the
# network:
#   1. PII redaction — sensitive-looking content (SSNs, credit card
#      numbers) gets masked out of whatever's sent to Claude's API,
#      so the raw value never leaves the device even in transit. Local
#      storage (save_message, memory) keeps the ORIGINAL unredacted
#      text — the point is protecting what crosses the network, not
#      hiding anything from the customer's own machine.
#   2. Triviality short-circuit — a quick "hey" or "thanks" gets a
#      local-generated reply instead of spending a full Claude call on
#      it. Deliberately conservative: any failure to classify (local
#      model unavailable, ambiguous result) defaults to NOT trivial,
#      so this can only ever save a call, never silently downgrade a
#      real request.
#   3. Offline fallback — if Claude's API is unreachable, this tries a
#      degraded local-model reply (clearly flagged as reduced-capability)
#      instead of a hard failure with no answer at all.
#
# HONEST DEPENDENCY, stated plainly: this requires Ollama
# (https://ollama.com) installed and running locally — NOT bundled
# with curant-cli itself. Every function below fails safe (returns
# None / False) if Ollama isn't running, rather than raising — this
# entire layer is an optimization and a privacy improvement, never a
# hard requirement for Curant to work. A customer who never installs
# Ollama gets the exact same behavior as before this layer existed.

OLLAMA_HOST = os.environ.get("CURANT_OLLAMA_HOST", "http://localhost:11434")
LOCAL_MODEL_NAME = os.environ.get("CURANT_LOCAL_MODEL", "qwen3:8b")
LOCAL_MODEL_TIMEOUT_SECONDS = 8
LOCAL_MODEL_HEALTH_CHECK_TIMEOUT_SECONDS = 1.5  # short — this is checked on every
                                                   # message, shouldn't add latency
                                                   # when Ollama simply isn't running


def is_local_model_available():
    """Fast health check — short timeout on purpose (see above). Never
    raises; any failure (not installed, not running, wrong port) means
    'not available', not an error."""
    try:
        import requests
        resp = requests.get(f"{OLLAMA_HOST}/api/tags", timeout=LOCAL_MODEL_HEALTH_CHECK_TIMEOUT_SECONDS)
        return resp.status_code == 200
    except Exception:
        return False


def _call_ollama(prompt, system="", timeout=LOCAL_MODEL_TIMEOUT_SECONDS):
    """
    Raw call to Ollama's local REST API. Returns the reply text, or
    None on ANY failure — connection refused, timeout, malformed
    response, model not pulled yet. Every caller in this section
    treats None as 'local model unavailable right now' and falls back
    accordingly; nothing here ever raises up to relay().
    """
    try:
        import requests
        resp = requests.post(
            f"{OLLAMA_HOST}/api/chat",
            json={
                "model": LOCAL_MODEL_NAME,
                "messages": ([{"role": "system", "content": system}] if system else [])
                            + [{"role": "user", "content": prompt}],
                "stream": False,
            },
            timeout=timeout,
        )
        resp.raise_for_status()
        data = resp.json()
        return (data.get("message") or {}).get("content", "").strip() or None
    except Exception:
        return None


# ── PII redaction ────────────────────────────────────────────────────────────
# Deterministic regex detection, not model-based judgment — same
# principle as _is_sensitive_field's hard block on payment form fields
# elsewhere in this file: a small local model's fuzzy judgment isn't
# reliable enough to be the ONLY line of defense for something this
# security-relevant, so this uses structural pattern matching instead.
#
# Deliberately covers only what can be detected with real confidence:
# SSNs (clean XXX-XX-XXXX format) and credit card numbers (13-19
# digits, Luhn-validated to cut false positives against arbitrary long
# numbers). Bank routing/account numbers are NOT covered — a bare
# 9-digit number has no reliable structural signature distinguishing it
# from any other number, and a noisy pattern that redacts things that
# aren't actually bank numbers would erode trust in this feature faster
# than it protects anything. Better to cover two categories well than
# five categories unreliably.

SSN_PATTERN = re.compile(r"\b\d{3}-\d{2}-\d{4}\b")
CREDIT_CARD_CANDIDATE_PATTERN = re.compile(r"\b(?:\d[ -]?){13,19}\b")


def _luhn_valid(digit_string):
    digits = [int(d) for d in re.sub(r"[ -]", "", digit_string)]
    checksum = 0
    for i, digit in enumerate(reversed(digits)):
        if i % 2 == 1:
            digit *= 2
            if digit > 9:
                digit -= 9
        checksum += digit
    return checksum % 10 == 0


def redact_pii(text):
    """
    Returns (redacted_text, redaction_count). Only ever called on
    content that's about to leave the device (the API-bound message
    content and the memory-extraction input) — never applied to what's
    saved to local storage, since the whole point is protecting what
    crosses the network, not hiding anything from the customer's own
    machine. Safe on empty/None input.
    """
    if not text:
        return text, 0

    count = 0
    redacted = SSN_PATTERN.sub(lambda m: "[REDACTED_SSN]", text)
    count += len(SSN_PATTERN.findall(text))

    def _replace_card(match):
        nonlocal count
        candidate = match.group(0)
        if not _luhn_valid(candidate):
            return candidate  # fails Luhn check — not actually a valid card number, leave it alone
        count += 1
        return "[REDACTED_CARD_NUMBER]"

    redacted = CREDIT_CARD_CANDIDATE_PATTERN.sub(_replace_card, redacted)
    return redacted, count


# ── Triviality short-circuit ─────────────────────────────────────────────────

def classify_message_triviality(text):
    """
    Conservative by design: returns False (not trivial — use full
    Claude reasoning) on any doubt at all. This can only ever save an
    API call on a genuinely trivial message; it can never cause a real
    request to get a degraded local-only answer, since a wrong "not
    trivial" classification just means the normal path runs anyway.
    """
    if not text or not text.strip():
        return False
    if not is_local_model_available():
        return False
    result = _call_ollama(
        prompt=f"Message: {text}",
        system=(
            "You classify a single incoming message to a personal AI secretary. "
            "Reply with EXACTLY one word: TRIVIAL if this is just a greeting, "
            "acknowledgment, thanks, or similar low-stakes small talk that needs only "
            "a brief friendly reply — SUBSTANTIVE for anything that involves a real "
            "question, task, request, or requires any actual thought. When genuinely "
            "unsure, answer SUBSTANTIVE."
        ),
        timeout=4,  # this is meant to save time, not cost more of it — short budget
    )
    if result is None:
        return False
    return result.strip().upper().startswith("TRIVIAL")


def generate_local_reply(text, persona_name="Curant"):
    """
    Only called after classify_message_triviality already returned
    True, so the local model is confirmed available — but still handles
    a None result gracefully (a race between the two calls, or Ollama
    going down in between) rather than ever returning nothing.
    """
    reply = _call_ollama(
        prompt=text,
        system=(f"You are {persona_name}, a personal AI secretary. Reply briefly and "
                f"warmly to this short, low-stakes message — a sentence or two at most."),
    )
    return reply or "Got it!"


def generate_offline_reply(text, persona_name="Curant"):
    """
    Called only when the real Claude call already failed (see relay()).
    Returns None if the local model ISN'T available either — in that
    case relay() falls back to its original hard-failure behavior,
    since there's genuinely nothing left to try.
    """
    if not is_local_model_available():
        return None
    return _call_ollama(
        prompt=text,
        system=(
            f"You are {persona_name}, a personal AI secretary, currently running in a "
            f"reduced OFFLINE mode because the main connection is unreachable. Be "
            f"upfront about that — you may not have full context or your usual "
            f"capabilities right now. Help as best you can with just what's in this "
            f"message, and mention that full service will resume once the connection "
            f"is back."
        ),
    )


def relay(message_text, context="", image_path=None, apple_id=None, tier="main"):
    """
    Handle an incoming message entirely locally: verify entitlement (using
    a cached status check, not a live call for every message), build the
    system prompt from local persona/instructions/memories/important
    people, call whichever model provider is configured with the
    customer's own API key, save the exchange locally, and kick off
    background memory extraction. If image_path is given, the model
    actually sees the image (a real vision content block, provider-
    appropriate) rather than the watcher trying to describe it first.

    Always prints structured JSON so curant-watcher.py's json.loads() never
    breaks, matching the previous client/server contract.

    tier defaults to "main" (the full model) for normal text relay. Callers
    that need lower latency more than top reasoning quality — currently
    just the experimental FaceTime answerer, where a caller is waiting in
    real time — can pass tier="fast" to use each provider's quicker model.
    """
    config = load_config()
    key = config.get("license_key")
    if not key and not DEV_UNLICENSED:
        print(json.dumps({"reply": None, "error": "not_activated"}))
        sys.exit(1)
    if DEV_UNLICENSED:
        _warn_dev_unlicensed()
        # Normal activation calls init_local_db() once; the bypass skips
        # activation entirely, so do it here instead. Idempotent (CREATE
        # TABLE IF NOT EXISTS throughout) — safe to call on every relay().
        init_local_db()

    _last_generated_files.clear()  # this turn's generations only, not leftover from a prior call

    global _current_apple_id
    _current_apple_id = apple_id

    provider = get_provider(config)
    api_key = get_api_key(config, provider)
    if not api_key:
        report_error("no_api_key_set", "curant-cli")
        print(json.dumps({"reply": None, "error": "no_api_key_set"}))
        sys.exit(1)

    if DEV_UNLICENSED:
        active = True  # entitlement bypass (CURANT_DEV_UNLICENSED); warned above
    else:
        config, active = refresh_status_if_stale(config)
    if not active:
        report_error("inactive_or_invalid_license", "curant-cli")
        print(json.dumps({"reply": None, "error": "inactive_or_invalid_license"}))
        sys.exit(1)

    # Local front-door layer, step 1: triviality short-circuit. Only
    # attempted for plain text (an image always deserves real reasoning
    # to actually look at it) and only ever SAVES a Claude call — never
    # skips one on uncertain ground, since classify_message_triviality
    # defaults to False on any doubt at all.
    if not image_path and classify_message_triviality(message_text):
        local_reply = generate_local_reply(message_text, persona_name=config.get("persona", "Curant").title())
        save_message("user", message_text, urgency="normal")
        save_message("assistant", local_reply, provider="local")
        print(json.dumps({
            "reply": local_reply,
            "reply_format": config.get("reply_format", "text"),
            "voice_tier": config.get("voice_tier", "standard"),
            "attachment_path": None,
        }))
        return

    memories = get_memories()
    people = get_important_people()

    # Multi-provider routing: if more than one provider has a key
    # configured, let this specific message be answered by whichever one
    # actually suits it — a one-off request in the message itself, an
    # existing standing rule, or (falling back) a judgment call about
    # relative model strengths. Skipped entirely with only one provider
    # configured, so this never adds cost/latency to the common case.
    eligible = get_eligible_providers(config)
    routed_provider, routing_reason, new_rule_saved = decide_provider(
        message_text, config, provider, eligible
    )
    if routed_provider != provider:
        # Routing to a different provider than "the" configured one means
        # a different API key too.
        routed_api_key = get_api_key(config, routed_provider)
        if routed_api_key:
            provider = routed_provider
            api_key = routed_api_key

    history = get_history()
    is_first_message = len(history) == 0
    urgency = classify_urgency(message_text)

    system_prompt = build_system_prompt(
        config, memories, people, context, active_provider=provider,
        is_first_message=is_first_message, urgency=urgency,
    )

    # Local front-door layer, step 2: PII redaction. Applied ONLY to what
    # actually leaves the device — the content sent to Claude below, and
    # (further down) what's passed into memory extraction, which is
    # itself a real API call and would otherwise defeat the point of
    # redacting here at all. Local storage (save_message, a few lines
    # down) deliberately keeps the ORIGINAL message_text — nothing about
    # this feature is about hiding anything from the customer's own
    # machine, only about what crosses the network.
    redacted_message_text, pii_redaction_count = redact_pii(message_text)
    if pii_redaction_count:
        print(f"[front-door] redacted {pii_redaction_count} PII match(es) before sending to {provider}",
              file=sys.stderr)

    if image_path:
        user_content = build_image_message_content(provider, image_path, redacted_message_text)
    else:
        user_content = redacted_message_text
    history.append({"role": "user", "content": user_content})

    # Tool support: log_capability_gap is always available; any
    # configured MCP servers add whatever they expose. Both providers'
    # tool-calling loop handle this the same way from here on.
    available_tools = get_all_available_tools(config)

    try:
        if available_tools:
            reply_text = call_llm_with_tools(
                provider, api_key, system_prompt, history, available_tools, available_tools,
                max_tokens=1000, tier=tier,
            )
        else:
            reply_text = call_llm(provider, api_key, system_prompt, history, max_tokens=1000, tier=tier)
    except Exception as e:
        # Local front-door layer, step 3: offline fallback. Only
        # attempted after the real call has already failed — this never
        # substitutes for Claude when Claude is actually reachable, it
        # only fills the gap between "the connection is down" and
        # "total silence." generate_offline_reply returns None if the
        # local model isn't available either, in which case this falls
        # through to the original hard-failure behavior unchanged.
        offline_reply = generate_offline_reply(
            redacted_message_text, persona_name=config.get("persona", "Curant").title()
        )
        if offline_reply:
            reply_text = offline_reply
            provider = "local_offline"
            report_error("llm_call_failed", "curant-cli")  # still worth knowing the real call failed
        else:
            report_error("llm_call_failed", "curant-cli")
            print(json.dumps({"reply": f"Couldn't reach {provider} on your account: {e}", "error": "llm_call_failed"}))
            sys.exit(1)

    user_history_text = message_text if message_text else ("[sent an image]" if image_path else message_text)
    save_message("user", user_history_text, urgency=urgency)
    save_message("assistant", reply_text, provider=provider)

    # Track usage as a count only — reported to the server on the next
    # periodic status check, never per-message.
    config = load_config()
    config["pending_usage_count"] = config.get("pending_usage_count", 0) + 1
    save_config(config)

    # Memory extraction — kept synchronous but cheap (the "fast" tier
    # model); this process exits right after, so a background thread
    # would risk being killed before it finishes. A few hundred ms here
    # is an acceptable tradeoff for memory reliably actually happening.
    # Uses the REDACTED text, not user_history_text — this is a real API
    # call too, and would otherwise leak whatever the front-door layer
    # just redacted from the main conversation turn.
    update_memories_from_exchange(provider, api_key, memories, redacted_message_text, reply_text)

    # Generated files sit encrypted on disk (see _save_generated_bytes) —
    # decrypt to a short-lived temp file only at the moment of actually
    # handing off to the watcher for delivery. curant-watcher.py deletes
    # this temp copy immediately after sending; the long-term encrypted
    # copy in ~/.curant/generated/ is what prune_generated_files() manages.
    attachment_path = None
    if _last_generated_files:
        try:
            encrypted_path = _last_generated_files[-1]
            plaintext_bytes = decrypt_generated_file(encrypted_path)
            temp_ext = os.path.basename(encrypted_path).split(".")[-2]  # e.g. "png" from "png_abc.png.enc"
            fd, attachment_path = tempfile.mkstemp(suffix=f".{temp_ext}")
            with os.fdopen(fd, "wb") as f:
                f.write(plaintext_bytes)
        except Exception as e:
            print(f"Could not decrypt generated file for delivery (non-fatal): {e}", file=sys.stderr)

    print(json.dumps({
        "reply": reply_text,
        "reply_format": config.get("reply_format", "text"),
        "voice_tier": config.get("voice_tier", "standard"),
        "attachment_path": attachment_path,
    }))


def proactive_check(context):
    """
    Decide locally whether a proactive (unprompted) check-in is warranted
    right now, using the same local persona/memory/instructions context.
    Deliberately conservative — most days should conclude nothing is worth
    sending, and any error fails closed (nothing sent) rather than risking
    a spurious message.
    """
    config = load_config()
    key = config.get("license_key")
    if not key:
        print(json.dumps({"should_send": False, "error": "not_activated"}))
        sys.exit(1)

    if not config.get("proactivity_enabled"):
        print(json.dumps({"should_send": False}))
        return

    provider = get_provider(config)
    api_key = get_api_key(config, provider)
    if not api_key:
        print(json.dumps({"should_send": False, "error": "no_api_key_set"}))
        return

    config, active = refresh_status_if_stale(config)
    if not active:
        print(json.dumps({"should_send": False, "error": "inactive_or_invalid_license"}))
        return

    if not context:
        # Nothing to reason about — don't manufacture a check-in from thin air.
        print(json.dumps({"should_send": False}))
        return

    memories = get_memories()
    people = get_important_people()
    extra = (
        "You are deciding whether to proactively message this person right now, "
        "unprompted — they haven't texted you. Only do this if something in their "
        "calendar/reminders genuinely warrants a heads-up (conflicts, something "
        "easy to forget, a change worth flagging). Most days there is nothing worth "
        "sending, and that is the correct, expected outcome — do not invent a reason "
        "to reach out just to seem useful.\n\n"
        f"Today's live context:\n{context}\n\n"
        'Respond with ONLY a JSON object: {"should_send": true/false, "message": "..."} '
        '— message should be empty string if should_send is false.'
    )
    system_prompt = build_system_prompt(config, memories, people, "", extra_instruction=extra)

    try:
        raw = call_llm(
            provider, api_key, system_prompt,
            messages=[{"role": "user", "content": "Decide whether to send a proactive check-in now."}],
            max_tokens=300, tier="main",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        decision = json.loads(raw)
    except Exception as e:
        # Fail closed — a broken proactivity check should never spam the
        # customer, it should just silently not send anything.
        print(f"Proactive check failed (non-fatal, not sending): {e}", file=sys.stderr)
        print(json.dumps({"should_send": False}))
        return

    if decision.get("should_send") and decision.get("message"):
        save_message("assistant", decision["message"])
        print(json.dumps({
            "should_send": True,
            "message": decision["message"],
            "reply_format": config.get("reply_format", "text"),
            "voice_tier": config.get("voice_tier", "standard"),
        }))
    else:
        print(json.dumps({"should_send": False}))


# --- Local backup (encrypted with a customer-chosen passphrase; entirely local, no server involvement) ---

def _derive_backup_key(passphrase, salt):
    """
    scrypt-derived key from the customer's own passphrase — deliberately
    NOT PBKDF2. PBKDF2's cost is pure CPU time, which parallelizes cheaply
    on GPUs/ASICs, so an attacker with dedicated hardware can brute-force
    it far faster than a defender's single CPU suggests. scrypt is
    memory-hard: each guess requires ~256MB of RAM (n=2**18, r=8, p=1),
    which is expensive to parallelize at scale even with custom hardware,
    not just slow on one core. This is the standard reason password-based
    encryption uses scrypt/Argon2 over PBKDF2 when the threat model
    includes serious brute-force attempts against a stolen file.

    Cost is ~1-2 seconds and ~256MB RAM per attempt, which is a deliberate
    tradeoff — this only runs on backup/restore, an infrequent command, so
    spending real time and memory per attempt is the whole point: it
    should be similarly expensive for anyone trying to brute-force it.

    The salt is not secret (it's stored alongside the ciphertext in the
    backup file itself) — its purpose is only to defeat precomputed
    rainbow-table attacks, not to add confidentiality on its own.
    """
    from cryptography.hazmat.primitives.kdf.scrypt import Scrypt
    import base64
    kdf = Scrypt(salt=salt, length=32, n=2**18, r=8, p=1)
    return base64.urlsafe_b64encode(kdf.derive(passphrase.encode()))


DEFAULT_BACKUP_PATH = os.path.join(CONFIG_DIR, "backup.curantbackup")


def backup_now(path=None):
    """
    Encrypts settings/preferences LOCALLY with a key derived from a
    passphrase you enter interactively, then writes the result to a file
    — nothing is ever sent to Curant's server. By default this writes to
    ~/.curant/backup.curantbackup, but you can point it anywhere with
    --path: an external drive, an iCloud Drive or Dropbox folder, etc.
    Writing to a location that's actually synced/backed up elsewhere is
    what makes this useful against losing the Mac itself — a backup file
    that only ever lives on the same disk doesn't survive that disk
    being lost.

    Deliberately scoped to settings only — persona, standing
    instructions, reply format, voice tier, proactivity setting. This
    does NOT include memories or important people: those are the actual
    learned facts about the customer and real people's names/
    relationships, which is meaningfully more sensitive content than a
    settings choice, so it's kept out of anything that might end up
    copied to an external drive or cloud folder. A restore brings back
    how Curant is configured, not what it has learned — that's a real,
    deliberate capability loss, not an oversight.

    Also deliberately excludes the Anthropic API key and raw recent
    message history — the API key is the single most sensitive thing on
    this machine, so it stays local-only even in a backup file; and
    message history already auto-expires by design, so there's no reason
    to preserve it.
    """
    import base64
    import getpass
    from cryptography.fernet import Fernet

    config = load_config()
    if not config.get("license_key"):
        print("Not activated. Run: curant-cli activate <your-license-key>")
        sys.exit(1)

    passphrase = getpass.getpass("Choose a backup passphrase (input hidden, won't be shown or stored): ")
    if not passphrase:
        print("Passphrase can't be empty.")
        sys.exit(1)
    confirm = getpass.getpass("Confirm passphrase: ")
    if passphrase != confirm:
        print("Passphrases didn't match — nothing was written.")
        sys.exit(1)

    payload_data = {
        "persona": config.get("persona"),
        "instructions": config.get("instructions"),
        "reply_format": config.get("reply_format"),
        "voice_tier": config.get("voice_tier"),
        "proactivity_enabled": config.get("proactivity_enabled"),
    }
    plaintext = json.dumps(payload_data).encode()
    salt = os.urandom(16)
    print("Deriving encryption key (this takes a couple seconds by design — "
          "it should be similarly slow for anyone trying to guess your passphrase)...")
    derived_key = _derive_backup_key(passphrase, salt)
    ciphertext = Fernet(derived_key).encrypt(plaintext)
    blob = base64.b64encode(salt).decode() + ":" + ciphertext.decode()

    target = os.path.expanduser(path) if path else DEFAULT_BACKUP_PATH
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "w") as f:
        f.write(blob)
    os.chmod(target, 0o600)

    print(f"Backup written to {target}")
    print("This backs up your settings only (persona, instructions, reply/voice "
          "preferences, proactivity) — not your memories or important people.")
    print("Remember your passphrase — it's the only way to restore this, and Curant "
          "has no way to recover it if you lose it, since it was never stored or sent anywhere.")
    if not path:
        print("This is on the same disk as everything else — copy it somewhere that "
              "survives losing this Mac (an external drive, iCloud Drive, Dropbox, etc.) "
              "if you want it to actually protect against that. You can also just run "
              "`curant-cli backup-now --path <somewhere else>` directly next time.")


def backup_restore(path=None):
    """Reads an encrypted backup file and decrypts it locally with a
    passphrase entered interactively. Never sends anything anywhere.
    Restores settings only — see backup_now()'s docstring for why
    memories/important people are deliberately not part of this."""
    import base64
    import getpass
    from cryptography.fernet import Fernet, InvalidToken

    config = load_config()
    if not config.get("license_key"):
        print("Not activated. Run: curant-cli activate <your-license-key> first.")
        sys.exit(1)

    source = os.path.expanduser(path) if path else DEFAULT_BACKUP_PATH
    if not os.path.exists(source):
        print(f"No backup file found at {source}. Pass --path if it's somewhere else "
              "(external drive, iCloud Drive, etc.)")
        sys.exit(1)
    with open(source) as f:
        blob = f.read().strip()

    passphrase = getpass.getpass("Enter your backup passphrase: ")
    print("Verifying (this takes a couple seconds by design)...")

    try:
        salt_b64, ciphertext = blob.split(":", 1)
        salt = base64.b64decode(salt_b64)
        derived_key = _derive_backup_key(passphrase, salt)
        plaintext = Fernet(derived_key).decrypt(ciphertext.encode())
        data = json.loads(plaintext)
    except (InvalidToken, ValueError):
        print("Could not decrypt backup — wrong passphrase, or the file is corrupted.")
        sys.exit(1)

    config["persona"] = data.get("persona", config.get("persona", "curant"))
    config["instructions"] = data.get("instructions", config.get("instructions", ""))
    config["reply_format"] = data.get("reply_format", config.get("reply_format", "text"))
    config["voice_tier"] = data.get("voice_tier", config.get("voice_tier", "standard"))
    config["proactivity_enabled"] = data.get("proactivity_enabled", config.get("proactivity_enabled", False))
    save_config(config)
    print("Backup restored: persona, instructions, and settings are back. "
          "Memories and important people are NOT included in backups and are not affected. "
          "You'll still need to run `curant-cli set-api-key` again — the API key is never included in backups.")


# --- Portable context export (encrypted; a human-readable template OR a
# spec-conformant portable-memory JSON file, meant to be decrypted and
# used with a different AI — see PORTABLE_MEMORY_SPEC.md. Distinct from
# the settings-only backup above, since this one's whole purpose is
# carrying memories/important-people content) ---

DEFAULT_CONTEXT_PATH = os.path.join(CONFIG_DIR, "context.curantcontext")
CPMF_VERSION = "1.0"  # see PORTABLE_MEMORY_SPEC.md — bump only for a
                       # breaking schema change, per that document's own
                       # versioning policy


def build_context_template(config, memories, people):
    """
    Builds the plain-language, pasteable context block (the "text"
    format). Deliberately contains nothing that grants access to
    anything (no API key, no license key, no device id) and no verbatim
    proprietary persona wording (uses PERSONA_STYLE_SUMMARY, not
    PERSONAS) — so this template is safe to exist even decrypted: worst
    case if it leaked, someone reads the customer's own stated
    preferences and memories, the same thing they'd be pasting into a
    third-party chat window themselves.
    """
    style = PERSONA_STYLE_SUMMARY.get(config.get("persona", "curant"), PERSONA_STYLE_SUMMARY["curant"])
    lines = ["--- Personal Assistant Context ---", ""]
    lines.append(f"Style: {style}")
    if config.get("instructions"):
        lines.append(f"Standing instructions: {config['instructions']}")
    lines.append("")
    lines.append("Preferences:")
    lines.append(f"- Reply format: {config.get('reply_format', 'text')}")
    lines.append(f"- Proactive check-ins: {'on' if config.get('proactivity_enabled') else 'off'}")
    lines.append("")
    lines.append("Things to remember about me:")
    if memories:
        for m in memories:
            lines.append(f"- {m}")
    else:
        lines.append("- (none yet)")
    lines.append("")
    lines.append("People who matter to me:")
    if people:
        for p in people:
            lines.append(f"- {p['name']} ({p['relationship']}): {p['note']}")
    else:
        lines.append("- (none yet)")
    lines.append("")
    lines.append("--- End context ---")
    return "\n".join(lines)


def build_cpmf_json(config, memories, people):
    """
    Builds a Curant Portable Memory Format (CPMF) v1.0 document — see
    PORTABLE_MEMORY_SPEC.md for the full schema and design rationale.
    This is the machine-readable counterpart to build_context_template():
    same underlying data, same safety properties (no secrets, no
    vendor-specific wording), but structured so any tool — not just a
    human pasting text — can parse it and build a working system prompt,
    regardless of which model that tool talks to.
    """
    import datetime
    style = PERSONA_STYLE_SUMMARY.get(config.get("persona", "curant"), PERSONA_STYLE_SUMMARY["curant"])
    return {
        "cpmf_version": CPMF_VERSION,
        "generated_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "persona": {
            "style_summary": style,
            "instructions": config.get("instructions", ""),
        },
        "preferences": {
            "reply_format": config.get("reply_format", "text"),
            "proactivity_enabled": bool(config.get("proactivity_enabled", False)),
        },
        "memories": [{"content": m} for m in memories],
        "people": [
            {"name": p["name"], "relationship": p["relationship"], "note": p["note"]}
            for p in people
        ],
    }


def validate_cpmf_json(data):
    """
    Minimal structural validation of a CPMF document — checked on every
    context_show(..., format='json') so a corrupted or malformed file
    fails with a clear message rather than a confusing downstream error.
    Deliberately lenient about unknown/extra fields (per the spec's own
    versioning policy: consumers should tolerate fields they don't
    recognize) — only the required shape is enforced.
    """
    if not isinstance(data, dict):
        return False, "not a JSON object"
    if "cpmf_version" not in data:
        return False, "missing cpmf_version"
    if not isinstance(data.get("memories", []), list):
        return False, "memories must be a list"
    if not isinstance(data.get("people", []), list):
        return False, "people must be a list"
    for m in data.get("memories", []):
        if not isinstance(m, dict) or "content" not in m:
            return False, "each memory needs a content field"
    for p in data.get("people", []):
        if not isinstance(p, dict) or "name" not in p:
            return False, "each person needs a name field"
    return True, None


def context_export(path=None, fmt="text"):
    """
    Builds the pasteable context (either the human-readable template, or
    a spec-conformant CPMF JSON document — see PORTABLE_MEMORY_SPEC.md)
    and writes it to disk ENCRYPTED — the plaintext never touches disk,
    only your terminal (via context_show()) and wherever you choose to
    paste/use it. Includes memories and important people, unlike
    backup-now/-restore, since carrying that content is the entire point
    of this export.
    """
    import base64
    import getpass
    from cryptography.fernet import Fernet

    config = load_config()
    if not config.get("license_key"):
        print("Not activated. Run: curant-cli activate <your-license-key>")
        sys.exit(1)

    passphrase = getpass.getpass("Choose a passphrase to encrypt this context file (input hidden): ")
    if not passphrase:
        print("Passphrase can't be empty.")
        sys.exit(1)
    confirm = getpass.getpass("Confirm passphrase: ")
    if passphrase != confirm:
        print("Passphrases didn't match — nothing was written.")
        sys.exit(1)

    memories = get_memories()
    people = get_important_people()
    if fmt == "json":
        plaintext = json.dumps(build_cpmf_json(config, memories, people), indent=2)
    else:
        plaintext = build_context_template(config, memories, people)

    salt = os.urandom(16)
    print("Deriving encryption key (this takes a couple seconds by design — "
          "it should be similarly slow for anyone trying to guess your passphrase)...")
    derived_key = _derive_backup_key(passphrase, salt)
    ciphertext = Fernet(derived_key).encrypt(plaintext.encode())
    blob = base64.b64encode(salt).decode() + ":" + ciphertext.decode()

    target = os.path.expanduser(path) if path else DEFAULT_CONTEXT_PATH
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "w") as f:
        f.write(blob)
    os.chmod(target, 0o600)

    print(f"Encrypted context written to {target} (format: {fmt})")
    if fmt == "json":
        print("This is a Curant Portable Memory Format (CPMF) v" + CPMF_VERSION + " file — "
              "see PORTABLE_MEMORY_SPEC.md. Any tool that speaks CPMF can use it, not just Curant.")
    print("Nothing in it grants access to anything (no API key, no license key): worst case "
          "if this file leaked, someone reads the same preferences/memories you'd be pasting elsewhere yourself.")
    print("Run `curant-cli context-show` (add --format json if you exported as json) to decrypt "
          "and print it when you want to copy it out.")


def context_show(path=None, fmt="text"):
    """Decrypts the context file and prints it to the terminal — never
    writes the decrypted plaintext back to disk. Copy it from the
    terminal output when you want to paste/use it elsewhere. For JSON,
    also validates the structure (see PORTABLE_MEMORY_SPEC.md) so a
    corrupted file fails clearly rather than confusingly downstream."""
    import base64
    import getpass
    from cryptography.fernet import Fernet, InvalidToken

    source = os.path.expanduser(path) if path else DEFAULT_CONTEXT_PATH
    if not os.path.exists(source):
        print(f"No context file found at {source}. Run `curant-cli context-export` first, "
              "or pass --path if it's somewhere else.")
        sys.exit(1)
    with open(source) as f:
        blob = f.read().strip()

    passphrase = getpass.getpass("Enter your context passphrase: ")
    print("Verifying (this takes a couple seconds by design)...")

    try:
        salt_b64, ciphertext = blob.split(":", 1)
        salt = base64.b64decode(salt_b64)
        derived_key = _derive_backup_key(passphrase, salt)
        plaintext = Fernet(derived_key).decrypt(ciphertext.encode())
    except (InvalidToken, ValueError):
        print("Could not decrypt — wrong passphrase, or the file is corrupted.")
        sys.exit(1)

    if fmt == "json":
        try:
            data = json.loads(plaintext.decode())
        except json.JSONDecodeError:
            print("Decrypted, but this doesn't look like valid JSON — was it exported with --format json?")
            sys.exit(1)
        valid, error = validate_cpmf_json(data)
        if not valid:
            print(f"Decrypted, but this isn't a valid CPMF document: {error}")
            sys.exit(1)
        print()
        print(json.dumps(data, indent=2))
        return

    print()
    print(plaintext.decode())


def context_import(path, apply_persona=False):
    """
    Import a CPMF document into local storage — from a different Curant
    install, a backup, or in principle any tool that produces valid CPMF
    JSON (see PORTABLE_MEMORY_SPEC.md). This is the other half of
    "portable": not just exporting for use elsewhere, but bringing a
    file made anywhere into this install.

    Auto-detects plaintext CPMF JSON vs. an encrypted Curant context file
    (salt:ciphertext) — no separate flag needed for that. Memories and
    people are merged additively (existing exact duplicates skipped,
    nothing is ever deleted by an import). Persona/instructions/
    preferences are left untouched UNLESS --apply-persona is passed —
    silently overwriting how someone's Curant is configured just because
    they imported someone else's memory file would be a bad surprise.
    """
    import base64
    import getpass
    from cryptography.fernet import Fernet, InvalidToken

    source = os.path.expanduser(path)
    if not os.path.exists(source):
        print(f"No file found at {source}.")
        sys.exit(1)
    with open(source) as f:
        raw = f.read().strip()

    data = None
    looked_like_json = False
    try:
        candidate = json.loads(raw)
        if isinstance(candidate, dict):
            looked_like_json = True
            data = candidate
    except json.JSONDecodeError:
        pass

    if not looked_like_json:
        # Only fall through to "maybe it's an encrypted Curant context
        # file" when the content didn't parse as JSON at all. (Valid JSON
        # missing cpmf_version should be rejected as invalid CPMF below,
        # not treated as ciphertext just because JSON syntax happens to
        # contain colons.)
        if ":" not in raw:
            print("This doesn't look like a plaintext CPMF file or an encrypted Curant context file.")
            sys.exit(1)
        passphrase = getpass.getpass("Enter the passphrase for this file: ")
        print("Verifying (this takes a couple seconds by design)...")
        try:
            salt_b64, ciphertext = raw.split(":", 1)
            salt = base64.b64decode(salt_b64)
            derived_key = _derive_backup_key(passphrase, salt)
            plaintext = Fernet(derived_key).decrypt(ciphertext.encode())
        except (InvalidToken, ValueError):
            print("Could not decrypt — wrong passphrase, or the file is corrupted.")
            sys.exit(1)
        try:
            data = json.loads(plaintext.decode())
        except json.JSONDecodeError:
            print("Decrypted, but this isn't valid JSON — was it exported with --format json?")
            sys.exit(1)

    valid, error = validate_cpmf_json(data)
    if not valid:
        print(f"This isn't a valid CPMF document: {error}")
        sys.exit(1)

    init_local_db()
    existing_memories = get_memories()
    added_memories = 0
    for m in data.get("memories", []):
        content = (m.get("content") or "").strip()
        if content and content not in existing_memories:
            save_memory(content)
            added_memories += 1

    existing_people = get_important_people()
    added_people = 0
    for p in data.get("people", []):
        name = (p.get("name") or "").strip()
        if not name:
            continue
        already = any(
            ep["name"] == name and ep.get("relationship") == p.get("relationship", "")
            for ep in existing_people
        )
        if not already:
            with closing(get_local_db()) as conn:
                conn.execute(
                    "INSERT INTO important_people (name, relationship, note) VALUES (?, ?, ?)",
                    (name, p.get("relationship", ""), p.get("note", "")),
                )
                conn.commit()
            added_people += 1

    print(f"Imported {added_memories} new memories and {added_people} new people "
          f"from a CPMF v{data.get('cpmf_version')} file.")

    if apply_persona:
        config = load_config()
        persona_block = data.get("persona", {})
        style = persona_block.get("style_summary", "")
        instructions = persona_block.get("instructions", "")
        combined = instructions
        if style:
            combined = (combined + f"\nAdopt this style: {style}").strip()
        config["instructions"] = combined
        prefs = data.get("preferences", {})
        if "reply_format" in prefs:
            config["reply_format"] = prefs["reply_format"]
        if "proactivity_enabled" in prefs:
            config["proactivity_enabled"] = prefs["proactivity_enabled"]
        save_config(config)
        print("Also applied this file's persona/instructions/preferences.")
    else:
        print("Persona/instructions were NOT changed — pass --apply-persona to also adopt "
              "this file's style and preferences, not just memories/people.")


def mcp_add_cmd(name, command):
    if not command:
        print("Need a command to launch the server, e.g.: curant-cli mcp-add gmail npx -y @some/gmail-mcp-server")
        sys.exit(1)
    add_mcp_server(name, command)
    print(f"Added MCP server '{name}'. Verifying it actually starts and lists tools...")
    server = next(s for s in get_mcp_servers() if s["name"] == name)
    tools = list_tools_from_server(name, server)
    if tools:
        print(f"Connected — {len(tools)} tool(s) available: {', '.join(t['name'] for t in tools)}")
    else:
        print("Added, but couldn't list any tools from it just now — check the command is correct. "
              "It'll be retried automatically on next use.")


def mcp_add_http_cmd(name, url, header_pairs):
    """header_pairs: list of 'Key: Value' strings from the CLI, for
    servers that need their own auth (an API key, a bearer token)."""
    headers = {}
    for pair in header_pairs or []:
        if ":" not in pair:
            print(f"Skipping malformed header '{pair}' — expected 'Key: Value'")
            continue
        key, _, value = pair.partition(":")
        headers[key.strip()] = value.strip()

    add_mcp_http_server(name, url, headers)
    print(f"Added HTTP MCP server '{name}' at {url}. Verifying it actually connects and lists tools...")
    server = next(s for s in get_mcp_servers() if s["name"] == name)
    tools = list_tools_from_server(name, server)
    if tools:
        print(f"Connected — {len(tools)} tool(s) available: {', '.join(t['name'] for t in tools)}")
    else:
        print("Added, but couldn't list any tools from it just now — check the URL/headers are correct. "
              "It'll be retried automatically on next use.")


