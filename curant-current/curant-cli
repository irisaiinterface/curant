DASHBOARD_PORT = 8765  # fixed, localhost-only — never bound to 0.0.0.0


def _dashboard_html(config, memories, people):
    import html as _html
    memory_rows = "".join(
        f'<tr><td>{_html.escape(m)}</td>'
        f'<td><form method="post" action="/memories/delete" style="display:inline">'
        f'<input type="hidden" name="content" value="{_html.escape(m)}">'
        f'<button type="submit">Forget this</button></form></td></tr>'
        for m in memories
    ) or '<tr><td colspan="2"><em>Nothing remembered yet.</em></td></tr>'

    people_rows = "".join(
        f'<tr><td>{_html.escape(p["name"])}</td><td>{_html.escape(p["relationship"])}</td>'
        f'<td>{_html.escape(p["note"])}</td>'
        f'<td><form method="post" action="/people/delete" style="display:inline">'
        f'<input type="hidden" name="name" value="{_html.escape(p["name"])}">'
        f'<input type="hidden" name="relationship" value="{_html.escape(p["relationship"])}">'
        f'<button type="submit">Remove</button></form></td></tr>'
        for p in people
    ) or '<tr><td colspan="4"><em>No one added yet.</em></td></tr>'

    return f"""<!DOCTYPE html>
<html><head><title>Your Curant</title>
<style>
  body {{ font-family: -apple-system, sans-serif; max-width: 720px; margin: 40px auto; padding: 0 20px; }}
  h1 {{ font-size: 1.4rem; }}
  h2 {{ font-size: 1.1rem; margin-top: 32px; }}
  table {{ width: 100%; border-collapse: collapse; margin: 12px 0; }}
  td, th {{ text-align: left; padding: 8px; border-bottom: 1px solid #eee; }}
  button {{ padding: 4px 10px; cursor: pointer; }}
  .muted {{ color: #888; font-size: 0.9rem; }}
</style></head>
<body>
  <h1>Your Curant — {_html.escape(config.get("persona", "curant")).title()}</h1>
  <p class="muted">This page only runs on your own Mac and never leaves it — nothing here touches Curant's server.</p>

  <h2>What Curant remembers about you</h2>
  <table><tr><th>Memory</th><th></th></tr>{memory_rows}</table>

  <h2>People who matter to you</h2>
  <table><tr><th>Name</th><th>Relationship</th><th>Note</th><th></th></tr>{people_rows}</table>

  <h2>Settings</h2>
  <table>
    <tr><td class="muted">Persona</td><td>{_html.escape(config.get("persona", "curant"))}</td></tr>
    <tr><td class="muted">Standing instructions</td><td>{_html.escape(config.get("instructions", "") or "(none set)")}</td></tr>
    <tr><td class="muted">Reply format</td><td>{_html.escape(config.get("reply_format", "text"))}</td></tr>
    <tr><td class="muted">Proactive check-ins</td><td>{"On" if config.get("proactivity_enabled") else "Off"}</td></tr>
  </table>
  <p class="muted">Change settings via curant-cli — this page is for reviewing and managing memory only.</p>
</body></html>"""


def run_local_dashboard():
    """
    A localhost-only web view of what Curant actually knows — memories
    and important people — with the ability to delete individual entries,
    for a customer who isn't comfortable with CLI commands. Deliberately
    NOT part of the server-hosted web dashboard built earlier: memories
    live only in ~/.curant/local.db on this Mac, and the server
    structurally has no access to them (nor should it) — this has to be
    a local interface, not a server one. Bound explicitly to 127.0.0.1,
    never 0.0.0.0, so it's not reachable from anywhere but this machine.
    """
    import http.server
    import urllib.parse
    import webbrowser

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass  # quiet — this is a local convenience tool, not a service worth logging

        def do_GET(self):
            config = load_config()
            memories = get_memories()
            people = get_important_people()
            body = _dashboard_html(config, memories, people).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            length = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(length).decode()
            fields = urllib.parse.parse_qs(raw)

            if self.path == "/memories/delete":
                content = fields.get("content", [""])[0]
                if content:
                    delete_memory_by_content(content)
            elif self.path == "/people/delete":
                name = fields.get("name", [""])[0]
                relationship = fields.get("relationship", [""])[0]
                if name:
                    with closing(get_local_db()) as conn:
                        conn.execute(
                            "DELETE FROM important_people WHERE name = ? AND relationship = ?",
                            (name, relationship),
                        )
                        conn.commit()

            self.send_response(303)
            self.send_header("Location", "/")
            self.end_headers()

    server = http.server.HTTPServer(("127.0.0.1", DASHBOARD_PORT), Handler)
    url = f"http://127.0.0.1:{DASHBOARD_PORT}/"
    print(f"Local dashboard running at {url} (this Mac only — never reachable from the network)")
    print("Press Ctrl+C to stop.")
    try:
        webbrowser.open(url)
    except Exception:
        pass  # fine if there's no browser to open automatically, the URL still works
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


