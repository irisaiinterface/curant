def _parse_hhmm(s):
    """Returns (hour, minute) or None if s isn't a valid HH:MM 24h string."""
    try:
        h, m = s.split(":")
        h, m = int(h), int(m)
        if 0 <= h <= 23 and 0 <= m <= 59:
            return (h, m)
    except Exception:
        pass
    return None


def set_quiet_hours_cmd(start_str, end_str):
    """
    Grace-exclusive. Sets a quiet window (e.g. 21:00 to 07:00, wrapping
    past midnight is fine) during which daily_briefing/weekly_rollup
    skip sending -- these are convenience digests on a fixed schedule,
    not something urgent, so they're the right thing to suppress.

    Deliberately scoped to just those two scheduled digests, NOT to
    screen_message's real-time third-party message notifications --
    suppressing those would mean either dropping a notice permanently
    (no queue/replay mechanism exists to hold it for later) or building
    that mechanism, which this doesn't attempt. VIP escalation
    (mark-vip) is unaffected by quiet hours either way -- a VIP's text
    still notifies you in real time regardless of this setting, which is
    the actual "VIP override" behavior here: not that quiet hours
    normally block VIPs and get overridden, but that quiet hours were
    never wired into that path to begin with.

    Same "bypassable by editing config.json directly" caveat as the
    local generation spend cap elsewhere in this file -- a real,
    accepted limitation of local-only enforcement, not an oversight.
    """
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("Quiet hours are a Grace-exclusive feature.")
        sys.exit(1)
    if start_str is None and end_str is None:
        start = config.get("quiet_hours_start")
        end = config.get("quiet_hours_end")
        if start and end:
            print(f"Quiet hours: {start}-{end}.")
        else:
            print("No quiet hours set.")
        return
    if start_str == "off":
        config.pop("quiet_hours_start", None)
        config.pop("quiet_hours_end", None)
        save_config(config)
        print("Quiet hours turned off.")
        return
    start = _parse_hhmm(start_str)
    end = _parse_hhmm(end_str) if end_str else None
    if not start or not end:
        print("Usage: curant-cli set-quiet-hours <HH:MM> <HH:MM>  (24-hour, e.g. 21:00 07:00), or 'off'")
        sys.exit(1)
    config["quiet_hours_start"] = start_str
    config["quiet_hours_end"] = end_str
    save_config(config)
    print(f"Quiet hours set: {start_str}-{end_str}. Daily briefing and weekly rollup will skip "
          f"sending during this window.")


def set_travel_mode_cmd(tz_str):
    """
    Grace-exclusive. When set, quiet-hours comparisons use this IANA
    timezone (e.g. 'Asia/Tokyo') instead of the Mac's own system
    timezone -- launchd itself still fires the scheduled jobs at the
    Mac's local clock time (there's no practical way to change that
    without changing the whole Mac's system timezone), but the actual
    quiet-hours SUPPRESSION check this file does in Python can compare
    against wherever the customer says they currently are.
    """
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("Travel mode is a Grace-exclusive feature.")
        sys.exit(1)
    if tz_str is None:
        current = config.get("travel_timezone")
        default_note = "not set (using this Mac's local timezone)"
        print(f"Travel timezone: {current or default_note}.")
        return
    if tz_str.lower() == "off":
        config.pop("travel_timezone", None)
        save_config(config)
        print("Travel mode turned off -- back to this Mac's local timezone.")
        return
    try:
        from zoneinfo import ZoneInfo
        ZoneInfo(tz_str)  # raises if invalid
    except Exception:
        print(f"'{tz_str}' isn't a recognized IANA timezone (e.g. 'Asia/Tokyo', 'Europe/London').")
        sys.exit(1)
    config["travel_timezone"] = tz_str
    save_config(config)
    print(f"Travel timezone set to {tz_str}. Quiet hours now compare against this timezone.")


def _is_quiet_hours_now(config):
    """True if right now falls inside the customer's configured quiet
    window (see set_quiet_hours_cmd), using travel_timezone if set
    (see set_travel_mode_cmd), else this Mac's local system time.
    False (never quiet) if no quiet hours are configured at all."""
    start_str = config.get("quiet_hours_start")
    end_str = config.get("quiet_hours_end")
    start = _parse_hhmm(start_str) if start_str else None
    end = _parse_hhmm(end_str) if end_str else None
    if not start or not end:
        return False

    now = datetime.now()  # module-level `datetime` here is the datetime CLASS
                            # (see `from datetime import datetime, timedelta` at
                            # the top of this file), not the module -- matches
                            # every other use of it in this file.
    tz_name = config.get("travel_timezone")
    if tz_name:
        try:
            from zoneinfo import ZoneInfo
            now = datetime.now(ZoneInfo(tz_name))
        except Exception:
            pass  # fall back to local time if the stored tz somehow became invalid

    now_minutes = now.hour * 60 + now.minute
    start_minutes = start[0] * 60 + start[1]
    end_minutes = end[0] * 60 + end[1]
    if start_minutes <= end_minutes:
        return start_minutes <= now_minutes < end_minutes
    # wraps past midnight, e.g. 21:00-07:00
    return now_minutes >= start_minutes or now_minutes < end_minutes


