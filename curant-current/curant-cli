# --- Device identity (for the 1:1 license<->device binding enforced server-side) ---

def get_device_id():
    """
    The Mac's actual hardware MAC address, read LIVE each time rather than
    a software-generated UUID cached in a copyable config file. This
    closes a gap the earlier UUID-based approach had: copying
    ~/.curant/config.json to a different machine used to carry the
    "device identity" along with it, since the identifier was just a
    value sitting in that file. A hardware MAC can't be carried over by
    copying a config file — it's derived from the machine actually
    running this code, every time.

    Tries `ifconfig en0` first — en0 is the built-in Wi-Fi interface on
    almost all Macs and is the most stable hardware identifier available
    without deeper system permissions (no need for admin/root, unlike
    reading the full hardware serial via `ioreg`). Falls back to Python's
    `uuid.getnode()` (also MAC-based, cross-platform) if `ifconfig`/`en0`
    isn't available — e.g. this dev/test environment isn't macOS.

    HONEST LIMITATION: a MAC address can be manually changed on macOS
    (`sudo ifconfig en0 ether ...`), so this is not literally unspoofable.
    It is meaningfully harder to casually bypass than the old approach
    (which only required copying one file, no special commands or
    privileges), but it is not a hardware root-of-trust guarantee.
    """
    try:
        result = subprocess.run(["ifconfig", "en0"], capture_output=True, text=True, timeout=5)
        for line in result.stdout.splitlines():
            line = line.strip()
            if line.startswith("ether "):
                return line.split()[1]
    except (FileNotFoundError, subprocess.SubprocessError):
        pass

    # Fallback for non-macOS dev/test environments, or if en0 doesn't exist
    # (e.g. Ethernet-only Macs, or a future macOS renaming the interface).
    import uuid as _uuid
    return format(_uuid.getnode(), "012x")


def load_config():
    if not os.path.exists(CONFIG_PATH):
        return {}
    with open(CONFIG_PATH, "r") as f:
        return json.load(f)


def save_config(config):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(config, f, indent=2)
    os.chmod(CONFIG_PATH, 0o600)  # only this user can read it — this file holds the API key


# --- Local database (memories, important people, recent message history) ---
# Single customer per Mac, so no license_key column needed — this db only
# ever holds one person's data, on their own machine.

def get_local_db():
    conn = sqlite3.connect(LOCAL_DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_local_db():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with closing(get_local_db()) as conn:
        conn.executescript("""
        CREATE TABLE IF NOT EXISTS important_people (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            relationship TEXT,
            note TEXT
        );

        CREATE TABLE IF NOT EXISTS memories (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            content TEXT,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        );

        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            role TEXT,
            content TEXT,
            provider TEXT,
            urgency TEXT,       -- 'urgent' | 'normal', heuristic-based, user messages only
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        );

        CREATE TABLE IF NOT EXISTS routing_rules (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            category TEXT,
            provider TEXT,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        );

        CREATE TABLE IF NOT EXISTS mcp_servers (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE,
            transport TEXT DEFAULT 'stdio',  -- 'stdio' | 'http' — some real services (Ideogram,
                                               -- for instance) offer a hosted MCP endpoint over a
                                               -- URL instead of a local launch command
            command TEXT,     -- JSON array, e.g. ["npx", "-y", "@some/mcp-server"] — stdio only
            url TEXT,         -- e.g. "https://mcp.example.com/mcp" — http only
            headers TEXT,     -- JSON object of extra headers (e.g. an API key) — http only
            enabled INTEGER DEFAULT 1,
            tools_cache TEXT,       -- JSON list of this server's tools, refreshed periodically
            tools_cached_at TEXT,   -- when tools_cache was last refreshed
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        );

        -- OAuth tokens for MCP servers that need a real interactive login
        -- (as opposed to a static header/API key, which lives on
        -- mcp_servers.headers instead). One row per server. Access and
        -- refresh tokens are stored here so a server's OAuthClientProvider
        -- can pick up where it left off without re-running the browser
        -- flow every single time — the SDK's TokenStorage interface calls
        -- get_tokens()/set_tokens() as needed, including silently
        -- refreshing an expired access token via the refresh token.
        CREATE TABLE IF NOT EXISTS mcp_oauth_tokens (
            server_name    TEXT PRIMARY KEY,
            client_info    TEXT,   -- JSON: client_id/client_secret from dynamic registration
            tokens         TEXT,   -- JSON: access_token/refresh_token/expires_at/etc.
            updated_at     TEXT DEFAULT CURRENT_TIMESTAMP
        );

        -- Slow tool calls (currently: Veo video generation, which can
        -- take several minutes) run here instead of blocking relay()
        -- itself. A detached subprocess does the actual work; the
        -- watcher's existing message-polling loop checks for completed
        -- jobs each cycle and delivers them as a follow-up message —
        -- no separate scheduled job needed, no duplicated
        -- AppleScript-sending logic living in curant-cli.
        CREATE TABLE IF NOT EXISTS background_jobs (
            id             INTEGER PRIMARY KEY AUTOINCREMENT,
            tool_name      TEXT,
            arguments      TEXT,    -- JSON
            apple_id       TEXT,    -- who to deliver the result to
            status         TEXT DEFAULT 'pending',  -- 'pending' | 'running' | 'done' | 'failed'
            result_path    TEXT,    -- file-shaped result (Veo)
            result_text    TEXT,    -- text-shaped result (browser automation)
            error          TEXT,
            delivered      INTEGER DEFAULT 0,
            created_at     TEXT DEFAULT CURRENT_TIMESTAMP,
            completed_at   TEXT
        );

        -- Aaron's grading calibration — deliberately scoped PER ASSIGNMENT
        -- (a persuasive-essay rubric doesn't transfer to a lab report),
        -- not one global "how this teacher grades" blob that would get
        -- muddier the more different assignment types get thrown into it.
        CREATE TABLE IF NOT EXISTS grading_assignments (
            id                INTEGER PRIMARY KEY AUTOINCREMENT,
            assignment_name   TEXT UNIQUE,
            assignment_prompt TEXT,
            rubric_text       TEXT,
            created_at        TEXT DEFAULT CURRENT_TIMESTAMP,
            updated_at        TEXT DEFAULT CURRENT_TIMESTAMP
        );

        -- The calibration examples themselves — a teacher's actual past
        -- submissions with the grade/feedback they actually gave. The
        -- setup flow explicitly asks for a spread (strong/average/weak),
        -- not just however many happen to get uploaded.
        CREATE TABLE IF NOT EXISTS grading_examples (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            assignment_id   INTEGER,
            submission_text TEXT,
            grade_given     TEXT,
            feedback_given  TEXT,
            created_at      TEXT DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (assignment_id) REFERENCES grading_assignments(id)
        );

        -- When a teacher corrects a suggested grade, that's real signal
        -- worth remembering for next time — this is what makes
        -- "adapt really well" actually mean something over time rather
        -- than being static after the first setup.
        CREATE TABLE IF NOT EXISTS grading_corrections (
            id                INTEGER PRIMARY KEY AUTOINCREMENT,
            assignment_id     INTEGER,
            submission_text   TEXT,
            suggested_grade   TEXT,
            corrected_grade   TEXT,
            corrected_feedback TEXT,
            created_at        TEXT DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (assignment_id) REFERENCES grading_assignments(id)
        );

        CREATE TABLE IF NOT EXISTS feature_requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            request_text TEXT,
            status TEXT DEFAULT 'logged',  -- 'logged' | 'reviewed' | 'built' | 'declined'
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        );

        CREATE TABLE IF NOT EXISTS generation_costs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            service TEXT,           -- 'flux' | 'ideogram' | 'elevenlabs' | 'veo' | 'descript'
            estimated_cost_usd REAL,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        );
        """)
        conn.commit()
    # Lightweight migration: installs that created messages/local.db before
    # the `provider` column existed won't have it — CREATE TABLE IF NOT
    # EXISTS above won't add a column to an already-existing table.
    with closing(get_local_db()) as conn:
        existing_cols = {row["name"] for row in conn.execute("PRAGMA table_info(messages)")}
        if "provider" not in existing_cols:
            conn.execute("ALTER TABLE messages ADD COLUMN provider TEXT")
            conn.commit()
        if "urgency" not in existing_cols:
            conn.execute("ALTER TABLE messages ADD COLUMN urgency TEXT")
            conn.commit()
        mcp_cols = {row["name"] for row in conn.execute("PRAGMA table_info(mcp_servers)")}
        if "tools_cache" not in mcp_cols:
            conn.execute("ALTER TABLE mcp_servers ADD COLUMN tools_cache TEXT")
            conn.execute("ALTER TABLE mcp_servers ADD COLUMN tools_cached_at TEXT")
            conn.commit()
        if "transport" not in mcp_cols:
            conn.execute("ALTER TABLE mcp_servers ADD COLUMN transport TEXT DEFAULT 'stdio'")
            conn.execute("ALTER TABLE mcp_servers ADD COLUMN url TEXT")
            conn.execute("ALTER TABLE mcp_servers ADD COLUMN headers TEXT")
            conn.commit()
        if "auth_mode" not in mcp_cols:
            conn.execute("ALTER TABLE mcp_servers ADD COLUMN auth_mode TEXT DEFAULT 'none'")
            conn.commit()
    os.chmod(LOCAL_DB_PATH, 0o600)  # this db holds memories/history — owner-only


