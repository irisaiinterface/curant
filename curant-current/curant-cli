CAPABILITY_GAP_COOLDOWN_MINUTES = 15
# Real bug this guards against (seen live 2026-08-13): given an
# unresolved capability gap sitting recently in conversation history,
# the model sometimes treats a vague/short follow-up ("Hi", "Hello?",
# "Hi?" -- not a new request at all) as a cue to proactively re-surface
# and re-log the SAME gap, calling log_capability_gap again each time.
# That re-texts the owner and re-recites the "call ___ for a quote"
# notice to the customer on every single greeting, which reads as
# broken/spammy. This is a genuine model-behavior issue, not just a
# wording one, so it's guarded here in code rather than relying only on
# a system-prompt instruction (see build_system_prompt's
# log_capability_gap guidance) to never re-trigger it. A near-duplicate
# description logged within this many minutes is treated as "already
# flagged" rather than logged and texted out again -- see
# _is_similar_capability_gap() and its use in log_capability_gap().


def _is_similar_capability_gap(a, b, threshold=0.3):
    """Cheap word-overlap similarity (Jaccard over lowercased alnum
    tokens) -- deliberately not exact-string matching, since the model
    phrases a re-surfaced gap slightly differently each time (e.g.
    "Direct email access / reading CAP Gmail inbox" vs. "Directly
    reading or connecting to Civil Air Patrol (CAP) Gmail email inbox"
    -- both hit live, clearly the same underlying gap, zero characters
    in common as exact strings). Not meant to be a precise NLP
    similarity measure, just good enough to catch "basically the same
    thing worded differently" without an extra LLM call."""
    tokens_a = set(re.findall(r"[a-z0-9]+", (a or "").lower()))
    tokens_b = set(re.findall(r"[a-z0-9]+", (b or "").lower()))
    if not tokens_a or not tokens_b:
        return False
    overlap = len(tokens_a & tokens_b) / len(tokens_a | tokens_b)
    return overlap >= threshold


def _recently_logged_similar_gap(description):
    """Returns the most recent feature_requests row if it's both within
    CAPABILITY_GAP_COOLDOWN_MINUTES and similar enough to `description`
    to be the same underlying gap re-surfacing -- else None. Two
    DIFFERENT genuine gaps arriving close together (e.g. customer asks
    about two unrelated unsupported things back to back) are NOT
    suppressed, only re-surfacing of the same one."""
    rows = get_feature_requests_local()
    if not rows:
        return None
    most_recent = rows[0]
    try:
        logged_at = datetime.strptime(most_recent["created_at"], "%Y-%m-%d %H:%M:%S")
    except (ValueError, TypeError):
        return None
    if datetime.utcnow() - logged_at > timedelta(minutes=CAPABILITY_GAP_COOLDOWN_MINUTES):
        return None
    if not _is_similar_capability_gap(description, most_recent["request_text"]):
        return None
    return most_recent


