DEFAULT_PROVIDER = "anthropic"

# Gemini speaks the OpenAI wire format via this compatibility endpoint, so it
# reuses the OpenAI SDK — same approach as Cloud's _openai_compatible_client().
GEMINI_OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"


def get_provider(config):
    provider = config.get("provider", DEFAULT_PROVIDER)
    if provider not in PROVIDER_MODELS:
        return DEFAULT_PROVIDER
    return provider


def get_api_key(config, provider=None):
    """
    Looks up the API key for a given provider (default: whichever
    provider is currently configured). Falls back to the legacy
    `anthropic_api_key` field for anthropic specifically, so installs
    from before multi-provider support still work without needing to
    re-enter a key.
    """
    provider = provider or get_provider(config)
    api_keys = config.get("api_keys", {})
    key = api_keys.get(provider)
    if key:
        return key
    if provider == "anthropic":
        legacy = config.get("anthropic_api_key")  # legacy field, pre-multi-provider
        if legacy:
            return legacy
    if DEV_UNLICENSED:
        # Local-dev convenience: read the key straight from the environment so
        # you don't have to run set-api-key first.
        for env_name in {"anthropic": ["ANTHROPIC_API_KEY"],
                         "openai": ["OPENAI_API_KEY"],
                         "gemini": ["GEMINI_API_KEY", "GOOGLE_API_KEY"]}.get(provider, []):
            if os.environ.get(env_name):
                return os.environ[env_name]
    return None


def get_eligible_providers(config):
    """All providers that actually have a usable API key right now — the
    set routing can choose between. A provider the customer hasn't set a
    key for is never eligible, no matter how well-suited it might be for
    a given task."""
    return [p for p in PROVIDER_MODELS if get_api_key(config, p)]


def _call_anthropic(api_key, system_prompt, messages, max_tokens, model):
    import anthropic
    client = anthropic.Anthropic(api_key=api_key)
    response = client.messages.create(
        model=model, max_tokens=max_tokens, system=system_prompt, messages=messages,
    )
    return response.content[0].text


def _call_openai(api_key, system_prompt, messages, max_tokens, model):
    from openai import OpenAI
    client = OpenAI(api_key=api_key)
    # OpenAI's chat.completions API takes the system prompt as a regular
    # message with role "system", prepended to the conversation, rather
    # than Anthropic's separate `system` parameter — this is the one spot
    # where the two APIs' shapes genuinely differ and need translating.
    openai_messages = [{"role": "system", "content": system_prompt}] + messages
    response = client.chat.completions.create(
        model=model, max_tokens=max_tokens, messages=openai_messages,
    )
    return response.choices[0].message.content


def _call_gemini(api_key, system_prompt, messages, max_tokens, model):
    """Same wire format as OpenAI — only base_url differs."""
    from openai import OpenAI
    client = OpenAI(api_key=api_key, base_url=GEMINI_OPENAI_BASE_URL)
    gemini_messages = [{"role": "system", "content": system_prompt}] + messages
    response = client.chat.completions.create(
        model=model, max_tokens=max_tokens, messages=gemini_messages,
    )
    return response.choices[0].message.content


# --- MCP client (real Model Context Protocol client, not a simulation) ---
# This is how "customer wants X and Curant doesn't support it" gets
# answered without custom engineering per request: if an MCP server
# exists for X (a huge and growing ecosystem — Gmail, Notion, Slack,
# task managers, etc.), connecting to it is configuration, not
# development. Uses the official `mcp` Python SDK, lazy-imported like
# anthropic/openai so it's only required if MCP servers are actually
# configured.
#
# The SDK's client is async; everything here wraps it in asyncio.run()
# since the rest of curant-cli is synchronous by design (one message in,
# one reply out, process exits).

MCP_CALL_TIMEOUT_SECONDS = 20


async def _mcp_list_tools_stdio_async(command):
    from mcp import ClientSession, StdioServerParameters
    from mcp.client.stdio import stdio_client
    params = StdioServerParameters(command=command[0], args=command[1:])
    async with stdio_client(params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            result = await session.list_tools()
            return [
                # The official mcp SDK's Tool model has used both inputSchema (older,
                # camelCase, matching the MCP wire protocol's JSON field name directly)
                # and input_schema (newer, snake_case, matching Python convention) across
                # different released versions -- found the hard way when a real customer's
                # Mac had mcp>=2 installed and every .inputSchema access here raised
                # AttributeError. Try both rather than pin to one, so this keeps working
                # across whichever mcp version happens to be installed locally.
                {"name": t.name, "description": t.description or "", "input_schema": getattr(t, "input_schema", None) or getattr(t, "inputSchema", None) or {}}
                for t in result.tools
            ]


async def _mcp_call_tool_stdio_async(command, tool_name, arguments):
    from mcp import ClientSession, StdioServerParameters
    from mcp.client.stdio import stdio_client
    params = StdioServerParameters(command=command[0], args=command[1:])
    async with stdio_client(params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            result = await session.call_tool(tool_name, arguments)
            texts = [c.text for c in result.content if hasattr(c, "text") and c.text]
            return "\n".join(texts) if texts else "(tool returned no text output)"


async def _mcp_list_tools_http_async(url, headers, auth=None):
    from mcp import ClientSession
    from mcp.client.streamable_http import streamable_http_client
    # mcp>=2.0 dropped streamable_http_client's headers=/auth= kwargs in
    # favor of an injected httpx2.AsyncClient — headers/auth (including
    # our OAuthClientProvider, which is an httpx2.Auth) now configure
    # that client directly instead. See CHANGELOG note in
    # MODEL_VERSION_POLICY.md-adjacent commit for why this changed.
    import httpx2
    http_client = httpx2.AsyncClient(headers=headers or None, auth=auth)
    async with streamable_http_client(url, http_client=http_client) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            result = await session.list_tools()
            return [
                # The official mcp SDK's Tool model has used both inputSchema (older,
                # camelCase, matching the MCP wire protocol's JSON field name directly)
                # and input_schema (newer, snake_case, matching Python convention) across
                # different released versions -- found the hard way when a real customer's
                # Mac had mcp>=2 installed and every .inputSchema access here raised
                # AttributeError. Try both rather than pin to one, so this keeps working
                # across whichever mcp version happens to be installed locally.
                {"name": t.name, "description": t.description or "", "input_schema": getattr(t, "input_schema", None) or getattr(t, "inputSchema", None) or {}}
                for t in result.tools
            ]


