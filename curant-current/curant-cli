def get_monthly_estimated_spend():
    """Spend from generation_costs within the current calendar month only —
    the cap resets monthly rather than being a lifetime ceiling, since a
    lifetime cap would eventually block a long-time customer from ever
    generating anything again regardless of how reasonably they're using it."""
    with closing(get_local_db()) as conn:
        row = conn.execute(
            "SELECT SUM(estimated_cost_usd) as total FROM generation_costs "
            "WHERE created_at >= date('now', 'start of month')"
        ).fetchone()
        return row["total"] or 0.0


def get_monthly_spend_cap(config):
    """None means uncapped — an explicit customer choice (set-spend-cap
    with no amount, or a negative/zero value), not the default state."""
    if "monthly_spend_cap_usd" not in config:
        return DEFAULT_MONTHLY_SPEND_CAP_USD
    return config["monthly_spend_cap_usd"]  # may be None (uncapped)


def check_spend_cap(config, service, cost_override=None):
    """
    Returns (ok: bool, message: str | None). Checked BEFORE a paid
    generation call fires, not after — the whole point of a cap is
    preventing the spend, not just recording it afterward. Compares
    current month-to-date spend PLUS this generation's estimated cost
    against the cap, so the generation that would cross the line is the
    one that gets blocked, not the one after it.

    cost_override: see log_generation_cost's docstring — used for
    ElevenLabs, where the real cost depends on how much text is being
    narrated, not a flat per-call estimate.
    """
    cap = get_monthly_spend_cap(config)
    if cap is None:
        return True, None
    current = get_monthly_estimated_spend()
    this_cost = cost_override if cost_override is not None else ESTIMATED_COST_USD.get(service, 0.0)
    projected = current + this_cost
    if projected > cap:
        return False, (
            f"This would put this month's generation spend at an estimated ${projected:.2f}, "
            f"over the ${cap:.2f} included this month. Nothing was generated. For more "
            f"generations this month, get in touch: {GENERATION_TOPUP_CONTACT}. (You can also "
            f"lower this cap yourself anytime with `curant-cli set-spend-cap <amount>` if you'd "
            f"rather spend less than the included ${cap:.2f}.)"
        )
    return True, None


def format_remaining_generation_balance(config):
    """
    One-line "here's what you have left" string, shared by the explicit
    get_spending_summary tool AND appended automatically after every
    successful paid generation (image/voice/video) — the automatic
    version is what the owner asked for directly: telling the customer
    where they stand after every generation, not only when they think to
    ask. Returns None when uncapped (nothing meaningful to report).
    """
    cap = get_monthly_spend_cap(config)
    if cap is None:
        return None
    monthly_spend = get_monthly_estimated_spend()
    remaining = max(cap - monthly_spend, 0)
    return f"${remaining:.2f} of your ${cap:.2f} included generation budget left this month."

