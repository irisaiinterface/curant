def log_generation_cost(service, cost_override=None):
    """
    cost_override lets a caller pass an actually-computed cost instead of
    the flat per-service estimate — used for ElevenLabs specifically,
    since voice generation is billed per-character, not per-call, and a
    flat estimate badly misrepresents a long narration vs. a short one.
    Everything else (FLUX, Ideogram, Veo) is genuinely a flat per-call
    rate, so the flat ESTIMATED_COST_USD value is accurate for those
    without an override.
    """
    cost = cost_override if cost_override is not None else ESTIMATED_COST_USD.get(service, 0.0)
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO generation_costs (service, estimated_cost_usd) VALUES (?, ?)",
            (service, cost),
        )
        conn.commit()


def get_generation_cost_summary():
