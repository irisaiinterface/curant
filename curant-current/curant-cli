def mcp_connect_cmd(service_name):
    """
    One-command connect for a known, pre-verified service — `curant-cli
    mcp-connect linear` instead of needing to already know
    https://mcp.linear.app/mcp. Falls back to a clear, honest message for
    anything not in the registry rather than guessing at a URL.
    """
    service = KNOWN_MCP_SERVICES.get(service_name.lower())
    if not service:
        known = ", ".join(sorted(KNOWN_MCP_SERVICES.keys()))
        print(f"'{service_name}' isn't in the pre-verified registry yet (known: {known}). "
              f"If it has its own MCP server, connect it manually with mcp-add-oauth or "
              f"mcp-add-http once you have its real URL from the vendor's own docs.")
        return

    trust_label = "OFFICIAL, vendor-hosted" if service["official"] else "UNOFFICIAL, community-built"
    print(f"{service_name} — {trust_label}")
    print(service["description"])
    print()

    if service.get("requires_local_setup"):
        # stdio-transport, unofficial entries (Canvas, Schoology) can't be
        # one-click connected — they need local installation with the
        # customer's OWN credentials, which Curant deliberately never
        # touches or stores itself (the server reads them from its own
        # .env file, per its own setup docs). This just points the
        # customer at the real next step rather than pretending a
        # one-command flow exists for something that structurally can't
        # have one.
        install_hint = " ".join(service["install_command"]) if service.get("install_command") else "(see the project's own README)"
        print(f"This one needs local setup first — Curant never sees or stores your credentials for it:")
        print(f"  1. Install: {install_hint}")
        if service.get("binary_hint"):
            print(f"  2. Find the installed binary: {service['binary_hint']}")
        print(f"  3. Follow the project's own README to add your credentials to ITS config "
              f"(not Curant's) — a personal API token for Canvas, or whatever Schoology's "
              f"specific server variant requires")
        print(f"  4. Then: curant-cli mcp-add {service_name.lower()} /path/to/the/binary")
        return

    if service.get("transport") == "stdio" and service.get("command"):
        # Registry entries that ARE one-command connectable but use a local
        # stdio process rather than a hosted URL (testrail, outlook, teams) —
        # distinct from canvas/schoology above, which need real manual setup
        # first. This branch was previously missing entirely: mcp-connect on
        # any of these three crashed on service["url"], which doesn't exist
        # for stdio entries. mcp_add_cmd already does exactly what's needed
        # (spawn the known command, verify it lists tools).
        if "TESTRAIL_INSTANCE_URL" not in os.environ and service_name.lower() == "testrail":
            print("Note: this server needs TESTRAIL_INSTANCE_URL, TESTRAIL_USERNAME, and "
                  "TESTRAIL_API_KEY set in your shell environment before it will actually work — "
                  "set those first if you haven't. Curant never stores them itself.")
        if service_name.lower() in ("outlook", "teams"):
            print("First run will prompt an interactive device-code sign-in against Microsoft "
                  "in this terminal — follow the printed URL/code once.")
        mcp_add_cmd(service_name.lower(), service["command"])
        return

    mcp_add_oauth_cmd(service_name.lower(), service["url"], transport=service.get("transport", "http"))


def mcp_add_oauth_cmd(name, url, transport="http"):
    """
    Real interactive OAuth flow for an MCP server that needs an actual
    login — not just a static API key (that's mcp-add-http --header).
    Runs a temporary localhost callback server, opens the authorization
    URL in the default browser, waits for the redirect with the
    authorization code, and lets OAuthClientProvider complete the
    exchange and persist tokens via CurantTokenStorage. Uses the real
    SDK's automatic dynamic client registration — no client_id/secret
    needs to be obtained manually first. transport='sse' for the few
    real services still on the older SSE transport (Square, confirmed)
    rather than the modern Streamable HTTP default.
    """
    import asyncio
    import http.server
    import threading
    import webbrowser
    import urllib.parse

    result_holder = {"code": None, "state": None, "error": None}
    server_ready = threading.Event()

    class CallbackHandler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            pass

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            params = urllib.parse.parse_qs(parsed.query)
            result_holder["code"] = params.get("code", [None])[0]
            result_holder["state"] = params.get("state", [None])[0]
            result_holder["error"] = params.get("error", [None])[0]
            body = b"<h1>You can close this tab.</h1>" if result_holder["code"] else b"<h1>Something went wrong.</h1>"
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(body)

    httpd = http.server.HTTPServer(("127.0.0.1", OAUTH_CALLBACK_PORT), CallbackHandler)

    def run_server():
        server_ready.set()
        httpd.handle_request()  # serves exactly one request — the callback — then stops

    thread = threading.Thread(target=run_server, daemon=True)
    thread.start()
    server_ready.wait(timeout=5)

    async def redirect_handler(auth_url):
        print(f"Opening your browser to log in: {auth_url}")
        print("If it doesn't open automatically, visit that URL yourself.")
        try:
            webbrowser.open(auth_url)
        except Exception:
            pass

    async def callback_handler():
        thread.join(timeout=300)  # up to 5 minutes to complete the login in the browser
        if result_holder["error"]:
            raise RuntimeError(f"Authorization failed: {result_holder['error']}")
        if not result_holder["code"]:
            raise RuntimeError("Timed out waiting for the browser login to complete.")
        # mcp>=2.0 expects an AuthorizationCodeResult object here, not a
        # plain (code, state) tuple — found live testing GitHub's OAuth
        # flow ("AttributeError: 'tuple' object has no attribute 'state'").
        from mcp.shared.auth import AuthorizationCodeResult
        return AuthorizationCodeResult(code=result_holder["code"], state=result_holder["state"])

    def _patch_form_encoded_token_responses():
        """
        Some real OAuth servers — GitHub's classic /login/oauth/access_token
        confirmed live, testing this exact flow — reply to a token request
        with RFC 6749's original application/x-www-form-urlencoded body
        (`access_token=...&token_type=bearer`) rather than JSON, unless the
        request explicitly sends `Accept: application/json` (which GitHub's
        docs mention but which mcp's OAuthClientProvider never sets — its
        token requests are built as raw httpx2.Request objects, bypassing
        the client's default headers entirely, so configuring an
        Accept header on our httpx2.AsyncClient doesn't reach the wire
        either; confirmed by inspecting a request built that way).
        mcp's handle_token_response_scopes only ever tries JSON and raises
        OAuthTokenError otherwise (surfaced here as GitHub's raw response
        body failing pydantic's model_validate_json).

        Rather than depend on a header trick that doesn't actually work,
        this wraps the parser to fall back to parsing
        application/x-www-form-urlencoded when JSON parsing fails — handles
        GitHub (and any other server with the same legacy default) without
        touching the installed mcp package on disk. Patches the name as
        bound inside oauth2.py's own namespace (`from ...utils import
        handle_token_response_scopes`), since patching mcp.client.auth.utils
        alone wouldn't affect that already-imported reference.
        """
        from mcp.client.auth import oauth2 as _oauth2_mod
        from mcp.client.auth.utils import OAuthTokenError
        from mcp.shared.auth import OAuthToken
        from urllib.parse import parse_qsl

        _original = _oauth2_mod.handle_token_response_scopes

        async def _patched(response):
            try:
                return await _original(response)
            except OAuthTokenError:
                content = await response.aread()
                try:
                    text = content.decode() if isinstance(content, (bytes, bytearray)) else content
                    fields = dict(parse_qsl(text))
                    if "error" in fields:
                        raise OAuthTokenError(f"Token endpoint returned an error: {fields}")
                    if "access_token" not in fields:
                        raise OAuthTokenError(f"Neither valid JSON nor a recognizable "
                                               f"form-encoded token response: {content[:200]!r}")
                    return OAuthToken(
                        access_token=fields["access_token"],
                        token_type=fields.get("token_type", "bearer"),
                        scope=fields.get("scope"),
                        refresh_token=fields.get("refresh_token"),
                        expires_in=int(fields["expires_in"]) if fields.get("expires_in") else None,
                    )
                except OAuthTokenError:
                    raise
                except Exception as e:
                    raise OAuthTokenError(f"Neither valid JSON nor form-encoded token response: {e}")

        _oauth2_mod.handle_token_response_scopes = _patched

    async def run_flow():
        from mcp import ClientSession
        from mcp.client.auth import OAuthClientProvider
        from mcp.shared.auth import OAuthClientMetadata

        _patch_form_encoded_token_responses()

        auth = OAuthClientProvider(
            server_url=url,
            client_metadata=OAuthClientMetadata(
                redirect_uris=[f"http://127.0.0.1:{OAUTH_CALLBACK_PORT}/callback"],
                client_name="Curant",
                grant_types=["authorization_code", "refresh_token"],
                response_types=["code"],
            ),
            storage=CurantTokenStorage(name),
            redirect_handler=redirect_handler,
            callback_handler=callback_handler,
        )
        if transport == "sse":
            from mcp.client.sse import sse_client
            async with sse_client(url, auth=auth) as (read, write):
                async with ClientSession(read, write) as session:
                    await session.initialize()
                    result = await session.list_tools()
                    return [t.name for t in result.tools]
        else:
            from mcp.client.streamable_http import streamable_http_client
            import httpx2
            http_client = httpx2.AsyncClient(auth=auth)
            async with streamable_http_client(url, http_client=http_client) as (read, write):
                async with ClientSession(read, write) as session:
                    await session.initialize()
                    result = await session.list_tools()
                    return [t.name for t in result.tools]

    # Some servers (GitHub's official remote MCP, confirmed as of this
    # writing) don't support RFC 7591 dynamic client registration at
    # all — registration just 404s. This is a known, widely-reported
    # limitation of the ecosystem, not something curant-cli's flow can
    # work around automatically: those servers need a real,
    # pre-registered OAuth App Client ID (GitHub's official IDE
    # integrations ship with one baked in; third-party tools don't get
    # one for free). If the customer has set one up themselves
    # (github.com/settings/developers -> New OAuth App, callback URL
    # http://127.0.0.1:{OAUTH_CALLBACK_PORT}/callback), seed it here so
    # OAuthClientProvider finds existing client_info and skips
    # registration entirely rather than attempting (and failing) DCR.
    pre_client_id = os.environ.get("CURANT_OAUTH_CLIENT_ID")
    pre_client_secret = os.environ.get("CURANT_OAUTH_CLIENT_SECRET")
    if pre_client_id:
        from mcp.shared.auth import OAuthClientInformationFull

        async def _seed_client_info():
            info = OAuthClientInformationFull(
                client_id=pre_client_id,
                client_secret=pre_client_secret,
                redirect_uris=[f"http://127.0.0.1:{OAUTH_CALLBACK_PORT}/callback"],
                # Left unset (None), mcp's OAuthClientProvider silently sends NO
                # client_secret at all in the token exchange — the comment in its
                # own source says "For 'none' (or absent), don't add any
                # client_secret" — which is exactly what produced GitHub's
                # "incorrect_client_credentials" here, nothing to do with a
                # copy-paste error. client_secret_post is what GitHub's classic
                # OAuth token endpoint documents (client_id/client_secret both in
                # the POST body); client_secret_basic (HTTP Basic auth header)
                # would likely also work but isn't what GitHub's own docs show.
                token_endpoint_auth_method="client_secret_post" if pre_client_secret else "none",
            )
            await CurantTokenStorage(name).set_client_info(info)

        asyncio.run(_seed_client_info())
        print(f"Using a pre-registered OAuth Client ID for '{name}' (skipping dynamic "
              f"client registration).")

    def _describe_exception(e):
        """anyio/httpx2's TaskGroup wraps real failures in an
        ExceptionGroup, whose own str() is just a useless summary count
        ("unhandled errors in a TaskGroup (1 sub-exception)") — walk down
        to the actual underlying exception(s) so the printed error means
        something."""
        if hasattr(e, "exceptions"):  # ExceptionGroup / BaseExceptionGroup (Python 3.11+)
            return "; ".join(_describe_exception(sub) for sub in e.exceptions)
        return f"{type(e).__name__}: {e}"

    try:
        tool_names = asyncio.run(asyncio.wait_for(run_flow(), timeout=310))
        _mark_mcp_server_oauth(name, url, transport=transport)
        print(f"Logged in and connected — {len(tool_names)} tool(s) available: {', '.join(tool_names)}")
    except Exception as e:
        print(f"OAuth login failed: {_describe_exception(e)}")
        if os.environ.get("CURANT_DEBUG"):
            import traceback
            traceback.print_exc()
        sys.exit(1)


def mcp_list_cmd():
    servers = get_mcp_servers()
    if not servers:
        print("No MCP servers connected.")
        return
    for s in servers:
        state = "enabled" if s["enabled"] else "disabled"
        # Badge only applies to entries that match something in the
        # curated registry — a customer's own custom mcp-add of a server
        # not in KNOWN_MCP_SERVICES at all has no official/unofficial
        # claim to make either way, since Curant never evaluated it.
        known = KNOWN_MCP_SERVICES.get(s["name"].lower())
        badge = ""
        if known is not None:
            badge = " [OFFICIAL]" if known["official"] else " [UNOFFICIAL — community-built, see mcp-connect for details]"
        if s["transport"] == "http":
            print(f"{s['name']}{badge} ({state}, http): {s['url']}")
        else:
            print(f"{s['name']}{badge} ({state}, stdio): {' '.join(s['command'])}")


