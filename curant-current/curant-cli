def refresh_status_if_stale(config):
    """Re-check license/billing status with the server at most every
    STATUS_RECHECK_SECONDS. Falls back to the last cached result if the
    server is unreachable, so a brief outage doesn't stop Curant from
    working — but a persistently unreachable server combined with a
    stale cache is surfaced rather than trusted forever.

    Also piggybacks the usage-count report on this same periodic call
    (rather than sending one on every single message) — that keeps the
    "how much is this used" signal to a coarse count on a ~12h cadence,
    not a per-message timing signal.
    """
    key = config.get("license_key")
    if not key:
        return config, False

    last_check = config.get("last_status_check", 0)
    if time.time() - last_check < STATUS_RECHECK_SECONDS:
        return config, config.get("last_status_active", False)

    device_id = get_device_id()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/status?device_id={device_id}",
        headers={"Authorization": f"Bearer {key}"},
    )
    try:
        result = request_with_retries(req, timeout=10)
        config["last_status_check"] = time.time()
        config["last_status_active"] = bool(result.get("active"))
        config["plan"] = result.get("plan", config.get("plan", "base"))
        config["unlocked_addons"] = result.get("unlocked_addons", config.get("unlocked_addons", []))
        apply_synced_preferences_if_newer(config, result)
        save_config(config)
        report_usage_if_pending(config)
        return config, config["last_status_active"]
    except Exception as e:
        print(f"Could not reach Curant's server to re-verify status (using cached result): {e}", file=sys.stderr)
        return config, config.get("last_status_active", False)


def _normalize_handle(h):
    """
    chat.db (read by curant-watcher.py) always stores phone numbers in
    E.164 form ("+12408390687"), never as a human would type one
    ("240-839-0687"), and handle matching there is a plain exact-string
    comparison -- a mismatched format means every text from that number
    silently never matches, forever, with no error surfaced anywhere.
    Applied here too (not just in curant-watcher.py, which has its own
    identical copy since curant-cli and the watcher are separate
    deployables) so a value typed into the web dashboard or this file's
    own setup wizard is already correct by the time it's saved, rather
    than relying on the watcher to catch it. Real bug, found live: a
    customer's own number, entered exactly as they'd naturally type it,
    never matched a single incoming text until this existed.

    Best-effort US/Canada-centric (NANP) -- there's no country context
    available at the point this is called, so a non-NANP number typed
    without its country code still needs a leading + entered by hand.
    """
    h = (h or "").strip()
    if not h or "@" in h:
        return h
    if h.startswith("+"):
        return h
    digits = re.sub(r"\D", "", h)
    if len(digits) == 10:
        return "+1" + digits
    if len(digits) == 11 and digits.startswith("1"):
        return "+" + digits
    return h


def apply_synced_preferences_if_newer(config, status_result):
    """
    Pulls persona/instructions/voice_tier from the server's /v1/status
    response (piggybacked there, not a separate endpoint -- see the
    server's own docstring on this) and applies them locally, but ONLY
    if the customer has actually set something via the web dashboard
    AND it's newer than what was already applied here.

    This is a narrow, deliberate exception to "the server never sees
    customer-specific data" -- persona/instructions/voice_tier are the
    one thing a customer can now set from the web instead of only
    locally via `curant-cli set-persona` etc. What Curant has LEARNED
    (memories, important_people) is unaffected and stays local-only,
    same as always -- this function never touches those tables.

    preferences_updated_at being None means the customer has never
    touched the dashboard's preferences form -- in that case this is a
    no-op, so a customer who's only ever configured Curant locally never
    has their local settings silently overwritten by server defaults.
    Comparing against config["last_synced_preferences_at"] (not
    last_status_check) means a genuinely unchanged server value doesn't
    re-apply (and re-log) on every single status poll.
    """
    updated_at = status_result.get("preferences_updated_at")
    if not updated_at:
        return
    if updated_at == config.get("last_synced_preferences_at"):
        return

    persona = status_result.get("persona")
    instructions = status_result.get("instructions")
    voice_tier = status_result.get("voice_tier")
    customer_apple_id = status_result.get("customer_apple_id")
    customer_handles = status_result.get("customer_handles")

    changed = []
    if persona and persona != config.get("persona"):
        config["persona"] = persona
        changed.append(f"persona -> {persona}")
    if instructions is not None and instructions != config.get("instructions"):
        config["instructions"] = instructions
        changed.append("instructions updated")
    if voice_tier and voice_tier != config.get("voice_tier"):
        config["voice_tier"] = voice_tier
        changed.append(f"voice_tier -> {voice_tier}")
    customer_apple_id = _normalize_handle(customer_apple_id)
    customer_handles = [_normalize_handle(h) for h in customer_handles] if customer_handles else customer_handles
    if customer_apple_id and customer_apple_id != config.get("customer_apple_id"):
        config["customer_apple_id"] = customer_apple_id
        changed.append("customer_apple_id updated")
    if customer_handles and customer_handles != config.get("customer_handles"):
        config["customer_handles"] = customer_handles
        changed.append("customer_handles updated")

    config["last_synced_preferences_at"] = updated_at
    if changed:
        print(f"[preferences sync] applied from web dashboard: {', '.join(changed)}", file=sys.stderr)


def report_usage_if_pending(config):
    """Send the accumulated local message count since the last report —
    a count only, never content or timestamps of individual messages.
    Best-effort: failure here never blocks anything else."""
    pending = config.get("pending_usage_count", 0)
    if pending <= 0:
        return
    key = config.get("license_key")
    payload = json.dumps({"message_count": pending}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/usage-report",
        data=payload,
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"},
        method="POST",
    )
    try:
        request_with_retries(req, timeout=10, max_attempts=1)
        config["pending_usage_count"] = 0
        save_config(config)
    except Exception as e:
        print(f"Usage report failed (non-fatal, will retry next cycle): {e}", file=sys.stderr)


def report_error(error_code, component):
    """Report a known, enumerated error code — never free text, never an
    exception message, never message content. Best-effort and silent on
    failure; this is a nice-to-have visibility signal, never allowed to
    block or complicate the actual error handling it's called from."""
    config = load_config()
    key = config.get("license_key")
    if not key:
        return
    payload = json.dumps({"error_code": error_code, "component": component}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/error-report",
        data=payload,
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"},
        method="POST",
    )
    try:
        request_with_retries(req, timeout=10, max_attempts=1)
    except Exception:
        pass  # never let telemetry reporting itself become a new failure mode


