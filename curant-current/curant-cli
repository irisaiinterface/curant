        conn.commit()


# --- MCP server config (which external tools Curant can reach) ---
# Storing only the launch command (e.g. ["npx", "-y", "@some/server"]) and
# a name — no credentials live here. If an MCP server needs its own auth
# (an API key, a token), that's the server's own concern to read from its
# own environment when curant-cli spawns it; Curant never handles or
# stores a third-party tool's credentials directly.

def get_mcp_servers(enabled_only=False):
    with closing(get_local_db()) as conn:
        query = ("SELECT id, name, transport, command, url, headers, auth_mode, enabled, "
                  "tools_cache, tools_cached_at FROM mcp_servers")
        if enabled_only:
            query += " WHERE enabled = 1"
        query += " ORDER BY id"
        rows = conn.execute(query).fetchall()
        return [{
            "id": r["id"], "name": r["name"],
            "transport": r["transport"] or "stdio",
            "command": json.loads(r["command"]) if r["command"] else None,
            "url": r["url"],
            "headers": json.loads(r["headers"]) if r["headers"] else {},
            "auth_mode": r["auth_mode"] or "none",
            "enabled": bool(r["enabled"]), "tools_cache": r["tools_cache"],
            "tools_cached_at": r["tools_cached_at"],
        } for r in rows]


def add_mcp_server(name, command_list):
    """Stdio transport — a local command that launches the server."""
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO mcp_servers (name, transport, command, enabled) VALUES (?, 'stdio', ?, 1) "
            "ON CONFLICT(name) DO UPDATE SET transport = 'stdio', command = excluded.command, "
            "url = NULL, headers = NULL, enabled = 1",
            (name, json.dumps(command_list)),
        )
        conn.commit()


def add_mcp_http_server(name, url, headers=None):
    """HTTP transport — a hosted MCP endpoint reached by URL. `headers`
    lets a server that needs its own auth (an API key, a bearer token)
    receive it on every request, without curant-cli needing to know
    anything about that server's specific auth scheme."""
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO mcp_servers (name, transport, url, headers, auth_mode, enabled) "
            "VALUES (?, 'http', ?, ?, 'headers', 1) "
            "ON CONFLICT(name) DO UPDATE SET transport = 'http', url = excluded.url, "
            "headers = excluded.headers, auth_mode = 'headers', command = NULL, enabled = 1",
            (name, url, json.dumps(headers or {})),
        )
        conn.commit()


def _mark_mcp_server_oauth(name, url, transport="http"):
    """Registers a server as using the OAuth auth mode — called once the
    interactive flow has actually completed and tokens exist, not before.
    transport defaults to 'http' (Streamable HTTP, the modern standard)
    but supports 'sse' for the few real services still on the older
    transport (Square, confirmed)."""
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO mcp_servers (name, transport, url, auth_mode, enabled) "
            "VALUES (?, ?, ?, 'oauth', 1) "
            "ON CONFLICT(name) DO UPDATE SET transport = excluded.transport, url = excluded.url, "
