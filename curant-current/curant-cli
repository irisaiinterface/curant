# ── OS-level containment for shell_exec (macOS) ──────────────────────────────
# The Aug 2026 audit's finding #3 was that the "sandbox" was only a working
# directory: in confirm/autonomous mode a command could still write anywhere
# and read anything, including ~/.ssh and the customer's own API key in
# ~/.curant/config.json. Confirmation is a real control, but it is procedural
# — it depends on a person reading carefully — and it is the only thing that
# was standing between an injected instruction and the filesystem.
#
# This adds a structural control underneath it, using macOS's own sandbox-exec
# (SBPL). Home is a Mac product, so this covers the deployed platform. The
# profile is permissive by default and subtractive, because a deny-by-default
# profile breaks ordinary dev commands (they need to read interpreters,
# libraries, and caches all over the filesystem):
#   - all writes denied except the workspace and the usual temp/null devices
#   - reads denied on the specific things worth stealing: SSH/AWS/GCP creds,
#     Keychains, browser profiles, shell history, and Curant's own config
#   - outbound network denied outright (a shell command has no reason to
#     exfiltrate, and this is the cheapest place to stop it)
#
# HONEST LIMITATION: sandbox-exec is deprecated by Apple (still functional,
# and still what powers the sandbox other tools rely on) and this profile has
# NOT been exercised on a real macOS machine from this build environment,
# which is Linux. It is therefore applied defensively: _sandbox_wrap() runs a
# trivial self-test first and, if the sandbox is unavailable or the profile
# is rejected, the command still runs but the result is prefixed with a
# visible warning rather than silently pretending containment applied. Verify
# on a real Mac before relying on it.
DEAN_SHELL_SANDBOX_DENIED_READS = (
    "~/.ssh", "~/.aws", "~/.config/gcloud", "~/.gnupg", "~/.curant",
    "~/Library/Keychains", "~/Library/Application Support/Google/Chrome",
    "~/Library/Application Support/Firefox", "~/Library/Cookies",
    "~/.bash_history", "~/.zsh_history", "~/.netrc",
)


def _build_sandbox_profile(workspace: str) -> str:
    """SBPL profile text. Paths are subpath-literals, so a denied entry covers
    everything beneath it."""
    denied = "\n".join(
        f'    (subpath "{os.path.expanduser(d)}")' for d in DEAN_SHELL_SANDBOX_DENIED_READS
    )
    return f"""(version 1)
(allow default)
(deny file-write*)
(allow file-write*
    (subpath "{workspace}")
    (subpath "/private/tmp")
    (subpath "/private/var/tmp")
    (literal "/dev/null")
    (literal "/dev/stdout")
    (literal "/dev/stderr"))
(deny file-read*
{denied})
(deny network-outbound)
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
"""


_sandbox_state = {"checked": False, "ok": False}


def _sandbox_available(workspace: str) -> bool:
    """One-time self-test: does sandbox-exec exist, and does this profile
    actually load? Cached — this shells out, and shell_exec may be called
    repeatedly in a conversation."""
    if _sandbox_state["checked"]:
        return _sandbox_state["ok"]
    _sandbox_state["checked"] = True
    if sys.platform != "darwin":
        _sandbox_state["ok"] = False
        return False
    try:
        probe = subprocess.run(
            ["sandbox-exec", "-p", _build_sandbox_profile(workspace), "/usr/bin/true"],
            capture_output=True, timeout=10,
        )
        _sandbox_state["ok"] = probe.returncode == 0
    except Exception:
        _sandbox_state["ok"] = False
    return _sandbox_state["ok"]

