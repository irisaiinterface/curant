def generate_slideshow_pptx(title, slides):
    """
    Builds a real .pptx via python-pptx -- entirely local, no network
    call. `slides` is a list of {"heading": str, "bullets": [str, ...]}
    dicts; a title slide is always added first from `title`. Lazy-
    imports pptx (same pattern as curant-watcher.py's whisper/pypdf
    imports) so this file doesn't hard-require python-pptx just to run
    unrelated commands -- returns a clear, sender-safe install
    instruction instead of a raw ImportError traceback if it's missing.
    """
    try:
        from pptx import Presentation
        from pptx.util import Inches, Pt
    except ImportError:
        return None, "python-pptx isn't installed on this Mac yet — run: pip install python-pptx --break-system-packages"
    try:
        import io
        prs = Presentation()
        title_layout = prs.slide_layouts[0]
        bullet_layout = prs.slide_layouts[1]

        title_slide = prs.slides.add_slide(title_layout)
        title_slide.shapes.title.text = title or "Untitled"
        if len(title_slide.placeholders) > 1:
            title_slide.placeholders[1].text = ""

        for s in (slides or []):
            slide = prs.slides.add_slide(bullet_layout)
            slide.shapes.title.text = s.get("heading", "")
            body = slide.placeholders[1].text_frame
            bullets = s.get("bullets") or []
            if bullets:
                body.text = bullets[0]
                for b in bullets[1:]:
                    p = body.add_paragraph()
                    p.text = b
            else:
                body.text = ""

        buf = io.BytesIO()
        prs.save(buf)
        return _save_generated_bytes(buf.getvalue(), "pptx"), None
    except Exception as e:
        return None, f"something went wrong building the slideshow: {e}"


def generate_document_docx(title, sections):
    """
    Builds a real .docx via python-docx -- same local-only, no-network,
    lazy-import pattern as generate_slideshow_pptx above. `sections` is
    a list of {"heading": str, "body": str} dicts.
    """
    try:
        from docx import Document
    except ImportError:
        return None, "python-docx isn't installed on this Mac yet — run: pip install python-docx --break-system-packages"
    try:
        import io
        doc = Document()
        doc.add_heading(title or "Untitled", level=0)
        for s in (sections or []):
            if s.get("heading"):
                doc.add_heading(s["heading"], level=1)
            if s.get("body"):
                doc.add_paragraph(s["body"])
        buf = io.BytesIO()
        doc.save(buf)
        return _save_generated_bytes(buf.getvalue(), "docx"), None
    except Exception as e:
        return None, f"something went wrong building the document: {e}"


def generate_spreadsheet_xlsx(title, sheets):
    """
    Builds a real .xlsx via openpyxl -- same local-only, no-network,
    lazy-import pattern as the other two. `sheets` is a list of
    {"name": str, "headers": [str, ...], "rows": [[str, ...], ...]}
    dicts -- at least one sheet is always created even if `sheets` is
    empty, so the file is never invalid/blank.
    """
    try:
        import openpyxl
    except ImportError:
        return None, "openpyxl isn't installed on this Mac yet — run: pip install openpyxl --break-system-packages"
    try:
        import io
        wb = openpyxl.Workbook()
        wb.remove(wb.active)
        for s in (sheets or [{"name": title or "Sheet1", "headers": [], "rows": []}]):
            ws = wb.create_sheet(title=(s.get("name") or "Sheet")[:31])  # Excel caps sheet names at 31 chars
            headers = s.get("headers") or []
            if headers:
                ws.append(headers)
            for row in (s.get("rows") or []):
                ws.append(row)
        buf = io.BytesIO()
        wb.save(buf)
        return _save_generated_bytes(buf.getvalue(), "xlsx"), None
    except Exception as e:
        return None, f"something went wrong building the spreadsheet: {e}"


def generate_image_flux(prompt, config):
    """
    Verified against Black Forest Labs' current integration guide
    (docs.bfl.ml/integration_guidelines) before writing this — two real
    corrections from the first pass: the API itself lives at api.bfl.ai
    (not api.bfl.ml, which is just the docs site — an easy mix-up), and
    BFL returns a polling_url directly in the submit response that you're
    supposed to poll, rather than constructing a fixed /get_result
    endpoint yourself as this originally did.
    """
    import requests
    api_key = get_api_key(config, "flux")
    if not api_key:
        return None, "No FLUX API key set. Run: curant-cli set-api-key <key> --provider flux"
    try:
        submit = requests.post(
            "https://api.bfl.ai/v1/flux-pro-1.1",
            headers={"accept": "application/json", "x-key": api_key, "Content-Type": "application/json"},
            json={"prompt": prompt, "width": 1024, "height": 1024},
            timeout=30,
        )
        submit.raise_for_status()
        submit_data = submit.json()
        task_id = submit_data.get("id")
        polling_url = submit_data.get("polling_url")
        if not task_id or not polling_url:
            return None, "FLUX didn't return an id/polling_url — the API shape may have changed since this was written."
        for _ in range(60):
            time.sleep(0.5)
            result = requests.get(
                polling_url, params={"id": task_id},
                headers={"accept": "application/json", "x-key": api_key}, timeout=15,
            )
            result.raise_for_status()
            data = result.json()
            status = data.get("status")
            if status == "Ready":
                image_url = (data.get("result") or {}).get("sample")
                if not image_url:
                    return None, "FLUX reported ready but returned no image URL."
                return _download_generated_file(image_url, "png"), None
            if status in ("Error", "Failed"):
                return None, f"FLUX generation failed (status: {status})."
        return None, "FLUX generation timed out waiting for a result."
    except Exception as e:
        return None, f"FLUX call failed: {e}"


