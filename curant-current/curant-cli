def save_routing_rule(category, provider):
    """Replaces any existing rule for the same category (case-insensitive)
    rather than stacking duplicates — a new standing instruction for a
    category supersedes the old one instead of leaving both around to
    conflict."""
    with closing(get_local_db()) as conn:
        conn.execute(
            "DELETE FROM routing_rules WHERE lower(category) = lower(?)",
            (category,),
        )
        conn.execute(
            "INSERT INTO routing_rules (category, provider) VALUES (?, ?)",
            (category, provider),
        )
        conn.commit()


def delete_routing_rule(category):
