def set_spend_cap_cmd(amount):
    """
    Self-serve — this is the customer's own spend limit on their own API
    key, so no admin gate belongs here, unlike device-release requests
    which deliberately do require review. Three modes:
      - no argument: just show the current cap and this month's spend
      - a number: set the cap to that amount
      - 'none': remove the cap entirely (explicit, not the accidental
        default — get_monthly_spend_cap() treats "never set" as the
        conservative $25 default specifically so a customer can't end
        up uncapped just by never having touched this).
    """
    config = load_config()
    current_spend = get_monthly_estimated_spend()
    current_cap = get_monthly_spend_cap(config)

    if amount is None:
        cap_str = "no cap set" if current_cap is None else f"${current_cap:.2f}/month"
        print(f"This month's generation spend so far: ~${current_spend:.2f}")
        print(f"Current cap: {cap_str}")
        return

    if amount.strip().lower() == "none":
        config["monthly_spend_cap_usd"] = None
        save_config(config)
        print("Spend cap removed — August's generation tools are now uncapped. "
              "You can set a new cap anytime with `curant-cli set-spend-cap <amount>`.")
        return

    try:
        new_cap = float(amount)
        if new_cap < 0:
            raise ValueError
    except ValueError:
        print(f"'{amount}' isn't a valid dollar amount. Use a number like 25 or 25.00, or 'none' to remove the cap.")
        sys.exit(1)

    config["monthly_spend_cap_usd"] = new_cap
    save_config(config)
    print(f"Monthly spend cap set to ${new_cap:.2f}. This month's spend so far: ~${current_spend:.2f}.")
    if current_spend >= new_cap:
        print("Note: this month's spend already meets or exceeds this cap — generation tools "
              "will be blocked until next month or until you raise the cap.")


def routing_rules_cmd(remove=None):
    """
    Shows the standing routing rules currently in effect, or removes one
    with --remove <category>. Nothing here is hidden — a customer can
    always see exactly what's been set, either by asking their Curant in
    a text ("what routing rules do I have set?", which the system prompt
    doesn't currently expose — use this command for a definitive answer)
    or by running this directly.
    """
    if remove:
        delete_routing_rule(remove)
        print(f"Removed routing rule for '{remove}' (if one existed).")
        return
    rules = get_routing_rules()
    if not rules:
        print("No standing routing rules set. Curant picks a provider per-message "
              "automatically when more than one is configured, unless you say "
              "something like 'always use GPT for coding' to set a standing rule.")
        return
    print("Standing routing rules:")
    for r in rules:
        print(f"  {r['category']} -> {r['provider']}")


def routing_log_cmd(limit=10):
    """Shows which provider actually answered your recent messages —
    definitive, pulled from stored history, not a guess."""
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT content, provider, created_at FROM messages "
            "WHERE role = 'assistant' AND provider IS NOT NULL "
            "ORDER BY id DESC LIMIT ?",
            (limit,),
        ).fetchall()
    if not rows:
        print("No routed messages yet.")
        return
    for r in reversed(rows):
        preview = r["content"][:60] + ("…" if len(r["content"]) > 60 else "")
        print(f"[{r['provider']}] {preview}")


def urgency_log_cmd(limit=10):
    """Shows recent incoming messages flagged as urgent — the heuristic
    is deliberately simple (see classify_urgency's docstring), so this
    command exists to make what got flagged, and why it might matter,
    directly inspectable rather than an invisible internal signal."""
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT content, urgency, created_at FROM messages "
            "WHERE role = 'user' AND urgency = 'urgent' "
            "ORDER BY id DESC LIMIT ?",
            (limit,),
        ).fetchall()
    if not rows:
        print("No messages flagged urgent recently.")
        return
    for r in reversed(rows):
        preview = r["content"][:70] + ("…" if len(r["content"]) > 70 else "")
        print(f"[{r['created_at']}] {preview}")


def request_release():
    """
    Request that this license's device binding be released — e.g. moving
    to a new Mac, or an old Mac that's gone for good. This is deliberately
    NOT automatic: it logs a request that a human reviews and approves,
    the same as calling support directly. Nothing changes until that
    happens — running this does not itself free up the license.
    """
    config = load_config()
    key = config.get("license_key")
    if not key:
        print("Not activated. Run: curant-cli activate <your-license-key>")
        sys.exit(1)

    payload = json.dumps({"license_key": key}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/release-request",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        result = request_with_retries(req, timeout=10)
    except Exception as e:
        print(f"Could not reach Curant's server: {e}")
        sys.exit(1)

    if not result.get("ok"):
        print("Couldn't submit the request — check your license key, or contact support directly.")
        sys.exit(1)

    if result.get("status") == "already_pending":
        print("You already have a release request pending review — no need to submit another. "
              "If it's been a while, call support directly to follow up.")
    else:
        print("Release request submitted. This does not release the binding automatically — "
              "a person needs to review and approve it, same as if you called in directly. "
              "Call support if you want to speed this along or confirm it was received.")


