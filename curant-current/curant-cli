def _handle_server_generation_response(resp):
    """Shared (path, error) handling for both server-proxied generation
    endpoints. The server never sends back its own FLUX/Ideogram key --
    only a hosted image_url to download, or a sanitized error message
    (cap exceeded, generation failed, etc.)."""
    try:
        data = resp.json()
    except Exception:
        return None, f"Curant's server returned an unreadable response (status {resp.status_code})."
    if resp.status_code == 200 and data.get("ok"):
        image_url = data.get("image_url")
        if not image_url:
            return None, "Curant's server reported success but returned no image URL."
        return _download_generated_file(image_url, "png"), None
    return None, data.get("message") or data.get("error") or f"Curant's server returned status {resp.status_code}."


