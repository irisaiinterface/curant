def request_release():
    """
    Request that this license's device binding be released — e.g. moving
    to a new Mac, or an old Mac that's gone for good. This is deliberately
    NOT automatic: it logs a request that a human reviews and approves,
    the same as calling support directly. Nothing changes until that
    happens — running this does not itself free up the license.
    """
    config = load_config()
    key = config.get("license_key")
    if not key:
        print("Not activated. Run: curant-cli activate <your-license-key>")
        sys.exit(1)

    payload = json.dumps({"license_key": key}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/release-request",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        result = request_with_retries(req, timeout=10)
    except Exception as e:
        print(f"Could not reach Curant's server: {e}")
        sys.exit(1)

    if not result.get("ok"):
        print("Couldn't submit the request — check your license key, or contact support directly.")
        sys.exit(1)

    if result.get("status") == "already_pending":
        print("You already have a release request pending review — no need to submit another. "
              "If it's been a while, call support directly to follow up.")
    else:
        print("Release request submitted. This does not release the binding automatically — "
              "a person needs to review and approve it, same as if you called in directly. "
              "Call support if you want to speed this along or confirm it was received.")


def propose_code_fix_for_gap(description, config):
    """
    Grace-exclusive. Asks the model to draft a PROPOSED implementation
    (as plain-text pseudo-diff/description, never a real applied patch)
    for a capability gap the customer just hit, and submits that draft
    to the server's code_proposals review queue -- it is NEVER written
    to disk here, never applied to this Mac's own curant-cli, never
    executed, and never auto-merged anywhere. It only becomes real code
    if a human (Abhy) reads it on the owner dashboard and manually
    implements/merges it themselves -- the "approve" button on that
    dashboard only flips a status column, it doesn't deploy anything.

    This is a deliberately conservative design, chosen explicitly over a
    fully-autonomous alternative: this codebase has hard-coded safety
    rails elsewhere (e.g. click_page_element refusing login/payment
    flows in code, not just by instruction) that a cleverly-worded
    capability-gap request could otherwise try to route around if the
    model's own draft were ever trusted to run unsupervised. Keeping a
    human in the loop for every single proposal, no exceptions, is what
    keeps that risk contained.

    Best-effort: any failure here (LLM call, network) is caught by the
    caller (log_capability_gap) and never blocks the customer-facing
    reply or the local capability-gap logging, which always happens
    regardless of whether this succeeds.
    """
    key = config.get("license_key")
    if not key:
        return

    provider = get_provider(config)
    api_key = get_api_key(config, provider)
    if not api_key:
        return

    draft_instruction = (
        "A Curant customer just asked for something Curant's current tools genuinely can't "
        "do:\n\n"
        f"\"{description}\"\n\n"
        "Draft a PROPOSED implementation for a developer (Abhy, Curant's owner) to review -- "
        "NOT code that will run automatically, just a clear draft for a human to read, edit, "
        "and manually decide whether to build. Curant is a Python CLI (curant-cli) where tools "
        "are Python functions registered in get_all_available_tools() and dispatched in "
        "execute_tool_call() by a qualified_name/tool_name match; most generation-style tools "
        "return a (result, error) tuple. Structure your answer as: (1) a one-paragraph summary "
        "of what the new tool would do and why, (2) a plausible Python function signature and "
        "docstring for it, (3) a short pseudocode/description of the implementation approach, "
        "and (4) anything that would need a new API key, new addon/tier gate, or new server "
        "endpoint. Keep it concise -- this is a starting point for a human developer, not a "
        "finished PR."
    )
    system_prompt = build_system_prompt(config, [], [], "", extra_instruction=draft_instruction)

    try:
        draft = call_llm(
            provider, api_key, system_prompt,
            messages=[{"role": "user", "content": "Draft the proposed implementation now."}],
            max_tokens=1200, tier="main",
        ).strip()
    except Exception as e:
        print(f"[code proposal] LLM draft failed (non-fatal): {e}", file=sys.stderr)
        return

    if not draft:
        return

    try:
        import requests
        requests.post(
            f"{SERVER_BASE}/v1/propose-code-fix",
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"},
            json={"gap_description": description, "proposed_diff": draft},
            timeout=20,
        )
    except Exception as e:
        print(f"[code proposal] submit failed (non-fatal): {e}", file=sys.stderr)


