def register_open_question(kind, prompt_text, patterns, resolver, resolver_args=None, priority=10):
    """Call this right after sending the customer a message that expects
    one of a SMALL KNOWN SET of replies (approve/decline, a specific
    keyword, etc.) -- not for open-ended conversational questions, which
    the model should keep handling exactly as before.

    `patterns` is {"<intent>": ["keyword", ...], ...}, e.g.
    {"approve": ["update", "yes", "install"], "decline": ["skip", "no"]}.
    `resolver` must be a key in OPEN_QUESTION_RESOLVERS. `resolver_args`
    is any extra JSON-serializable context the resolver needs beyond the
    matched intent (e.g. which version to install)."""
    with closing(get_local_db()) as conn:
        cur = conn.execute(
            "INSERT INTO open_questions (kind, prompt_text, patterns_json, resolver, resolver_args_json, priority) "
            "VALUES (?, ?, ?, ?, ?, ?)",
            (kind, prompt_text, json.dumps(patterns), resolver, json.dumps(resolver_args or {}), priority),
        )
        conn.commit()
        return cur.lastrowid


def get_open_unresolved_questions():
    """Highest priority first, then most recently asked first -- see
    match_incoming_reply for how ties/multiple matches are handled."""
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT id, kind, prompt_text, patterns_json, resolver, resolver_args_json, priority, created_at "
            "FROM open_questions WHERE status = 'open' ORDER BY priority DESC, id DESC"
        ).fetchall()
        return [dict(r) for r in rows]


