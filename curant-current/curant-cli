        )
        conn.commit()


def _match_question_intent(question, incoming_text):
    """Case-insensitive substring match of incoming_text against each
    intent's keyword list. Returns the matched intent string, or None.
    Deliberately simple (no regex/NLP) -- the whole point is that this
    is dumb, predictable, and auditable, unlike asking an LLM to guess."""
    try:
        patterns = json.loads(question["patterns_json"] or "{}")
    except (json.JSONDecodeError, TypeError):
        return None
    lowered = (incoming_text or "").strip().lower()
    if not lowered:
        return None
    for intent, keywords in patterns.items():
        for kw in keywords or []:
            kw = str(kw).strip().lower()
            if kw and kw in lowered:
                return intent
    return None


# Resolvers take (intent: str, resolver_args: dict) and return a
# customer-facing reply string. Each one is responsible for actually
# doing the thing (calling the real tool logic) AND for phrasing the
# confirmation -- match_incoming_reply just wires the plumbing.
OPEN_QUESTION_RESOLVERS = {}


def _register_resolver(name):
    def deco(fn):
        OPEN_QUESTION_RESOLVERS[name] = fn
        return fn
    return deco


@_register_resolver("apply_pending_update")
def _resolve_apply_pending_update(intent, resolver_args):
    config = load_config()
    pending = config.get("pending_auto_update")
    if not pending:
        # Already applied/declined via some other path -- nothing left
        # to do, and importantly: don't claim success or failure either
        # way since there's genuinely nothing pending anymore.
        return "Looks like that update isn't pending anymore -- nothing to do here."
    if intent == "decline":
        config.pop("pending_auto_update", None)
        config["auto_update_declined_version"] = pending["version"]
        save_config(config)
        return (f"Okay, skipping version {pending['version']} for now. I won't ask about this "
                f"specific version again, but let me know if you change your mind or a newer "
                f"version comes out.")
    # intent == "approve"
    _notify_task_starting("installing the update (I'll be back in a moment)")
    success, detail = _download_and_apply_update(pending["download_url"])
    config = load_config()
    config.pop("pending_auto_update", None)
    if success:
        config.pop("auto_update_declined_version", None)
        save_config(config)
        if detail == "applied":
            return f"Updated to version {pending['version']} and restarted the background watcher."
        return (f"Updated to version {pending['version']}, but there was a hiccup restarting the "
                f"background watcher ({detail}). The update itself is real -- run `curant-cli "
                f"check-update` to confirm -- but if I've gone quiet after this, that's why: run "
                f"`launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.curant.watcher.plist` "
                f"by hand to bring it back.")
    save_config(config)
    return (f"Update to version {pending['version']} failed: {detail}. Nothing changed -- still "
            f"running {CURANT_VERSION}. Say the word to try again, or run `curant-cli update` by hand.")


def match_incoming_reply(incoming_text):
    """The deterministic pre-check curant-watcher.py runs BEFORE handing
    a message to the LLM at all (see match_open_question_cmd below).
    Checks unresolved open_questions highest-priority-first; the first
    one whose patterns match wins outright -- no ambiguity, no guessing,
    and critically, a structured question always beats whatever else is
    being discussed in the conversation, which is exactly the bug this
    exists to fix. Returns (reply_text, question_id) or (None, None) if
    nothing matched (caller should fall through to the normal LLM path
    unchanged)."""
    for question in get_open_unresolved_questions():
        intent = _match_question_intent(question, incoming_text)
        if not intent:
            continue
        resolver = OPEN_QUESTION_RESOLVERS.get(question["resolver"])
        if not resolver:
            continue
        try:
            resolver_args = json.loads(question["resolver_args_json"] or "{}")
        except (json.JSONDecodeError, TypeError):
            resolver_args = {}
        reply_text = resolver(intent, resolver_args)
        resolve_open_question(question["id"])
        return reply_text, question["id"]
    return None, None


SEND_TO_PARAM_HINTS = ("to", "recipients", "recipient")
SEND_SUBJECT_PARAM_HINTS = ("subject",)
SEND_BODY_PARAM_HINTS = ("body", "message", "text", "content")
SEND_TOOL_NAME_HINTS = ("send",)


def _build_send_email_arguments(input_schema, to_addr, subject, body):
    """Best-effort mapping from (to, subject, body) onto whatever field
    names a given MCP server's send tool actually expects -- same
    "no fixed contract with a customer-chosen MCP server" reasoning as
    _pick_query_param_name above, just for the three fields a send
    needs instead of one search query. If a field's schema says it
    wants an array (several send tools take `to` as a list of
    recipients, e.g. shinzo-labs/gmail-mcp), wraps the single address
    in a one-item list rather than sending a bare string a strict
    schema might reject."""
    props = (input_schema or {}).get("properties") or {}

    def _find(hints):
        for hint in hints:
            if hint in props:
                return hint
        return None

    args = {}
    to_key = _find(SEND_TO_PARAM_HINTS)
    if to_key:
        wants_array = props.get(to_key, {}).get("type") == "array"
        args[to_key] = [to_addr] if wants_array else to_addr
    subject_key = _find(SEND_SUBJECT_PARAM_HINTS)
    if subject_key:
        args[subject_key] = subject
    body_key = _find(SEND_BODY_PARAM_HINTS)
    if body_key:
        args[body_key] = body
    return args


def process_email_approvals_tool(approve_ids, reject_ids):
    """Dispatch target for the process_email_approvals builtin tool --
    see that tool's schema/description for the full safety rationale.
    This is the ONLY code path anywhere in this file that turns a
    pending_email_sends row into a real, actually-sent email, and it
    only runs because a live customer message triggered it (this
    function is never called from an unattended background job)."""
    results = []

    for send_id in approve_ids:
        row = get_pending_email_send_by_id(send_id)
        if not row:
            results.append(f"#{send_id}: not found (already handled, or never existed).")
            continue
        if row["status"] != "pending":
            results.append(f"#{send_id}: already {row['status']}, skipping.")
            continue
        server = next((s for s in get_mcp_servers(enabled_only=True) if s["name"] == row["mcp_server_name"]), None)
        if not server:
            set_pending_email_send_status(send_id, "send_failed")
            results.append(f"#{send_id}: the '{row['mcp_server_name']}' connection isn't available anymore -- not sent.")
            continue
        tools = _get_server_tools_cached(server)
        send_tool = next((t for t in tools if any(hint in t["name"].lower() for hint in SEND_TOOL_NAME_HINTS)
                           and "draft" not in t["name"].lower()), None)
        if not send_tool:
            set_pending_email_send_status(send_id, "send_failed")
            results.append(f"#{send_id}: couldn't find a send tool on '{row['mcp_server_name']}' -- not sent.")
            continue
        send_args = _build_send_email_arguments(send_tool.get("input_schema"), row["to_addr"], row["subject"], row["body"])
        result = call_mcp_tool(server, send_tool["name"], send_args)
        if isinstance(result, str) and result.startswith("[Error"):
            set_pending_email_send_status(send_id, "send_failed")
            results.append(f"#{send_id}: send failed -- {result}")
        else:
            set_pending_email_send_status(send_id, "sent")
            results.append(f"#{send_id}: sent to {row['to_addr']}.")

    for send_id in reject_ids:
        row = get_pending_email_send_by_id(send_id)
        if not row:
            results.append(f"#{send_id}: not found.")
            continue
        if row["status"] != "pending":
            results.append(f"#{send_id}: already {row['status']}, skipping.")
            continue
        set_pending_email_send_status(send_id, "rejected")
        results.append(f"#{send_id}: rejected, not sent.")

    return "\n".join(results) if results else "No valid ids given -- nothing changed."


CAPABILITY_GAPS_XLSX_PATH = os.path.join(CONFIG_DIR, "capability_gaps.xlsx")


def export_capability_gaps_xlsx():
    """
    Writes every logged capability gap (the feature_requests table) out
    to a real, directly-viewable .xlsx at a FIXED path
    (~/.curant/capability_gaps.xlsx) -- deliberately NOT run through the
    same at-rest Fernet encryption as generated attachments/backups,
    because the whole point is a file the owner can just double-click
    and look at in Excel/Numbers whenever, not one that needs a decrypt
    step first. "Secure" here means the same standard local.db already
    uses: chmod 0600 (owner-only read/write), same as the database this
    data is pulled from -- not full encryption-at-rest.

    Called automatically at the end of log_capability_gap() (see below)
    so this file is always current the moment a new gap is logged --
    no separate manual export step required. Also exposed as its own
    `curant-cli export-capability-gaps` command for an on-demand
    refresh (e.g. after the local.db was restored from a backup, or if
    the file gets deleted).

    Overwrites the whole file each time rather than trying to append --
    feature_requests is small (capability gaps are, by definition, rare
    enough to be worth a custom-quote conversation) so a full rewrite
    is cheap, and it sidesteps any question of the sheet drifting out
    of sync with the database.
    """
    import openpyxl
    from openpyxl.styles import Font

    rows = get_feature_requests_local()
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Capability Gaps"
    ws.append(["Logged At", "Status", "Request"])
    for cell in ws[1]:
        cell.font = Font(bold=True)
    for r in rows:
        ws.append([r.get("created_at", ""), r.get("status", ""), r.get("request_text", "")])
    ws.column_dimensions["A"].width = 20
    ws.column_dimensions["B"].width = 12
    ws.column_dimensions["C"].width = 80

    os.makedirs(CONFIG_DIR, exist_ok=True)
    wb.save(CAPABILITY_GAPS_XLSX_PATH)
    os.chmod(CAPABILITY_GAPS_XLSX_PATH, 0o600)  # owner-only, same standard as local.db
    return CAPABILITY_GAPS_XLSX_PATH


