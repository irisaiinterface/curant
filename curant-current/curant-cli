# Default monthly cap on August's paid generation tools (FLUX/Ideogram/
# ElevenLabs/Veo) — applied to a fresh config that hasn't set one
# explicitly. Deliberately conservative: at Veo's ~$3.20/generation, this
# still allows real use (dozens of images, several videos) while putting
# a real ceiling on a runaway-loop scenario, which is a documented real
# risk category for AI agent products (not hypothetical — a misconfigured
# loop has produced a $34,000 bill in 8 days for another product, from a
# lack of exactly this kind of safeguard). The customer can raise or
# remove this themselves at any time via `curant-cli set-spend-cap` —
# this is a safety default, not a hard business limit imposed on them.
DEFAULT_MONTHLY_SPEND_CAP_USD = 25.0


def get_monthly_estimated_spend():
    """Spend from generation_costs within the current calendar month only —
    the cap resets monthly rather than being a lifetime ceiling, since a
    lifetime cap would eventually block a long-time customer from ever
    generating anything again regardless of how reasonably they're using it."""
    with closing(get_local_db()) as conn:
        row = conn.execute(
            "SELECT SUM(estimated_cost_usd) as total FROM generation_costs "
            "WHERE created_at >= date('now', 'start of month')"
        ).fetchone()
        return row["total"] or 0.0


def get_monthly_spend_cap(config):
    """None means uncapped — an explicit customer choice (set-spend-cap
    with no amount, or a negative/zero value), not the default state."""
    if "monthly_spend_cap_usd" not in config:
        return DEFAULT_MONTHLY_SPEND_CAP_USD
    return config["monthly_spend_cap_usd"]  # may be None (uncapped)


def check_spend_cap(config, service):
    """
    Returns (ok: bool, message: str | None). Checked BEFORE a paid
    generation call fires, not after — the whole point of a cap is
    preventing the spend, not just recording it afterward. Compares
    current month-to-date spend PLUS this generation's estimated cost
    against the cap, so the generation that would cross the line is the
    one that gets blocked, not the one after it.
    """
    cap = get_monthly_spend_cap(config)
    if cap is None:
        return True, None
    current = get_monthly_estimated_spend()
    projected = current + ESTIMATED_COST_USD.get(service, 0.0)
    if projected > cap:
        return False, (
            f"This would put this month's generation spend at an estimated ${projected:.2f}, "
            f"over the ${cap:.2f} monthly cap currently set. Nothing was generated. The "
            f"customer can raise this cap themselves anytime with `curant-cli set-spend-cap "
            f"<amount>`, or remove it entirely with `curant-cli set-spend-cap none`."
        )
    return True, None

# Reset at the start of each relay() call, appended to by successful
# generation tool calls during that turn — lets relay() know what to
# hand back to curant-watcher.py for delivery without threading a return
# value through the whole provider-specific tool-calling loop machinery.
_last_generated_files = []

# Set at the start of relay() (see below), read by execute_tool_call when
# dispatching an async tool that needs to know who to deliver a result
# to later — same "avoid threading a new parameter through the whole
# tool-calling call chain" reasoning as _last_generated_files above.
_current_apple_id = None


def _get_generated_files_key():
    """
    A dedicated Fernet key for encrypting generated files at rest —
    separate from other keys in config, generated once on first need
    and persisted. Images/audio sitting in ~/.curant/generated/ deserve
    the same at-rest protection as everything else this system encrypts
    (backups, context exports); there's no principled reason for this
    one directory to be the unencrypted exception.
    """
    from cryptography.fernet import Fernet
    config = load_config()
    key = config.get("generated_files_key")
    if not key:
        key = Fernet.generate_key().decode()
        config["generated_files_key"] = key
        save_config(config)
    return Fernet(key.encode())


def _save_generated_bytes(content_bytes, extension):
    os.makedirs(GENERATION_OUTPUT_DIR, exist_ok=True)
    prune_generated_files()  # cheap, just an mtime scan — do it opportunistically
                               # rather than needing a separate cron/launchd job
    fernet = _get_generated_files_key()
    encrypted = fernet.encrypt(content_bytes)
    filename = f"{extension}_{os.urandom(4).hex()}.{extension}.enc"
    path = os.path.join(GENERATION_OUTPUT_DIR, filename)
    with open(path, "wb") as f:
        f.write(encrypted)
    return path


def decrypt_generated_file(encrypted_path):
    """Decrypts a generated file back to plaintext bytes. Used only at
    the moment of actually delivering it (see relay()'s attachment
    handling) — the long-term copy on disk stays encrypted the whole
    time; only a short-lived plaintext copy exists, and only for as
    long as it takes to hand off to Messages for sending."""
    fernet = _get_generated_files_key()
    with open(encrypted_path, "rb") as f:
        return fernet.decrypt(f.read())


def prune_generated_files():
    """Deletes generated files older than GENERATED_FILE_MAX_AGE_HOURS.
    Called opportunistically (on each new generation, and at the start
    of relay()) rather than needing a separate scheduled job — cheap
    enough that this doesn't need its own infrastructure."""
    if not os.path.isdir(GENERATION_OUTPUT_DIR):
        return
    cutoff = time.time() - (GENERATED_FILE_MAX_AGE_HOURS * 3600)
    for filename in os.listdir(GENERATION_OUTPUT_DIR):
        path = os.path.join(GENERATION_OUTPUT_DIR, filename)
        try:
            if os.path.isfile(path) and os.path.getmtime(path) < cutoff:
                os.remove(path)
        except OSError:
            pass  # file may have been removed concurrently — not worth failing over


def _download_generated_file(url, extension):
    import requests
    resp = requests.get(url, timeout=60)
    resp.raise_for_status()
    return _save_generated_bytes(resp.content, extension)


def generate_image_flux(prompt, config):
    """
    Verified against Black Forest Labs' current integration guide
    (docs.bfl.ml/integration_guidelines) before writing this — two real
    corrections from the first pass: the API itself lives at api.bfl.ai
    (not api.bfl.ml, which is just the docs site — an easy mix-up), and
    BFL returns a polling_url directly in the submit response that you're
    supposed to poll, rather than constructing a fixed /get_result
    endpoint yourself as this originally did.
    """
    import requests
    api_key = get_api_key(config, "flux")
    if not api_key:
        return None, "No FLUX API key set. Run: curant-cli set-api-key <key> --provider flux"
    try:
        submit = requests.post(
            "https://api.bfl.ai/v1/flux-pro-1.1",
            headers={"accept": "application/json", "x-key": api_key, "Content-Type": "application/json"},
            json={"prompt": prompt, "width": 1024, "height": 1024},
            timeout=30,
        )
        submit.raise_for_status()
        submit_data = submit.json()
        task_id = submit_data.get("id")
        polling_url = submit_data.get("polling_url")
        if not task_id or not polling_url:
            return None, "FLUX didn't return an id/polling_url — the API shape may have changed since this was written."
        for _ in range(60):
            time.sleep(0.5)
            result = requests.get(
                polling_url, params={"id": task_id},
                headers={"accept": "application/json", "x-key": api_key}, timeout=15,
            )
            result.raise_for_status()
            data = result.json()
            status = data.get("status")
            if status == "Ready":
                image_url = (data.get("result") or {}).get("sample")
                if not image_url:
                    return None, "FLUX reported ready but returned no image URL."
                return _download_generated_file(image_url, "png"), None
            if status in ("Error", "Failed"):
                return None, f"FLUX generation failed (status: {status})."
        return None, "FLUX generation timed out waiting for a result."
    except Exception as e:
        return None, f"FLUX call failed: {e}"


