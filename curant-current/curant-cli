def set_spend_cap_cmd(amount):
    """
    Self-serve — this is the customer's own spend limit on their own API
    key, so no admin gate belongs here, unlike device-release requests
    which deliberately do require review. Three modes:
      - no argument: just show the current cap and this month's spend
      - a number: set the cap to that amount
      - 'none': remove the cap entirely (explicit, not the accidental
        default — get_monthly_spend_cap() treats "never set" as the
        conservative $25 default specifically so a customer can't end
        up uncapped just by never having touched this).
    """
    config = load_config()
    current_spend = get_monthly_estimated_spend()
    current_cap = get_monthly_spend_cap(config)

    if amount is None:
        cap_str = "no cap set" if current_cap is None else f"${current_cap:.2f}/month"
        print(f"This month's generation spend so far: ~${current_spend:.2f}")
        print(f"Current cap: {cap_str}")
        return

    if amount.strip().lower() == "none":
        config["monthly_spend_cap_usd"] = None
        save_config(config)
        print("Spend cap removed — August's generation tools are now uncapped. "
              "You can set a new cap anytime with `curant-cli set-spend-cap <amount>`.")
        return

    try:
        new_cap = float(amount)
        if new_cap < 0:
            raise ValueError
    except ValueError:
        print(f"'{amount}' isn't a valid dollar amount. Use a number like 25 or 25.00, or 'none' to remove the cap.")
        sys.exit(1)

    config["monthly_spend_cap_usd"] = new_cap
    save_config(config)
    print(f"Monthly spend cap set to ${new_cap:.2f}. This month's spend so far: ~${current_spend:.2f}.")
    if current_spend >= new_cap:
        print("Note: this month's spend already meets or exceeds this cap — generation tools "
              "will be blocked until next month or until you raise the cap.")


