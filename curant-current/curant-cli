# Urgency classification is a deliberately lightweight, free heuristic —
# not another paid API call per message, the way the routing decision is.
# It only flags things clearly signaled as urgent by surface wording or
# formatting; it makes no claim to actually understand urgency, and it is
# NOT a safety/crisis triage mechanism — that judgment stays entirely
# with the model itself, on every message, regardless of this tag. This
# exists purely to help the model calibrate response speed/tone (skip
# small talk, get to the point) when someone's phrasing suggests they're
# in a hurry or dealing with something time-sensitive.
URGENT_KEYWORDS = (
    "urgent", "emergency", "asap", "as soon as possible", "right away",
    "immediately", "right now", "need this now", "time sensitive",
    "time-sensitive", "before it's too late", "hurry",
)


def classify_urgency(message_text):
    """Returns 'urgent' or 'normal'. Conservative by design — false
    negatives (missing real urgency) are far less costly than false
    positives (treating everything as an emergency)."""
    if not message_text:
        return "normal"
    text_lower = message_text.lower()
    if any(kw in text_lower for kw in URGENT_KEYWORDS):
        return "urgent"
    if message_text.count("!") >= 3:
        return "urgent"
    letters = [c for c in message_text if c.isalpha()]
    if len(letters) > 10 and sum(1 for c in letters if c.isupper()) / len(letters) > 0.7:
        return "urgent"  # heavy ALL CAPS as a secondary, weaker signal
    return "normal"

