            "INSERT INTO grading_examples (assignment_id, submission_text, grade_given, feedback_given) "
            "VALUES (?, ?, ?, ?)",
            (assignment["id"], submission_text, grade_given, feedback_given),
        )
        conn.commit()
    return True, "Example added."


def get_grading_examples(assignment_name):
    assignment = get_grading_assignment(assignment_name)
    if not assignment:
        return []
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT submission_text, grade_given, feedback_given FROM grading_examples WHERE assignment_id = ?",
            (assignment["id"],),
        ).fetchall()
        return [dict(r) for r in rows]


def get_grading_corrections(assignment_name, limit=10):
    """Recent corrections for this assignment — real signal from past
    mistakes, folded into future calibration the same way the original
    examples are, most recent first since a teacher's standards for a
    given assignment are more likely to have settled than drifted."""
    assignment = get_grading_assignment(assignment_name)
    if not assignment:
        return []
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT submission_text, suggested_grade, corrected_grade, corrected_feedback "
            "FROM grading_corrections WHERE assignment_id = ? ORDER BY id DESC LIMIT ?",
            (assignment["id"], limit),
        ).fetchall()
        return [dict(r) for r in rows]


def record_grading_correction(assignment_name, submission_text, suggested_grade, corrected_grade, corrected_feedback):
    assignment = get_grading_assignment(assignment_name)
    if not assignment:
        return False, f"No assignment set up called '{assignment_name}'."
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO grading_corrections (assignment_id, submission_text, suggested_grade, "
            "corrected_grade, corrected_feedback) VALUES (?, ?, ?, ?, ?)",
            (assignment["id"], submission_text, suggested_grade, corrected_grade, corrected_feedback),
        )
        conn.commit()
    return True, "Got it — I'll factor that in for this assignment going forward."


def list_grading_assignments():
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT assignment_name, (SELECT COUNT(*) FROM grading_examples WHERE assignment_id = grading_assignments.id) as example_count "
            "FROM grading_assignments ORDER BY updated_at DESC"
        ).fetchall()
        return [dict(r) for r in rows]


def _grade_tier(grade_str):
    """Best-effort extraction of a 'tier' from a grade string, for
    spread-checking — handles the common letter-grade case (A, B+, C-,
    etc.) by ignoring +/- so 'C+' and 'C' correctly count as the same
    tier, not a real spread. Falls back to an exact-string match for
    anything else (numeric grades, rubric labels like 'meets
    expectations') since there's no reliable universal way to parse
    every grading system a teacher might use — this is an honest
    limitation, not silently pretended away."""
    match = re.match(r'^\s*([A-Fa-f])[+-]?\s*$', grade_str)
    if match:
        return match.group(1).upper()
    return grade_str.strip().lower()


def build_grading_calibration_context(assignment_name):
    """
    Assembles everything the model needs to actually grade in this
    teacher's voice for this specific assignment: the prompt, the
    rubric, the calibration examples (explicitly flagging if the spread
    looks thin — e.g. only high-scoring examples, no contrast), and
    recent corrections. Returns a formatted string ready to drop into
    the system prompt, or None if the assignment doesn't exist yet.
    """
    assignment = get_grading_assignment(assignment_name)
    if not assignment:
        return None
    examples = get_grading_examples(assignment_name)
    corrections = get_grading_corrections(assignment_name)

    parts = [
        f"Assignment: {assignment_name}",
        f"Prompt: {assignment['assignment_prompt']}",
        f"Rubric: {assignment['rubric_text']}",
    ]
    if examples:
        parts.append(f"\nCalibration examples ({len(examples)} on file):")
        for i, ex in enumerate(examples, 1):
            parts.append(f"  Example {i} — grade given: {ex['grade_given']}\n"
                        f"  Feedback given: {ex['feedback_given']}\n"
                        f"  Submission excerpt: {ex['submission_text'][:300]}")
        tiers_seen = {_grade_tier(ex["grade_given"]) for ex in examples}
        if len(tiers_seen) < 2:
            parts.append(
                "\nNOTE: the calibration examples for this assignment don't show a clear "
                "spread (best-effort check — for letter grades this ignores +/-, so 'C+' and "
                "'C' count as the same tier; for other grading formats it's an exact-string "
                "match, which won't catch every case). Tell the teacher this before grading "
                "anything new, and ask for at least one clearly stronger or weaker example."
            )
    else:
        parts.append("\nNo calibration examples yet for this assignment.")

    if corrections:
        parts.append(f"\nRecent corrections from this teacher on this assignment ({len(corrections)}):")
        for c in corrections:
            parts.append(f"  Suggested {c['suggested_grade']}, teacher corrected to {c['corrected_grade']}"
                        f"{' — ' + c['corrected_feedback'] if c['corrected_feedback'] else ''}")

    return "\n".join(parts)



# explicitly did NOT solve. Receiving a verification email is one thing;
# actually completing a signup on some third-party website's own UI —
# typing into fields, clicking submit — is a different, much larger
# capability. Built here using Playwright, verified as genuinely
# installable and launchable (real Chromium binary, real browser
# process) before writing any of this.
#
# This is the single most consequential capability in this whole
# system — an AI autonomously interacting with arbitrary third-party
# websites, potentially agreeing to terms of service or submitting real
# data on the customer's behalf. Handled with the same read/write split
# used for Gmail/Calendar/Drive, PLUS one extra hard rail specific to
# this capability that the other integrations didn't need:
#   - browse_page(): read-only, no side effect, runs freely — look at a
#     page, see what's on it, see what fields exist.
#   - fill_and_submit_form(): the real external-effect action. Gated the
#     same way gmail_send/drive_share are (system prompt instructs
#     confirmation-first) — but ALSO hard-blocked in code, not just by
#     instruction, from ever touching anything that looks like a
#     payment or sensitive-ID field (card numbers, CVV, SSNs). That
#     refusal happens regardless of what the model decides, because
#     payment/identity data deserves a harder line than "the model
#     should ask first" — a categorically different risk than filling
#     out a newsletter signup.

# Expanded after the Aug 2026 audit, which tested the matcher against real
# field names and found it correctly caught card/cvv/ssn/routing but missed
# several categories that are just as sensitive: international bank details,
# government IDs, and date of birth.
PAYMENT_FIELD_KEYWORDS = (
    "card", "cvv", "cvc", "ccnum", "cardnumber", "security-code",
    "securitycode", "expiry", "exp-date", "expdate", "ssn", "social-security",
    "socialsecurity", "routing-number", "routingnumber", "account-number", "accountnumber",
    # international banking
    "iban", "bic", "swift", "sortcode", "sort-code",
    # government / identity documents
    "passport", "taxid", "tax-id", "nationalid", "national-id", "driverslicense",
    "drivers-license", "licensenumber", "sin", "nino",
    # date of birth (commonly paired with the above for identity verification)
    "dateofbirth", "date-of-birth", "dob", "birthdate", "birth-date",
    # credentials — never auto-fill these either
    "password", "passwd", "pin", "otp", "onetimecode", "mfa", "2fa",
)

# ── SSRF guard for the browser tools ─────────────────────────────────────────
# Added after the Aug 2026 audit found browse_page() passed whatever URL it
# was given straight to Playwright with no validation at all. That meant the
# model could be steered — by a customer, or by injected text in an email or
# web page it had just read — into fetching http://localhost, a router admin
# page on the customer's LAN, or a cloud metadata endpoint like
# http://169.254.169.254/ and reporting the contents back.
#
# Blocks by resolved IP, not by hostname string: a name like
# "internal.example.com" or a DNS entry deliberately pointed at 127.0.0.1
# looks perfectly public as text. Resolution happens here, and again inside
# the page's request interceptor, so a redirect or a subresource can't reach
# somewhere the top-level URL wasn't allowed to.
BLOCKED_URL_SCHEMES_NOTE = "only http:// and https:// are allowed"


def _ip_is_private(ip_str: str) -> bool:
    try:
        ip = ipaddress.ip_address(ip_str)
    except ValueError:
        return True  # unparseable — treat as unsafe rather than allow
    return (ip.is_private or ip.is_loopback or ip.is_link_local
            or ip.is_reserved or ip.is_multicast or ip.is_unspecified)


def _is_safe_url(url):
    """Returns (safe, reason). Used both up front and per-request."""
    try:
        parsed = urlparse(url)
    except Exception:
        return False, "that isn't a URL I can parse"
    if parsed.scheme not in ("http", "https"):
        return False, f"the scheme '{parsed.scheme or 'none'}' isn't allowed — {BLOCKED_URL_SCHEMES_NOTE}"
    host = parsed.hostname
    if not host:
        return False, "that URL has no hostname"
    try:
        infos = socket.getaddrinfo(host, None)
    except Exception:
        return False, f"'{host}' couldn't be resolved"
    for info in infos:
        if _ip_is_private(info[4][0]):
            return False, (f"'{host}' resolves to a private, loopback, or link-local address "
                            f"({info[4][0]}) — internal network addresses are not reachable from here")
    return True, ""


def _install_ssrf_guard(page):
    """Re-checks every request the page makes, so redirects, iframes, and
    subresource loads are held to the same rule as the original URL."""
    def _route(route, request):
        ok, _ = _is_safe_url(request.url)
        if ok:
            route.continue_()
        else:
            route.abort()
    page.route("**/*", _route)


def _is_sensitive_field(field_name):
    """
    Normalizes separators (underscores, hyphens) out of both the field
    name and the keyword list before comparing — a raw substring check
    without this misses real variants (e.g. 'cc_number' vs the keyword
    'ccnum': the underscore breaks a naive substring match even though
    they mean the same thing). Caught by testing this against multiple
    real-world naming conventions, not just one.
    """
    if not field_name:
        return False
    normalized = re.sub(r"[^a-z0-9]", "", field_name.lower())
    normalized_keywords = [re.sub(r"[^a-z0-9]", "", kw) for kw in PAYMENT_FIELD_KEYWORDS]
    return any(kw in normalized for kw in normalized_keywords)


BROWSER_TIMEOUT_MS = 15000


def browse_page(url):
    """
    Read-only — navigate to a page and see what's there: visible text,
    and every fillable field with its name/type/label, so the model
    knows what a subsequent fill_and_submit_form() call could target.
    No side effect, no confirmation needed, same as reading an email.
    """
    safe, why = _is_safe_url(url)
    if not safe:
        return None, f"Refusing to open that URL — {why}."

    try:
        from playwright.sync_api import sync_playwright
        with sync_playwright() as p:
            browser = p.chromium.launch()
            try:
                page = browser.new_page()
                _install_ssrf_guard(page)
                page.goto(url, timeout=BROWSER_TIMEOUT_MS)
                page.wait_for_load_state("networkidle", timeout=BROWSER_TIMEOUT_MS)
                text_content = page.inner_text("body")
                fields = page.eval_on_selector_all(
                    "input, select, textarea",
                    """els => els.map(el => ({
                        name: el.name || el.id || '',
                        type: el.type || el.tagName.toLowerCase(),
                        label: (el.labels && el.labels[0]) ? el.labels[0].innerText : ''
                    }))""",
                )
                return {"text": text_content[:3000], "fields": fields}, None
            finally:
                browser.close()
    except Exception as e:
        return None, f"Could not load that page: {e}"


# Keywords that mark a page or a specific clickable element as a login,
# payment/checkout, or other high-stakes action -- click_page_element()
# refuses these regardless of what the model claims about intent, the
# same belt-and-suspenders pattern as fill_and_submit_form()'s sensitive-
# field block and confirmed-flag check. This is deliberately a lower
# ceiling than fill_and_submit_form: clicking is for navigating/expanding
# read-oriented content (pagination, "read more", FAQ toggles), not for
# completing an action that has a real-world consequence -- those still
# require fill_and_submit_form's explicit prior confirmation.
CLICK_BLOCKED_KEYWORDS = (
    "sign in", "log in", "login", "buy now", "add to cart", "add to bag",
    "purchase", "place order", "pay now", "payment", "donate", "checkout",
    "confirm order", "complete order", "delete account", "cancel subscription",
    "unsubscribe", "transfer funds", "send money",
)


def _page_looks_like_login_or_payment(page):
    """Checks the CURRENT page (not a specific element) for login/payment
    signals -- a password field, a card-number-shaped field (reuses
    _is_sensitive_field/PAYMENT_FIELD_KEYWORDS), or a URL containing an
    obvious login/checkout path segment. Returns (blocked: bool, reason)."""
    try:
        url = (page.url or "").lower()
        for kw in ("checkout", "payment", "login", "signin", "sign-in", "/cart"):
            if kw in url:
                return True, f"the page URL contains '{kw}'"
        if page.query_selector("input[type='password']"):
            return True, "the page has a password field"
        field_names = page.eval_on_selector_all(
            "input, select, textarea", "els => els.map(el => el.name || el.id || '')"
        )
        if any(_is_sensitive_field(n) for n in field_names):
            return True, "the page has a payment or sensitive-ID field"
    except Exception:
        pass
    return False, None


def _click_target_is_blocked(page, selector):
    """Checks the SPECIFIC element about to be clicked for blocked-action
    text (its own visible text, not the whole page) -- catches a "Buy now"
    button on an otherwise reasonable-looking page that _page_looks_like_
    login_or_payment wouldn't flag on its own. Returns (blocked, reason)."""
    try:
        el = page.query_selector(selector)
        if el is None:
            return False, None
        el_type = (el.evaluate("el => el.type || ''") or "").lower()
        if el_type == "password":
            return True, "that element is a password field"
        text = (el.inner_text() or "").strip().lower()
        for kw in CLICK_BLOCKED_KEYWORDS:
            if kw in text:
                return True, f"its text ('{text[:60]}') matches a blocked action ('{kw}')"
    except Exception:
        pass
    return False, None


def click_page_element(url, selector):
    """
    Navigates to `url`, clicks the element matching `selector`, and
    returns the resulting page's text -- for things like expanding a
    FAQ section, following "read more", or paging through results.
    Read/navigate only, no confirmation required, same trust tier as
    browse_page -- but NOT a general-purpose click-anything tool.

    Refuses in code (not just by instruction) if:
      - the URL fails the same SSRF check browse_page/fill_and_submit_form
        use (_is_safe_url) -- no localhost/private-network/metadata-
        endpoint access, same as always;
      - the page itself looks like a login or payment/checkout flow
        BEFORE the click (password field, payment-shaped field, or a
        login/checkout-ish URL);
      - the specific element being clicked has text matching
        CLICK_BLOCKED_KEYWORDS (sign in, buy now, checkout, pay, donate,
        delete account, etc.) -- checked on the element itself, not just
        the page, so a stray "Buy now" button doesn't get through just
        because the rest of the page reads as a normal article;
      - the click LANDS somewhere that looks like login/payment even if
        it didn't start that way (re-checked after navigation) -- still
        returns whatever text is on that resulting page, since seeing
        "this led to a login page" is useful information, but doesn't
        pretend the click didn't happen.

    Anything that actually needs to complete (submit a form, log in, buy
    something) still goes through fill_and_submit_form, which requires
    explicit prior customer confirmation -- this tool never substitutes
    for that.
    """
    safe, why = _is_safe_url(url)
    if not safe:
        return None, f"Refusing to open that URL — {why}."

    try:
        from playwright.sync_api import sync_playwright
        with sync_playwright() as p:
            browser = p.chromium.launch()
            try:
                page = browser.new_page()
                _install_ssrf_guard(page)
                page.goto(url, timeout=BROWSER_TIMEOUT_MS)
                page.wait_for_load_state("networkidle", timeout=BROWSER_TIMEOUT_MS)

                blocked, reason = _page_looks_like_login_or_payment(page)
                if blocked:
                    return None, (f"Refusing — {reason}, which looks like a login or payment "
                                   f"page. This tool doesn't click through those.")

                blocked, reason = _click_target_is_blocked(page, selector)
                if blocked:
                    return None, (f"Refusing to click that element — {reason}. That kind of "
                                   f"action needs a person to do it directly, or (if it's really "
                                   f"a form to submit) go through fill_and_submit_form with "
                                   f"explicit confirmation instead.")

                page.click(selector, timeout=BROWSER_TIMEOUT_MS)
                page.wait_for_load_state("networkidle", timeout=BROWSER_TIMEOUT_MS)

                landed_blocked, landed_reason = _page_looks_like_login_or_payment(page)
                text_content = page.inner_text("body")[:3000]
                if landed_blocked:
                    return {"text": text_content, "warning":
                            f"That click landed on what looks like a login or payment page "
                            f"({landed_reason}) — stopping here rather than interacting further."}, None
                return {"text": text_content}, None
            finally:
                browser.close()
    except Exception as e:
        return None, f"Couldn't click that element: {e}"


def get_shell_safety_mode(config):
    mode = config.get("shell_safety_mode")
    return mode if mode in DEAN_SHELL_SAFETY_MODES else DEAN_SHELL_DEFAULT_SAFETY_MODE


def set_shell_safety_mode(mode):
    """Called either from the CLI (set-shell-mode) or by Dean himself via
    the set_shell_safety_mode tool, once he's actually asked the customer
    which mode they want — see the tool's description in
    get_all_available_tools for why this is asked rather than assumed."""
    if mode not in DEAN_SHELL_SAFETY_MODES:
        return False, f"Not a valid mode — must be one of: {', '.join(DEAN_SHELL_SAFETY_MODES)}."
    config = load_config()
    config["shell_safety_mode"] = mode
    save_config(config)
    return True, f"Shell safety mode set to '{mode}'."


def _shell_command_is_allowlisted(command: str) -> tuple[bool, str]:
    """
    Returns (allowed, reason_if_not).

    REWRITTEN after the Aug 2026 security audit found the original
    version trivially bypassable. The original did a bare prefix match
    and carried a comment claiming "shell metacharacters break the match
    rather than sneaking past it." That was FALSE: a metacharacter only
    broke the match when it landed immediately after the allowlisted
    word. `git status; rm -rf /` was correctly refused, but
    `git log --oneline; rm -rf ~` matched the "git log " prefix and ran —
    with no confirmation, since that's the entire point of allowlist
    mode. Confirmed by execution, not theory.

    Three checks now, all of which must pass:
      1. No shell metacharacters anywhere — no chaining, substitution,
         redirection, or pipelines. This is what makes prefix matching
         defensible at all.
      2. Prefix match against the allowlist.
      3. No absolute paths or parent-directory traversal in the
         arguments. `ls` is safe; `ls /Users/someone/.ssh` is not, and
         the difference is the argument, not the command.
    """
    command = command.strip()
    if not command:
        return False, "empty command"

    for ch in SHELL_METACHARACTERS:
        if ch in command:
            return False, (
                f"it contains the shell metacharacter '{ch}'. Allowlist mode runs commands "
                f"without asking the customer first, so it only permits a single plain command "
                f"— no chaining, pipes, redirection, or substitution."
            )

    if not any(command == entry or command.startswith(entry + " ") for entry in DEAN_SHELL_ALLOWLIST):
        return False, "it isn't one of the pre-approved read-only commands"

    try:
        parts = shlex.split(command)
    except ValueError:
        return False, "it couldn't be parsed as a well-formed command (unbalanced quotes?)"
    for arg in parts[1:]:
        if arg.startswith("/") or arg.startswith("~") or ".." in arg:
            return False, (
                f"the argument '{arg}' points outside Dean's working directory. Allowlist mode "
                f"only runs against relative paths inside it."
            )

    return True, ""


def shell_exec(command: str, cwd: str | None, confirmed: bool, config: dict) -> tuple[str | None, str | None]:
    """
    Dean's real shell-access action — see the module comment above
    DEAN_SHELL_SAFETY_MODES for the full scoping reasoning (Home-only,
    Dean-only, customer's own choice of safety mode).

    HONEST SCOPE. Two layers, and it is worth being precise about which
    does what, because an earlier version of this docstring overstated it:

      - Mode rules (procedural). "confirm" needs the customer to approve
        the exact string; "allowlist" permits only a short list of
        commands, with no shell interpretation, no metacharacters and no
        absolute paths; "autonomous" is unrestricted by the customer's
        own explicit choice.
      - OS containment (structural, macOS only). Commands run under
        sandbox-exec: writes denied outside the workspace, reads denied
        on credential stores (~/.ssh, ~/.aws, Keychains, browser
        profiles, shell history, and Curant's own config), outbound
        network denied. This is what stops an approved-but-misunderstood
        command, or an injected one, from reaching things it shouldn't.

    If sandbox-exec is unavailable (non-macOS, or the profile is
    rejected) the command still runs, but the output carries a visible
    warning saying containment did not apply — it never silently
    pretends to be contained. The profile itself has not yet been
    exercised on real macOS hardware; see the note above
    DEAN_SHELL_SANDBOX_DENIED_READS.

    The `cwd` parameter specifically is still checked against escaping
    the workspace root — that's a guard on this function's own argument,
    not a claim about the command string.

    Returns (output, error) — output includes the exit code and combined
    stdout/stderr (truncated), error is set only when the command didn't
    run at all (blocked by safety mode, or a real subprocess failure).
    """
    os.makedirs(DEAN_SHELL_WORKSPACE, exist_ok=True)

    mode = get_shell_safety_mode(config)
    if mode == "confirm" and not confirmed:
        return None, (
            f"Not run — this action requires explicit customer confirmation first. The exact "
            f"command that would run is: `{command}`. Ask the customer to confirm, wait for "
            f"their reply, then call this again with confirmed=true."
        )
    allowlisted, refusal_reason = (True, "")
    if mode == "allowlist":
        allowlisted, refusal_reason = _shell_command_is_allowlisted(command)
        if not allowlisted:
            return None, (
                f"Not run — shell safety mode is 'allowlist', and `{command}` was refused because "
                f"{refusal_reason}. Ask the customer to either approve switching to 'confirm' or "
                f"'autonomous' mode (via set_shell_safety_mode) or run this themselves."
            )

    run_dir = DEAN_SHELL_WORKSPACE
    if cwd:
        candidate = os.path.realpath(os.path.join(DEAN_SHELL_WORKSPACE, cwd))
        if not candidate.startswith(os.path.realpath(DEAN_SHELL_WORKSPACE)):
            return None, "Not run — that working directory would escape Dean's shell workspace."
        run_dir = candidate
        os.makedirs(run_dir, exist_ok=True)

    sandboxed = _sandbox_available(DEAN_SHELL_WORKSPACE)
    sandbox_note = "" if sandboxed else (
        "[warning: OS-level containment is unavailable on this machine, so this command "
        "ran with your full user permissions — it could read or write anything you can. "
        "Mention this to the customer if it matters for what they asked.]\n"
    )

    try:
        if mode == "allowlist":
            # No shell interpretation at all in this mode — the argv list is
            # passed straight to exec, so there is no shell left to interpret
            # a metacharacter even if one somehow got past the check above.
            # Defense in depth: the check and this are independent.
            argv = shlex.split(command)
        else:
            # A real shell, because confirm/autonomous legitimately want pipes
            # and redirection — the customer approved the exact string.
            argv = ["/bin/sh", "-c", command]

        if sandboxed:
            argv = ["sandbox-exec", "-p", _build_sandbox_profile(DEAN_SHELL_WORKSPACE)] + argv

        result = subprocess.run(
            argv, shell=False, cwd=run_dir, capture_output=True, text=True,
            timeout=DEAN_SHELL_TIMEOUT_SECONDS,
        )
        output = (result.stdout or "") + (result.stderr or "")
        truncated = output[:DEAN_SHELL_OUTPUT_MAX_CHARS]
        if len(output) > DEAN_SHELL_OUTPUT_MAX_CHARS:
            truncated += "\n[...output truncated...]"
        return f"{sandbox_note}[exit code {result.returncode}]\n{truncated}", None
    except subprocess.TimeoutExpired:
        return None, f"Command timed out after {DEAN_SHELL_TIMEOUT_SECONDS} seconds and was killed."
    except Exception as e:
        return None, f"Command failed to run: {e}"


def fill_and_submit_form(url, field_values, submit_selector, confirmed=False):
    """
    The real external-effect action. `confirmed` is now checked here in
    code, not just requested via system prompt instruction — a model
    that calls this without confirmed=True gets refused outright, the
    same structural pattern already used for the sensitive-field block
    below. Belt-and-suspenders on purpose: the schema marks `confirmed`
    required so a well-behaved model can't omit it, and this check
    catches the case where it's present but false anyway (a model
    calling ahead of actual customer confirmation, or a malformed call).

    Also hard-blocked in code from touching anything that looks like a
    payment or sensitive-ID field — that block applies regardless of
    confirmation, since payment/identity data is a categorically
    different risk than a newsletter signup.
    """
    if not confirmed:
        return None, (
            "Not submitted — this action requires explicit customer confirmation first. "
            "Ask the customer to confirm, wait for their reply, then call this again with "
            "confirmed=true."
        )

    blocked = [k for k in field_values if _is_sensitive_field(k)]
    if blocked:
        return None, (
            f"Refusing to auto-fill these fields — they look like payment or sensitive-ID "
            f"fields ({', '.join(blocked)}). That needs a person to enter directly, never "
            f"automated, regardless of confirmation."
        )

    safe, why = _is_safe_url(url)
    if not safe:
        return None, f"Refusing to open that URL — {why}."

    try:
        from playwright.sync_api import sync_playwright
        with sync_playwright() as p:
            browser = p.chromium.launch()
            try:
                page = browser.new_page()
                _install_ssrf_guard(page)
                page.goto(url, timeout=BROWSER_TIMEOUT_MS)
                for field_name, value in field_values.items():
                    el = page.query_selector(f"#{field_name}, [name='{field_name}']")
                    if not el:
                        return None, f"Could not find a field matching '{field_name}' on this page."
                    tag = el.evaluate("el => el.tagName.toLowerCase()")
                    el_type = el.evaluate("el => el.type || ''")
                    if tag == "select":
                        el.select_option(str(value))
                    elif el_type == "checkbox":
                        if str(value).lower() in ("true", "1", "yes"):
                            el.check()
                    else:
                        el.fill(str(value))

                page.click(submit_selector, timeout=BROWSER_TIMEOUT_MS)
                page.wait_for_load_state("networkidle", timeout=BROWSER_TIMEOUT_MS)
                result_text = page.inner_text("body")
                return {"result_text": result_text[:2000]}, None
            finally:
                browser.close()
    except Exception as e:
        return None, f"Browser automation failed: {e}"


BROWSER_SYNC_WAIT_SECONDS = 8  # most form submissions are fast (a few seconds) — worth
                                # trying to answer in the same turn rather than always
                                # going through the two-message "started... done" pattern
                                # Veo needs, since Veo is *always* slow and forms usually aren't
BROWSER_SYNC_WAIT_SECONDS_GRACE = 20  # Grace gets a longer same-turn window before
                                       # falling back to the async "I'll let you know"
                                       # handoff -- fewer form submissions need the
                                       # two-message pattern at all for these customers.


def _browser_sync_wait_seconds(config=None):
    """Grace gets a longer synchronous wait before falling back to the
    async delivery path -- see BROWSER_SYNC_WAIT_SECONDS_GRACE above.
    Accepts an optional already-loaded config (some call sites have one
    on hand already); loads fresh otherwise."""
    try:
        cfg = config if config is not None else load_config()
        if get_customer_august_tier(cfg) == "grace":
            return BROWSER_SYNC_WAIT_SECONDS_GRACE
    except Exception:
        pass
    return BROWSER_SYNC_WAIT_SECONDS


def fill_and_submit_form_hybrid(url, field_values, submit_selector, apple_id, confirmed=False):
    """
    The safety property that matters most here: the actual browser work
    runs EXACTLY ONCE, inside the detached background job subprocess
    (see run_background_job_cmd), regardless of how this function
    returns. This function only ever *polls* that job's status — it
    never calls fill_and_submit_form() itself. That's what makes it safe
    to poll-then-give-up without any risk of the form getting submitted
    twice, which matters here in a way it wouldn't for read-only actions.

    `confirmed` is checked HERE, before even creating the background
    job — an unconfirmed call never reaches the subprocess at all, so
    there's no path where a slow/async submission slips past the same
    check a synchronous call would hit.

    Most submissions finish within BROWSER_SYNC_WAIT_SECONDS, so the
    common case gets a real, same-turn answer. If a site is slow enough
    to still be running past that window, this hands off to the same
    background-job delivery path Veo uses (the watcher's polling loop
    picks it up once it actually finishes) rather than blocking relay()
    for however long that slow site takes.
    """
    if not confirmed:
        return (
            "Not submitted — this action requires explicit customer confirmation first. "
            "Ask the customer to confirm, wait for their reply, then call this again with "
            "confirmed=true."
        )

    job_id = _create_background_job(
        "fill_and_submit_form",
        {"url": url, "field_values": field_values, "submit_selector": submit_selector, "confirmed": True},
        apple_id,
    )
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "run-background-job", str(job_id)],
            start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        _update_background_job(job_id, "failed", error=f"Could not start: {e}")
        return f"Couldn't fill out that form: {e}"

    deadline = time.time() + _browser_sync_wait_seconds()
    while time.time() < deadline:
        time.sleep(0.5)
        job = _get_background_job(job_id)
        if job["status"] in ("done", "failed"):
            mark_job_delivered(job_id)  # answering it right now, in this same reply
            if job["status"] == "done":
                return job.get("result_text") or "(Form submitted, but no page content came back.)"
            return f"[Form submission failed: {job['error']}]"

    return ("Still working on that one — the site's taking a bit longer than usual. "
            "I'll let you know as soon as it's done.")


# Short, persona-flavored "starting on it" notices -- sent as a SEPARATE,
# immediate text via send_imessage the moment a slow tool call begins
# (see _notify_task_starting below), before the actual work happens.
# Real gap this closes: generate_video already had a "you'll hear back
# when it's done" pattern (background job + "Your video is ready!"
# follow-up), but everything else in a single relay() call is silent
# until the WHOLE turn finishes -- for a slideshow/document/spreadsheet
# or a multi-tool-call turn, that can be a real, noticeable wait with
# zero acknowledgment that anything is even happening. One canned line
# per persona (not a separate LLM call) -- deliberately, so the "started"
# notice itself doesn't add the very latency it exists to paper over,
# and doesn't risk hallucinating something off-persona in a rushed
# low-context call. {task} is filled in per call site (see
# _notify_task_starting).
TASK_START_TEMPLATES = {
    "curant": "On it — starting on {task} now, I'll let you know when it's ready.",
    "grace": "Understood. I'm beginning work on {task} now and will follow up once it's complete.",
    "dean": "Yep, starting on {task} now. Ping when it's done.",
    "nora": "Okay — I'll start on {task} now and check back in once it's ready.",
    "frank": "You got it! Kicking off {task} right now — back in a bit!",
    "miles": "Starting {task}.",
    "jane": "Starting {task} now. I'll confirm once it's finished.",
    "leo": "Alright, I'm starting on {task} now — no rush, I'll let you know when it's done.",
    "august": "Diving into {task} now — give me a moment to make it good.",
    "aaron": "Starting on {task} now — I'll let you know as soon as it's ready.",
}


def _notify_task_starting(task_label):
    """
    Best-effort, fire-and-forget: sends an immediate, persona-flavored
    "starting now" text via send_imessage, separate from and BEFORE the
    tool's own (possibly slow) work happens. Uses _current_apple_id (set
    once per relay() call — see relay()'s docstring) as the recipient,
    same as generate_video's existing background-job delivery. Never
    raises and never blocks the actual tool call on failure -- a failed
    courtesy notice should not be the reason a real task doesn't run.
    """
    if not _current_apple_id:
        return
    try:
        config = load_config()
        persona = config.get("persona", "curant")
        template = TASK_START_TEMPLATES.get(persona, TASK_START_TEMPLATES["curant"])
        send_imessage(_current_apple_id, template.format(task=task_label))
    except Exception as e:
        print(f"[task-start notice] failed to send (non-fatal): {e}", file=sys.stderr)


def execute_tool_call(tool_name, arguments, available_tools):
    """Routes a tool call to either the built-in capability-gap logger,
    one of August's specialist generation tools, or the right MCP
    server, based on the qualified name the model was given. Never
    raises — a tool failure becomes a text result the model can react
    to. Successful generations append their local file path to
    _last_generated_files so relay() can surface it for delivery.

    Slow/generation-style tools get an immediate "starting now" text via
    _notify_task_starting BEFORE the real work runs — see its docstring
    and TASK_START_TEMPLATES above. Fast, near-instant tools (lookup_person,
    log_capability_gap, mark_sender_as_spam, etc.) deliberately do NOT get
    one; announcing something that finishes before the notice would even
    plausibly be read is just noise.
    """
    match = next((t for t in available_tools if t["qualified_name"] == tool_name), None)
    if match is None:
        return f"[Unknown tool: {tool_name}]"

    _TASK_START_LABELS = {
        "generate_slideshow": "your slideshow",
        "generate_document": "your document",
        "generate_spreadsheet": "your spreadsheet",
        "generate_image": "your image",
        "generate_image_with_text": "your image",
        "generate_voice": "your voice clip",
        "edit_media": "that edit",
        "generate_video": "your video (this one takes a few minutes)",
        "fill_and_submit_form": "that form",
        "fill_and_submit_form_hybrid": "that form",
        # NOTE: send_message_to_person is deliberately excluded -- it's a
        # single, near-instant AppleScript send, same speed class as the
        # fast tools this notice is meant to skip (see the docstring
        # above); a "starting" notice immediately followed by the actual
        # message would just be noise, not a useful heads-up.
    }
    if match["builtin"] and tool_name in _TASK_START_LABELS:
        _notify_task_starting(_TASK_START_LABELS[tool_name])

    if match["builtin"] and tool_name == "log_capability_gap":
        description = arguments.get("description", "").strip()
        if not description:
            return "[No description provided — nothing was logged.]"
        return log_capability_gap(description)

    if match["builtin"] and tool_name == "search_order_status":
        query = (arguments.get("query") or "").strip()
        if not query:
            return "[No search query provided.]"
        config = load_config()
        return search_order_status_email(query, config)

    if match["builtin"] and tool_name == "lookup_person":
        handle = (arguments.get("handle") or "").strip()
        if not handle:
            return "[No handle provided — nothing to look up.]"
        person = get_person_by_handle(handle)
        if person:
            bits = [f"name: {person['name']}"]
            if person.get("relationship"):
                bits.append(f"relationship: {person['relationship']}")
            if person.get("role"):
                bits.append(f"role: {person['role']}")
            if person.get("gender"):
                bits.append(f"gender: {person['gender']}")
            if person.get("note"):
                bits.append(f"note: {person['note']}")
            if person.get("is_spam"):
                bits.append("(marked as spam)")
            return "Found in local people-memory — " + "; ".join(bits)
        contact_name = lookup_macos_contact(handle)
        if contact_name:
            return (f"No local people-memory for this handle, but it matches '{contact_name}' in the "
                    f"Mac's Contacts app — nothing else is known about them yet. Consider calling "
                    f"remember_person once you learn more (relationship, role, etc.).")
        return "No record of this handle anywhere — not in local people-memory, not in Contacts. Unknown person."

    if match["builtin"] and tool_name == "remember_person":
        handle = (arguments.get("handle") or "").strip()
        if not handle:
            return "[No handle provided — nothing was saved.]"
        person = upsert_person(
            handle,
            name=arguments.get("name"),
            relationship=arguments.get("relationship"),
            note=arguments.get("note"),
            gender=arguments.get("gender"),
            role=arguments.get("role"),
        )
        return f"Saved — {person['name']} ({handle}) is now remembered."

    if match["builtin"] and tool_name == "mark_sender_as_spam":
        handle = (arguments.get("handle") or "").strip()
        if not handle:
            return "[No handle provided — nothing was marked.]"
        is_spam = arguments.get("is_spam", True)
        set_person_spam(handle, is_spam=bool(is_spam))
        return f"{handle} is now {'marked as spam — future texts from them will be silently dropped' if is_spam else 'un-marked as spam'}."

    if match["builtin"] and tool_name == "generate_slideshow":
        path, error = generate_slideshow_pptx(arguments.get("title", ""), arguments.get("slides", []))
        if error:
            return f"[generate_slideshow failed: {error}]"
        _last_generated_files.append(path)
        return f"Slideshow generated successfully, saved at {path}."

    if match["builtin"] and tool_name == "generate_document":
        path, error = generate_document_docx(arguments.get("title", ""), arguments.get("sections", []))
        if error:
            return f"[generate_document failed: {error}]"
        _last_generated_files.append(path)
        return f"Document generated successfully, saved at {path}."

    if match["builtin"] and tool_name == "generate_spreadsheet":
        path, error = generate_spreadsheet_xlsx(arguments.get("title", ""), arguments.get("sheets", []))
        if error:
            return f"[generate_spreadsheet failed: {error}]"
        _last_generated_files.append(path)
        return f"Spreadsheet generated successfully, saved at {path}."

    if match["builtin"] and tool_name == "send_message_to_person":
        handle = (arguments.get("handle") or "").strip()
        text_to_send = (arguments.get("text") or "").strip()
        confirmed = arguments.get("confirmed", False)
        if not handle or not text_to_send:
            return "[Missing handle or text — nothing was sent.]"
        if not confirmed:
            return ("[Refused: send_message_to_person requires confirmed=true, set only after the "
                     "customer has explicitly confirmed IN A PRIOR MESSAGE that this exact message "
                     "should be sent. Ask them to confirm first, then call this again.]")
        person = get_person_by_handle(handle)
        if person and person.get("is_spam"):
            return f"[Refused: {handle} is marked as spam — not sending to them.]"
        known_name = (person.get("name") if person else None) or lookup_macos_contact(handle)
        if not known_name:
            return (f"[Refused: {handle} isn't a recognized contact — no local people-memory and no "
                     f"match in the Mac's Contacts app. Confirm the exact number/email with the customer, "
                     f"or save it first with remember_person, before sending.]")
        ok, error = send_imessage(handle, text_to_send)
        if ok:
            return f"Sent to {known_name} ({handle})."
        return f"Failed to send to {known_name} ({handle}): {error or 'unknown error'}"

    if match["builtin"] and tool_name == "shell_exec":
        config = load_config()
        output, error = shell_exec(
            arguments.get("command", ""),
            arguments.get("cwd"),
            arguments.get("confirmed", False),
            config,
        )
        return error if error else output

    if match["builtin"] and tool_name == "set_shell_safety_mode":
        ok, msg = set_shell_safety_mode(arguments.get("mode", ""))
        return msg

    if match["builtin"] and tool_name == "process_email_approvals":
        return process_email_approvals_tool(arguments.get("approve_ids") or [], arguments.get("reject_ids") or [])

    if match["builtin"] and tool_name == "apply_pending_update":
        config = load_config()
        pending = config.get("pending_auto_update")
        if not pending:
            return "[No pending update to respond to -- nothing changed.]"
        # Reached via the LLM tool-call path (e.g. an image message, or
        # phrasing that didn't hit any keyword in match_incoming_reply) --
        # the deterministic pre-check in curant-watcher.py normally beats
        # this to it for plain-text replies. Either way, clear the
        # open_questions row too so it doesn't linger as stale/unresolved.
        approved = bool(arguments.get("approved", False))
        if not approved:
            config.pop("pending_auto_update", None)
            config["auto_update_declined_version"] = pending["version"]
            save_config(config)
            expire_open_questions("auto_update_offer")
            return (f"Okay, skipping version {pending['version']} for now. I won't ask about this "
                    f"specific version again, but let me know if you change your mind or a newer "
                    f"version comes out.")
        _notify_task_starting("installing the update (I'll be back in a moment)")
        success, detail = _download_and_apply_update(pending["download_url"])
        config = load_config()  # reload -- _download_and_apply_update restarts the watcher, which
                                  # doesn't touch config, but reloading fresh here avoids clobbering
                                  # any change written by another process in the meantime
        config.pop("pending_auto_update", None)
        expire_open_questions("auto_update_offer")
        if success:
            config.pop("auto_update_declined_version", None)  # a fresh accepted version supersedes any old decline
            save_config(config)
            if detail == "applied":
                return f"Updated to version {pending['version']} and restarted the background watcher."
            return (f"Updated to version {pending['version']}, but there was a hiccup restarting the "
                    f"background watcher ({detail}). The update itself is real -- run `curant-cli "
                    f"check-update` to confirm -- but if I've gone quiet after this, that's why: run "
                    f"`launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.curant.watcher.plist` "
                    f"by hand to bring it back.")
        save_config(config)
        return (f"Update to version {pending['version']} failed: {detail}. Nothing changed -- still "
                f"running {CURANT_VERSION}. Say the word to try again, or run `curant-cli update` by hand.")

    if match["builtin"] and tool_name == "queue_email_for_approval":
        send_id = queue_pending_email_send(
            match["_iris_server_name"],
            arguments.get("to", ""), arguments.get("subject", ""), arguments.get("body", ""),
            reasoning=arguments.get("reasoning", ""), source_context=arguments.get("source_context", ""),
        )
        return (f"Queued as #{send_id} -- NOT sent. The customer will see this in their next digest "
                f"and has to approve it before it actually sends.")

    if match["builtin"] and tool_name == "set_notification_preferences":
        config = load_config()
        changed = []
        if "daily_briefing" in arguments:
            config["daily_briefing_enabled"] = bool(arguments["daily_briefing"])
            changed.append(f"daily briefing {'on' if config['daily_briefing_enabled'] else 'off'}")
        if "proactive_checkins" in arguments:
            config["proactivity_enabled"] = bool(arguments["proactive_checkins"])
            changed.append(f"proactive check-ins {'on' if config['proactivity_enabled'] else 'off'}")
        if "custom_briefing_time" in arguments:
            raw_time = str(arguments["custom_briefing_time"]).strip()
            if raw_time.lower() == "none":
                config["custom_briefing_time"] = None
                changed.append("custom briefing time removed")
            elif re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", raw_time):
                config["custom_briefing_time"] = raw_time
                changed.append(f"custom briefing time set to {raw_time}")
            else:
                return (f"[Refused: '{raw_time}' isn't a valid 24-hour HH:MM time (e.g. '19:00'). "
                        f"Ask the customer to confirm the time and try again.]")
        if not changed:
            return "[No setting specified — nothing changed.]"
        save_config(config)
        return f"Updated: {', '.join(changed)}."

    if match["builtin"] and tool_name == "set_persona":
        persona = (arguments.get("persona") or "").strip().lower()
        if persona not in PERSONAS:
            return f"[Refused: '{persona}' isn't a valid persona. Available: {', '.join(PERSONAS.keys())}.]"
        config = load_config()
        config["persona"] = persona
        save_config(config)
        return (f"Switched to {persona}. Instructions, memories, and important people all carry over "
                f"unchanged — only the tone/specialization changed.")

    if match["builtin"] and tool_name == "set_spend_cap":
        config = load_config()
        current_spend = get_monthly_estimated_spend()
        if arguments.get("remove_cap"):
            config["monthly_spend_cap_usd"] = None
            save_config(config)
            return "Spend cap removed — generation tools are now uncapped."
        if "amount_usd" in arguments:
            try:
                new_cap = float(arguments["amount_usd"])
                if new_cap < 0:
                    raise ValueError
            except (TypeError, ValueError):
                return f"[Refused: '{arguments.get('amount_usd')}' isn't a valid non-negative dollar amount.]"
            config["monthly_spend_cap_usd"] = new_cap
            save_config(config)
            note = ""
            if current_spend >= new_cap:
                note = " Note: this month's spend already meets or exceeds this cap — generation tools will be blocked until next month or a higher cap."
            return f"Monthly spend cap set to ${new_cap:.2f}. This month's spend so far: ~${current_spend:.2f}.{note}"
        current_cap = get_monthly_spend_cap(config)
        cap_str = "no cap set" if current_cap is None else f"${current_cap:.2f}/month"
        return f"This month's generation spend so far: ~${current_spend:.2f}. Current cap: {cap_str}."

    if match["builtin"] and tool_name == "set_quote_phone":
        config = load_config()
        number = (arguments.get("phone_number") or "").strip()
        if not number:
            current = config.get("quote_phone_number")
            return (f"Current quote phone number: {current}" if current
                    else "No quote phone number set yet — capability-gap replies omit the \"call ___\" line until one is set.")
        config["quote_phone_number"] = number
        save_config(config)
        return f"Quote phone number set to: {number}"

    if match["builtin"] and tool_name == "set_vip_status":
        handle = (arguments.get("handle") or "").strip()
        if not handle:
            return "[No handle provided — nothing was changed.]"
        is_vip = bool(arguments.get("is_vip", True))
        set_vip(handle, is_vip=is_vip)
        return (f"{handle} marked {'VIP' if is_vip else 'not VIP'}."
                + (" Their texts will now reach the customer even in 'approved' access mode." if is_vip else ""))

    if match["builtin"] and tool_name == "manage_auto_reply_contact":
        handle = (arguments.get("handle") or "").strip()
        action = (arguments.get("action") or "").strip().lower()
        if not handle or action not in ("add", "remove"):
            return "[Refused: needs a handle and action ('add' or 'remove').]"
        if action == "add":
            label = (arguments.get("label") or "").strip()
            with closing(get_local_db()) as conn:
                conn.execute(
                    "INSERT INTO auto_reply_contacts (handle, label) VALUES (?, ?) "
                    "ON CONFLICT(handle) DO UPDATE SET label = excluded.label",
                    (handle, label),
                )
                conn.commit()
            return (f"{handle} added as an auto-reply contact{f' ({label})' if label else ''}. Curant may now "
                    f"send routine replies to them directly (never anything urgent or high-stakes) instead of "
                    f"asking the customer first each time — they'll still get an FYI notice after it happens.")
        with closing(get_local_db()) as conn:
            conn.execute("DELETE FROM auto_reply_contacts WHERE handle = ?", (handle,))
            conn.commit()
        return f"{handle} removed from auto-reply contacts — back to drafting suggestions and asking first."

    if match["builtin"] and tool_name == "set_quiet_hours":
        config = load_config()
        if arguments.get("off"):
            config.pop("quiet_hours_start", None)
            config.pop("quiet_hours_end", None)
            save_config(config)
            return "Quiet hours turned off."
        start_str = arguments.get("start_time")
        end_str = arguments.get("end_time")
        if not start_str and not end_str:
            start = config.get("quiet_hours_start")
            end = config.get("quiet_hours_end")
            return f"Quiet hours: {start}-{end}." if start and end else "No quiet hours set."
        start = _parse_hhmm(start_str) if start_str else None
        end = _parse_hhmm(end_str) if end_str else None
        if not start or not end:
            return "[Refused: needs both start_time and end_time as 24-hour 'HH:MM', e.g. '21:00' and '07:00'.]"
        config["quiet_hours_start"] = start_str
        config["quiet_hours_end"] = end_str
        save_config(config)
        return f"Quiet hours set: {start_str}-{end_str}. Daily briefing and weekly rollup will skip sending during this window."

    if match["builtin"] and tool_name == "set_travel_mode":
        config = load_config()
        if arguments.get("off"):
            config.pop("travel_timezone", None)
            save_config(config)
            return "Travel mode turned off — back to this Mac's local timezone."
        tz_str = (arguments.get("timezone") or "").strip()
        if not tz_str:
            current = config.get("travel_timezone")
            return f"Travel timezone: {current or 'not set (using this Mac' + chr(39) + 's local timezone)'}."
        try:
            from zoneinfo import ZoneInfo
            ZoneInfo(tz_str)
        except Exception:
            return f"[Refused: '{tz_str}' isn't a recognized IANA timezone, e.g. 'Asia/Tokyo' or 'Europe/London'.]"
        config["travel_timezone"] = tz_str
        save_config(config)
        return f"Travel timezone set to {tz_str}. Quiet hours now compare against this timezone."

    if match["builtin"] and tool_name == "set_elevenlabs_voice":
        voice_id = (arguments.get("voice_id") or "").strip()
        if not voice_id:
            return "[No voice_id provided — nothing was changed.]"
        config = load_config()
        config["elevenlabs_voice_id"] = voice_id
        save_config(config)
        return (f"Voice set to {voice_id}. This applies to the customer's own ElevenLabs account/key — "
                f"it must actually exist there (a cloned voice or one of ElevenLabs' own presets).")

    if match["builtin"] and tool_name in (
        "generate_image", "generate_image_with_text", "generate_voice", "edit_media"
    ):
        config = load_config()
        service_map = {
            "generate_image": "flux", "generate_image_with_text": "ideogram",
            "generate_voice": "elevenlabs", "edit_media": "descript",
        }
        service = service_map[tool_name]

        # ElevenLabs is billed per-character, not a flat per-call rate —
        # compute the real estimated cost from the actual text length so
        # both the cap check and the logged spend reflect a long
        # narration costing more than a short one, instead of every
        # voice generation counting the same regardless of length.
        cost_override = None
        if tool_name == "generate_voice":
            text_len = len(arguments.get("text", ""))
            cost_override = (text_len / 1000.0) * ESTIMATED_COST_USD.get("elevenlabs", 0.0)

        # FLUX and Ideogram are covered by the business for customers on an
        # August tier (august_standard/pro/max) -- those calls go through
        # Curant's own server, which holds the real keys and enforces its
        # own per-tier monthly budget server-side. Everyone else (no
        # August tier unlocked) falls back to their own BYOK key and the
        # local per-customer spend cap, same as before. Voice
        # (ElevenLabs, pure BYOK) and edit_media are unaffected either way.
        august_tier = None
        if tool_name in ("generate_image", "generate_image_with_text"):
            august_tier = get_customer_august_tier(config)

        if august_tier:
            if tool_name == "generate_image":
                path, error = generate_image_flux_server(arguments.get("prompt", ""), config)
            else:
                path, error = generate_image_ideogram_server(arguments.get("prompt", ""), config)
            if error:
                return f"[{tool_name} failed: {error}]"
            _last_generated_files.append(path)
            # Cost is already checked-and-logged (or refunded on failure)
            # server-side against the tier's own budget -- nothing to log
            # locally here, and the local $4 cap doesn't apply to a
            # generation the business is covering.
            return f"Generated successfully, saved at {path}."

        ok, cap_message = check_spend_cap(config, service, cost_override=cost_override)
        if not ok:
            return cap_message

        if tool_name == "generate_image":
            path, error = generate_image_flux(arguments.get("prompt", ""), config)
        elif tool_name == "generate_image_with_text":
            path, error = generate_image_ideogram(arguments.get("prompt", ""), config)
        elif tool_name == "generate_voice":
            path, error = generate_voice_elevenlabs(arguments.get("text", ""), config)
        else:
            path, error = edit_media_descript(arguments.get("instructions", ""), config)

        if error:
            return f"[{tool_name} failed: {error}]"
        _last_generated_files.append(path)
        # Only log a cost for a generation that actually happened — the
        # Descript stub always returns an error above and never reaches
        # here, so no spend gets recorded for something that didn't run.
        log_generation_cost(service, cost_override=cost_override)
        balance_line = format_remaining_generation_balance(config)
        balance_suffix = f" ({balance_line})" if balance_line else ""
        return f"Generated successfully, saved at {path}.{balance_suffix}"

    if match["builtin"] and tool_name == "generate_video":
        # Runs in a detached background process instead of blocking this
        # whole relay() call (and the watcher) for several minutes — see
        # generate_video_veo_async's docstring. Cost is logged once the
        # background job actually completes (run_background_job_cmd),
        # not here, since nothing has happened yet at this point.
        #
        # The cap check happens BEFORE the job starts, not after it
        # completes — Veo is the most expensive single generation
        # (~$3.20), and checking only post-completion would let several
        # video jobs get kicked off in flight before any of them
        # actually counted against the cap.
        config = load_config()
        ok, cap_message = check_spend_cap(config, "veo")
        if not ok:
            return cap_message
        return generate_video_veo_async(arguments.get("prompt", ""), config, _current_apple_id)

    if match["builtin"] and tool_name == "get_spending_summary":
        summary = get_generation_cost_summary()
        total = get_total_estimated_spend()
        config = load_config()
        monthly_spend = get_monthly_estimated_spend()
        balance_line = format_remaining_generation_balance(config)
        cap_line = balance_line or "No monthly cap set."
        if not summary:
            return f"No generation spend yet this account. {cap_line}"
        lines = [f"{row['service']}: {row['count']} generation(s), ~${row['total']:.2f}" for row in summary]
        return (f"Estimated spend so far: ~${total:.2f} total (~${monthly_spend:.2f} this month). {cap_line}\n"
                + "\n".join(lines) +
                "\n(These are estimates for a general sense of spend, not exact billing — check your own account with each provider for the real number.)")

    if match["builtin"] and tool_name == "browse_page":
        result, error = browse_page(arguments.get("url", ""))
        if error:
            return f"[browse_page failed: {error}]"
        fields_summary = "\n".join(
            f"  - {f['name']} ({f['type']}){': ' + f['label'] if f['label'] else ''}"
            for f in result["fields"]
        ) or "  (no fillable fields found)"
        return f"Page content:\n{result['text']}\n\nFillable fields:\n{fields_summary}"

    if match["builtin"] and tool_name == "click_page_element":
        result, error = click_page_element(arguments.get("url", ""), arguments.get("selector", ""))
        if error:
            return f"[click_page_element failed: {error}]"
        warning = f"\n\n(Note: {result['warning']})" if result.get("warning") else ""
        return f"Page content after clicking:\n{result['text']}{warning}"

    if match["builtin"] and tool_name == "fill_and_submit_form":
        # Routed through the hybrid wrapper, not called directly — see
        # fill_and_submit_form_hybrid's docstring for why that matters
        # (guarantees the form only ever gets submitted once).
        return fill_and_submit_form_hybrid(
            arguments.get("url", ""), arguments.get("field_values", {}),
            arguments.get("submit_selector", ""), _current_apple_id,
            confirmed=arguments.get("confirmed", False),
        )

    if match["builtin"] and tool_name == "setup_grading_assignment":
        create_or_update_grading_assignment(
            arguments.get("assignment_name", ""), arguments.get("assignment_prompt", ""),
            arguments.get("rubric_text", ""),
        )
        return f"Assignment '{arguments.get('assignment_name', '')}' set up. Ready for calibration examples."

    if match["builtin"] and tool_name == "add_grading_example":
        success, msg = add_grading_example(
            arguments.get("assignment_name", ""), arguments.get("submission_text", ""),
            arguments.get("grade_given", ""), arguments.get("feedback_given", ""),
        )
        return msg

    if match["builtin"] and tool_name == "suggest_grade":
        # This tool doesn't itself call the model again — it assembles
        # the calibration context and hands it back so the model (already
        # mid-conversation, already has the rubric/examples/corrections
        # in front of it via this result) produces the actual suggestion
        # itself in its next turn, rather than a second, separate LLM call.
        assignment_name = arguments.get("assignment_name", "")
        context = build_grading_calibration_context(assignment_name)
        if context is None:
            return f"[No assignment called '{assignment_name}' — set it up first with setup_grading_assignment.]"
        return (f"Calibration context for grading this submission:\n\n{context}\n\n"
                f"New submission to grade:\n{arguments.get('submission_text', '')}\n\n"
                f"Suggest a grade and rubric-mapped feedback based on the above — present it "
                f"as a draft for the teacher to review, not a final grade.")

    if match["builtin"] and tool_name == "record_grade_correction":
        success, msg = record_grading_correction(
            arguments.get("assignment_name", ""), arguments.get("submission_text", ""),
            arguments.get("suggested_grade", ""), arguments.get("corrected_grade", ""),
            arguments.get("corrected_feedback", ""),
        )
        return msg

    if match["builtin"] and tool_name == "list_grading_assignments":
        assignments = list_grading_assignments()
        if not assignments:
            return "No assignments set up yet."
        return "\n".join(f"{a['assignment_name']} — {a['example_count']} example(s)" for a in assignments)

    return call_mcp_tool(match["server_command"], match["raw_name"], arguments)


_PROVIDER_CALLERS = {
    "anthropic": _call_anthropic,
    "openai": _call_openai,
    "gemini": _call_gemini,
}


class AllModelsExhaustedError(Exception):
    """Raised when every model in a provider's fallback chain hit a
    rate/quota limit for the requested tier. Deliberately a distinct
    exception from a generic call failure -- relay() needs to tell "you
    are genuinely out of free-tier quota everywhere right now" apart
    from "the network/API is down," because those two situations
    warrant different replies: a connectivity problem falls through to
    generate_offline_reply() (a local model standing in), but that would
    be misleading here -- quota exhaustion isn't fixed by anything local,
    and silently answering with a degraded offline reply would hide that
    the real answer is "wait for quota to reset or add a paid tier."
    See _is_quota_error() and _model_fallback_chain()."""


def _is_quota_error(e):
    """Detects RESOURCE_EXHAUSTED / 429 rate-limit errors across every
    SDK this file calls through (the OpenAI SDK, used directly for
    OpenAI and via Gemini's OpenAI-compat endpoint, and the native
    google-genai client used for Gemini tool calls) without needing a
    separate isinstance() check per SDK's own exception class --
    confirmed live that all of them put a recognizable marker in the
    string form of the exception (e.g. "Error code: 429 ...
    RESOURCE_EXHAUSTED ... quota")."""
    msg = str(e).lower()
    return ("429" in msg or "resource_exhausted" in msg or "resource exhausted" in msg
            or "rate limit" in msg or "quota" in msg)


def _is_transient_server_error(e):
    """Real bug found live (2026-08-18): a customer's text got a live
    503 'high demand, try again later' from Gemini and got NOTHING back
    -- not even an error message, total silence. Root cause:
    _is_quota_error only recognizes 429/RESOURCE_EXHAUSTED/rate-limit/
    quota text, so a 503 fell through as a 'non-quota error' and
    call_llm/call_llm_with_tools raised it immediately instead of
    trying the next model in the fallback chain, same as this file's
    generic-failure path (bad key, network down) -- but a 503 'try
    again' is a TRANSIENT server-side overload, not a permanent
    failure, and is if anything MORE naturally suited to falling
    through to another model than a quota error is (a different model
    is a different service instance, not just a different quota
    bucket). It then hit relay()'s offline fallback, which returned
    None (no local Ollama model available on this Mac) -- silent
    failure, no reply, no error text either.

    Deliberately broad-but-safe pattern matching across providers'
    actual error text (confirmed live for Gemini's '503 UNAVAILABLE...
    high demand'; OpenAI and Anthropic use their own overload-style
    codes/wording -- 503/'server_error' for OpenAI, 529/'overloaded'
    for Anthropic -- included here even though not yet independently
    confirmed live against those two, same as how Gemini's chain
    started from real observed errors and grew from there). None of
    these patterns overlap with a genuine non-retryable failure like a
    bad API key ('401'/'invalid api key'/'authentication') or a
    malformed request ('400'), so this can't accidentally mask a real
    permanent problem as something worth retrying."""
    msg = str(e).lower()
    return ("503" in msg or "529" in msg or "unavailable" in msg or "overloaded" in msg
            or "server_error" in msg or "high demand" in msg or "internal server error" in msg
            or "service unavailable" in msg)


def _is_retryable_llm_error(e):
    """Union of both known-transient error categories -- what
    call_llm/call_llm_with_tools should actually check before giving up
    on a model and trying the next one in the fallback chain. See
    _is_quota_error and _is_transient_server_error's docstrings for the
    two categories this covers."""
    return _is_quota_error(e) or _is_transient_server_error(e)


def _model_fallback_chain(provider, tier):
    """Ordered list of models to try for one call.

    Looks up MODEL_CHAINS_BY_PROVIDER[provider][tier] uniformly for all
    three providers now (previously only Gemini had a real chain here;
    Anthropic/OpenAI fell back to a generic "requested tier, then every
    other tier" shuffle -- see ANTHROPIC_MODEL_CHAINS/OPENAI_MODEL_CHAINS
    above for why their chains are intentionally shallower than
    Gemini's). Falls back to the old generic behavior only if a provider
    somehow isn't in MODEL_CHAINS_BY_PROVIDER at all (shouldn't happen
    for any currently-supported provider, but fails safe rather than
    raising a KeyError mid-relay if one is ever added to PROVIDER_MODELS
    without a matching chain entry).

    Real basis for why this helps at all, not just theoretical: live
    testing on 2026-08-08 hit RESOURCE_EXHAUSTED on gemini-3.5-flash (the
    "main" model) while gemini-3.5-flash-lite ("fast", same API key, same
    day) was still serving requests fine -- different models draw from
    separate free-tier quota buckets, so falling through to another
    model is a real way to keep answering, not a no-op. Confirmed again
    live on 2026-08-13 when gemini-3.5-flash AND gemini-3.5-flash-lite
    both hit their daily caps simultaneously -- the two-model chain
    wasn't deep enough that time, hence the move to the longer
    GEMINI_MODEL_CHAINS list."""
    if provider in MODEL_CHAINS_BY_PROVIDER:
        return list(MODEL_CHAINS_BY_PROVIDER[provider][tier])
    models = PROVIDER_MODELS[provider]
    chain = [models[tier]]
    for other_tier, other_model in models.items():
        if other_tier != tier and other_model not in chain:
            chain.append(other_model)
    return chain


def call_llm(provider, api_key, system_prompt, messages, max_tokens=1000, tier="main"):
    """
    The single choke point every LLM call in this file goes through.
    `messages` uses the common {"role": "user"/"assistant", "content": str}
    shape both providers already accept directly for user/assistant turns
    — only the system prompt needs provider-specific handling, done
    inside each _call_* function.

    On a rate/quota error (RESOURCE_EXHAUSTED / 429), retries against
    the next model in this provider's fallback chain instead of failing
    the whole message outright -- see _model_fallback_chain(). A
    non-quota error (bad key, network failure, etc.) is NOT retried
    here; it propagates immediately to relay()'s existing offline-
    fallback handling, same as before this change. Only once every
    model in the chain has been tried and every single one hit a quota
    error does this raise AllModelsExhaustedError.
    """
    caller = _PROVIDER_CALLERS.get(provider)
    if caller is None:
        raise ValueError(f"Unknown provider: {provider}")
    chain = _model_fallback_chain(provider, tier)
    last_err = None
    for i, model in enumerate(chain):
        try:
            return caller(api_key, system_prompt, messages, max_tokens, model)
        except Exception as e:
            if not _is_retryable_llm_error(e):
                raise
            last_err = e
            more = f"trying next model ({chain[i + 1]})" if i + 1 < len(chain) else "no more models left to try"
            reason = "rate/quota limit" if _is_quota_error(e) else "transient server error"
            print(f"[retry] {provider}/{model} hit a {reason} ({e}) -- {more}.", file=sys.stderr)
    raise AllModelsExhaustedError(
        f"Every model in {provider}'s fallback chain for tier={tier} ({chain}) hit a rate/quota "
        f"limit or transient server error. Last error: {last_err}"
    )


MAX_TOOL_CALL_ITERATIONS = 5  # a hard ceiling so a confused model calling
                               # tools in a loop can't run indefinitely —
                               # after this many rounds, return whatever
                               # explanation we can rather than hang


def _call_anthropic_with_tools(api_key, system_prompt, messages, max_tokens, model, tools, available_tools):
    import anthropic
    client = anthropic.Anthropic(api_key=api_key)
    anthropic_tools = [
        {"name": t["qualified_name"], "description": t["description"],
         "input_schema": _strip_vendor_extension_keys(t["input_schema"]) or {"type": "object", "properties": {}}}
        for t in tools
    ]
    conversation = list(messages)
    for _ in range(MAX_TOOL_CALL_ITERATIONS):
        response = client.messages.create(
            model=model, max_tokens=max_tokens, system=system_prompt,
            messages=conversation, tools=anthropic_tools,
        )
        tool_uses = [b for b in response.content if getattr(b, "type", None) == "tool_use"]
        if not tool_uses:
            text_blocks = [b.text for b in response.content if getattr(b, "type", None) == "text"]
            return "\n".join(text_blocks).strip()

        conversation.append({"role": "assistant", "content": response.content})
        tool_results = []
        for tu in tool_uses:
            result_text = execute_tool_call(tu.name, tu.input, available_tools)
            tool_results.append({"type": "tool_result", "tool_use_id": tu.id, "content": result_text})
        conversation.append({"role": "user", "content": tool_results})

    return "(I tried a few tool calls but couldn't reach a final answer — something may need a closer look.)"


def _call_openai_with_tools(api_key, system_prompt, messages, max_tokens, model, tools, available_tools):
    from openai import OpenAI
    client = OpenAI(api_key=api_key)
    openai_tools = [
        {"type": "function", "function": {
            "name": t["qualified_name"], "description": t["description"],
            "parameters": _strip_vendor_extension_keys(t["input_schema"]) or {"type": "object", "properties": {}},
        }}
        for t in tools
    ]
    conversation = [{"role": "system", "content": system_prompt}] + list(messages)
    for _ in range(MAX_TOOL_CALL_ITERATIONS):
        response = client.chat.completions.create(
            model=model, max_tokens=max_tokens, messages=conversation, tools=openai_tools,
        )
        msg = response.choices[0].message
        if not msg.tool_calls:
            return msg.content or ""

        conversation.append({
            "role": "assistant",
            "content": msg.content,
            "tool_calls": [
                {"id": tc.id, "type": "function",
                 "function": {"name": tc.function.name, "arguments": tc.function.arguments}}
                for tc in msg.tool_calls
            ],
        })
        for tc in msg.tool_calls:
            try:
                args = json.loads(tc.function.arguments or "{}")
            except json.JSONDecodeError:
                args = {}
            result_text = execute_tool_call(tc.function.name, args, available_tools)
            conversation.append({"role": "tool", "tool_call_id": tc.id, "content": result_text})

    return "(I tried a few tool calls but couldn't reach a final answer — something may need a closer look.)"


def _strip_vendor_extension_keys(schema):
    """
    Recursively strips vendor-extension keys (anything starting with 'x-')
    from a JSON Schema. This is the light-touch sanitizer used for the
    Anthropic and OpenAI paths, which otherwise accept standard JSON Schema
    as-is and pass it through to their APIs as opaque JSON.

    Real bug this fixes: some MCP servers embed non-standard keys like
    'x-mcp-header' on a property to mark it as an HTTP header rather than
    part of the request body -- a legitimate MCP convention, but not
    something every provider tolerates. Cheap to strip, and it's never
    meaningful to the model, so we drop it everywhere rather than only
    where it's been confirmed to break.
    """
    if isinstance(schema, dict):
        out = {}
        for k, v in schema.items():
            if k.startswith("x-"):
                continue
            if k == "properties" and isinstance(v, dict):
                # `properties` is a name->schema MAP -- its keys are user-chosen
                # field names, so a param legitimately named "x-foo" must not be
                # mistaken for a vendor-extension key and dropped.
                out[k] = {pk: _strip_vendor_extension_keys(pv) for pk, pv in v.items()}
            else:
                out[k] = _strip_vendor_extension_keys(v)
        return out
    if isinstance(schema, list):
        return [_strip_vendor_extension_keys(v) for v in schema]
    return schema


# The complete set of fields Gemini's Schema proto actually has, in both the
# camelCase (JSON Schema) and snake_case (python SDK) spellings the google-genai
# client accepts. Anything outside this set is rejected -- sometimes client-side
# by pydantic, sometimes only by the API with a 400 "Cannot find field" -- so
# the Gemini path allowlists rather than blacklisting. See
# _sanitize_schema_for_gemini for why.
_GEMINI_SCHEMA_FIELDS = {
    "type", "format", "title", "description", "nullable", "default", "example",
    "enum", "properties", "required", "items", "anyOf", "any_of",
    "propertyOrdering", "property_ordering",
    "minimum", "maximum", "pattern",
    "minItems", "min_items", "maxItems", "max_items",
    "minLength", "min_length", "maxLength", "max_length",
    "minProperties", "min_properties", "maxProperties", "max_properties",
}


def _sanitize_schema_for_gemini(schema, _defs=None):
    """
    Reshapes a JSON Schema into the narrower dialect Gemini accepts.

    Gemini's Schema type is proto-backed with a fixed, closed field set --
    unlike Anthropic/OpenAI, which pass schema dicts through as opaque JSON,
    ANY shape Gemini doesn't recognize crashes the ENTIRE reply (not just
    calls to the one offending tool), for every tool in the list, as soon as
    one MCP server's tools are included. Worse, the rejection happens at two
    different layers: some bad shapes are caught client-side by the SDK's
    strict pydantic models, others sail through the client and are only
    rejected by the API with a 400 INVALID_ARGUMENT / "Cannot find field".

    We hit three of these in a row in live testing (x-mcp-header from the
    github server; non-string enum entries and JSON Schema union types from
    an issue-tracker server; then additionalProperties from another), each
    one a separate outage-per-customer. Rather than keep blacklisting the
    next unsupported keyword one incident at a time, this allowlists the
    fields Gemini's proto actually defines (_GEMINI_SCHEMA_FIELDS) and drops
    everything else. Standard-but-unsupported JSON Schema keywords
    (additionalProperties, allOf, oneOf, not, const, multipleOf,
    exclusiveMinimum/Maximum, patternProperties, $schema, ...) are all
    dropped as constraints -- the model loses a little validation detail it
    was never strictly bound by anyway, which is a far better failure mode
    than every reply erroring out.

    Beyond the allowlist, three shapes need active conversion rather than
    dropping:
      1. `enum` entries must be strings even when the field's declared type
         is boolean/number -- coerced via str()/json.dumps().
      2. `type` must be a single value, not a JSON Schema union list --
         collapsed to the first non-"null" member, with a "null" member
         translated into Gemini's own `nullable: true` rather than lost.
      3. `$ref`/`$defs` (emitted routinely by any MCP server that builds
         schemas from pydantic/zod models) aren't supported, but silently
         dropping a `$ref` would leave a meaningless empty schema -- so
         refs into the local `$defs`/`definitions` table are inlined
         instead. Recursive/self-referential models can't be inlined
         finitely; those degrade to a bare {"type": "object"} rather than
         recursing forever.
    """
    if _defs is None:
        _defs = {}

    if isinstance(schema, dict):
        # Collect any definition tables on the way down so nested $refs can
        # still resolve after the table itself is dropped by the allowlist.
        merged_defs = _defs
        local_defs = {**schema.get("$defs", {}), **schema.get("definitions", {})}
        if local_defs:
            merged_defs = {**_defs, **local_defs}

        ref = schema.get("$ref")
        if isinstance(ref, str):
            # Only local refs ("#/$defs/Foo", "#/definitions/Foo") are
            # resolvable; anything remote we can't fetch, so fall back to a
            # permissive object.
            name = ref.rsplit("/", 1)[-1] if ref.startswith("#/") else None
            target = merged_defs.get(name) if name else None
            if target is None:
                return {"type": "object"}
            # Drop this ref's own name from the table before recursing, so a
            # self-referential model terminates instead of looping forever.
            remaining = {k: v for k, v in merged_defs.items() if k != name}
            resolved = _sanitize_schema_for_gemini(target, remaining)
            # Sibling keys alongside $ref (description, etc.) still apply.
            siblings = {k: v for k, v in schema.items() if k not in ("$ref", "$defs", "definitions")}
            if siblings:
                resolved = {**resolved, **_sanitize_schema_for_gemini(siblings, merged_defs)}
            return resolved

        cleaned = {}
        for k, v in schema.items():
            if k not in _GEMINI_SCHEMA_FIELDS:
                continue
            if k == "properties" and isinstance(v, dict):
                # `properties` is a name->schema MAP, not a schema: its keys are
                # user-chosen field names (a param legitimately named "owner" or
                # "default" must survive), so recurse into the values only and
                # never filter the keys against the allowlist.
                cleaned[k] = {pk: _sanitize_schema_for_gemini(pv, merged_defs) for pk, pv in v.items()}
            elif k in ("required", "enum", "propertyOrdering", "property_ordering"):
                # Lists of plain strings/values, not nested schemas -- leave the
                # contents alone here (enum gets its own coercion pass below).
                cleaned[k] = v
            else:
                cleaned[k] = _sanitize_schema_for_gemini(v, merged_defs)

        if isinstance(cleaned.get("enum"), list):
            cleaned["enum"] = [
                v if isinstance(v, str)
                else json.dumps(v) if isinstance(v, (dict, list))
                else str(v)
                for v in cleaned["enum"]
            ]

        if isinstance(cleaned.get("type"), list):
            types = cleaned["type"]
            remaining_types = [t for t in types if t != "null"]
            cleaned["type"] = remaining_types[0] if remaining_types else "string"
            if "null" in types:
                cleaned["nullable"] = True

        return cleaned

    if isinstance(schema, list):
        return [_sanitize_schema_for_gemini(v, _defs) for v in schema]
    return schema


def _call_gemini_with_tools(api_key, system_prompt, messages, max_tokens, model, tools, available_tools):
    """
    Gemini 3 models require a 'thought_signature' to be echoed back on every
    function-call turn of a multi-turn tool-calling conversation — Google's
    own OpenAI-compat endpoint does not surface that field through the
    OpenAI SDK's typed response objects, so round-tripping tool calls through
    _call_openai_with_tools's dict-based conversation history causes every
    second turn to fail with 400 'Function call is missing a thought_signature'
    (confirmed live, and matches widely-reported issues in other OpenAI-compat
    clients hitting Gemini 3 — this is not fixable by adjusting request
    parameters, and thinking cannot be disabled for Gemini 3 models to avoid
    it). google-genai (the native SDK, already a dependency for Veo) doesn't
    have this problem: appending the SDK's own returned `content` object back
    into history verbatim (rather than re-serializing through OpenAI's
    tool_calls dict shape) keeps the thought signature intact, because it's
    never parsed out or reconstructed.
    """
    from google import genai
    from google.genai import types as genai_types

    client = genai.Client(api_key=api_key)
    gemini_tools = [genai_types.Tool(function_declarations=[
        genai_types.FunctionDeclaration(
            name=t["qualified_name"],
            description=t["description"],
            parameters=_sanitize_schema_for_gemini(t["input_schema"]) or {"type": "object", "properties": {}},
        )
        for t in tools
    ])]
    # Translate the common {"role": "user"/"assistant", "content": str} history
    # into genai Content objects. Gemini uses "model" where the rest of this
    # file says "assistant".
    conversation = [
        genai_types.Content(
            role=("model" if m["role"] == "assistant" else "user"),
            parts=[genai_types.Part.from_text(text=m["content"])],
        )
        for m in messages
    ]
    config = genai_types.GenerateContentConfig(
        system_instruction=system_prompt, max_output_tokens=max_tokens, tools=gemini_tools,
    )

    for _ in range(MAX_TOOL_CALL_ITERATIONS):
        response = client.models.generate_content(model=model, contents=conversation, config=config)
        candidate_content = response.candidates[0].content
        function_calls = [p.function_call for p in (candidate_content.parts or []) if p.function_call]

        if not function_calls:
            return response.text or ""

        # Append the model's OWN returned Content object unmodified — this is
        # what preserves its thought_signature, rather than reconstructing an
        # equivalent-looking turn ourselves.
        conversation.append(candidate_content)

        response_parts = []
        for fc in function_calls:
            try:
                result_text = execute_tool_call(fc.name, dict(fc.args or {}), available_tools)
            except Exception as e:
                result_text = f"Tool call failed: {e}"
            response_parts.append(genai_types.Part.from_function_response(
                name=fc.name, response={"result": result_text},
            ))
        conversation.append(genai_types.Content(role="user", parts=response_parts))

    return "(I tried a few tool calls but couldn't reach a final answer — something may need a closer look.)"


_PROVIDER_TOOL_CALLERS = {
    "anthropic": _call_anthropic_with_tools,
    "openai": _call_openai_with_tools,
    "gemini": _call_gemini_with_tools,
}


def call_llm_with_tools(provider, api_key, system_prompt, messages, tools, available_tools, max_tokens=1000, tier="main"):
    """
    Same idea as call_llm(), but runs the full tool-call loop: the model
    can request a tool (an MCP server's, or the built-in
    log_capability_gap), gets the result fed back, and keeps going
    until it has a final text answer or MAX_TOOL_CALL_ITERATIONS is hit.
    `tools` is the schema list for the API call; `available_tools` is the
    same list with routing info (server command, etc.) execute_tool_call
    needs to actually run one.

    Same model-fallback-then-AllModelsExhaustedError behavior as
    call_llm() -- see its docstring and _model_fallback_chain(). Applied
    here too because this is the path actually taken on almost every
    real message: log_capability_gap is always in available_tools, so
    plain call_llm() (no tools) is the less common case in practice.
    """
    caller = _PROVIDER_TOOL_CALLERS.get(provider)
    if caller is None:
        raise ValueError(f"Unknown provider: {provider}")
    chain = _model_fallback_chain(provider, tier)
    last_err = None
    for i, model in enumerate(chain):
        try:
            return caller(api_key, system_prompt, messages, max_tokens, model, tools, available_tools)
        except Exception as e:
            if not _is_retryable_llm_error(e):
                raise
            last_err = e
            more = f"trying next model ({chain[i + 1]})" if i + 1 < len(chain) else "no more models left to try"
            reason = "rate/quota limit" if _is_quota_error(e) else "transient server error"
            print(f"[retry] {provider}/{model} hit a {reason} ({e}) -- {more}.", file=sys.stderr)
    raise AllModelsExhaustedError(
        f"Every model in {provider}'s fallback chain for tier={tier} ({chain}) hit a rate/quota "
        f"limit or transient server error. Last error: {last_err}"
    )


def update_memories_from_exchange(provider, api_key, existing_memories, user_message, reply_text):
    """Best-effort local memory extraction using a fast/cheap model, via
    whichever provider is currently configured. Any failure here is
    swallowed — memory is a nice-to-have, never allowed to break the
    core message flow."""
    try:
        existing_str = "\n".join(f"- {m}" for m in existing_memories) if existing_memories else "(none yet)"
        raw = call_llm(
            provider, api_key,
            system_prompt=MEMORY_EXTRACTION_PROMPT,
            messages=[{
                "role": "user",
                "content": (
                    f"Existing memories:\n{existing_str}\n\n"
                    f"Latest exchange:\nPerson: {user_message}\nAssistant: {reply_text}"
                ),
            }],
            max_tokens=400, tier="fast",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        parsed = json.loads(raw)
        for item in parsed.get("remove", []):
            delete_memory_by_content(item)
        for item in parsed.get("add", []):
            # This exact-string check is a narrow safety net, NOT the
            # real dedup mechanism — genuine near-duplicate detection
            # ("has a presentation Tuesday" vs. "has a big presentation
            # this Tuesday") needs semantic judgment a plain string
            # comparison can't do, so that's handled by the model itself
            # via MEMORY_EXTRACTION_PROMPT's explicit dedup instructions
            # (it's told to pair a rephrased fact's "remove" of the old
            # text with an "add" of the new one). This check only
            # catches the trivial case where the model returns something
            # already stored verbatim — cheap, harmless, worth keeping,
            # just not sufficient on its own.
            if item and item not in existing_memories:
                save_memory(item)
    except Exception as e:
        print(f"Memory extraction skipped (non-fatal): {e}", file=sys.stderr)


# --- Multi-provider routing ---
# Lets a message get answered by whichever configured provider actually
# suits it, instead of always going to whatever's set as "the" provider.
# Three ways this can be decided, checked in this order:
#   1. The message itself explicitly asks for a specific provider
#      ("use GPT for this one", "ask Claude instead") — a one-off,
#      applies to this message only.
#   2. A standing rule the customer has set previously applies to this
#      message's task category (routing_rules table).
#   3. Neither of the above — fall back to a judgment call about which
#      configured provider is generally better suited to this kind of
#      task. This is a real judgment call based on general knowledge of
#      each model family's relative strengths, not a verified benchmark
#      — treated and communicated as such, never asserted as fact.
# Also detects when the message itself is STATING a new standing rule
# ("from now on, use GPT for anything about code") and saves it — this
# reuses the one extra call rather than needing a second one.
#
# Deliberately skipped entirely when fewer than 2 providers have a key
# configured — there's nothing to route between, so this doesn't add
# cost/latency to the common single-provider case.

ROUTING_DECISION_PROMPT = """You help decide which AI model provider should \
handle an incoming message, when more than one is available.

You'll be given: the message itself, the list of currently available \
providers, and any standing routing rules the person has already set \
(e.g. "coding -> openai" means they've said to use OpenAI for coding tasks).

Decide, in this priority order:
1. Does the message ITSELF explicitly ask for a specific provider for just \
this one message (e.g. "use GPT for this", "ask Claude instead", "let \
ChatGPT handle this one")? If so, that's a one-off override — use it, and \
do not save it as a standing rule.
2. Does the message state a NEW standing preference going forward (e.g. \
"from now on use GPT for anything about code", "always use Claude for \
writing")? If so, extract it as {"category": "...", "provider": "..."} — \
category should be a short, general, reusable label (e.g. "coding", \
"creative writing", "research"), not a one-off restatement of this \
specific message.
3. Does an existing standing rule's category clearly apply to this \
message's task? If so, use that rule's provider.
4. Otherwise, pick whichever available provider is generally better \
suited to this kind of task, based on your own general knowledge of each \
model family's relative strengths. This is a judgment call, not a \
certainty — when it's genuinely unclear or the task doesn't favor either \
provider, just pick the person's default provider rather than guessing.

Respond with ONLY a JSON object, no other text:
{"provider": "<one of the available providers>", "reason": "<one short \
plain-language sentence, e.g. 'GPT tends to be strong at code' or \
'you asked for Claude specifically'>", "new_rule": {"category": "...", \
"provider": "..."} or null}"""


def decide_provider(message_text, config, default_provider, eligible_providers):
    """
    Returns (provider, reason, new_rule_saved: bool). Never raises — any
    failure here falls back to the default provider silently, since a
    broken routing decision should never be the reason a message doesn't
    get answered.
    """
    if len(eligible_providers) < 2:
        return default_provider, None, False

    rules = get_routing_rules()
    rules_str = "\n".join(f"- {r['category']} -> {r['provider']}" for r in rules) if rules else "(none set yet)"

    try:
        api_key = get_api_key(config, default_provider)
        raw = call_llm(
            default_provider, api_key,
            system_prompt=ROUTING_DECISION_PROMPT,
            messages=[{
                "role": "user",
                "content": (
                    f"Message: {message_text}\n\n"
                    f"Available providers: {', '.join(eligible_providers)}\n"
                    f"Person's default provider: {default_provider}\n\n"
                    f"Existing standing rules:\n{rules_str}"
                ),
            }],
            max_tokens=200, tier="fast",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        decision = json.loads(raw)
        provider = decision.get("provider")
        if provider not in eligible_providers:
            return default_provider, None, False

        new_rule_saved = False
        new_rule = decision.get("new_rule")
        if new_rule and new_rule.get("category") and new_rule.get("provider") in eligible_providers:
            save_routing_rule(new_rule["category"], new_rule["provider"])
            new_rule_saved = True

        return provider, decision.get("reason"), new_rule_saved
    except Exception as e:
        print(f"Routing decision skipped, using default provider (non-fatal): {e}", file=sys.stderr)
        return default_provider, None, False




def request_with_retries(req, timeout, max_attempts=3):
    """
    A dropped wifi connection on the Mac Mini shouldn't silently fail a
    status check. Retries transient failures with short exponential
    backoff. Does NOT retry 4xx — an invalid/expired license needs the
    customer to act, not more attempts.
    """
    last_error = None
    for attempt in range(max_attempts):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read())
        except urllib.error.HTTPError as e:
            if 400 <= e.code < 500:
                raise
            last_error = e
        except Exception as e:
            last_error = e
        if attempt < max_attempts - 1:
            time.sleep(2 ** attempt)
    raise last_error


# Bumped whenever Curant_ToS_Privacy_Draft.md changes in a way that
# materially affects what's disclosed (e.g. the Grace conversation-
# retention window fix). Anyone who already agreed to an older version
# is asked again once, not silently carried forward -- consent to a
# document is consent to what it actually says, not to whatever it
# later becomes.
PRIVACY_ACK_VERSION = "2026-08-16"

PRIVACY_ACK_SUMMARY = """
Before continuing, here's the short version of what Curant does with
your data (full draft: Curant_ToS_Privacy_Draft.md in the repo -- this
is a plain-language summary of it, not a separate or looser policy):

  - Your persona, instructions, memory, and recent conversation history
    live on this Mac only. They are never sent to Curant's servers.
  - Your AI provider API key is stored locally and used to call your
    provider directly from this machine -- never seen by Curant.
  - Curant's servers only ever see: your license key, plan/add-ons,
    which Mac your license is bound to, a running count of how many
    messages you've exchanged (not their content), and generic error
    codes if something breaks.
  - This account is for one person's own use, not a shared or team tool,
    and you must be 18 or older to use it.
  - This is beta software, provided as-is -- expect rough edges, and
    the underlying draft policy is still pending a real attorney review
    before any paid, public launch.
"""


def _ensure_privacy_consent(config):
    """Gate first activation on a one-time, explicit acknowledgment of
    the plain-language privacy/ToS summary above. Nothing in this file
    asked for this before -- activate() ran straight from a license key
    to a bound device with no acknowledgment step at all, closed beta or
    not. Re-asks if PRIVACY_ACK_VERSION has moved past whatever the
    customer last agreed to. Returns True if consent is already on file
    or was just given; False if it wasn't (caller should not proceed).
    """
    if config.get("privacy_ack_version") == PRIVACY_ACK_VERSION:
        return True

    if os.environ.get("CURANT_SKIP_PRIVACY_ACK") == "1":
        # Escape hatch for automated/non-interactive test environments
        # only (mirrors CURANT_DEV_UNLICENSED's pattern) -- never set
        # this for a real customer or beta tester.
        return True

    if not sys.stdin.isatty():
        print("Activation needs a one-time privacy acknowledgment, which requires "
              "an interactive terminal. Run `curant-cli activate <key>` directly "
              "in a terminal, not from a script.")
        return False

    print(PRIVACY_ACK_SUMMARY)
    answer = _wizard_prompt("Type 'I agree' to continue: ", default="") or ""
    if answer.strip().lower() not in ("i agree", "agree", "y", "yes"):
        print("Not activated -- Curant needs this acknowledgment before it can run.")
        return False

    config["privacy_ack_version"] = PRIVACY_ACK_VERSION
    config["privacy_ack_time"] = time.time()
    save_config(config)
    return True


def activate(license_key):
    """Verify a license key against the server (billing/entitlement check
    only) and store the result locally."""
    config = load_config()
    if not _ensure_privacy_consent(config):
        sys.exit(1)

    device_id = get_device_id()
    payload = json.dumps({"license_key": license_key, "device_id": device_id}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/activate",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        result = request_with_retries(req, timeout=10)
    except Exception as e:
        print(f"Could not reach Curant's server: {e}")
        sys.exit(1)

    if not result.get("valid"):
        error = result.get("error")
        if error == "license_already_bound_to_another_device":
            print("This license key is already activated on a different Mac. "
                  "A license can only be active on one Mac at a time. If that Mac is "
                  "gone or you've upgraded, run `curant-cli request-release` — this doesn't "
                  "release it automatically, a person reviews the request first (or call "
                  "support directly at curant.app/support).")
        elif error == "device_already_bound_to_another_license":
            print("This Mac is already activated with a different license key. "
                  "A Mac can only run one Curant license at a time.")
        elif error == "device_limit_reached":
            print("This license has already reached its device limit. If you've upgraded "
                  "or retired one of your other Macs, run `curant-cli request-release` to free "
                  "up a slot (a person reviews the request first), or call support directly "
                  "at curant.app/support.")
        else:
            print("That license key isn't valid or isn't active. Check your account at curant.app/billing.")
        sys.exit(1)

    config = load_config()
    config["license_key"] = license_key
    config["device_id"] = device_id  # informational only — always recomputed live from
                                       # hardware when actually used, never read back from here
    config["customer_id"] = result.get("customer_id")
    config["customer_name"] = result.get("customer_name")
    config["plan"] = result.get("plan", "base")
    config["unlocked_addons"] = result.get("unlocked_addons", [])
    config.setdefault("persona", "curant")
    config.setdefault("reply_format", "text")
    config.setdefault("voice_tier", "standard")
    config.setdefault("proactivity_enabled", False)
    config.setdefault("instructions", "")
    config["last_status_check"] = time.time()
    config["last_status_active"] = True
    # Apply customer_apple_id/customer_handles (and anything else synced
    # via the dashboard) immediately at activation, not just on the next
    # periodic /v1/status recheck up to STATUS_RECHECK_SECONDS later --
    # a customer who filled in "who should Curant listen to" on the web
    # dashboard before running `activate` shouldn't have to wait hours
    # for curant-watcher.py to stop refusing to start.
    apply_synced_preferences_if_newer(config, result)
    save_config(config)
    init_local_db()
    print(f"Activated. Welcome, {result.get('customer_name', 'there')} — your Curant is ready.")
    if not config.get("customer_apple_id"):
        print("Note: no phone number/Apple ID is set for Curant to listen to yet. Set it at "
              "curant.app/dashboard (or run curant-cli directly against ~/.curant/config.json) "
              "before starting the watcher, or it will refuse to run.")
    if not get_api_key(config):
        print(f"One more step: run `curant-cli set-api-key <your-api-key>` to connect your "
              f"own {get_provider(config)} API key. This stays on your Mac only — it is never "
              f"sent to Curant's server. (Anthropic is the default provider; run "
              f"`curant-cli set-provider openai` first if you'd rather use OpenAI — your "
              f"persona, instructions, and memories carry over either way.)")


GENERATION_SERVICES = {"flux", "ideogram", "elevenlabs", "veo", "descript"}  # August-only, gated separately


def set_api_key(api_key, provider=None):
    """Store the customer's own API key locally, for a given provider
    or specialist generation service (default: whichever LLM provider
    is currently configured, or anthropic if none set yet). Never
    touches Curant's server — used only for direct calls from this
    machine."""
    config = load_config()
    provider = provider or get_provider(config)
    if provider not in PROVIDER_MODELS and provider not in GENERATION_SERVICES:
        print(f"Unknown provider/service '{provider}'. Supported: "
              f"{', '.join(sorted(PROVIDER_MODELS) + sorted(GENERATION_SERVICES))}")
        sys.exit(1)

    if provider == "anthropic" and not api_key.startswith("sk-ant-"):
        print("That doesn't look like an Anthropic API key (should start with 'sk-ant-'). "
              "Get yours at https://console.anthropic.com/settings/keys")
        sys.exit(1)
    if provider == "openai" and not api_key.startswith("sk-"):
        print("That doesn't look like an OpenAI API key (should start with 'sk-'). "
              "Get yours at https://platform.openai.com/api-keys")
        sys.exit(1)
    # Generation services don't get a format check — their key formats
    # aren't reliably known/stable enough to validate confidently, so
    # this just stores whatever's given rather than guessing at a prefix.

    config.setdefault("api_keys", {})
    config["api_keys"][provider] = api_key
    save_config(config)
    print(f"API key saved locally for {provider}. It will never be sent to Curant's server.")


