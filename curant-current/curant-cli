def add_auto_reply_contact_cmd(handle, label):
    """Grace-exclusive. `curant-cli add-auto-reply-contact <handle> [label]`
    -- opts a specific, known contact in to Curant actually SENDING
    routine replies to them on the customer's behalf, instead of only
    ever drafting a suggestion and asking first (see screen_message).
    This is deliberately scoped narrower than delegate access: a
    delegate can have a real two-way conversation with Curant; an
    auto-reply contact just means Curant won't bother the customer for
    permission on messages from this person that are ALSO judged
    routine (not urgent, not high-stakes) message by message -- being
    on this list never bypasses those per-message checks, and never
    overrides VIP status (a VIP always gets a notify-first notice,
    even if also on this list, since VIP specifically means "always
    tell me")."""
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("Auto-reply contacts are a Grace-exclusive feature.")
        sys.exit(1)
    if not handle:
        print("Usage: curant-cli add-auto-reply-contact <handle> [label]")
        sys.exit(1)
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO auto_reply_contacts (handle, label) VALUES (?, ?) "
            "ON CONFLICT(handle) DO UPDATE SET label = excluded.label",
            (handle, label or ""),
        )
        conn.commit()
    print(f"{handle} added as an auto-reply contact{f' ({label})' if label else ''}. Curant may now "
          f"send routine replies to them directly (never anything urgent or high-stakes) instead of "
          f"asking you first each time -- you'll still get an FYI notice after it happens.")


