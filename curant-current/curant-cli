def get_memories():
    with closing(get_local_db()) as conn:
        rows = conn.execute("SELECT content FROM memories ORDER BY id").fetchall()
        return [r["content"] for r in rows]


def get_memories_with_age():
    """
    Grace-exclusive use case: weekly_rollup's stalled-items digest needs
    to know roughly HOW LONG a memory has been sitting around to flag
    something as stalled ("you said you'd follow up with Jamie 10 days
    ago") -- plain get_memories() only returns content strings, no
    timestamp, since nothing else in this file has needed the age
    before now. Returns a list of {"content": str, "days_old": int}."""
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT content, "
            "CAST((julianday('now') - julianday(created_at)) AS INTEGER) AS days_old "
            "FROM memories ORDER BY id"
        ).fetchall()
        return [dict(r) for r in rows]


