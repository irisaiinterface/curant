    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT submission_text, grade_given, feedback_given FROM grading_examples WHERE assignment_id = ?",
            (assignment["id"],),
        ).fetchall()
        return [dict(r) for r in rows]


def get_grading_corrections(assignment_name, limit=10):
    """Recent corrections for this assignment — real signal from past
    mistakes, folded into future calibration the same way the original
    examples are, most recent first since a teacher's standards for a
    given assignment are more likely to have settled than drifted."""
    assignment = get_grading_assignment(assignment_name)
    if not assignment:
        return []
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT submission_text, suggested_grade, corrected_grade, corrected_feedback "
            "FROM grading_corrections WHERE assignment_id = ? ORDER BY id DESC LIMIT ?",
            (assignment["id"], limit),
        ).fetchall()
        return [dict(r) for r in rows]


def record_grading_correction(assignment_name, submission_text, suggested_grade, corrected_grade, corrected_feedback):
    assignment = get_grading_assignment(assignment_name)
    if not assignment:
        return False, f"No assignment set up called '{assignment_name}'."
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO grading_corrections (assignment_id, submission_text, suggested_grade, "
            "corrected_grade, corrected_feedback) VALUES (?, ?, ?, ?, ?)",
            (assignment["id"], submission_text, suggested_grade, corrected_grade, corrected_feedback),
        )
        conn.commit()
    return True, "Got it — I'll factor that in for this assignment going forward."


def list_grading_assignments():
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT assignment_name, (SELECT COUNT(*) FROM grading_examples WHERE assignment_id = grading_assignments.id) as example_count "
            "FROM grading_assignments ORDER BY updated_at DESC"
        ).fetchall()
        return [dict(r) for r in rows]


def _grade_tier(grade_str):
    """Best-effort extraction of a 'tier' from a grade string, for
    spread-checking — handles the common letter-grade case (A, B+, C-,
    etc.) by ignoring +/- so 'C+' and 'C' correctly count as the same
    tier, not a real spread. Falls back to an exact-string match for
    anything else (numeric grades, rubric labels like 'meets
    expectations') since there's no reliable universal way to parse
    every grading system a teacher might use — this is an honest
    limitation, not silently pretended away."""
    match = re.match(r'^\s*([A-Fa-f])[+-]?\s*$', grade_str)
    if match:
        return match.group(1).upper()
    return grade_str.strip().lower()


def build_grading_calibration_context(assignment_name):
    """
    Assembles everything the model needs to actually grade in this
    teacher's voice for this specific assignment: the prompt, the
    rubric, the calibration examples (explicitly flagging if the spread
    looks thin — e.g. only high-scoring examples, no contrast), and
    recent corrections. Returns a formatted string ready to drop into
    the system prompt, or None if the assignment doesn't exist yet.
    """
    assignment = get_grading_assignment(assignment_name)
    if not assignment:
        return None
    examples = get_grading_examples(assignment_name)
    corrections = get_grading_corrections(assignment_name)

    parts = [
        f"Assignment: {assignment_name}",
        f"Prompt: {assignment['assignment_prompt']}",
        f"Rubric: {assignment['rubric_text']}",
    ]
    if examples:
        parts.append(f"\nCalibration examples ({len(examples)} on file):")
        for i, ex in enumerate(examples, 1):
            parts.append(f"  Example {i} — grade given: {ex['grade_given']}\n"
                        f"  Feedback given: {ex['feedback_given']}\n"
                        f"  Submission excerpt: {ex['submission_text'][:300]}")
        tiers_seen = {_grade_tier(ex["grade_given"]) for ex in examples}
        if len(tiers_seen) < 2:
            parts.append(
                "\nNOTE: the calibration examples for this assignment don't show a clear "
                "spread (best-effort check — for letter grades this ignores +/-, so 'C+' and "
                "'C' count as the same tier; for other grading formats it's an exact-string "
                "match, which won't catch every case). Tell the teacher this before grading "
                "anything new, and ask for at least one clearly stronger or weaker example."
            )
    else:
        parts.append("\nNo calibration examples yet for this assignment.")

    if corrections:
        parts.append(f"\nRecent corrections from this teacher on this assignment ({len(corrections)}):")
        for c in corrections:
            parts.append(f"  Suggested {c['suggested_grade']}, teacher corrected to {c['corrected_grade']}"
                        f"{' — ' + c['corrected_feedback'] if c['corrected_feedback'] else ''}")

    return "\n".join(parts)



# explicitly did NOT solve. Receiving a verification email is one thing;
# actually completing a signup on some third-party website's own UI —
# typing into fields, clicking submit — is a different, much larger
# capability. Built here using Playwright, verified as genuinely
# installable and launchable (real Chromium binary, real browser
# process) before writing any of this.
#
# This is the single most consequential capability in this whole
# system — an AI autonomously interacting with arbitrary third-party
# websites, potentially agreeing to terms of service or submitting real
# data on the customer's behalf. Handled with the same read/write split
# used for Gmail/Calendar/Drive, PLUS one extra hard rail specific to
# this capability that the other integrations didn't need:
#   - browse_page(): read-only, no side effect, runs freely — look at a
#     page, see what's on it, see what fields exist.
#   - fill_and_submit_form(): the real external-effect action. Gated the
#     same way gmail_send/drive_share are (system prompt instructs
#     confirmation-first) — but ALSO hard-blocked in code, not just by
#     instruction, from ever touching anything that looks like a
#     payment or sensitive-ID field (card numbers, CVV, SSNs). That
#     refusal happens regardless of what the model decides, because
#     payment/identity data deserves a harder line than "the model
#     should ask first" — a categorically different risk than filling
#     out a newsletter signup.

# Expanded after the Aug 2026 audit, which tested the matcher against real
# field names and found it correctly caught card/cvv/ssn/routing but missed
# several categories that are just as sensitive: international bank details,
# government IDs, and date of birth.
PAYMENT_FIELD_KEYWORDS = (
    "card", "cvv", "cvc", "ccnum", "cardnumber", "security-code",
    "securitycode", "expiry", "exp-date", "expdate", "ssn", "social-security",
    "socialsecurity", "routing-number", "routingnumber", "account-number", "accountnumber",
    # international banking
    "iban", "bic", "swift", "sortcode", "sort-code",
    # government / identity documents
    "passport", "taxid", "tax-id", "nationalid", "national-id", "driverslicense",
    "drivers-license", "licensenumber", "sin", "nino",
    # date of birth (commonly paired with the above for identity verification)
    "dateofbirth", "date-of-birth", "dob", "birthdate", "birth-date",
    # credentials — never auto-fill these either
    "password", "passwd", "pin", "otp", "onetimecode", "mfa", "2fa",
)

# ── SSRF guard for the browser tools ─────────────────────────────────────────
# Added after the Aug 2026 audit found browse_page() passed whatever URL it
# was given straight to Playwright with no validation at all. That meant the
# model could be steered — by a customer, or by injected text in an email or
# web page it had just read — into fetching http://localhost, a router admin
# page on the customer's LAN, or a cloud metadata endpoint like
# http://169.254.169.254/ and reporting the contents back.
#
# Blocks by resolved IP, not by hostname string: a name like
# "internal.example.com" or a DNS entry deliberately pointed at 127.0.0.1
# looks perfectly public as text. Resolution happens here, and again inside
# the page's request interceptor, so a redirect or a subresource can't reach
# somewhere the top-level URL wasn't allowed to.
BLOCKED_URL_SCHEMES_NOTE = "only http:// and https:// are allowed"


def _ip_is_private(ip_str: str) -> bool:
    try:
        ip = ipaddress.ip_address(ip_str)
    except ValueError:
        return True  # unparseable — treat as unsafe rather than allow
    return (ip.is_private or ip.is_loopback or ip.is_link_local
            or ip.is_reserved or ip.is_multicast or ip.is_unspecified)


def _is_safe_url(url):
    """Returns (safe, reason). Used both up front and per-request."""
    try:
        parsed = urlparse(url)
    except Exception:
        return False, "that isn't a URL I can parse"
    if parsed.scheme not in ("http", "https"):
        return False, f"the scheme '{parsed.scheme or 'none'}' isn't allowed — {BLOCKED_URL_SCHEMES_NOTE}"
    host = parsed.hostname
    if not host:
        return False, "that URL has no hostname"
    try:
        infos = socket.getaddrinfo(host, None)
    except Exception:
        return False, f"'{host}' couldn't be resolved"
    for info in infos:
        if _ip_is_private(info[4][0]):
            return False, (f"'{host}' resolves to a private, loopback, or link-local address "
                            f"({info[4][0]}) — internal network addresses are not reachable from here")
    return True, ""


def _install_ssrf_guard(page):
    """Re-checks every request the page makes, so redirects, iframes, and
    subresource loads are held to the same rule as the original URL."""
    def _route(route, request):
        ok, _ = _is_safe_url(request.url)
        if ok:
            route.continue_()
        else:
            route.abort()
    page.route("**/*", _route)


def _is_sensitive_field(field_name):
    """
    Normalizes separators (underscores, hyphens) out of both the field
    name and the keyword list before comparing — a raw substring check
    without this misses real variants (e.g. 'cc_number' vs the keyword
    'ccnum': the underscore breaks a naive substring match even though
    they mean the same thing). Caught by testing this against multiple
    real-world naming conventions, not just one.
    """
    if not field_name:
        return False
    normalized = re.sub(r"[^a-z0-9]", "", field_name.lower())
    normalized_keywords = [re.sub(r"[^a-z0-9]", "", kw) for kw in PAYMENT_FIELD_KEYWORDS]
    return any(kw in normalized for kw in normalized_keywords)


BROWSER_TIMEOUT_MS = 15000


def browse_page(url):
    """
    Read-only — navigate to a page and see what's there: visible text,
    and every fillable field with its name/type/label, so the model
    knows what a subsequent fill_and_submit_form() call could target.
    No side effect, no confirmation needed, same as reading an email.
    """
    safe, why = _is_safe_url(url)
    if not safe:
        return None, f"Refusing to open that URL — {why}."

    try:
        from playwright.sync_api import sync_playwright
        with sync_playwright() as p:
            browser = p.chromium.launch()
            try:
                page = browser.new_page()
                _install_ssrf_guard(page)
                page.goto(url, timeout=BROWSER_TIMEOUT_MS)
                page.wait_for_load_state("networkidle", timeout=BROWSER_TIMEOUT_MS)
                text_content = page.inner_text("body")
                fields = page.eval_on_selector_all(
                    "input, select, textarea",
                    """els => els.map(el => ({
                        name: el.name || el.id || '',
                        type: el.type || el.tagName.toLowerCase(),
                        label: (el.labels && el.labels[0]) ? el.labels[0].innerText : ''
                    }))""",
                )
                return {"text": text_content[:3000], "fields": fields}, None
            finally:
                browser.close()
    except Exception as e:
        return None, f"Could not load that page: {e}"


def get_shell_safety_mode(config):
    mode = config.get("shell_safety_mode")
    return mode if mode in DEAN_SHELL_SAFETY_MODES else DEAN_SHELL_DEFAULT_SAFETY_MODE


def set_shell_safety_mode(mode):
    """Called either from the CLI (set-shell-mode) or by Dean himself via
    the set_shell_safety_mode tool, once he's actually asked the customer
    which mode they want — see the tool's description in
    get_all_available_tools for why this is asked rather than assumed."""
    if mode not in DEAN_SHELL_SAFETY_MODES:
        return False, f"Not a valid mode — must be one of: {', '.join(DEAN_SHELL_SAFETY_MODES)}."
    config = load_config()
    config["shell_safety_mode"] = mode
    save_config(config)
    return True, f"Shell safety mode set to '{mode}'."


def _shell_command_is_allowlisted(command: str) -> tuple[bool, str]:
    """
    Returns (allowed, reason_if_not).

    REWRITTEN after the Aug 2026 security audit found the original
    version trivially bypassable. The original did a bare prefix match
    and carried a comment claiming "shell metacharacters break the match
    rather than sneaking past it." That was FALSE: a metacharacter only
    broke the match when it landed immediately after the allowlisted
    word. `git status; rm -rf /` was correctly refused, but
    `git log --oneline; rm -rf ~` matched the "git log " prefix and ran —
    with no confirmation, since that's the entire point of allowlist
    mode. Confirmed by execution, not theory.

    Three checks now, all of which must pass:
      1. No shell metacharacters anywhere — no chaining, substitution,
         redirection, or pipelines. This is what makes prefix matching
         defensible at all.
      2. Prefix match against the allowlist.
      3. No absolute paths or parent-directory traversal in the
         arguments. `ls` is safe; `ls /Users/someone/.ssh` is not, and
         the difference is the argument, not the command.
    """
    command = command.strip()
    if not command:
        return False, "empty command"

    for ch in SHELL_METACHARACTERS:
        if ch in command:
            return False, (
                f"it contains the shell metacharacter '{ch}'. Allowlist mode runs commands "
                f"without asking the customer first, so it only permits a single plain command "
                f"— no chaining, pipes, redirection, or substitution."
            )

    if not any(command == entry or command.startswith(entry + " ") for entry in DEAN_SHELL_ALLOWLIST):
        return False, "it isn't one of the pre-approved read-only commands"

    try:
        parts = shlex.split(command)
    except ValueError:
        return False, "it couldn't be parsed as a well-formed command (unbalanced quotes?)"
    for arg in parts[1:]:
        if arg.startswith("/") or arg.startswith("~") or ".." in arg:
            return False, (
                f"the argument '{arg}' points outside Dean's working directory. Allowlist mode "
                f"only runs against relative paths inside it."
            )

    return True, ""


def shell_exec(command: str, cwd: str | None, confirmed: bool, config: dict) -> tuple[str | None, str | None]:
    """
    Dean's real shell-access action — see the module comment above
    DEAN_SHELL_SAFETY_MODES for the full scoping reasoning (Home-only,
    Dean-only, customer's own choice of safety mode).

    HONEST SCOPE. Two layers, and it is worth being precise about which
    does what, because an earlier version of this docstring overstated it:

      - Mode rules (procedural). "confirm" needs the customer to approve
        the exact string; "allowlist" permits only a short list of
        commands, with no shell interpretation, no metacharacters and no
        absolute paths; "autonomous" is unrestricted by the customer's
        own explicit choice.
      - OS containment (structural, macOS only). Commands run under
        sandbox-exec: writes denied outside the workspace, reads denied
        on credential stores (~/.ssh, ~/.aws, Keychains, browser
        profiles, shell history, and Curant's own config), outbound
        network denied. This is what stops an approved-but-misunderstood
        command, or an injected one, from reaching things it shouldn't.

    If sandbox-exec is unavailable (non-macOS, or the profile is
    rejected) the command still runs, but the output carries a visible
    warning saying containment did not apply — it never silently
    pretends to be contained. The profile itself has not yet been
    exercised on real macOS hardware; see the note above
    DEAN_SHELL_SANDBOX_DENIED_READS.

    The `cwd` parameter specifically is still checked against escaping
    the workspace root — that's a guard on this function's own argument,
    not a claim about the command string.

    Returns (output, error) — output includes the exit code and combined
    stdout/stderr (truncated), error is set only when the command didn't
    run at all (blocked by safety mode, or a real subprocess failure).
    """
    os.makedirs(DEAN_SHELL_WORKSPACE, exist_ok=True)

    mode = get_shell_safety_mode(config)
    if mode == "confirm" and not confirmed:
        return None, (
            f"Not run — this action requires explicit customer confirmation first. The exact "
            f"command that would run is: `{command}`. Ask the customer to confirm, wait for "
            f"their reply, then call this again with confirmed=true."
        )
    allowlisted, refusal_reason = (True, "")
    if mode == "allowlist":
        allowlisted, refusal_reason = _shell_command_is_allowlisted(command)
        if not allowlisted:
            return None, (
                f"Not run — shell safety mode is 'allowlist', and `{command}` was refused because "
                f"{refusal_reason}. Ask the customer to either approve switching to 'confirm' or "
                f"'autonomous' mode (via set_shell_safety_mode) or run this themselves."
            )

    run_dir = DEAN_SHELL_WORKSPACE
    if cwd:
        candidate = os.path.realpath(os.path.join(DEAN_SHELL_WORKSPACE, cwd))
        if not candidate.startswith(os.path.realpath(DEAN_SHELL_WORKSPACE)):
            return None, "Not run — that working directory would escape Dean's shell workspace."
        run_dir = candidate
        os.makedirs(run_dir, exist_ok=True)

    sandboxed = _sandbox_available(DEAN_SHELL_WORKSPACE)
    sandbox_note = "" if sandboxed else (
        "[warning: OS-level containment is unavailable on this machine, so this command "
        "ran with your full user permissions — it could read or write anything you can. "
        "Mention this to the customer if it matters for what they asked.]\n"
    )

    try:
        if mode == "allowlist":
            # No shell interpretation at all in this mode — the argv list is
            # passed straight to exec, so there is no shell left to interpret
            # a metacharacter even if one somehow got past the check above.
            # Defense in depth: the check and this are independent.
            argv = shlex.split(command)
        else:
            # A real shell, because confirm/autonomous legitimately want pipes
            # and redirection — the customer approved the exact string.
            argv = ["/bin/sh", "-c", command]

        if sandboxed:
            argv = ["sandbox-exec", "-p", _build_sandbox_profile(DEAN_SHELL_WORKSPACE)] + argv

        result = subprocess.run(
            argv, shell=False, cwd=run_dir, capture_output=True, text=True,
            timeout=DEAN_SHELL_TIMEOUT_SECONDS,
        )
        output = (result.stdout or "") + (result.stderr or "")
        truncated = output[:DEAN_SHELL_OUTPUT_MAX_CHARS]
        if len(output) > DEAN_SHELL_OUTPUT_MAX_CHARS:
            truncated += "\n[...output truncated...]"
        return f"{sandbox_note}[exit code {result.returncode}]\n{truncated}", None
    except subprocess.TimeoutExpired:
        return None, f"Command timed out after {DEAN_SHELL_TIMEOUT_SECONDS} seconds and was killed."
    except Exception as e:
        return None, f"Command failed to run: {e}"


def fill_and_submit_form(url, field_values, submit_selector, confirmed=False):
    """
    The real external-effect action. `confirmed` is now checked here in
    code, not just requested via system prompt instruction — a model
    that calls this without confirmed=True gets refused outright, the
    same structural pattern already used for the sensitive-field block
    below. Belt-and-suspenders on purpose: the schema marks `confirmed`
    required so a well-behaved model can't omit it, and this check
    catches the case where it's present but false anyway (a model
    calling ahead of actual customer confirmation, or a malformed call).

    Also hard-blocked in code from touching anything that looks like a
    payment or sensitive-ID field — that block applies regardless of
    confirmation, since payment/identity data is a categorically
    different risk than a newsletter signup.
    """
    if not confirmed:
        return None, (
            "Not submitted — this action requires explicit customer confirmation first. "
            "Ask the customer to confirm, wait for their reply, then call this again with "
            "confirmed=true."
        )

    blocked = [k for k in field_values if _is_sensitive_field(k)]
    if blocked:
        return None, (
            f"Refusing to auto-fill these fields — they look like payment or sensitive-ID "
            f"fields ({', '.join(blocked)}). That needs a person to enter directly, never "
            f"automated, regardless of confirmation."
        )

    safe, why = _is_safe_url(url)
    if not safe:
        return None, f"Refusing to open that URL — {why}."

    try:
        from playwright.sync_api import sync_playwright
        with sync_playwright() as p:
            browser = p.chromium.launch()
            try:
                page = browser.new_page()
                _install_ssrf_guard(page)
                page.goto(url, timeout=BROWSER_TIMEOUT_MS)
                for field_name, value in field_values.items():
                    el = page.query_selector(f"#{field_name}, [name='{field_name}']")
                    if not el:
                        return None, f"Could not find a field matching '{field_name}' on this page."
                    tag = el.evaluate("el => el.tagName.toLowerCase()")
                    el_type = el.evaluate("el => el.type || ''")
                    if tag == "select":
                        el.select_option(str(value))
                    elif el_type == "checkbox":
                        if str(value).lower() in ("true", "1", "yes"):
                            el.check()
                    else:
                        el.fill(str(value))

                page.click(submit_selector, timeout=BROWSER_TIMEOUT_MS)
                page.wait_for_load_state("networkidle", timeout=BROWSER_TIMEOUT_MS)
                result_text = page.inner_text("body")
                return {"result_text": result_text[:2000]}, None
            finally:
                browser.close()
    except Exception as e:
        return None, f"Browser automation failed: {e}"


BROWSER_SYNC_WAIT_SECONDS = 8  # most form submissions are fast (a few seconds) — worth
                                # trying to answer in the same turn rather than always
                                # going through the two-message "started... done" pattern
                                # Veo needs, since Veo is *always* slow and forms usually aren't


def fill_and_submit_form_hybrid(url, field_values, submit_selector, apple_id, confirmed=False):
    """
    The safety property that matters most here: the actual browser work
    runs EXACTLY ONCE, inside the detached background job subprocess
    (see run_background_job_cmd), regardless of how this function
    returns. This function only ever *polls* that job's status — it
    never calls fill_and_submit_form() itself. That's what makes it safe
    to poll-then-give-up without any risk of the form getting submitted
    twice, which matters here in a way it wouldn't for read-only actions.

    `confirmed` is checked HERE, before even creating the background
    job — an unconfirmed call never reaches the subprocess at all, so
    there's no path where a slow/async submission slips past the same
    check a synchronous call would hit.

    Most submissions finish within BROWSER_SYNC_WAIT_SECONDS, so the
    common case gets a real, same-turn answer. If a site is slow enough
    to still be running past that window, this hands off to the same
    background-job delivery path Veo uses (the watcher's polling loop
    picks it up once it actually finishes) rather than blocking relay()
    for however long that slow site takes.
    """
    if not confirmed:
        return (
            "Not submitted — this action requires explicit customer confirmation first. "
            "Ask the customer to confirm, wait for their reply, then call this again with "
            "confirmed=true."
        )

    job_id = _create_background_job(
        "fill_and_submit_form",
        {"url": url, "field_values": field_values, "submit_selector": submit_selector, "confirmed": True},
        apple_id,
    )
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "run-background-job", str(job_id)],
            start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        _update_background_job(job_id, "failed", error=f"Could not start: {e}")
        return f"Couldn't fill out that form: {e}"

    deadline = time.time() + BROWSER_SYNC_WAIT_SECONDS
    while time.time() < deadline:
        time.sleep(0.5)
        job = _get_background_job(job_id)
        if job["status"] in ("done", "failed"):
            mark_job_delivered(job_id)  # answering it right now, in this same reply
            if job["status"] == "done":
                return job.get("result_text") or "(Form submitted, but no page content came back.)"
            return f"[Form submission failed: {job['error']}]"

    return ("Still working on that one — the site's taking a bit longer than usual. "
            "I'll let you know as soon as it's done.")


def execute_tool_call(tool_name, arguments, available_tools):
    """Routes a tool call to either the built-in capability-gap logger,
    one of August's specialist generation tools, or the right MCP
    server, based on the qualified name the model was given. Never
    raises — a tool failure becomes a text result the model can react
    to. Successful generations append their local file path to
    _last_generated_files so relay() can surface it for delivery."""
    match = next((t for t in available_tools if t["qualified_name"] == tool_name), None)
    if match is None:
        return f"[Unknown tool: {tool_name}]"

    if match["builtin"] and tool_name == "log_capability_gap":
        description = arguments.get("description", "").strip()
        if not description:
            return "[No description provided — nothing was logged.]"
        return log_capability_gap(description)

    if match["builtin"] and tool_name == "shell_exec":
        config = load_config()
        output, error = shell_exec(
            arguments.get("command", ""),
            arguments.get("cwd"),
            arguments.get("confirmed", False),
            config,
        )
        return error if error else output

    if match["builtin"] and tool_name == "set_shell_safety_mode":
        ok, msg = set_shell_safety_mode(arguments.get("mode", ""))
        return msg

    if match["builtin"] and tool_name in (
        "generate_image", "generate_image_with_text", "generate_voice", "edit_media"
    ):
        config = load_config()
        service_map = {
            "generate_image": "flux", "generate_image_with_text": "ideogram",
            "generate_voice": "elevenlabs", "edit_media": "descript",
        }
        service = service_map[tool_name]

        ok, cap_message = check_spend_cap(config, service)
        if not ok:
            return cap_message

        if tool_name == "generate_image":
            path, error = generate_image_flux(arguments.get("prompt", ""), config)
        elif tool_name == "generate_image_with_text":
            path, error = generate_image_ideogram(arguments.get("prompt", ""), config)
        elif tool_name == "generate_voice":
            path, error = generate_voice_elevenlabs(arguments.get("text", ""), config)
        else:
            path, error = edit_media_descript(arguments.get("instructions", ""), config)

        if error:
            return f"[{tool_name} failed: {error}]"
        _last_generated_files.append(path)
        # Only log a cost for a generation that actually happened — the
        # Descript stub always returns an error above and never reaches
        # here, so no spend gets recorded for something that didn't run.
        log_generation_cost(service)
        return f"Generated successfully, saved at {path}."

    if match["builtin"] and tool_name == "generate_video":
        # Runs in a detached background process instead of blocking this
        # whole relay() call (and the watcher) for several minutes — see
        # generate_video_veo_async's docstring. Cost is logged once the
        # background job actually completes (run_background_job_cmd),
        # not here, since nothing has happened yet at this point.
        #
        # The cap check happens BEFORE the job starts, not after it
        # completes — Veo is the most expensive single generation
        # (~$3.20), and checking only post-completion would let several
        # video jobs get kicked off in flight before any of them
        # actually counted against the cap.
        config = load_config()
        ok, cap_message = check_spend_cap(config, "veo")
        if not ok:
            return cap_message
        return generate_video_veo_async(arguments.get("prompt", ""), config, _current_apple_id)

    if match["builtin"] and tool_name == "get_spending_summary":
        summary = get_generation_cost_summary()
        total = get_total_estimated_spend()
        config = load_config()
        monthly_spend = get_monthly_estimated_spend()
        cap = get_monthly_spend_cap(config)
        cap_line = (f"No monthly cap set." if cap is None else
                    f"Monthly cap: ${cap:.2f} — ~${max(cap - monthly_spend, 0):.2f} remaining this month.")
        if not summary:
            return f"No generation spend yet this account. {cap_line}"
        lines = [f"{row['service']}: {row['count']} generation(s), ~${row['total']:.2f}" for row in summary]
        return (f"Estimated spend so far: ~${total:.2f} total (~${monthly_spend:.2f} this month). {cap_line}\n"
                + "\n".join(lines) +
                "\n(These are estimates for a general sense of spend, not exact billing — check your own account with each provider for the real number.)")

    if match["builtin"] and tool_name == "browse_page":
        result, error = browse_page(arguments.get("url", ""))
        if error:
            return f"[browse_page failed: {error}]"
        fields_summary = "\n".join(
            f"  - {f['name']} ({f['type']}){': ' + f['label'] if f['label'] else ''}"
            for f in result["fields"]
        ) or "  (no fillable fields found)"
        return f"Page content:\n{result['text']}\n\nFillable fields:\n{fields_summary}"

    if match["builtin"] and tool_name == "fill_and_submit_form":
        # Routed through the hybrid wrapper, not called directly — see
        # fill_and_submit_form_hybrid's docstring for why that matters
        # (guarantees the form only ever gets submitted once).
        return fill_and_submit_form_hybrid(
            arguments.get("url", ""), arguments.get("field_values", {}),
            arguments.get("submit_selector", ""), _current_apple_id,
            confirmed=arguments.get("confirmed", False),
        )

    if match["builtin"] and tool_name == "setup_grading_assignment":
        create_or_update_grading_assignment(
            arguments.get("assignment_name", ""), arguments.get("assignment_prompt", ""),
            arguments.get("rubric_text", ""),
        )
        return f"Assignment '{arguments.get('assignment_name', '')}' set up. Ready for calibration examples."

    if match["builtin"] and tool_name == "add_grading_example":
        success, msg = add_grading_example(
            arguments.get("assignment_name", ""), arguments.get("submission_text", ""),
            arguments.get("grade_given", ""), arguments.get("feedback_given", ""),
        )
        return msg

    if match["builtin"] and tool_name == "suggest_grade":
        # This tool doesn't itself call the model again — it assembles
        # the calibration context and hands it back so the model (already
        # mid-conversation, already has the rubric/examples/corrections
        # in front of it via this result) produces the actual suggestion
        # itself in its next turn, rather than a second, separate LLM call.
        assignment_name = arguments.get("assignment_name", "")
        context = build_grading_calibration_context(assignment_name)
        if context is None:
            return f"[No assignment called '{assignment_name}' — set it up first with setup_grading_assignment.]"
        return (f"Calibration context for grading this submission:\n\n{context}\n\n"
                f"New submission to grade:\n{arguments.get('submission_text', '')}\n\n"
                f"Suggest a grade and rubric-mapped feedback based on the above — present it "
                f"as a draft for the teacher to review, not a final grade.")

    if match["builtin"] and tool_name == "record_grade_correction":
        success, msg = record_grading_correction(
            arguments.get("assignment_name", ""), arguments.get("submission_text", ""),
            arguments.get("suggested_grade", ""), arguments.get("corrected_grade", ""),
            arguments.get("corrected_feedback", ""),
        )
        return msg

    if match["builtin"] and tool_name == "list_grading_assignments":
        assignments = list_grading_assignments()
        if not assignments:
            return "No assignments set up yet."
        return "\n".join(f"{a['assignment_name']} — {a['example_count']} example(s)" for a in assignments)

    return call_mcp_tool(match["server_command"], match["raw_name"], arguments)


_PROVIDER_CALLERS = {
    "anthropic": _call_anthropic,
    "openai": _call_openai,
    "gemini": _call_gemini,
}


def call_llm(provider, api_key, system_prompt, messages, max_tokens=1000, tier="main"):
    """
    The single choke point every LLM call in this file goes through.
    `messages` uses the common {"role": "user"/"assistant", "content": str}
    shape both providers already accept directly for user/assistant turns
    — only the system prompt needs provider-specific handling, done
    inside each _call_* function.
    """
    caller = _PROVIDER_CALLERS.get(provider)
    if caller is None:
        raise ValueError(f"Unknown provider: {provider}")
    model = PROVIDER_MODELS[provider][tier]
    return caller(api_key, system_prompt, messages, max_tokens, model)


MAX_TOOL_CALL_ITERATIONS = 5  # a hard ceiling so a confused model calling
                               # tools in a loop can't run indefinitely —
                               # after this many rounds, return whatever
                               # explanation we can rather than hang


def _call_anthropic_with_tools(api_key, system_prompt, messages, max_tokens, model, tools, available_tools):
    import anthropic
    client = anthropic.Anthropic(api_key=api_key)
    anthropic_tools = [
        {"name": t["qualified_name"], "description": t["description"],
         "input_schema": t["input_schema"] or {"type": "object", "properties": {}}}
        for t in tools
    ]
    conversation = list(messages)
    for _ in range(MAX_TOOL_CALL_ITERATIONS):
        response = client.messages.create(
            model=model, max_tokens=max_tokens, system=system_prompt,
            messages=conversation, tools=anthropic_tools,
        )
        tool_uses = [b for b in response.content if getattr(b, "type", None) == "tool_use"]
        if not tool_uses:
            text_blocks = [b.text for b in response.content if getattr(b, "type", None) == "text"]
            return "\n".join(text_blocks).strip()

        conversation.append({"role": "assistant", "content": response.content})
        tool_results = []
        for tu in tool_uses:
            result_text = execute_tool_call(tu.name, tu.input, available_tools)
            tool_results.append({"type": "tool_result", "tool_use_id": tu.id, "content": result_text})
        conversation.append({"role": "user", "content": tool_results})

    return "(I tried a few tool calls but couldn't reach a final answer — something may need a closer look.)"


def _call_openai_with_tools(api_key, system_prompt, messages, max_tokens, model, tools, available_tools):
    from openai import OpenAI
    client = OpenAI(api_key=api_key)
    openai_tools = [
        {"type": "function", "function": {
            "name": t["qualified_name"], "description": t["description"],
            "parameters": t["input_schema"] or {"type": "object", "properties": {}},
        }}
        for t in tools
    ]
    conversation = [{"role": "system", "content": system_prompt}] + list(messages)
    for _ in range(MAX_TOOL_CALL_ITERATIONS):
        response = client.chat.completions.create(
            model=model, max_tokens=max_tokens, messages=conversation, tools=openai_tools,
        )
        msg = response.choices[0].message
        if not msg.tool_calls:
            return msg.content or ""

        conversation.append({
            "role": "assistant",
            "content": msg.content,
            "tool_calls": [
                {"id": tc.id, "type": "function",
                 "function": {"name": tc.function.name, "arguments": tc.function.arguments}}
                for tc in msg.tool_calls
            ],
        })
        for tc in msg.tool_calls:
            try:
                args = json.loads(tc.function.arguments or "{}")
            except json.JSONDecodeError:
                args = {}
            result_text = execute_tool_call(tc.function.name, args, available_tools)
            conversation.append({"role": "tool", "tool_call_id": tc.id, "content": result_text})

    return "(I tried a few tool calls but couldn't reach a final answer — something may need a closer look.)"


def _call_gemini_with_tools(api_key, system_prompt, messages, max_tokens, model, tools, available_tools):
    """
    Gemini 3 models require a 'thought_signature' to be echoed back on every
    function-call turn of a multi-turn tool-calling conversation — Google's
    own OpenAI-compat endpoint does not surface that field through the
    OpenAI SDK's typed response objects, so round-tripping tool calls through
    _call_openai_with_tools's dict-based conversation history causes every
    second turn to fail with 400 'Function call is missing a thought_signature'
    (confirmed live, and matches widely-reported issues in other OpenAI-compat
    clients hitting Gemini 3 — this is not fixable by adjusting request
    parameters, and thinking cannot be disabled for Gemini 3 models to avoid
    it). google-genai (the native SDK, already a dependency for Veo) doesn't
    have this problem: appending the SDK's own returned `content` object back
    into history verbatim (rather than re-serializing through OpenAI's
    tool_calls dict shape) keeps the thought signature intact, because it's
    never parsed out or reconstructed.
    """
    from google import genai
    from google.genai import types as genai_types

    client = genai.Client(api_key=api_key)
    gemini_tools = [genai_types.Tool(function_declarations=[
        genai_types.FunctionDeclaration(
            name=t["qualified_name"],
            description=t["description"],
            parameters=t["input_schema"] or {"type": "object", "properties": {}},
        )
        for t in tools
    ])]
    # Translate the common {"role": "user"/"assistant", "content": str} history
    # into genai Content objects. Gemini uses "model" where the rest of this
    # file says "assistant".
    conversation = [
        genai_types.Content(
            role=("model" if m["role"] == "assistant" else "user"),
            parts=[genai_types.Part.from_text(text=m["content"])],
        )
        for m in messages
    ]
    config = genai_types.GenerateContentConfig(
        system_instruction=system_prompt, max_output_tokens=max_tokens, tools=gemini_tools,
    )

    for _ in range(MAX_TOOL_CALL_ITERATIONS):
        response = client.models.generate_content(model=model, contents=conversation, config=config)
        candidate_content = response.candidates[0].content
        function_calls = [p.function_call for p in (candidate_content.parts or []) if p.function_call]

        if not function_calls:
            return response.text or ""

        # Append the model's OWN returned Content object unmodified — this is
        # what preserves its thought_signature, rather than reconstructing an
        # equivalent-looking turn ourselves.
        conversation.append(candidate_content)

        response_parts = []
        for fc in function_calls:
            try:
                result_text = execute_tool_call(fc.name, dict(fc.args or {}), available_tools)
            except Exception as e:
                result_text = f"Tool call failed: {e}"
            response_parts.append(genai_types.Part.from_function_response(
                name=fc.name, response={"result": result_text},
            ))
        conversation.append(genai_types.Content(role="user", parts=response_parts))

    return "(I tried a few tool calls but couldn't reach a final answer — something may need a closer look.)"


_PROVIDER_TOOL_CALLERS = {
    "anthropic": _call_anthropic_with_tools,
    "openai": _call_openai_with_tools,
    "gemini": _call_gemini_with_tools,
}


def call_llm_with_tools(provider, api_key, system_prompt, messages, tools, available_tools, max_tokens=1000, tier="main"):
    """
    Same idea as call_llm(), but runs the full tool-call loop: the model
    can request a tool (an MCP server's, or the built-in
    log_capability_gap), gets the result fed back, and keeps going
    until it has a final text answer or MAX_TOOL_CALL_ITERATIONS is hit.
    `tools` is the schema list for the API call; `available_tools` is the
    same list with routing info (server command, etc.) execute_tool_call
    needs to actually run one.
    """
    caller = _PROVIDER_TOOL_CALLERS.get(provider)
    if caller is None:
        raise ValueError(f"Unknown provider: {provider}")
    model = PROVIDER_MODELS[provider][tier]
    return caller(api_key, system_prompt, messages, max_tokens, model, tools, available_tools)


def update_memories_from_exchange(provider, api_key, existing_memories, user_message, reply_text):
    """Best-effort local memory extraction using a fast/cheap model, via
    whichever provider is currently configured. Any failure here is
    swallowed — memory is a nice-to-have, never allowed to break the
    core message flow."""
    try:
        existing_str = "\n".join(f"- {m}" for m in existing_memories) if existing_memories else "(none yet)"
        raw = call_llm(
            provider, api_key,
            system_prompt=MEMORY_EXTRACTION_PROMPT,
            messages=[{
                "role": "user",
                "content": (
                    f"Existing memories:\n{existing_str}\n\n"
                    f"Latest exchange:\nPerson: {user_message}\nAssistant: {reply_text}"
                ),
            }],
            max_tokens=400, tier="fast",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        parsed = json.loads(raw)
        for item in parsed.get("remove", []):
            delete_memory_by_content(item)
        for item in parsed.get("add", []):
            # This exact-string check is a narrow safety net, NOT the
            # real dedup mechanism — genuine near-duplicate detection
            # ("has a presentation Tuesday" vs. "has a big presentation
            # this Tuesday") needs semantic judgment a plain string
            # comparison can't do, so that's handled by the model itself
            # via MEMORY_EXTRACTION_PROMPT's explicit dedup instructions
            # (it's told to pair a rephrased fact's "remove" of the old
            # text with an "add" of the new one). This check only
            # catches the trivial case where the model returns something
            # already stored verbatim — cheap, harmless, worth keeping,
            # just not sufficient on its own.
            if item and item not in existing_memories:
                save_memory(item)
    except Exception as e:
        print(f"Memory extraction skipped (non-fatal): {e}", file=sys.stderr)


# --- Multi-provider routing ---
# Lets a message get answered by whichever configured provider actually
# suits it, instead of always going to whatever's set as "the" provider.
# Three ways this can be decided, checked in this order:
#   1. The message itself explicitly asks for a specific provider
#      ("use GPT for this one", "ask Claude instead") — a one-off,
#      applies to this message only.
#   2. A standing rule the customer has set previously applies to this
#      message's task category (routing_rules table).
#   3. Neither of the above — fall back to a judgment call about which
#      configured provider is generally better suited to this kind of
#      task. This is a real judgment call based on general knowledge of
#      each model family's relative strengths, not a verified benchmark
#      — treated and communicated as such, never asserted as fact.
# Also detects when the message itself is STATING a new standing rule
# ("from now on, use GPT for anything about code") and saves it — this
# reuses the one extra call rather than needing a second one.
#
# Deliberately skipped entirely when fewer than 2 providers have a key
# configured — there's nothing to route between, so this doesn't add
# cost/latency to the common single-provider case.

ROUTING_DECISION_PROMPT = """You help decide which AI model provider should \
handle an incoming message, when more than one is available.

You'll be given: the message itself, the list of currently available \
providers, and any standing routing rules the person has already set \
(e.g. "coding -> openai" means they've said to use OpenAI for coding tasks).

Decide, in this priority order:
1. Does the message ITSELF explicitly ask for a specific provider for just \
this one message (e.g. "use GPT for this", "ask Claude instead", "let \
ChatGPT handle this one")? If so, that's a one-off override — use it, and \
do not save it as a standing rule.
2. Does the message state a NEW standing preference going forward (e.g. \
"from now on use GPT for anything about code", "always use Claude for \
writing")? If so, extract it as {"category": "...", "provider": "..."} — \
category should be a short, general, reusable label (e.g. "coding", \
"creative writing", "research"), not a one-off restatement of this \
specific message.
3. Does an existing standing rule's category clearly apply to this \
message's task? If so, use that rule's provider.
4. Otherwise, pick whichever available provider is generally better \
suited to this kind of task, based on your own general knowledge of each \
model family's relative strengths. This is a judgment call, not a \
certainty — when it's genuinely unclear or the task doesn't favor either \
provider, just pick the person's default provider rather than guessing.

Respond with ONLY a JSON object, no other text:
{"provider": "<one of the available providers>", "reason": "<one short \
plain-language sentence, e.g. 'GPT tends to be strong at code' or \
'you asked for Claude specifically'>", "new_rule": {"category": "...", \
"provider": "..."} or null}"""


def decide_provider(message_text, config, default_provider, eligible_providers):
    """
    Returns (provider, reason, new_rule_saved: bool). Never raises — any
    failure here falls back to the default provider silently, since a
    broken routing decision should never be the reason a message doesn't
    get answered.
    """
    if len(eligible_providers) < 2:
        return default_provider, None, False

    rules = get_routing_rules()
    rules_str = "\n".join(f"- {r['category']} -> {r['provider']}" for r in rules) if rules else "(none set yet)"

    try:
        api_key = get_api_key(config, default_provider)
        raw = call_llm(
            default_provider, api_key,
            system_prompt=ROUTING_DECISION_PROMPT,
            messages=[{
                "role": "user",
                "content": (
                    f"Message: {message_text}\n\n"
                    f"Available providers: {', '.join(eligible_providers)}\n"
                    f"Person's default provider: {default_provider}\n\n"
                    f"Existing standing rules:\n{rules_str}"
                ),
            }],
            max_tokens=200, tier="fast",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        decision = json.loads(raw)
        provider = decision.get("provider")
        if provider not in eligible_providers:
            return default_provider, None, False

        new_rule_saved = False
        new_rule = decision.get("new_rule")
        if new_rule and new_rule.get("category") and new_rule.get("provider") in eligible_providers:
            save_routing_rule(new_rule["category"], new_rule["provider"])
            new_rule_saved = True

        return provider, decision.get("reason"), new_rule_saved
    except Exception as e:
        print(f"Routing decision skipped, using default provider (non-fatal): {e}", file=sys.stderr)
        return default_provider, None, False




def request_with_retries(req, timeout, max_attempts=3):
    """
    A dropped wifi connection on the Mac Mini shouldn't silently fail a
    status check. Retries transient failures with short exponential
    backoff. Does NOT retry 4xx — an invalid/expired license needs the
    customer to act, not more attempts.
    """
    last_error = None
    for attempt in range(max_attempts):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read())
        except urllib.error.HTTPError as e:
            if 400 <= e.code < 500:
                raise
            last_error = e
        except Exception as e:
            last_error = e
        if attempt < max_attempts - 1:
            time.sleep(2 ** attempt)
    raise last_error


def activate(license_key):
    """Verify a license key against the server (billing/entitlement check
    only) and store the result locally."""
    device_id = get_device_id()
    payload = json.dumps({"license_key": license_key, "device_id": device_id}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/activate",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        result = request_with_retries(req, timeout=10)
    except Exception as e:
        print(f"Could not reach Curant's server: {e}")
        sys.exit(1)

    if not result.get("valid"):
        error = result.get("error")
        if error == "license_already_bound_to_another_device":
            print("This license key is already activated on a different Mac. "
                  "A license can only be active on one Mac at a time. If that Mac is "
                  "gone or you've upgraded, run `curant-cli request-release` — this doesn't "
                  "release it automatically, a person reviews the request first (or call "
                  "support directly at curant.app/support).")
        elif error == "device_already_bound_to_another_license":
            print("This Mac is already activated with a different license key. "
                  "A Mac can only run one Curant license at a time.")
        else:
            print("That license key isn't valid or isn't active. Check your account at curant.app/billing.")
        sys.exit(1)

    config = load_config()
    config["license_key"] = license_key
    config["device_id"] = device_id  # informational only — always recomputed live from
                                       # hardware when actually used, never read back from here
    config["customer_id"] = result.get("customer_id")
    config["customer_name"] = result.get("customer_name")
    config["plan"] = result.get("plan", "base")
    config["unlocked_addons"] = result.get("unlocked_addons", [])
    config.setdefault("persona", "curant")
    config.setdefault("reply_format", "text")
    config.setdefault("voice_tier", "standard")
    config.setdefault("proactivity_enabled", False)
    config.setdefault("instructions", "")
    config["last_status_check"] = time.time()
    config["last_status_active"] = True
    save_config(config)
    init_local_db()
    print(f"Activated. Welcome, {result.get('customer_name', 'there')} — your Curant is ready.")
    if not get_api_key(config):
        print(f"One more step: run `curant-cli set-api-key <your-api-key>` to connect your "
              f"own {get_provider(config)} API key. This stays on your Mac only — it is never "
              f"sent to Curant's server. (Anthropic is the default provider; run "
              f"`curant-cli set-provider openai` first if you'd rather use OpenAI — your "
              f"persona, instructions, and memories carry over either way.)")


GENERATION_SERVICES = {"flux", "ideogram", "elevenlabs", "veo", "descript"}  # August-only, gated separately


def set_api_key(api_key, provider=None):
    """Store the customer's own API key locally, for a given provider
    or specialist generation service (default: whichever LLM provider
    is currently configured, or anthropic if none set yet). Never
    touches Curant's server — used only for direct calls from this
    machine."""
    config = load_config()
    provider = provider or get_provider(config)
    if provider not in PROVIDER_MODELS and provider not in GENERATION_SERVICES:
        print(f"Unknown provider/service '{provider}'. Supported: "
              f"{', '.join(sorted(PROVIDER_MODELS) + sorted(GENERATION_SERVICES))}")
        sys.exit(1)

    if provider == "anthropic" and not api_key.startswith("sk-ant-"):
        print("That doesn't look like an Anthropic API key (should start with 'sk-ant-'). "
              "Get yours at https://console.anthropic.com/settings/keys")
        sys.exit(1)
    if provider == "openai" and not api_key.startswith("sk-"):
        print("That doesn't look like an OpenAI API key (should start with 'sk-'). "
              "Get yours at https://platform.openai.com/api-keys")
        sys.exit(1)
    # Generation services don't get a format check — their key formats
    # aren't reliably known/stable enough to validate confidently, so
    # this just stores whatever's given rather than guessing at a prefix.

    config.setdefault("api_keys", {})
    config["api_keys"][provider] = api_key
    save_config(config)
    print(f"API key saved locally for {provider}. It will never be sent to Curant's server.")


def set_provider(provider):
    """Switch which model provider handles messages going forward. Same
    persona/instructions/memories/important-people drive it either way —
    that continuity across providers is the entire point (see
    PORTABLE_MEMORY_SPEC.md)."""
    if provider not in PROVIDER_MODELS:
        print(f"Unknown provider '{provider}'. Supported: {', '.join(PROVIDER_MODELS)}")
        sys.exit(1)
    config = load_config()
    config["provider"] = provider
    save_config(config)
    if not get_api_key(config, provider):
        print(f"Provider set to {provider}. You'll need to run "
              f"`curant-cli set-api-key <key> --provider {provider}` before messages will work.")
    else:
        print(f"Provider set to {provider}. Your existing persona, instructions, and memories "
              f"carry over unchanged — that's the whole point.")


def refresh_status_if_stale(config):
    """Re-check license/billing status with the server at most every
    STATUS_RECHECK_SECONDS. Falls back to the last cached result if the
    server is unreachable, so a brief outage doesn't stop Curant from
    working — but a persistently unreachable server combined with a
    stale cache is surfaced rather than trusted forever.

    Also piggybacks the usage-count report on this same periodic call
    (rather than sending one on every single message) — that keeps the
    "how much is this used" signal to a coarse count on a ~12h cadence,
    not a per-message timing signal.
    """
    key = config.get("license_key")
    if not key:
        return config, False

    last_check = config.get("last_status_check", 0)
    if time.time() - last_check < STATUS_RECHECK_SECONDS:
        return config, config.get("last_status_active", False)

    device_id = get_device_id()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/status?device_id={device_id}",
        headers={"Authorization": f"Bearer {key}"},
    )
    try:
        result = request_with_retries(req, timeout=10)
        config["last_status_check"] = time.time()
        config["last_status_active"] = bool(result.get("active"))
        config["plan"] = result.get("plan", config.get("plan", "base"))
        config["unlocked_addons"] = result.get("unlocked_addons", config.get("unlocked_addons", []))
        save_config(config)
        report_usage_if_pending(config)
        return config, config["last_status_active"]
    except Exception as e:
        print(f"Could not reach Curant's server to re-verify status (using cached result): {e}", file=sys.stderr)
        return config, config.get("last_status_active", False)


def report_usage_if_pending(config):
    """Send the accumulated local message count since the last report —
    a count only, never content or timestamps of individual messages.
    Best-effort: failure here never blocks anything else."""
    pending = config.get("pending_usage_count", 0)
    if pending <= 0:
        return
    key = config.get("license_key")
    payload = json.dumps({"message_count": pending}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/usage-report",
        data=payload,
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"},
        method="POST",
    )
    try:
        request_with_retries(req, timeout=10, max_attempts=1)
        config["pending_usage_count"] = 0
        save_config(config)
    except Exception as e:
        print(f"Usage report failed (non-fatal, will retry next cycle): {e}", file=sys.stderr)


def report_error(error_code, component):
    """Report a known, enumerated error code — never free text, never an
    exception message, never message content. Best-effort and silent on
    failure; this is a nice-to-have visibility signal, never allowed to
    block or complicate the actual error handling it's called from."""
    config = load_config()
    key = config.get("license_key")
    if not key:
        return
    payload = json.dumps({"error_code": error_code, "component": component}).encode()
    req = urllib.request.Request(
        f"{SERVER_BASE}/v1/error-report",
        data=payload,
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"},
        method="POST",
    )
    try:
        request_with_retries(req, timeout=10, max_attempts=1)
    except Exception:
        pass  # never let telemetry reporting itself become a new failure mode


def status():
    """Check whether the current install is activated and in good standing."""
    config = load_config()
    if DEV_UNLICENSED:
        _warn_dev_unlicensed()
        print(f"DEV (unlicensed) — license checks bypassed. "
              f"persona: {config.get('persona', 'curant')}, provider: {get_provider(config)}")
