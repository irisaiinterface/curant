def get_important_people():
    # Excludes anyone flagged is_spam -- a spam-marked handle shouldn't
    # keep showing up in "people who matter to this customer" context
    # just because a row still exists for it (see set_person_spam).
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT name, relationship, note, handle, gender, role, is_spam, is_vip "
            "FROM important_people WHERE is_spam IS NOT 1"
        ).fetchall()
        return [dict(r) for r in rows]


def get_person_by_handle(handle):
    """Local people-memory lookup keyed on a real iMessage handle (phone
    number or email) -- this is what lets an incoming text's sender be
    matched to someone Curant actually has a record of, as opposed to
    get_important_people()'s free-text name matching. Returns None if no
    row has this exact handle."""
    if not handle:
        return None
    with closing(get_local_db()) as conn:
        row = conn.execute(
            "SELECT name, relationship, note, handle, gender, role, is_spam, is_vip "
            "FROM important_people WHERE handle = ?", (handle,)
        ).fetchone()
        return dict(row) if row else None


def upsert_person(handle, name=None, relationship=None, note=None, gender=None, role=None):
    """Creates or updates a person record keyed on handle. Only fields
    actually passed (non-None) overwrite what's already stored -- calling
    this with just a name after a handle already has a role/note saved
    doesn't blow those away. Used by the remember_person tool (see
    get_all_available_tools) so Curant can save what it's told about a
    person mid-conversation ("that's Aarav, my friend from college") and
    recall it on their next message."""
    if not handle:
        raise ValueError("upsert_person requires a handle")
    existing = get_person_by_handle(handle)
    with closing(get_local_db()) as conn:
        if existing:
            conn.execute(
                """UPDATE important_people SET
                       name = COALESCE(?, name),
                       relationship = COALESCE(?, relationship),
                       note = COALESCE(?, note),
                       gender = COALESCE(?, gender),
                       role = COALESCE(?, role),
                       updated_at = CURRENT_TIMESTAMP
                   WHERE handle = ?""",
                (name, relationship, note, gender, role, handle),
            )
        else:
            conn.execute(
                """INSERT INTO important_people (name, relationship, note, handle, gender, role, updated_at)
                   VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)""",
                (name or handle, relationship, note, handle, gender, role),
            )
        conn.commit()
    return get_person_by_handle(handle)


def set_person_spam(handle, is_spam=True):
    """Flags (or un-flags) a handle as spam. A spam-marked handle is
    filtered by curant-watcher.py's screening path (see the `screen`
    subcommand) BEFORE it ever reaches the customer as a notification --
    the point is to stop bothering the customer with the same spammer
    over and over, not just to hide it from get_important_people()'s
    context. Creates a minimal record if this handle has no person row
    yet (most spam never will)."""
    if not handle:
        raise ValueError("set_person_spam requires a handle")
    existing = get_person_by_handle(handle)
    with closing(get_local_db()) as conn:
        if existing:
            conn.execute(
                "UPDATE important_people SET is_spam = ?, updated_at = CURRENT_TIMESTAMP WHERE handle = ?",
                (1 if is_spam else 0, handle),
            )
        else:
            conn.execute(
                "INSERT INTO important_people (name, handle, is_spam, updated_at) VALUES (?, ?, ?, CURRENT_TIMESTAMP)",
                (handle, handle, 1 if is_spam else 0),
            )
        conn.commit()


def set_vip(handle, is_vip=True):
    """
    Grace-exclusive VIP escalation. Flags (or un-flags) a handle as VIP
    -- see get_vip_handles() for how this actually changes behavior
    (curant-watcher.py's fetch_new_messages allows VIP handles through
    even in the default secure 'approved' text-access mode, where every
    OTHER non-customer sender's messages are never even fetched from
    chat.db at all). Same "create a minimal record if none exists yet"
    pattern as set_person_spam. Caller (mark_vip_cmd) is responsible for
    the tier gate -- this function itself has no gate, matching how
    set_person_spam has none either (it's a pure data-layer function)."""
    if not handle:
        raise ValueError("set_vip requires a handle")
    existing = get_person_by_handle(handle)
    with closing(get_local_db()) as conn:
        if existing:
            conn.execute(
                "UPDATE important_people SET is_vip = ?, updated_at = CURRENT_TIMESTAMP WHERE handle = ?",
                (1 if is_vip else 0, handle),
            )
        else:
            conn.execute(
                "INSERT INTO important_people (name, handle, is_vip, updated_at) VALUES (?, ?, ?, CURRENT_TIMESTAMP)",
                (handle, handle, 1 if is_vip else 0),
            )
        conn.commit()


def get_vip_handles():
    """Every handle currently flagged VIP -- used by curant-watcher.py's
    fetch_new_messages to let these specific senders' messages through
    even in 'approved' access mode, where every other non-customer
    sender is filtered out at the SQL level before Curant ever sees
    their message exists. VIP messages still only ever go through the
    notify-the-owner screening path, never full auto-reply -- being VIP
    means "always tell me when they text," not "let Curant talk to them
    on my behalf." """
    with closing(get_local_db()) as conn:
        rows = conn.execute(
            "SELECT handle FROM important_people WHERE is_vip = 1 AND handle IS NOT NULL AND handle != ''"
        ).fetchall()
        return [r["handle"] for r in rows]


def vip_handles_cmd():
    """Internal -- prints VIP handles as a JSON array, for
    curant-watcher.py to call once at startup (same pattern as how it
    reads CUSTOMER_HANDLES from config once at module load)."""
    print(json.dumps(get_vip_handles()))


def get_delegate_handles():
    """Every handle currently registered as an active delegate -- see
    add_delegate_cmd. Used by curant-watcher.py to (a) let a delegate's
    messages through the SQL-level allowlist even in 'approved' access
    mode, same as VIP handles, and (b) route a delegate's message
    through the FULL relay path (real assistant capability, replying
    back to the delegate directly) instead of the notify-only screening
    path every other non-customer sender gets. That's the actual
    difference between a delegate and a VIP: a VIP being flagged means
    "always tell me when they text"; a delegate means "let them actually
    use Curant on my behalf." """
    with closing(get_local_db()) as conn:
        rows = conn.execute("SELECT handle FROM delegates WHERE active = 1").fetchall()
        return [r["handle"] for r in rows]


def delegate_handles_cmd():
    """Internal -- prints delegate handles as JSON, for curant-watcher.py
    to read once at startup (same pattern as vip_handles_cmd)."""
    print(json.dumps(get_delegate_handles()))


def add_delegate_cmd(handle, label):
    """Grace-exclusive. `curant-cli add-delegate <handle> [label]` --
    grants a second person full assistant access to this same Curant
    install, sharing the same persona/memories/important-people context
    as the executive. This is a genuinely bigger trust decision than
    anything else Grace unlocks (VIP escalation only ever notifies the
    owner; a delegate can actually transact with Curant), so it's kept
    to an explicit, deliberate add/remove action rather than any
    automatic heuristic."""
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("Delegate access is a Grace-exclusive feature.")
        sys.exit(1)
    if not handle:
        print("Usage: curant-cli add-delegate <handle> [label]")
        sys.exit(1)
    with closing(get_local_db()) as conn:
        conn.execute(
            "INSERT INTO delegates (handle, label, active) VALUES (?, ?, 1) "
            "ON CONFLICT(handle) DO UPDATE SET label = excluded.label, active = 1",
            (handle, label or ""),
        )
        conn.commit()
    print(f"{handle} added as a delegate{f' ({label})' if label else ''}. They can now message "
          f"this Curant install with full assistant access, sharing the same context you have.")


def remove_delegate_cmd(handle):
