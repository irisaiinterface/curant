def _build_oauth_provider(server):
    """
    For servers using auth_mode 'oauth' — reuses the already-persisted
    tokens from CurantTokenStorage rather than re-running the interactive
    browser flow (that only happens once, during mcp-add-oauth). If the
    access token has expired, OAuthClientProvider handles refreshing it
    silently via the refresh token, same as it would mid-session.
    redirect_handler/callback_handler are still required by the SDK's
    constructor even though they should never actually fire here (no
    valid token + no refresh token would mean the login genuinely needs
    to be redone via mcp-add-oauth, not silently re-prompted mid-reply).
    """
    from mcp.client.auth import OAuthClientProvider
    from mcp.shared.auth import OAuthClientMetadata

    async def _unexpected_redirect(auth_url):
        raise RuntimeError(
            "This server's login has expired or was never completed — "
            "run curant-cli mcp-add-oauth again to log in."
        )

    async def _unexpected_callback():
        raise RuntimeError("Unexpected re-authorization required — run mcp-add-oauth again.")

    return OAuthClientProvider(
        server_url=server["url"],
        client_metadata=OAuthClientMetadata(
            redirect_uris=[f"http://127.0.0.1:{OAUTH_CALLBACK_PORT}/callback"],
            client_name="Curant",
            grant_types=["authorization_code", "refresh_token"],
            response_types=["code"],
        ),
        storage=CurantTokenStorage(server["name"]),
        redirect_handler=_unexpected_redirect,
        callback_handler=_unexpected_callback,
    )


def list_tools_from_server(server_name, server):
    """
    Best-effort — an unreachable or misbehaving MCP server should reduce
    Curant's capability for this message, not break it entirely. Returns
    an empty list on any failure. `server` is a full server dict from
    get_mcp_servers() — dispatches to stdio, Streamable HTTP, or SSE
    based on its 'transport' field. Streamable HTTP is the modern
    standard remote MCP transport; SSE is the older one, still used by
    a few real services (Square, confirmed) even though most have moved
    to Streamable HTTP.
    """
    try:
        if server.get("transport") == "http":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_list_tools_http_async(server["url"], server.get("headers"), auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        if server.get("transport") == "sse":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_list_tools_sse_async(server["url"], server.get("headers"), auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        return asyncio.run(asyncio.wait_for(
            _mcp_list_tools_stdio_async(server["command"]), timeout=MCP_CALL_TIMEOUT_SECONDS
        ))
    except Exception as e:
        print(f"Could not list tools from MCP server '{server_name}' (non-fatal, skipping it): {e}", file=sys.stderr)
        return []


def call_mcp_tool(server, tool_name, arguments):
    """Errors are returned as a text result the model can see and react
    to ('that tool failed') rather than raised — a broken third-party
    tool call shouldn't crash the whole reply when the model could
    instead just tell the customer it didn't work. `server` is a full
    server dict — dispatches to stdio, HTTP, or SSE the same way listing does."""
    try:
        if server.get("transport") == "http":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_call_tool_http_async(server["url"], server.get("headers"), tool_name, arguments, auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        if server.get("transport") == "sse":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_call_tool_sse_async(server["url"], server.get("headers"), tool_name, arguments, auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        return asyncio.run(asyncio.wait_for(
            _mcp_call_tool_stdio_async(server["command"], tool_name, arguments),
            timeout=MCP_CALL_TIMEOUT_SECONDS,
        ))
    except Exception as e:
        return f"[Error calling this tool: {e}]"


MCP_TOOLS_CACHE_MAX_AGE_SECONDS = 60 * 60  # refresh each server's tool list at most hourly —
                                             # listing tools means spawning a subprocess and a
                                             # full protocol handshake per server, which would
                                             # make every single reply noticeably slower if done
                                             # on every message with any MCP servers configured


def _get_server_tools_cached(server):
    """Returns a server's tool list, using the cache unless it's stale
    or missing. Refreshing on a cache miss/expiry still costs a real
    subprocess spawn + handshake, but that now happens at most hourly
    per server instead of on every message."""
    if server.get("tools_cache") and server.get("tools_cached_at"):
        try:
            cached_at = server["tools_cached_at"]
            with closing(get_local_db()) as conn:
                row = conn.execute(
                    "SELECT (julianday('now') - julianday(?)) * 86400 AS age_seconds", (cached_at,)
                ).fetchone()
                if row and row["age_seconds"] is not None and row["age_seconds"] < MCP_TOOLS_CACHE_MAX_AGE_SECONDS:
                    return json.loads(server["tools_cache"])
        except Exception:
            pass  # fall through to a fresh fetch on any cache-parsing weirdness

    tools = list_tools_from_server(server["name"], server)
    with closing(get_local_db()) as conn:
        conn.execute(
            "UPDATE mcp_servers SET tools_cache = ?, tools_cached_at = CURRENT_TIMESTAMP WHERE name = ?",
            (json.dumps(tools), server["name"]),
        )
        conn.commit()
    return tools


