def get_quote_phone_number(config):
    """Real bug fixed 2026-08-13: QUOTE_PHONE_NUMBER above was a bare
    literal that had never been filled in, and log_capability_gap was
    reciting it verbatim to real customers ("call
    REPLACE_WITH_REAL_PHONE_NUMBER") — a placeholder value leaking
    straight into customer-facing text because there was no fallback
    behavior for "not configured yet," just an assumption someone would
    remember to edit the constant before shipping.

    Reads config['quote_phone_number'] instead (settable via
    `curant-cli set-quote-phone <number>` or directly in
    ~/.curant/config.json) and returns None if it isn't set, so callers
    can omit the "call ___" clause entirely rather than print a
    placeholder. A missing phone number should degrade to "no call-to-
    action for a paid quote yet," never to a broken-looking string sent
    to a real customer."""
    number = (config.get("quote_phone_number") or "").strip()
    return number or None


def log_capability_gap(description):
    """
    Called (as a tool, from relay()) whenever the customer asks for
    something Curant genuinely can't do. Logs it locally so patterns
    across what gets asked for are reviewable later, AND sends an
    immediate, separate text straight to the account owner (config's
    customer_apple_id) via send_imessage — not just relying on it
    showing up buried in whatever reply the model happens to write back
    in the same turn. Real motivation: the owner explicitly asked for
    capability gaps to be sent to them directly, not just logged
    somewhere they'd have to go dig for (the feature_requests table) --
    same "don't make the important thing require going and checking"
    reasoning as _notify_task_starting's "starting now" texts.

    Sending to customer_apple_id specifically (not _current_apple_id) is
    deliberate: this should always reach the actual account owner, even
    in a future where a capability gap gets hit in some OTHER
    conversation thread (e.g. the screening flow) rather than the
    owner's own chat -- _current_apple_id would be wrong in that case,
    customer_apple_id is always right.

    Fails soft on the notification send (never raises, never blocks the
    tool's normal return) -- a failed courtesy notice shouldn't be the
    reason the customer-facing reply itself breaks. No server round-trip
    for the LOGGING itself: this doesn't need confirmation before being
    called, since logging locally + texting the owner has no side effect
    on anyone but the person running this Mac.

    Checks _recently_logged_similar_gap() first -- see that function and
    CAPABILITY_GAP_COOLDOWN_MINUTES's comment for the real bug this
    guards against (the model re-surfacing/re-logging the same
    unresolved gap on unrelated follow-up messages, spamming the owner
    and reciting the quote-call notice repeatedly). A genuine duplicate
    within the cooldown window still isn't silently dropped -- it
    returns a short, honest "already flagged" reply instead of pretending
    nothing happened, and does NOT re-text the owner or re-export the
    xlsx for something already reflected there.
    """
    duplicate = _recently_logged_similar_gap(description)
    if duplicate:
        print(f"[capability gap] \"{description}\" -- treating as a duplicate of "
              f"\"{duplicate['request_text']}\" logged at {duplicate['created_at']} "
              f"(within {CAPABILITY_GAP_COOLDOWN_MINUTES}min cooldown), not re-notifying", file=sys.stderr)
        return "Already flagged that one a few minutes ago — no need to log it again."

    save_feature_request_local(description, status="logged")

    xlsx_path = None
    try:
        xlsx_path = export_capability_gaps_xlsx()
    except Exception as e:
        print(f"[capability-gap xlsx export] failed (non-fatal, local.db entry still saved): {e}", file=sys.stderr)

    # ALWAYS print a clear, unconditional line -- this is the guaranteed
    # "gets shared even on a local-only setup" channel: curant-watcher.py
    # now forwards curant-cli's stderr into ITS OWN stderr (see the fix
    # in relay_to_curant()/screen_with_curant()), which launchd already
    # pipes to /tmp/curant-watcher-error.log -- so this line lands
    # somewhere real and persistent regardless of whether iMessage
    # sending works, whether a customer_apple_id is even configured, or
    # whether this is being run by hand with no watcher at all (in which
    # case it just prints straight to the terminal). The text/xlsx
    # notification below is the NICE-TO-HAVE on top of this, not a
    # replacement for it.
    print(f"[capability gap] \"{description}\" -- logged"
          + (f", spreadsheet updated at {xlsx_path}" if xlsx_path else ""), file=sys.stderr)

    config = load_config()
    is_grace = get_customer_august_tier(config) == "grace"

    # Grace-exclusive: skip the "call for a custom quote" wall entirely --
    # the gap gets flagged directly on Abhy's owner dashboard, urgent,
    # best-effort (a failure here never blocks the local log/xlsx/text
    # path below, which always happens regardless of tier).
    forwarded_to_owner_directly = False
    if is_grace:
        try:
            import requests
            key = config.get("license_key")
            if key:
                resp = requests.post(
                    f"{SERVER_BASE}/v1/urgent-capability-gap",
                    headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"},
                    json={"description": description},
                    timeout=15,
                )
                forwarded_to_owner_directly = resp.status_code == 200 and resp.json().get("ok")
        except Exception as e:
            print(f"[urgent capability gap] forward failed (non-fatal, falling back to normal "
                  f"logging): {e}", file=sys.stderr)

        # Also draft a proposed code fix and submit it for the owner's
        # manual review -- this NEVER applies, merges, or executes
        # anything on its own. See draft_code_proposal_for_gap's
        # docstring for the full safety reasoning; this is strictly
        # "write a draft, hand it to a human" -- the actual approve
        # action on the server dashboard only changes a status column,
        # it does not deploy code either.
        try:
            propose_code_fix_for_gap(description, config)
        except Exception as e:
            print(f"[code proposal] drafting failed (non-fatal): {e}", file=sys.stderr)

    try:
        owner = config.get("customer_apple_id")
        quote_phone = get_quote_phone_number(config)
        if owner:
            if forwarded_to_owner_directly:
                tail = "— flagged directly to Abhy as a priority build request, no need to call anyone."
            elif quote_phone:
                tail = (f"— let me know if you want to prioritize building it, or if it's worth a "
                        f"custom quote (call {quote_phone}).")
            else:
                tail = "— let me know if you want to prioritize building it."
            send_imessage(
                owner,
                f"(Capability gap logged) Just hit something I can't do yet: \"{description}\". "
                f"Full list is at {CAPABILITY_GAPS_XLSX_PATH} on this Mac (kept in sync automatically) "
                + tail
            )
        else:
            print("[capability gap] no customer_apple_id configured -- couldn't text a notice, "
                  "but it's saved in feature_requests and the .xlsx above.", file=sys.stderr)
    except Exception as e:
        print(f"[capability-gap notice] failed to send (non-fatal): {e}", file=sys.stderr)

    if forwarded_to_owner_directly:
        return ("Logged and flagged directly to Abhy as a priority build request — "
                "no need to call anyone.")
    quote_phone = get_quote_phone_number(config)
    if quote_phone:
        return (f"Logged. For custom work like this, they'd need to call {quote_phone} "
                f"for a quote — Curant doesn't build one-off custom features for free.")
    return ("Logged. Curant doesn't build one-off custom features for free — I'll flag this "
            "one for review.")


IMAGE_MIME_TYPES = {
    ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png",
    ".gif": "image/gif", ".webp": "image/webp", ".heic": "image/heic",
    ".bmp": "image/bmp", ".tiff": "image/tiff",
}


def build_image_message_content(provider, image_path, text):
    """
    Builds a provider-shaped content array for a message that includes an
    image — both Anthropic and OpenAI accept an array of content blocks
    instead of a plain string, but the block shape for an image genuinely
    differs between them, so this is the one place that difference is
    handled, same pattern as the system-prompt handling in _call_openai.
    Falls back to plain text (no image block) if the file can't be read
    or the extension isn't recognized, rather than failing the whole
    message over an attachment problem.
    """
    import base64
    ext = os.path.splitext(image_path)[1].lower()
    mime_type = IMAGE_MIME_TYPES.get(ext)
    if not mime_type:
        return text or "[Sent an image in an unrecognized format]"
    try:
        with open(image_path, "rb") as f:
            image_b64 = base64.b64encode(f.read()).decode()
    except Exception as e:
        return (text or "") + f"\n[Couldn't read the attached image: {e}]"

    if provider == "anthropic":
        return [
            {"type": "image", "source": {"type": "base64", "media_type": mime_type, "data": image_b64}},
            {"type": "text", "text": text or "What's in this image?"},
        ]
    elif provider == "openai":
        return [
            {"type": "text", "text": text or "What's in this image?"},
            {"type": "image_url", "image_url": {"url": f"data:{mime_type};base64,{image_b64}"}},
        ]
    else:
        return text or "[Image attached — this provider doesn't have image support wired up]"


RELATIONSHIP_STATE_MAX_AGE_HOURS = 24


def get_relationship_state(config, provider=None, api_key=None):
    """
    Grace-exclusive (Step 3 of the "make Curant more human" work). The
    existing memory system stores FACTS ("their dog's name is Bodhi").
    This derives something different from those same facts plus recent
    conversation history: a small profile of HOW this specific customer
    prefers to be talked to -- formality, brevity, warmth, and any
    topics worth extra care around -- so memory can shape TONE turn to
    turn, not just supply reference material the model recites.

    Deliberately cached and refreshed at most once every
    RELATIONSHIP_STATE_MAX_AGE_HOURS, not recomputed on every message --
    this is a real extra LLM call, and a customer's communication
    preferences don't meaningfully shift message to message the way
    "what did they just say" does. Cached in config.json under
    "relationship_state" / "relationship_state_computed_at".

    Returns None (never blocks the reply) if: not Grace tier, no
    provider/api_key available, fewer than 3 memories logged yet (not
    enough signal to infer anything real from), or the derivation call
    itself fails for any reason -- in all of these cases the customer
    just gets today's non-personalized tone, exactly like before this
    existed, not a broken reply.
    """
    if get_customer_august_tier(config) != "grace":
        return None

    cached = config.get("relationship_state")
    computed_at = config.get("relationship_state_computed_at")
    if cached and computed_at:
        try:
            age_hours = (datetime.now() - datetime.fromisoformat(computed_at)).total_seconds() / 3600
            if age_hours < RELATIONSHIP_STATE_MAX_AGE_HOURS:
                return cached
        except Exception:
            pass  # malformed timestamp -- fall through and recompute

    if not provider or not api_key:
        return cached  # can't recompute right now; stale cache beats nothing

    memories = get_memories()
    if len(memories) < 3:
        return cached

    try:
        history = get_history(limit=20)
        history_lines = []
        for h in history:
            content = h.get("content")
            if isinstance(content, str):
                history_lines.append(f"{h.get('role')}: {content}")
        extra = (
            "Based on what you know about this customer (their stored memories) and recent "
            "conversation history, infer their actual communication preferences -- not facts about "
            "their life, but HOW they like to be talked to.\n\n"
            "Memories:\n" + "\n".join(f"- {m}" for m in memories) + "\n\n"
            "Recent conversation:\n" + "\n".join(history_lines[-20:]) + "\n\n"
            'Respond with ONLY a JSON object: {"formality": "casual" or "formal", '
            '"brevity": "brief" or "detailed", "warmth": "warm" or "reserved", '
            '"handle_with_care": ["topic1", ...] (empty list if none), '
            '"note": "one short sentence of anything else genuinely useful about their communication '
            'style, or empty string"}. Base this only on real signal in the conversation -- if there '
            "isn't enough to tell, use reasonable moderate defaults rather than guessing at extremes."
        )
        system_prompt = build_system_prompt(config, [], [], "", extra_instruction=extra)
        raw = call_llm(
            provider, api_key, system_prompt,
            messages=[{"role": "user", "content": "Infer the communication-style profile now."}],
            max_tokens=300, tier="fast",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        state = json.loads(raw)
        config["relationship_state"] = state
        config["relationship_state_computed_at"] = datetime.now().isoformat()
        save_config(config)
        return state
    except Exception as e:
        print(f"[relationship state] derivation failed (non-fatal): {e}", file=sys.stderr)
        return cached


def relationship_state_cmd():
    """Customer-facing transparency command: `curant-cli relationship-state`
    -- shows what Curant has currently inferred about how you like to be
    talked to, in plain language. Grace-exclusive, same as the feature
    itself."""
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("Relationship-aware tone is a Grace-exclusive feature.")
        sys.exit(1)
    state = config.get("relationship_state")
    if not state:
        print("Nothing inferred yet -- this builds up after a handful of conversations and memories.")
        return
    computed_at = config.get("relationship_state_computed_at", "unknown time")
    print(f"As of {computed_at}, here's what I've picked up about how you like to be talked to:")
    print(f"  Formality: {state.get('formality', 'unknown')}")
    print(f"  Reply length: {state.get('brevity', 'unknown')}")
    print(f"  Warmth: {state.get('warmth', 'unknown')}")
    care = state.get("handle_with_care") or []
    if care:
        print(f"  Topics I'm handling with extra care: {', '.join(care)}")
    if state.get("note"):
        print(f"  Note: {state['note']}")


def _current_time_context_str(config):
    """Real gap fixed 2026-08-13: build_system_prompt never told the
    model what time it currently is, anywhere. Every other piece of
    "now"-relative behavior in this file (quiet hours, relationship-
    state freshness, background job timeouts) computes its own
    datetime.now() internally, but the MODEL ITSELF -- the thing
    actually answering "what time is it", converting "brief me at 7pm"
    to a stored HH:MM, or reasoning about "in 2 hours"/"tomorrow" -- had
    no grounding on the current date/time at all and could only guess.
    Reuses the same travel_timezone-or-local-system-time logic as
    _is_quiet_hours_now for consistency -- whatever timezone quiet hours
    already treats as authoritative is what the model should reason
    against too."""
    now = datetime.now()
    tz_label = "this Mac's local time"
    tz_name = config.get("travel_timezone")
    if tz_name:
        try:
            from zoneinfo import ZoneInfo
            now = datetime.now(ZoneInfo(tz_name))
            tz_label = tz_name
        except Exception:
            pass  # fall back to local time if the stored tz somehow became invalid
    formatted = now.strftime("%A, %B %d, %Y, %I:%M %p").lstrip("0").replace(" 0", " ")
    return f"Right now it is {formatted} ({tz_label})."


def build_system_prompt(config, memories, people, live_context, extra_instruction=None,
                        active_provider=None, is_first_message=False, urgency=None,
                        relationship_state=None):
    persona_prompt = PERSONAS.get(config.get("persona", "curant"), PERSONAS["curant"])
    addons = config.get("unlocked_addons", [])

    system_parts = [persona_prompt]
    system_parts.append(
        _current_time_context_str(config) + " Use this as your ground truth for the current date/time "
        "-- when the customer says something time-relative (\"in 2 hours\", \"tomorrow morning\", "
        "\"7pm tonight\", \"what time is it\"), compute it from this, don't guess or say you don't "
        "know what time it is. Use it silently for that math -- don't recite today's date/time back "
        "in your reply unless the customer specifically asked what time or day it is. Real bug found "
        "in the persona regression suite (2026-08-19): asked \"what's on my calendar tomorrow\", the "
        "model opened with \"It is Wednesday, August 19, 2026, 12:17 PM\" before ever answering the "
        "actual question -- wasted words nobody asked for, and it hit especially hard on terser "
        "personas (Miles, Aaron) with tight reply-length expectations. Just answer what was asked."
    )
    pending_sends = get_pending_email_sends(status="pending")
    if pending_sends:
        lines = [
            f"#{p['id']}: to {p['to_addr']}, subject \"{p['subject']}\" -- {p['reasoning'] or 'no reasoning given'}"
            for p in pending_sends
        ]
        system_parts.append(
            "Emails an unattended background check drafted and is waiting on the customer to approve "
            "before anything actually sends (see process_email_approvals):\n" + "\n".join(lines) +
            "\nIf the customer's message is about approving/rejecting/reviewing these, use "
            "process_email_approvals with the right ids. If they just ask what's pending, answer from "
            "this list directly."
        )
    pending_update = config.get("pending_auto_update")
    if pending_update:
        system_parts.append(
            f"There's a Curant software update waiting on the customer's approval: version "
            f"{pending_update['version']} (currently running {CURANT_VERSION})"
            + (f" -- {pending_update['changelog']}" if pending_update.get("changelog") else "") +
            ". The offer specifically asked the customer to reply UPDATE or SKIP, precisely so a "
            "bare reply about this doesn't get confused with anything else being discussed -- if their "
            "message is UPDATE/install it/go ahead/yes (or SKIP/not now/no), use apply_pending_update "
            "with their answer (true to install, false to decline) EVEN IF another topic was just being "
            "discussed; this offer is a separate thread from whatever else is going on. If they're just "
            "asking what's pending or whether an update is available, answer from this directly rather "
            "than guessing."
        )
    if relationship_state:
        # Grace-exclusive (see get_relationship_state) -- this is what makes
        # memory shape HOW you talk to this specific customer, not just WHAT
        # you know about them. Placed early, right after the persona itself,
        # since it should color the whole reply, not read as one fact among many.
        bits = []
        formality = relationship_state.get("formality")
        if formality:
            bits.append(f"they read as {formality} in how they communicate -- match that, don't default to formal")
        brevity = relationship_state.get("brevity")
        if brevity == "brief":
            bits.append("they respond well to short, to-the-point replies -- don't pad this one out")
        elif brevity == "detailed":
            bits.append("they tend to want real detail, not just the headline")
        warmth = relationship_state.get("warmth")
        if warmth:
            bits.append(f"their tone with you reads as {warmth} -- meet that rather than overriding it")
        care = relationship_state.get("handle_with_care") or []
        if care:
            bits.append(f"handle these topics with extra care based on past conversations: {', '.join(care)}")
        note = relationship_state.get("note")
        if note:
            bits.append(note)
        if bits:
            system_parts.append(
                "How this specific customer prefers to be talked to, learned from your actual history "
                "with them (this should shape tone and delivery, not what's technically true): "
                + "; ".join(bits) + "."
            )
    if config.get("instructions"):
        system_parts.append(f"Standing instructions from this customer: {config['instructions']}")
    if memories:
        system_parts.append("What you've learned about this customer so far:\n" + "\n".join(f"- {m}" for m in memories))
    if live_context:
        system_parts.append(
            "Live context from their device right now (calendar/reminders — "
            "use this naturally, don't just recite it back):\n" + live_context
        )
    if people:
        def _person_line(p):
            bits = [p.get("relationship") or ""]
            if p.get("role"):
                bits.append(f"role: {p['role']}")
            if p.get("gender"):
                bits.append(f"gender: {p['gender']}")
            descriptor = ", ".join(b for b in bits if b)
            note = f": {p['note']}" if p.get("note") else ""
            return f"- {p['name']} ({descriptor}){note}" if descriptor else f"- {p['name']}{note}"
        people_str = "\n".join(_person_line(p) for p in people)
        system_parts.append(f"People who matter to this customer:\n{people_str}")
    if addons:
        system_parts.append(f"Unlocked add-ons: {', '.join(addons)}. You may use these capabilities.")
    else:
        system_parts.append("Base plan only — do not offer autonomous sending or other locked features; suggest unlocking the relevant add-on instead.")
    custom_briefing_time = config.get("custom_briefing_time")
    system_parts.append(
        f"Automated background notifications for this customer — daily briefing (structured digest "
        f"of today's agenda plus open reminders, sent automatically at 9am and 5pm when there's "
        f"something to report): {'on' if config.get('daily_briefing_enabled', True) else 'off'}. "
        f"Proactive check-ins (your own judgment call on whether anything unprompted is worth a "
        f"heads-up, off by default and much more conservative than the briefing): "
        f"{'on' if config.get('proactivity_enabled') else 'off'}. Custom additional briefing time (a "
        f"third daily send on top of 9am/5pm, at a specific time the customer picked): "
        + (f"set to {custom_briefing_time}." if custom_briefing_time else "not set.") +
        f" If the customer asks to turn any of these on/off, or asks for a briefing at a specific "
        f"time (e.g. \"send it at 7pm instead\"), use set_notification_preferences directly rather "
        f"than logging it as a capability gap — this is a real, already-built feature, just one they "
        f"may not know exists."
    )
    system_parts.append(
        "Other real, already-built preference changes you can make directly in conversation, never "
        "logged as capability gaps: switching persona (set_persona), setting/removing a monthly "
        "generation spend cap (set_spend_cap), setting the quote-line phone number used in "
        "capability-gap replies (set_quote_phone), and adding/removing an auto-reply contact "
        "(manage_auto_reply_contact -- available on every tier, not Grace-exclusive)."
        + (
            " Grace-exclusive, also available directly: marking/unmarking a VIP contact "
            "(set_vip_status), setting or removing quiet hours (set_quiet_hours), setting "
            "travel-mode timezone (set_travel_mode), and setting a custom ElevenLabs voice id "
            "(set_elevenlabs_voice)."
            if get_customer_august_tier(config) == "grace" else ""
        )
    )
    system_parts.append(
        "A firm, structural boundary, not a preference: some settings can ONLY be changed from the "
        "terminal on the customer's own Mac, never here in conversation, because they involve real "
        "credentials or change who Curant trusts as \"the customer\" in the first place — the same "
        "reasoning Dean applies to shell safety mode, just for account-level settings instead of shell "
        "access. If asked to change any of these by text, don't attempt it, don't pretend it's done, "
