        print("Editor exited with an error — no changes applied. Once you're done editing, run "
              "`curant-cli sync-memories`.", file=sys.stderr)
        return
    added, removed = sync_memories_file_to_db()
    print(f"Synced: {added} added, {removed} removed.")


