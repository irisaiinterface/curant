class CurantTokenStorage:
    """
    Implements the mcp SDK's TokenStorage interface, persisting to
    mcp_oauth_tokens instead of keeping tokens only in memory — so a
    server's login survives across separate relay() calls (each message
    is its own process) rather than needing the browser flow re-run on
    every single message. Verified against the real TokenStorage
    interface (get_client_info/set_client_info/get_tokens/set_tokens)
    before writing this, not guessed at.
    """
    def __init__(self, server_name):
        self.server_name = server_name

    async def get_client_info(self):
        from mcp.shared.auth import OAuthClientInformationFull
        row = _get_oauth_tokens_row(self.server_name)
        if row and row.get("client_info"):
            return OAuthClientInformationFull.model_validate_json(row["client_info"])
        return None

    async def set_client_info(self, client_info):
        _save_oauth_client_info(self.server_name, client_info.model_dump_json())

    async def get_tokens(self):
        from mcp.shared.auth import OAuthToken
        row = _get_oauth_tokens_row(self.server_name)
        if row and row.get("tokens"):
            return OAuthToken.model_validate_json(row["tokens"])
        return None

    async def set_tokens(self, tokens):
        _save_oauth_tokens(self.server_name, tokens.model_dump_json())



