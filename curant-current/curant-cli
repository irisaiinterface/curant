def _build_oauth_provider(server):
    """
    For servers using auth_mode 'oauth' — reuses the already-persisted
    tokens from CurantTokenStorage rather than re-running the interactive
    browser flow (that only happens once, during mcp-add-oauth). If the
    access token has expired, OAuthClientProvider handles refreshing it
    silently via the refresh token, same as it would mid-session.
    redirect_handler/callback_handler are still required by the SDK's
    constructor even though they should never actually fire here (no
    valid token + no refresh token would mean the login genuinely needs
    to be redone via mcp-add-oauth, not silently re-prompted mid-reply).
    """
    from mcp.client.auth import OAuthClientProvider
    from mcp.shared.auth import OAuthClientMetadata

    async def _unexpected_redirect(auth_url):
        raise RuntimeError(
            "This server's login has expired or was never completed — "
            "run curant-cli mcp-add-oauth again to log in."
        )

    async def _unexpected_callback():
        raise RuntimeError("Unexpected re-authorization required — run mcp-add-oauth again.")

    return OAuthClientProvider(
        server_url=server["url"],
        client_metadata=OAuthClientMetadata(
            redirect_uris=[f"http://127.0.0.1:{OAUTH_CALLBACK_PORT}/callback"],
            client_name="Curant",
            grant_types=["authorization_code", "refresh_token"],
            response_types=["code"],
        ),
        storage=CurantTokenStorage(server["name"]),
        redirect_handler=_unexpected_redirect,
        callback_handler=_unexpected_callback,
    )


def list_tools_from_server(server_name, server):
    """
    Best-effort — an unreachable or misbehaving MCP server should reduce
    Curant's capability for this message, not break it entirely. Returns
    an empty list on any failure. `server` is a full server dict from
    get_mcp_servers() — dispatches to stdio, Streamable HTTP, or SSE
    based on its 'transport' field. Streamable HTTP is the modern
    standard remote MCP transport; SSE is the older one, still used by
    a few real services (Square, confirmed) even though most have moved
    to Streamable HTTP.
    """
    try:
        if server.get("transport") == "http":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_list_tools_http_async(server["url"], server.get("headers"), auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        if server.get("transport") == "sse":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_list_tools_sse_async(server["url"], server.get("headers"), auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        return asyncio.run(asyncio.wait_for(
            _mcp_list_tools_stdio_async(server["command"]), timeout=MCP_CALL_TIMEOUT_SECONDS
        ))
    except Exception as e:
        print(f"Could not list tools from MCP server '{server_name}' (non-fatal, skipping it): {e}", file=sys.stderr)
        return []


def call_mcp_tool(server, tool_name, arguments):
    """Errors are returned as a text result the model can see and react
    to ('that tool failed') rather than raised — a broken third-party
    tool call shouldn't crash the whole reply when the model could
    instead just tell the customer it didn't work. `server` is a full
    server dict — dispatches to stdio, HTTP, or SSE the same way listing does."""
    try:
        if server.get("transport") == "http":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_call_tool_http_async(server["url"], server.get("headers"), tool_name, arguments, auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        if server.get("transport") == "sse":
            auth = _build_oauth_provider(server) if server.get("auth_mode") == "oauth" else None
            return asyncio.run(asyncio.wait_for(
                _mcp_call_tool_sse_async(server["url"], server.get("headers"), tool_name, arguments, auth=auth),
                timeout=MCP_CALL_TIMEOUT_SECONDS,
            ))
        return asyncio.run(asyncio.wait_for(
            _mcp_call_tool_stdio_async(server["command"], tool_name, arguments),
            timeout=MCP_CALL_TIMEOUT_SECONDS,
        ))
    except Exception as e:
        return f"[Error calling this tool: {e}]"


MCP_TOOLS_CACHE_MAX_AGE_SECONDS = 60 * 60  # refresh each server's tool list at most hourly —
                                             # listing tools means spawning a subprocess and a
                                             # full protocol handshake per server, which would
                                             # make every single reply noticeably slower if done
                                             # on every message with any MCP servers configured


def _get_server_tools_cached(server):
    """Returns a server's tool list, using the cache unless it's stale
    or missing. Refreshing on a cache miss/expiry still costs a real
    subprocess spawn + handshake, but that now happens at most hourly
    per server instead of on every message."""
    if server.get("tools_cache") and server.get("tools_cached_at"):
        try:
            cached_at = server["tools_cached_at"]
            with closing(get_local_db()) as conn:
                row = conn.execute(
                    "SELECT (julianday('now') - julianday(?)) * 86400 AS age_seconds", (cached_at,)
                ).fetchone()
                if row and row["age_seconds"] is not None and row["age_seconds"] < MCP_TOOLS_CACHE_MAX_AGE_SECONDS:
                    return json.loads(server["tools_cache"])
        except Exception:
            pass  # fall through to a fresh fetch on any cache-parsing weirdness

    tools = list_tools_from_server(server["name"], server)
    with closing(get_local_db()) as conn:
        conn.execute(
            "UPDATE mcp_servers SET tools_cache = ?, tools_cached_at = CURRENT_TIMESTAMP WHERE name = ?",
            (json.dumps(tools), server["name"]),
        )
        conn.commit()
    return tools


def lookup_macos_contact(handle):
    """Real macOS Contacts.app lookup by phone/email, via AppleScript --
    same mechanism curant-watcher.py's resolve_contact_name() uses, kept
    as an independent copy here (not imported) because curant-cli and
    curant-watcher.py are separate standalone scripts, not a shared
    package. Used as a fallback by the lookup_person tool when a handle
    has no local people-memory row yet, so Curant can still recognize a
    real contact even before anyone's told it anything about them.
    Fails soft: returns None on any error (Contacts access not granted,
    AppleScript failure, no match) rather than raising."""
    if not handle:
        return None
    safe_handle = handle.replace(chr(34), chr(92) + chr(34))
    script = (
        'tell application "Contacts"\n'
        '    set matchedPeople to {}\n'
        '    try\n'
        f'        set matchedPeople to (people whose (value of emails contains "{safe_handle}") or (value of phones contains "{safe_handle}"))\n'
        '    end try\n'
        '    if (count of matchedPeople) > 0 then\n'
        '        return name of item 1 of matchedPeople\n'
        '    else\n'
        '        return ""\n'
        '    end if\n'
        'end tell\n'
    )
    try:
        r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=10)
        found = (r.stdout or "").strip()
        return found if (r.returncode == 0 and found) else None
    except Exception:
        return None


def send_imessage(to_handle, text):
    """Sends a REAL iMessage from this Mac to a third-party handle, via
    AppleScript -- the actual mechanism behind the send_message_to_person
    tool. Deliberately independent of the normal reply path: watcher.py's
    send_text_reply() always targets whoever's thread relay() is already
    handling (the customer); this is curant-cli itself initiating a NEW
    outbound message to someone ELSE, as a real side effect of a tool
    call mid-conversation. Returns (success, error_or_None) -- never
    raises, same contract as the other tool-backing functions in this
    file."""
    safe_text = text.replace(chr(34), chr(92) + chr(34))
    safe_handle = to_handle.replace(chr(34), chr(92) + chr(34))
    script = (
        'tell application "Messages"\n'
        '    set targetService to 1st service whose service type = iMessage\n'
        f'    set targetBuddy to buddy "{safe_handle}" of targetService\n'
        f'    send "{safe_text}" to targetBuddy\n'
        'end tell\n'
    )
    try:
        r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=15)
        return r.returncode == 0, ((r.stderr or "").strip() or None)
    except Exception as e:
        return False, str(e)


def get_all_available_tools(config):
    """
    Aggregates tools from every enabled MCP server into one flat list,
    each tagged with which server and command it came from so a call can
    be routed back to the right place. Tool names are prefixed with the
    server name (server__toolname) to avoid collisions between servers
    that happen to expose a same-named tool. Uses a per-server cache
    (see above) rather than re-listing tools from scratch every message.

    Also includes exactly one first-party built-in tool —
    log_capability_gap — which isn't an MCP server call at all, but goes
    through this same mechanism since running it has a real side effect
    (a local log entry) even though it doesn't need confirmation the way
    sending something externally would. This one is always available,
    even with zero MCP servers configured, and costs nothing extra to
    include (no subprocess involved).
    """
    tools = []
    for server in get_mcp_servers(enabled_only=True):
        for t in _get_server_tools_cached(server):
            tools.append({
                "qualified_name": f"{server['name']}__{t['name']}",
                "description": f"[{server['name']}] {t['description']}",
                "input_schema": t["input_schema"],
                "server_command": server,  # full server dict now — needed to dispatch
                                             # stdio vs. http transport correctly
                "raw_name": t["name"],
                "builtin": False,
            })
    tools.append({
        "qualified_name": "log_capability_gap",
        "description": (
            "Call this whenever the customer asks for something Curant genuinely can't do — "
            "no tool covers it and it's not something you can help with by reasoning or writing. "
            "Logs it locally for later review and returns a message pointing the customer to call "
            "for a custom quote. Fine to call in the same turn the gap comes up — this only writes "
            "a local log entry, nothing is sent anywhere, so it doesn't need separate confirmation "
            "the way sending an email or message would."
        ),
        "input_schema": {
            "type": "object",
            "properties": {"description": {"type": "string", "description": "Plain description of what the customer wants"}},
            "required": ["description"],
        },
        "server_command": None,
        "raw_name": "log_capability_gap",
        "builtin": True,
    })
    pending_sends = get_pending_email_sends(status="pending")
    if pending_sends:
        tools.append({
            "qualified_name": "process_email_approvals",
            "description": (
                "Call this when the customer is responding to the pending-email-approvals digest "
                "they were sent (e.g. \"approve 1 and 3\", \"send all of them\", \"reject #2, that's "
                "not right\", \"yes go ahead\"). Each pending item was already shown to you above in "
                "this system prompt with its own id number, recipient, subject, and body -- use those "
                "ids. Approving an id ACTUALLY SENDS that email for real, right now, via the real "
                "connected email account -- this is the one and only point anything queued by the "
                "unattended inbox-check job is allowed to actually send, exactly because a real human "
                "(the customer, right here) is confirming it first. Rejecting an id just discards it, "
                "nothing is sent. Only call this when the customer's message is clearly about the "
                "pending items -- if they're just asking what's pending, answer from the context above "
                "directly instead of calling this."
            ),
            "input_schema": {
                "type": "object",
                "properties": {
                    "approve_ids": {"type": "array", "items": {"type": "integer"}, "description": "ids to actually send"},
                    "reject_ids": {"type": "array", "items": {"type": "integer"}, "description": "ids to discard without sending"},
                },
            },
            "server_command": None,
            "raw_name": "process_email_approvals",
            "builtin": True,
        })
    tools.append({
