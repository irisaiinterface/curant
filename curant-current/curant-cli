def _get_generated_files_key():
    """
    A dedicated Fernet key for encrypting generated files at rest —
    separate from other keys in config, generated once on first need
    and persisted. Images/audio sitting in ~/.curant/generated/ deserve
    the same at-rest protection as everything else this system encrypts
    (backups, context exports); there's no principled reason for this
    one directory to be the unencrypted exception.
    """
    from cryptography.fernet import Fernet
    config = load_config()
    key = config.get("generated_files_key")
    if not key:
        key = Fernet.generate_key().decode()
        config["generated_files_key"] = key
        save_config(config)
    return Fernet(key.encode())


def _save_generated_bytes(content_bytes, extension):
    os.makedirs(GENERATION_OUTPUT_DIR, exist_ok=True)
    prune_generated_files()  # cheap, just an mtime scan — do it opportunistically
                               # rather than needing a separate cron/launchd job
    fernet = _get_generated_files_key()
    encrypted = fernet.encrypt(content_bytes)
    filename = f"{extension}_{os.urandom(4).hex()}.{extension}.enc"
    path = os.path.join(GENERATION_OUTPUT_DIR, filename)
    with open(path, "wb") as f:
        f.write(encrypted)
    return path


def decrypt_generated_file(encrypted_path):
    """Decrypts a generated file back to plaintext bytes. Used only at
    the moment of actually delivering it (see relay()'s attachment
    handling) — the long-term copy on disk stays encrypted the whole
    time; only a short-lived plaintext copy exists, and only for as
    long as it takes to hand off to Messages for sending."""
    fernet = _get_generated_files_key()
    with open(encrypted_path, "rb") as f:
        return fernet.decrypt(f.read())


GENERATED_FILE_MAX_AGE_HOURS_GRACE = 72  # Grace gets 3 days instead of 1 --
# more breathing room to notice/re-request a delivery before the local
# copy is cleaned up, since Grace customers may be juggling more at once
# (multi-device, uncapped generation).


def _generated_file_max_age_hours():
    """Grace gets a longer local-retention window than everyone else --
    see GENERATED_FILE_MAX_AGE_HOURS_GRACE above. Reads config fresh
    rather than taking it as a param since prune_generated_files() is
    called opportunistically from several places that don't all already
    have a config value in hand."""
    try:
        if get_customer_august_tier(load_config()) == "grace":
            return GENERATED_FILE_MAX_AGE_HOURS_GRACE
    except Exception:
        pass  # never let a tier lookup failure block the prune itself
    return GENERATED_FILE_MAX_AGE_HOURS


def prune_generated_files():
    """Deletes generated files older than _generated_file_max_age_hours()
    (GENERATED_FILE_MAX_AGE_HOURS for most customers, longer for Grace --
    see GENERATED_FILE_MAX_AGE_HOURS_GRACE). Called opportunistically (on
    each new generation, and at the start of relay()) rather than needing
    a separate scheduled job — cheap enough that this doesn't need its
    own infrastructure."""
    if not os.path.isdir(GENERATION_OUTPUT_DIR):
        return
    cutoff = time.time() - (_generated_file_max_age_hours() * 3600)
    for filename in os.listdir(GENERATION_OUTPUT_DIR):
        path = os.path.join(GENERATION_OUTPUT_DIR, filename)
        try:
            if os.path.isfile(path) and os.path.getmtime(path) < cutoff:
                os.remove(path)
        except OSError:
            pass  # file may have been removed concurrently — not worth failing over


def _download_generated_file(url, extension):
    import requests
    resp = requests.get(url, timeout=60)
    resp.raise_for_status()
    return _save_generated_bytes(resp.content, extension)


