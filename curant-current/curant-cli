def run_iris_inbox_check():
    """Unattended background job (see mac/curant-watcher.py's
    --iris-inbox-check entry point and com.curant.irisinbox.plist) --
    reads/searches a specifically-connected email account with real
    tool-calling (unlike daily_briefing/proactive_check, which only get
    a single best-effort blind inbox summary folded into plain text)
    and can propose replies, but literally cannot send anything itself
    -- see _get_iris_inbox_check_tools' docstring. Fail-closed on
    anything: no license, no key, no connected server, or any error
    just means this run does nothing, same contract as every other
    background job in this file."""
    init_local_db()
    config = load_config()
    key = config.get("license_key")
    if not key:
        print("[iris-inbox-check] not activated, skipping.", file=sys.stderr)
        return
    config, active = refresh_status_if_stale(config)
    if not active:
        print("[iris-inbox-check] license inactive, skipping.", file=sys.stderr)
        return
    provider = get_provider(config)
    api_key = get_api_key(config, provider)
    if not api_key:
        print("[iris-inbox-check] no API key set, skipping.", file=sys.stderr)
        return

    server_name = get_iris_inbox_server_name(config)
    server, tools = _get_iris_inbox_check_tools(server_name)
    if not server:
        print(f"[iris-inbox-check] no connected MCP server named '{server_name}' -- skipping. "
              f"Connect one with `curant-cli mcp-add {server_name} ...` or set "
              f"config['iris_inbox_mcp_server'] to the name you used.", file=sys.stderr)
        return

    memories = get_memories()
    people = get_important_people()
    extra = (
        f"You're doing an unattended check of the '{server_name}' email inbox -- no one is watching "
        "this run, and there is no send tool available to you (see queue_email_for_approval's "
        "description for why). Look for anything that genuinely needs a reply. For each one, use "
        "queue_email_for_approval to propose a draft -- don't propose a reply for routine/no-action-"
        "needed emails just to seem thorough. If nothing needs a reply, that's a normal, correct "
        "outcome -- do nothing further."
    )
    system_prompt = build_system_prompt(config, memories, people, "", extra_instruction=extra)

    try:
        call_llm_with_tools(
            provider, api_key, system_prompt,
            messages=[{"role": "user", "content": f"Check the '{server_name}' inbox for anything that needs a reply."}],
            tools=tools, available_tools=tools, max_tokens=1000, tier="main",
        )
    except Exception as e:
        print(f"[iris-inbox-check] failed (non-fatal): {e}", file=sys.stderr)


def weekly_rollup(context):
    """
    Grace-exclusive. A longer-form weekly summary on top of the
    twice-daily briefing everyone now gets by default -- scheduled
    separately (see com.curant.weeklyrollup.plist, Sunday evening),
    genuinely different in shape from daily_briefing: looks across the
    week ahead rather than just today, and is expected to be a longer,
    more thorough read since it only runs once a week rather than twice
    a day. Reuses the same live context daily_briefing does (the
    watcher's calendar/reminders lookup already pulls a week's worth of
    events -- "eventsToday+7" -- so no separate data source is needed).

    Same fail-closed contract as daily_briefing/proactive_check.
    """
    config = load_config()
    key = config.get("license_key")
    if not key:
        print(json.dumps({"should_send": False, "error": "not_activated"}))
        return

    config, active = refresh_status_if_stale(config)
    if not active:
        print(json.dumps({"should_send": False, "error": "inactive_or_invalid_license"}))
        return

    if get_customer_august_tier(config) != "grace":
        # Silent, not an error -- safe to schedule on every Mac regardless
        # of tier, same pattern as the other scheduled jobs.
        print(json.dumps({"should_send": False}))
        return

    if _is_quiet_hours_now(config):
        print(json.dumps({"should_send": False, "reason": "quiet_hours"}))
        return

    provider = get_provider(config)
    api_key = get_api_key(config, provider)
    if not api_key:
        print(json.dumps({"should_send": False, "error": "no_api_key_set"}))
        return

    if not context:
        print(json.dumps({"should_send": False}))
        return

    memories = get_memories()
    people = get_important_people()

    # Stalled-items digest: memories older than a week, called out
    # separately in the prompt so the model can flag anything that
    # looks like it's still open/unresolved -- get_memories() alone
    # (used for the "what you've learned" section below, via
    # build_system_prompt) has no age information, so this uses
    # get_memories_with_age() as a second, purpose-built pass over the
    # same table rather than trying to overload one function for both.
    stalled_block = ""
    aged_memories = [m for m in get_memories_with_age() if m["days_old"] >= 7]
    if aged_memories:
        stalled_lines = "\n".join(f"- ({m['days_old']} days old) {m['content']}" for m in aged_memories)
        stalled_block = (
            "\n\nThings that have been noted for a week or more and may still be open "
            "(use judgment -- not everything old is actually stalled, some things just aren't "
            "time-sensitive; only call out what genuinely looks like it might have been "
            f"forgotten or is worth a nudge):\n{stalled_lines}"
        )

    extra = (
        "Write this week's executive rollup -- a longer, more thorough weekly summary than "
        "a normal daily briefing, based on the live calendar/reminders context below (which "
        "covers roughly the next 7 days). Always produce a real rollup as long as there's "
        "something in the context to summarize -- you are not deciding whether this is "
        "worth sending. Organize it by day or by theme, whichever fits the actual week "
        "ahead better; call out anything that looks like a scheduling conflict, an unusually "
        "busy day, or something easy to lose track of across the week. If anything in the "
        "'stalled items' list below genuinely looks forgotten or overdue, mention it briefly "
        "in its own short section -- otherwise leave that out entirely, don't force it. No "
        "filler, no 'let me know if you need anything else' -- just the rollup itself."
        f"{stalled_block}\n\n"
        f"This week's live context:\n{context}\n\n"
        'Respond with ONLY a JSON object: {"message": "..."}.'
    )
    system_prompt = build_system_prompt(config, memories, people, "", extra_instruction=extra)

    try:
        raw = call_llm(
            provider, api_key, system_prompt,
            messages=[{"role": "user", "content": "Write this week's executive rollup."}],
            max_tokens=1200, tier="main",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        result = json.loads(raw)
        message = (result.get("message") or "").strip()
    except Exception as e:
        print(f"Weekly rollup failed (non-fatal, not sending): {e}", file=sys.stderr)
        print(json.dumps({"should_send": False}))
        return

    if not message:
        print(json.dumps({"should_send": False}))
        return

    save_message("assistant", message)
    print(json.dumps({
        "should_send": True,
        "message": message,
        "reply_format": config.get("reply_format", "text"),
        "voice_tier": config.get("voice_tier", "standard"),
    }))


def _prune_old_meeting_brief_keys():
    with closing(get_local_db()) as conn:
        conn.execute("DELETE FROM meeting_briefs_sent WHERE sent_at < datetime('now', '-24 hours')")
        conn.commit()


def meeting_prep_check(context):
    """
    Grace-exclusive. Runs frequently (every 15 min, see
    com.curant.meetingprep.plist) rather than on a fixed daily/weekly
    schedule like daily_briefing/weekly_rollup -- checks whether
    anything in the live calendar context is starting imminently and,
    if so, sends a short prep note naming who's involved (matched
    against important_people) and anything Curant already knows about
    them.

    Dedup via meeting_briefs_sent: the model is asked for a stable
    event_key alongside its decision, and this only actually sends once
    per event_key -- without this, the same upcoming meeting would
    generate a fresh brief every single 15-minute check until it starts.

    Deliberately NOT quiet-hours-gated, unlike daily_briefing/
    weekly_rollup -- those are convenience digests on a fixed schedule;
    this is tied to a real, imminent, time-sensitive event, which is a
    meaningfully different thing to suppress.

    Same fail-closed contract as the other scheduled checks.
    """
    config = load_config()
    key = config.get("license_key")
    if not key:
        print(json.dumps({"should_send": False, "error": "not_activated"}))
        return

    config, active = refresh_status_if_stale(config)
    if not active:
        print(json.dumps({"should_send": False, "error": "inactive_or_invalid_license"}))
        return

    if get_customer_august_tier(config) != "grace":
        print(json.dumps({"should_send": False}))
        return

    provider = get_provider(config)
    api_key = get_api_key(config, provider)
    if not api_key:
        print(json.dumps({"should_send": False, "error": "no_api_key_set"}))
        return

    if not context:
        print(json.dumps({"should_send": False}))
        return

    _prune_old_meeting_brief_keys()

    memories = get_memories()
    people = get_important_people()
    extra = (
        "Look at the live calendar context below and decide whether anything is starting "
        "within roughly the next 30 minutes. If nothing is imminent, say so. If something IS "
        "imminent, write a short prep note (2-4 sentences): what the meeting is, and if you "
        "can identify who's likely involved (matching names against the people you know about "
        "below) mention anything relevant you know about them. Don't invent attendees that "
        "aren't reasonably implied by the event title/description.\n\n"
        f"Live calendar context:\n{context}\n\n"
        'Respond with ONLY a JSON object: {"has_upcoming_meeting": true/false, '
        '"event_key": "short stable identifier for this specific event, e.g. its title", '
        '"message": "the prep note, or empty string if has_upcoming_meeting is false"}.'
    )
    system_prompt = build_system_prompt(config, memories, people, "", extra_instruction=extra)

    try:
        raw = call_llm(
            provider, api_key, system_prompt,
            messages=[{"role": "user", "content": "Check for an imminent meeting."}],
            max_tokens=400, tier="main",
        ).strip()
        if raw.startswith("```"):
            raw = raw.strip("`")
            if raw.startswith("json"):
                raw = raw[4:]
        result = json.loads(raw)
    except Exception as e:
        print(f"Meeting prep check failed (non-fatal, not sending): {e}", file=sys.stderr)
        print(json.dumps({"should_send": False}))
        return

    if not result.get("has_upcoming_meeting"):
        print(json.dumps({"should_send": False}))
        return

    message = (result.get("message") or "").strip()
    event_key = (result.get("event_key") or "").strip().lower()
    if not message or not event_key:
        print(json.dumps({"should_send": False}))
        return

    with closing(get_local_db()) as conn:
        try:
            conn.execute("INSERT INTO meeting_briefs_sent (event_key) VALUES (?)", (event_key,))
            conn.commit()
        except sqlite3.IntegrityError:
            # Already sent a brief for this event within the last 24h.
            print(json.dumps({"should_send": False, "reason": "already_sent"}))
            return

    save_message("assistant", message)
    print(json.dumps({
        "should_send": True,
        "message": message,
        "reply_format": config.get("reply_format", "text"),
        "voice_tier": config.get("voice_tier", "standard"),
    }))


# --- Local backup (encrypted with a customer-chosen passphrase; entirely local, no server involvement) ---

def _derive_backup_key(passphrase, salt):
    """
    scrypt-derived key from the customer's own passphrase — deliberately
    NOT PBKDF2. PBKDF2's cost is pure CPU time, which parallelizes cheaply
    on GPUs/ASICs, so an attacker with dedicated hardware can brute-force
    it far faster than a defender's single CPU suggests. scrypt is
    memory-hard: each guess requires ~256MB of RAM (n=2**18, r=8, p=1),
    which is expensive to parallelize at scale even with custom hardware,
    not just slow on one core. This is the standard reason password-based
    encryption uses scrypt/Argon2 over PBKDF2 when the threat model
    includes serious brute-force attempts against a stolen file.

    Cost is ~1-2 seconds and ~256MB RAM per attempt, which is a deliberate
    tradeoff — this only runs on backup/restore, an infrequent command, so
    spending real time and memory per attempt is the whole point: it
    should be similarly expensive for anyone trying to brute-force it.

    The salt is not secret (it's stored alongside the ciphertext in the
    backup file itself) — its purpose is only to defeat precomputed
    rainbow-table attacks, not to add confidentiality on its own.
    """
    from cryptography.hazmat.primitives.kdf.scrypt import Scrypt
    import base64
    kdf = Scrypt(salt=salt, length=32, n=2**18, r=8, p=1)
    return base64.urlsafe_b64encode(kdf.derive(passphrase.encode()))


DEFAULT_BACKUP_PATH = os.path.join(CONFIG_DIR, "backup.curantbackup")


def _write_encrypted_backup(passphrase, path=None, quiet=False):
    """
    Shared encryption/write logic used by both the interactive
    backup_now() and the automated (Grace-only) scheduled backup path --
    same payload scope, same scrypt-derived key, same file format either
    way. See backup_now()'s docstring for exactly what is and isn't
    included and why. `quiet` suppresses the human-facing print()s for
    the unattended scheduled-job path (still writes to stderr on error).
    """
    import base64
    from cryptography.fernet import Fernet

    config = load_config()
    payload_data = {
        "persona": config.get("persona"),
        "instructions": config.get("instructions"),
        "reply_format": config.get("reply_format"),
        "voice_tier": config.get("voice_tier"),
        "proactivity_enabled": config.get("proactivity_enabled"),
    }
    plaintext = json.dumps(payload_data).encode()
    salt = os.urandom(16)
    if not quiet:
        print("Deriving encryption key (this takes a couple seconds by design — "
              "it should be similarly slow for anyone trying to guess your passphrase)...")
    derived_key = _derive_backup_key(passphrase, salt)
    ciphertext = Fernet(derived_key).encrypt(plaintext)
    blob = base64.b64encode(salt).decode() + ":" + ciphertext.decode()

    target = os.path.expanduser(path) if path else DEFAULT_BACKUP_PATH
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "w") as f:
        f.write(blob)
    os.chmod(target, 0o600)
    return target


def backup_now(path=None):
    """
    Encrypts settings/preferences LOCALLY with a key derived from a
    passphrase you enter interactively, then writes the result to a file
    — nothing is ever sent to Curant's server. By default this writes to
    ~/.curant/backup.curantbackup, but you can point it anywhere with
    --path: an external drive, an iCloud Drive or Dropbox folder, etc.
    Writing to a location that's actually synced/backed up elsewhere is
    what makes this useful against losing the Mac itself — a backup file
    that only ever lives on the same disk doesn't survive that disk
    being lost.

    Deliberately scoped to settings only — persona, standing
    instructions, reply format, voice tier, proactivity setting. This
    does NOT include memories or important people: those are the actual
    learned facts about the customer and real people's names/
    relationships, which is meaningfully more sensitive content than a
    settings choice, so it's kept out of anything that might end up
    copied to an external drive or cloud folder. A restore brings back
    how Curant is configured, not what it has learned — that's a real,
    deliberate capability loss, not an oversight.

    Also deliberately excludes the Anthropic API key and raw recent
    message history — the API key is the single most sensitive thing on
    this machine, so it stays local-only even in a backup file; and
    message history already auto-expires by design, so there's no reason
    to preserve it.

    See run_automated_backup() below for Grace's unattended weekly
    version of this same underlying logic.
    """
    import getpass

    config = load_config()
    if not config.get("license_key"):
        print("Not activated. Run: curant-cli activate <your-license-key>")
        sys.exit(1)

    passphrase = getpass.getpass("Choose a backup passphrase (input hidden, won't be shown or stored): ")
    if not passphrase:
        print("Passphrase can't be empty.")
        sys.exit(1)
    confirm = getpass.getpass("Confirm passphrase: ")
    if passphrase != confirm:
        print("Passphrases didn't match — nothing was written.")
        sys.exit(1)

    target = _write_encrypted_backup(passphrase, path)

    print(f"Backup written to {target}")
    print("This backs up your settings only (persona, instructions, reply/voice "
          "preferences, proactivity) — not your memories or important people.")
    print("Remember your passphrase — it's the only way to restore this, and Curant "
          "has no way to recover it if you lose it, since it was never stored or sent anywhere.")
    if not path:
        print("This is on the same disk as everything else — copy it somewhere that "
              "survives losing this Mac (an external drive, iCloud Drive, Dropbox, etc.) "
              "if you want it to actually protect against that. You can also just run "
              "`curant-cli backup-now --path <somewhere else>` directly next time.")


BACKUP_KEYCHAIN_SERVICE = "curant-auto-backup"  # macOS Keychain item name, not a config.json value


def set_auto_backup_cmd(enabled_str):
    """
    Grace-exclusive: turns on unattended weekly encrypted backups (see
    run_automated_backup / com.curant.autobackup.plist). The real design
    problem this solves: backup_now()'s passphrase is deliberately never
    stored anywhere, by design (see its docstring) -- fine for a command
    a customer runs themselves, impossible for a scheduled job with no
    one there to type it in. This asks for the passphrase ONCE, right
    now, interactively, and stores it in the macOS Keychain (via the
    `security` CLI) rather than anywhere in config.json -- Keychain
    entries are protected by the user's own login, encrypted at rest by
    macOS itself, and specifically designed for exactly this "let a
    background process retrieve a secret without a human typing it"
    use case. This is a genuinely different security posture than a
    plaintext config value would be, though it's honest to note it's
    still a lower bar than a passphrase that's NEVER stored anywhere at
    all, which is what backup_now() gives you if you run it yourself.
    """
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("Automatic backups are a Grace-exclusive feature. Everyone else can still run "
              "`curant-cli backup-now` manually anytime.")
        sys.exit(1)

    if enabled_str is None:
        current = config.get("auto_backup_enabled", False)
        print(f"Automatic weekly backup is currently {'on' if current else 'off'}.")
        return

    if enabled_str.lower() not in ("on", "off"):
        print("Usage: curant-cli set-auto-backup <on|off>")
        sys.exit(1)

    if enabled_str.lower() == "off":
        config["auto_backup_enabled"] = False
        save_config(config)
        subprocess.run(
            ["security", "delete-generic-password", "-s", BACKUP_KEYCHAIN_SERVICE],
            capture_output=True,
        )
        print("Automatic weekly backup turned off, and the stored passphrase was removed "
              "from Keychain.")
        return

    import getpass
    passphrase = getpass.getpass("Choose a passphrase for automatic weekly backups (input hidden): ")
    if not passphrase:
        print("Passphrase can't be empty.")
        sys.exit(1)
    confirm = getpass.getpass("Confirm passphrase: ")
    if passphrase != confirm:
        print("Passphrases didn't match — automatic backup was not enabled.")
        sys.exit(1)

    # -U updates an existing Keychain entry instead of erroring if one's already there
    result = subprocess.run(
        ["security", "add-generic-password", "-a", os.environ.get("USER", "curant"),
         "-s", BACKUP_KEYCHAIN_SERVICE, "-w", passphrase, "-U"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"Couldn't save the passphrase to Keychain: {result.stderr.strip()}")
        sys.exit(1)

    config["auto_backup_enabled"] = True
    save_config(config)
    print("Automatic weekly backup turned on. Your passphrase is stored in macOS Keychain "
          "(not in any Curant config file) so the scheduled job can use it without you "
          "typing it in each time. Remember it anyway -- Curant still has no way to recover "
          "it if you ever need to restore on a different Mac.")


def _wizard_prompt(prompt_text, default=None):
    """Shared input helper for onboarding_wizard_cmd -- returns a
    stripped answer, or default (possibly None) on a blank Enter or on
    EOF (e.g. input piped from /dev/null in a non-interactive context)."""
    try:
        raw = input(prompt_text).strip()
    except EOFError:
        return default
    return raw if raw else default


def setup_wizard_cmd():
    """
    A friendlier front door onto first-time setup, available to every
    customer regardless of tier (unlike onboarding_wizard_cmd, which is
    Grace-exclusive and covers a different, more advanced set of
    settings). This exists because the bare-minimum path to a working
    Curant -- activate, pick a provider, paste in an API key, and say
    who Curant should listen to -- was otherwise only discoverable by
    reading docs and running four separate `curant-cli` commands with
    positional/flag arguments, one of which (the API key) shouldn't be
    typed as a plain CLI argument at all (see set-api-key's own
    getpass-based prompt, used here too).

    Everything this collects stays local -- activation aside (a
    billing/entitlement check against the server, same as always), the
    API key and customer_apple_id/customer_handles entered here are
    written straight to ~/.curant/config.json and never touch Curant's
    server, exactly like running the equivalent `curant-cli set-*`
    commands by hand would. This is deliberately NOT a web form for
    that reason -- see the same design note on update_customer_preferences
    in server/app.py.

    Requires an interactive terminal, same as onboarding_wizard_cmd.
    """
    if not sys.stdin.isatty():
        print("Setup needs an interactive terminal -- run `curant-cli setup` directly "
              "in a terminal, not from a script.")
        sys.exit(1)

    print("Let's get Curant set up. Press Enter on any question to skip it.\n")

    config = load_config()

    # 0. Privacy/ToS consent -- REAL GAP, found during the beta-readiness
    # pass: this used to only run as a side effect of calling activate()
    # below, which means a customer who skips activation (leaves the
    # license key blank -- exactly the path every beta tester takes right
    # now, since there is no live license server to activate against) never
    # saw this screen at all. Consent has nothing to do with billing/
    # entitlement, so it shouldn't be gated behind a step that does. Called
    # unconditionally here, before activation is even asked about;
    # _ensure_privacy_consent() itself is a no-op if this version's already
    # been acknowledged, so re-running setup never re-prompts unnecessarily.
    if not _ensure_privacy_consent(config):
        sys.exit(1)
    config = load_config()

    # 1. Activation
    if not config.get("license_key"):
        key_answer = _wizard_prompt("License key (leave blank to skip activation for now): ")
        if key_answer:
            activate(key_answer)
            config = load_config()
        else:
            print("Skipping activation -- most things won't work until you run "
                  "`curant-cli activate <key>` later.")
    else:
        print(f"Already activated (license {config['license_key'][:8]}...).")

    # 2. Provider
    current_provider = get_provider(config)
    provider_answer = _wizard_prompt(
        f"Which provider should Curant use for replies? [{', '.join(PROVIDER_MODELS)}] "
        f"(current: {current_provider}) "
    )
    if provider_answer:
        set_provider(provider_answer)
        config = load_config()

    # 3. API key -- getpass, never echoed, never a plain CLI argument
    provider_for_key = get_provider(config)
    if get_api_key(config, provider_for_key):
        key_answer = _wizard_prompt(
            f"An API key is already saved for {provider_for_key}. Replace it? [y/N] ",
            default="n",
        )
        replace_key = key_answer.lower().startswith("y")
    else:
        replace_key = True
    if replace_key:
        api_key = getpass.getpass(f"Paste your {provider_for_key} API key (input hidden): ").strip()
        if api_key:
            set_api_key(api_key, provider=provider_for_key)
        else:
            print("No key entered -- skipping.")

    # 4. Customer identity -- who Curant listens to. Local-only, same
    # fields the web dashboard's preferences form can also set (see
    # update_customer_preferences in server/app.py) -- whichever path a
    # customer uses, both land in the same config fields.
    config = load_config()
    current_id = config.get("customer_apple_id")
    id_answer = _wizard_prompt(
        f"Phone number or Apple ID Curant should listen for messages/calls from "
        f"(current: {current_id or 'not set'}): "
    )
    if id_answer:
        config["customer_apple_id"] = _normalize_handle(id_answer)
        save_config(config)

    handles_answer = _wizard_prompt(
        "Any extra handles (comma-separated, optional): "
    )
    if handles_answer:
        config = load_config()
        config["customer_handles"] = [_normalize_handle(h.strip()) for h in handles_answer.split(",") if h.strip()]
        save_config(config)

    print("\nSetup done. Run `curant-cli status` to confirm everything's active.")


def onboarding_wizard_cmd():
    """
    Grace-exclusive guided setup -- walks a new executive customer
    through the handful of settings that are otherwise scattered across
    a dozen separate `curant-cli set-*` commands someone would only
    discover by reading docs (persona, voice, quiet hours, travel
    timezone, daily briefing, automatic backups, VIP contacts,
    delegates). Every step is optional (blank Enter skips it, keeping
    whatever's already configured) and reuses the existing setter
    functions rather than duplicating their validation/persistence
    logic -- this is purely a friendlier front door onto commands that
    already work standalone.

    Standing instructions are NOT part of this wizard -- those are set
    via the web dashboard and synced down on the next status refresh
    (see apply_synced_preferences_if_newer), not stored as a local-only
    setting like everything else here, so a step here would be
    misleading about where that data actually lives.

    Requires an interactive terminal (checks sys.stdin.isatty()) --
    fails closed with a clear message rather than hanging or silently
    skipping every step if run from a non-interactive context (e.g. by
    mistake from a script or scheduled job).
    """
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("The guided onboarding wizard is a Grace-exclusive feature.")
        sys.exit(1)
    if not sys.stdin.isatty():
        print("The onboarding wizard needs an interactive terminal to ask questions -- "
              "run `curant-cli onboarding-wizard` directly in a terminal, not from a script.")
        sys.exit(1)

    print("Welcome to Grace -- let's get you set up. Press Enter on any question to skip it "
          "and keep things as they are.\n")

    # 1. Persona
    current_persona = config.get("persona", "curant")
    print(f"Available personas: {', '.join(PERSONAS.keys())}")
    persona_answer = _wizard_prompt(f"Which persona would you like? [current: {current_persona}] ")
    if persona_answer:
        if persona_answer in PERSONAS:
            set_persona(persona_answer)
        else:
            print(f"Unknown persona '{persona_answer}' -- skipping, kept {current_persona}.")

    # 2. Voice
    voice_answer = _wizard_prompt(
        "ElevenLabs voice ID for spoken replies, if you have a cloned/custom voice "
        "(leave blank to use the default voice)? "
    )
    if voice_answer:
        set_voice_cmd(voice_answer)

    # 3. Quiet hours
    quiet_answer = _wizard_prompt(
        "Set quiet hours for your daily briefing and weekly rollup? Enter as 'HH:MM HH:MM' "
        "(24-hour, e.g. '21:00 07:00'), or leave blank to skip: "
    )
    if quiet_answer:
        parts = quiet_answer.split()
        if len(parts) == 2:
            set_quiet_hours_cmd(parts[0], parts[1])
        else:
            print("Didn't understand that format -- skipping quiet hours.")

    # 4. Travel timezone
    tz_answer = _wizard_prompt(
        "Set a travel timezone (IANA name, e.g. 'Europe/London'), or leave blank to use "
        "this Mac's local timezone: "
    )
    if tz_answer:
        set_travel_mode_cmd(tz_answer)

    # 5. Daily briefing
    briefing_answer = _wizard_prompt(
        "Keep the twice-daily executive briefing on? [Y/n] ", default="y"
    )
    set_daily_briefing_cmd("off" if briefing_answer.lower().startswith("n") else "on")

    # 6. Automatic backups
    backup_answer = _wizard_prompt(
        "Turn on automatic weekly encrypted backups? You'll be asked to choose a passphrase "
        "next if so. [y/N] ", default="n"
    )
    if backup_answer.lower().startswith("y"):
        set_auto_backup_cmd("on")

    # 7. VIP contacts
    print("\nVIP contacts always trigger a real-time notice when they text, bypassing normal "
          "spam screening. Enter phone numbers/handles one at a time, blank to finish.")
    while True:
        handle = _wizard_prompt("VIP handle (or blank to finish): ")
        if not handle:
            break
        mark_vip_cmd(handle, "on")

    # 8. Delegates
    print("\nDelegates can message Curant directly with full assistant access (not just "
          "notify-only, like VIPs). Enter handles one at a time, blank to finish.")
    while True:
        handle = _wizard_prompt("Delegate handle (or blank to finish): ")
        if not handle:
            break
        label = _wizard_prompt(f"  Label for {handle} (e.g. 'Chief of Staff'), optional: ")
        add_delegate_cmd(handle, label)

    config = load_config()
    config["onboarding_completed"] = True
    save_config(config)
    print("\nAll set. You can revisit any of this anytime with the individual `curant-cli "
          "set-*` commands -- run `curant-cli --help` to see them all.")


def _fetch_update_manifest():
    """
    GETs UPDATE_MANIFEST_URL and returns the parsed
    {"version": ..., "download_url": ..., "changelog": ...} dict, or None
    on any failure (unreachable, not configured yet, malformed JSON) --
    every caller treats None as "couldn't check, nothing to report" and
    fails silently rather than alarming the customer over a network blip.
    """
    if not UPDATE_MANIFEST_URL or UPDATE_MANIFEST_URL.startswith("REPLACE_WITH_"):
        return None
    try:
        req = urllib.request.Request(UPDATE_MANIFEST_URL, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            manifest = json.loads(resp.read().decode("utf-8"))
        if not isinstance(manifest, dict) or "version" not in manifest or "download_url" not in manifest:
            return None
        return manifest
    except Exception:
        return None


def _version_is_newer(remote_version, local_version):
    """
    Plain string comparison -- only correct because CURANT_VERSION's
    format is fixed as "YYYY-MM-DD.N" (see its own comment), which sorts
    lexicographically the same as chronologically. Do not use this for
    arbitrary semver-style strings.
    """
    return isinstance(remote_version, str) and remote_version > local_version


def _restart_watcher_verified(gui_domain, plist_path, max_attempts=3, settle_seconds=1.5):
    """bootout + bootstrap the persistent watcher, but -- unlike the old
    version of this code -- actually VERIFY it came back up before
    claiming success, retrying on failure. `launchctl bootstrap` firing
    before a preceding `bootout` has fully released the service label is
    a real, observed launchd race (not hypothetical): it can fail
    outright, or "succeed" while the service never actually starts.
    Returns (restarted: bool, detail: str)."""
    label = "app.curant.watcher"
    subprocess.run(["launchctl", "bootout", f"{gui_domain}/{label}"], capture_output=True)
    if not os.path.exists(plist_path):
        return False, "no com.curant.watcher.plist found to bootstrap"

    last_err = ""
    for attempt in range(1, max_attempts + 1):
        result = subprocess.run(["launchctl", "bootstrap", gui_domain, plist_path],
                                 capture_output=True, text=True)
        time.sleep(settle_seconds)  # give launchd a moment to actually spawn it
        check = subprocess.run(["launchctl", "list"], capture_output=True, text=True)
        if label in (check.stdout or ""):
            return True, "restarted cleanly" if attempt == 1 else f"restarted on attempt {attempt}"
        last_err = (result.stderr or result.stdout or "").strip() or (
            "bootstrap reported no error, but the service isn't listed as running")
        # Most likely transient cause: bootout hadn't fully released the
        # label yet. Bootout again defensively before the next attempt.
        subprocess.run(["launchctl", "bootout", f"{gui_domain}/{label}"], capture_output=True)

    return False, f"didn't come back after {max_attempts} attempts -- last error: {last_err}"


def _download_and_apply_update(download_url):
    """
    Downloads the zip at download_url (the same shape package-for-beta.sh
    produces: a top-level curant-current/ directory containing curant-cli
    and mac/curant-watcher.py), replaces this Mac's installed copies in
    ~/bin, and restarts the watcher service so it picks up the new code
    immediately rather than waiting for the next unrelated restart.

    Deliberately narrow scope: only curant-cli and curant-watcher.py get
    replaced, never the *.plist files, install.command, or anything
    else -- this is an update to the running brain/watcher, not a full
    reinstall, and shouldn't risk touching a customer's already-working
    launchd configuration.

    Returns (success: bool, detail: str).
    """
    bin_dir = os.path.expanduser("~/bin")
    tmp_dir = tempfile.mkdtemp(prefix="curant-update-")
    try:
        zip_path = os.path.join(tmp_dir, "update.zip")
        req = urllib.request.Request(download_url)
        with urllib.request.urlopen(req, timeout=60) as resp, open(zip_path, "wb") as f:
            shutil.copyfileobj(resp, f)

        with zipfile.ZipFile(zip_path) as zf:
            zf.extractall(tmp_dir)

        # Locate the two files regardless of the exact top-level folder
        # name inside the zip (package-for-beta.sh always names it
        # curant-current/, but this stays robust to that changing).
        new_cli = None
        new_watcher = None
        for root, _dirs, files in os.walk(tmp_dir):
            if "curant-cli" in files and new_cli is None:
                candidate = os.path.join(root, "curant-cli")
                # Skip the zip file itself and anything under mac/ when
                # looking for the top-level curant-cli specifically.
                if os.path.basename(root) != "mac":
                    new_cli = candidate
            if "curant-watcher.py" in files and new_watcher is None:
                new_watcher = os.path.join(root, "curant-watcher.py")

        if not new_cli or not new_watcher:
            return False, "update package didn't contain both curant-cli and curant-watcher.py"

        os.makedirs(bin_dir, exist_ok=True)
        shutil.copy2(new_cli, os.path.join(bin_dir, "curant-cli"))
        shutil.copy2(new_watcher, os.path.join(bin_dir, "curant-watcher.py"))
        os.chmod(os.path.join(bin_dir, "curant-cli"), 0o755)
        os.chmod(os.path.join(bin_dir, "curant-watcher.py"), 0o755)

        # Restart the watcher so the new code is actually running, not
        # just sitting on disk until some unrelated future restart.
        gui_domain = f"gui/{os.getuid()}"
        plist_path = os.path.expanduser("~/Library/LaunchAgents/com.curant.watcher.plist")
        restarted, restart_detail = _restart_watcher_verified(gui_domain, plist_path)
        if restarted:
            return True, "applied"
        # Real bug found live (2026-08-19): this used to fire bootout+bootstrap
        # with zero verification and unconditionally return success -- a
        # launchd race (bootstrap firing before bootout fully released the
        # label, which happens in practice, not just in theory) silently left
        # a customer with NO watcher running at all after an otherwise-
        # successful update, while still being told "restarted the background
        # watcher." The files DID update correctly (that part's not a lie --
        # check-update will show the new version) so this still returns
        # success=True, but detail now flags the restart problem so the
        # customer-facing message can be honest about it instead of silent.
        return True, f"applied, but the watcher didn't restart cleanly ({restart_detail})"
    except Exception as e:
        return False, str(e)
    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)


def check_update_cmd():
    """`curant-cli check-update` -- read-only, just reports status."""
    manifest = _fetch_update_manifest()
    if manifest is None:
        print("Couldn't check for updates (unreachable, or updates aren't configured yet).")
        return
    remote = manifest.get("version", "")
    if _version_is_newer(remote, CURANT_VERSION):
        print(f"Update available: {CURANT_VERSION} -> {remote}")
        if manifest.get("changelog"):
            print(f"What's new: {manifest['changelog']}")
        print("Run `curant-cli update` to apply it.")
    else:
        print(f"Up to date (version {CURANT_VERSION}).")


def update_cmd():
    """
    `curant-cli update` -- manual, on-demand. Running this command IS the
    explicit action, so it applies without an extra confirmation prompt
    once a real update is found (consistent with how e.g. `brew upgrade`
    behaves) -- it does not silently run on its own; see auto_update_cmd
    for the scheduled/unattended version of this.
    """
    print("Checking for updates...")
    manifest = _fetch_update_manifest()
    if manifest is None:
        print("Couldn't check for updates right now (unreachable, or updates aren't configured yet).")
        return
    remote = manifest.get("version", "")
    if not _version_is_newer(remote, CURANT_VERSION):
        print(f"Already up to date (version {CURANT_VERSION}).")
        return

    print(f"Updating {CURANT_VERSION} -> {remote}...")
    if manifest.get("changelog"):
        print(f"What's new: {manifest['changelog']}")
    success, detail = _download_and_apply_update(manifest["download_url"])
    if success:
        if detail == "applied":
            print(f"Updated to {remote}. The background watcher has been restarted.")
        else:
            print(f"Updated to {remote}, but the watcher had trouble restarting ({detail}). "
                  f"Run `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.curant.watcher.plist` "
                  f"by hand to bring it back up.")
    else:
        print(f"Update failed: {detail}")
        sys.exit(1)


def auto_update_cmd():
    """
    Invoked unattended by com.curant.autoupdate.plist, every 30 minutes --
    deliberately NOT mid-conversation, so this never fires WHILE a real
    exchange with the customer is in progress (see the plist's own comment
    on that tradeoff). Opt-out, not opt-in (config["auto_update_enabled"]
    defaults True) -- toggle with `curant-cli set-auto-update off` if
    that's the wrong default for a given install.

    CONSENT CHANGE (this version): this used to download AND apply an
    update the moment one was found, purely unattended, then just texted
    the customer afterward saying it had already happened. That's no
    longer how this works -- an update is never applied without the
    customer explicitly saying yes first. This function's job now is only
    to detect a newer version and ASK, via a text the watcher delivers
    (see below); the actual download+install only happens later, when the
    customer replies and the model calls the apply_pending_update tool
    (see get_all_available_tools/execute_tool_call) -- the same
    confirm-before-real-effect pattern this codebase already uses for
    fill_and_submit_form and send_message_to_person, applied here too.

    State lives in config["pending_auto_update"] (version/download_url/
    changelog) so the pending offer survives across the many separate
    processes involved (this check, then whichever later `relay()` call
    handles the customer's "yes"). config["auto_update_declined_version"]
    remembers a version the customer already said no to, so this doesn't
    re-ask about the SAME version every 30 minutes -- declining is real
    and respected, not just skipped once. A genuinely newer version
    arriving later still gets offered normally, since it won't match the
    declined version.

    Prints a single JSON line either way so curant-watcher.py's
    --auto-update-check entry point can text the customer -- a new offer,
    or nothing at all if there's nothing new to report. Failure to even
    check (unreachable manifest, disabled) is silent by design, same as
    before -- only a genuine new-version detection is worth a text.
    """
    config = load_config()
    if not config.get("auto_update_enabled", True):
        print(json.dumps({"notify_text": None}))
        return

    manifest = _fetch_update_manifest()
    if manifest is None:
        print(json.dumps({"notify_text": None}))
        return

    remote = manifest.get("version", "")
    if not _version_is_newer(remote, CURANT_VERSION):
        # Nothing newer than what's installed -- clear out any stale
        # pending offer / declined-version memory referencing an old
        # manifest state, so a rolled-back or re-pinned manifest doesn't
        # leave confusing stale state sitting around.
        changed = False
        if config.get("pending_auto_update"):
            config.pop("pending_auto_update", None)
            changed = True
        if config.get("auto_update_declined_version"):
            config.pop("auto_update_declined_version", None)
            changed = True
        if changed:
            save_config(config)
            expire_open_questions("auto_update_offer")
        print(json.dumps({"notify_text": None}))
        return

    if config.get("auto_update_declined_version") == remote:
        # Already asked, customer already said no to this exact version --
        # don't nag again every 30 minutes. They can still ask directly
        # ("is there an update") or run `curant-cli check-update` by hand
        # anytime to be re-offered it.
        print(json.dumps({"notify_text": None}))
        return

    pending = config.get("pending_auto_update")
    if pending and pending.get("version") == remote:
        # Already offered this exact version and still waiting on a reply
        # -- don't re-text every 30 minutes while it's pending.
        print(json.dumps({"notify_text": None}))
        return

    config["pending_auto_update"] = {
        "version": remote,
        "download_url": manifest["download_url"],
        "changelog": manifest.get("changelog", ""),
    }
    save_config(config)

    changelog = manifest.get("changelog", "")
    text = f"An update to Curant is available -- version {remote} (currently running {CURANT_VERSION})."
    if changelog:
        text += f" What's new: {changelog}"
    # Real bug found live (2026-08-19): a customer with any other open thread
    # can have a bare "yes"/"no" misattributed to that unrelated topic instead
    # of this offer -- the model has to guess which "yes" is which. Asking for
    # a distinct word (UPDATE / SKIP) instead of generic yes/no makes that
    # collision far less likely, while the system prompt below still accepts
    # plain yes/no as a fallback for customers who don't read closely.
    text += (" Reply UPDATE and I'll install it now -- the background watcher restarts briefly as "
             "part of that. Reply SKIP and I won't ask again about this specific version.")

    # Deterministic reply routing (see open_questions' table comment):
    # register this as a structured open question so a bare UPDATE/SKIP
    # (or yes/no) gets resolved in code, correctly, even if something
    # else is being discussed in the same conversation. Priority 100 --
    # high enough to always beat a freeform conversational question,
    # which is the exact scenario that caused the real bug this exists
    # to fix (see match_incoming_reply's docstring).
    expire_open_questions("auto_update_offer")  # any stale prior offer, just in case
    register_open_question(
        kind="auto_update_offer",
        prompt_text=text,
        patterns={
            "approve": ["update", "yes", "install", "go ahead", "do it"],
            "decline": ["skip", "no", "not now", "nah"],
        },
        resolver="apply_pending_update",
        resolver_args={"version": remote},
        priority=100,
    )
    print(json.dumps({"notify_text": text}))


def match_open_question_cmd(incoming_text):
    """`curant-cli match-open-question "<text>"` -- called by
    curant-watcher.py's handle_message() on every incoming message,
    BEFORE relay_to_curant() (the normal LLM path). Prints a single JSON
    line: {"matched": true, "reply": "..."} if a structured open
    question resolved it deterministically (the caller should send
    `reply` directly and skip the LLM entirely for this turn), or
    {"matched": false} if nothing matched (caller proceeds exactly as
    before -- this never blocks or delays normal conversation)."""
    init_local_db()  # defensive -- same pattern as every other command that
                      # touches local.db; matters on a genuinely fresh install
                      # where this could be the very first DB access
    reply_text, question_id = match_incoming_reply(incoming_text)
    if reply_text is None:
        print(json.dumps({"matched": False}))
        return
    print(json.dumps({"matched": True, "reply": reply_text, "question_id": question_id}))


def set_auto_update_cmd(enabled_str):
    config = load_config()
    if enabled_str is None:
        current = config.get("auto_update_enabled", True)
        print(f"Auto-update is currently {'ON' if current else 'OFF'} (default: ON).")
        return
    config["auto_update_enabled"] = enabled_str.strip().lower() == "on"
    save_config(config)
    print(f"Auto-update is now {'ON' if config['auto_update_enabled'] else 'OFF'}.")


def run_automated_backup():
    """
    Grace-exclusive, unattended -- invoked by com.curant.autobackup.plist
    on a weekly schedule, never by a human directly. Retrieves the
    passphrase from Keychain (set up via `curant-cli set-auto-backup on`)
    rather than prompting, since nothing is watching stdin on a
    scheduled job. Silently does nothing if auto backups aren't enabled,
    the tier isn't Grace, or no passphrase is in Keychain yet -- this is
    meant to be safe to schedule on every Mac regardless of tier/setup,
    same "safe to always run" pattern as the other scheduled jobs.
    """
    config = load_config()
    if get_customer_august_tier(config) != "grace":
        return
    if not config.get("auto_backup_enabled"):
        return

    result = subprocess.run(
        ["security", "find-generic-password", "-a", os.environ.get("USER", "curant"),
         "-s", BACKUP_KEYCHAIN_SERVICE, "-w"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"[auto-backup] no passphrase in Keychain, skipping: {result.stderr.strip()}", file=sys.stderr)
        return
    passphrase = result.stdout.strip()
    if not passphrase:
        print("[auto-backup] Keychain entry was empty, skipping", file=sys.stderr)
        return

    try:
        target = _write_encrypted_backup(passphrase, path=None, quiet=True)
        print(f"[auto-backup] wrote {target}", file=sys.stderr)
    except Exception as e:
        print(f"[auto-backup] failed (non-fatal): {e}", file=sys.stderr)


DEFAULT_FULL_EXPORT_PATH = os.path.join(CONFIG_DIR, "full_export.curantexport")


def full_export_cmd(path=None):
    """
    Grace-exclusive, explicit, on-demand only -- deliberately a
    SEPARATE command from backup_now(), not a flag on it. backup_now()
    intentionally excludes memories and important_people (see its
    docstring: "the actual learned facts about the customer and real
    people's names/relationships, meaningfully more sensitive content
    than a settings choice"); this command is the one place in this
    file that DOES include them in an exportable file, so it needs to
    be something a Grace customer reaches for on purpose, not something
    that happens by default or gets casually automated (this is NOT
    wired into run_automated_backup() -- the weekly automatic backup
    stays settings-only, same as always).

    Same encryption approach as backup_now (interactive passphrase,
    scrypt-derived key, never stored anywhere) -- but always interactive,
    never Keychain-backed, since this is meant to be a deliberate,
    occasional action, not a routine automated one.
    """
    import getpass
    from cryptography.fernet import Fernet
    import base64

    config = load_config()
    if get_customer_august_tier(config) != "grace":
        print("Full data export (including memories and important people) is a Grace-exclusive "
              "feature. Everyone else can still run `curant-cli backup-now` for a settings-only backup.")
        sys.exit(1)
    if not config.get("license_key"):
        print("Not activated. Run: curant-cli activate <your-license-key>")
        sys.exit(1)

    print("This export includes your memories and important people, not just settings -- "
          "meaningfully more sensitive than a regular backup. Make sure wherever you're "
          "about to write this file is somewhere you actually trust.")
    passphrase = getpass.getpass("Choose a passphrase for this export (input hidden): ")
    if not passphrase:
        print("Passphrase can't be empty.")
        sys.exit(1)
    confirm = getpass.getpass("Confirm passphrase: ")
    if passphrase != confirm:
        print("Passphrases didn't match — nothing was written.")
        sys.exit(1)

    payload_data = {
        "persona": config.get("persona"),
        "instructions": config.get("instructions"),
        "reply_format": config.get("reply_format"),
        "voice_tier": config.get("voice_tier"),
        "proactivity_enabled": config.get("proactivity_enabled"),
        "memories": get_memories(),
        "important_people": get_important_people(),
    }
    plaintext = json.dumps(payload_data).encode()
    salt = os.urandom(16)
    print("Deriving encryption key (this takes a couple seconds by design)...")
    derived_key = _derive_backup_key(passphrase, salt)
    ciphertext = Fernet(derived_key).encrypt(plaintext)
    blob = base64.b64encode(salt).decode() + ":" + ciphertext.decode()

    target = os.path.expanduser(path) if path else DEFAULT_FULL_EXPORT_PATH
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "w") as f:
        f.write(blob)
    os.chmod(target, 0o600)

    print(f"Full export written to {target}")
    print("Includes: settings, memories, and important people. Remember your passphrase -- "
          "Curant has no way to recover it if you lose it.")


def backup_restore(path=None):
    """Reads an encrypted backup file and decrypts it locally with a
    passphrase entered interactively. Never sends anything anywhere.
    Restores settings only — see backup_now()'s docstring for why
    memories/important people are deliberately not part of this."""
    import base64
    import getpass
    from cryptography.fernet import Fernet, InvalidToken

    config = load_config()
    if not config.get("license_key"):
        print("Not activated. Run: curant-cli activate <your-license-key> first.")
        sys.exit(1)

    source = os.path.expanduser(path) if path else DEFAULT_BACKUP_PATH
    if not os.path.exists(source):
        print(f"No backup file found at {source}. Pass --path if it's somewhere else "
              "(external drive, iCloud Drive, etc.)")
        sys.exit(1)
    with open(source) as f:
        blob = f.read().strip()

    passphrase = getpass.getpass("Enter your backup passphrase: ")
    print("Verifying (this takes a couple seconds by design)...")

    try:
        salt_b64, ciphertext = blob.split(":", 1)
        salt = base64.b64decode(salt_b64)
        derived_key = _derive_backup_key(passphrase, salt)
        plaintext = Fernet(derived_key).decrypt(ciphertext.encode())
        data = json.loads(plaintext)
    except (InvalidToken, ValueError):
        print("Could not decrypt backup — wrong passphrase, or the file is corrupted.")
        sys.exit(1)

    config["persona"] = data.get("persona", config.get("persona", "curant"))
    config["instructions"] = data.get("instructions", config.get("instructions", ""))
    config["reply_format"] = data.get("reply_format", config.get("reply_format", "text"))
    config["voice_tier"] = data.get("voice_tier", config.get("voice_tier", "standard"))
    config["proactivity_enabled"] = data.get("proactivity_enabled", config.get("proactivity_enabled", False))
    save_config(config)
    print("Backup restored: persona, instructions, and settings are back. "
          "Memories and important people are NOT included in backups and are not affected. "
          "You'll still need to run `curant-cli set-api-key` again — the API key is never included in backups.")


# --- Portable context export (encrypted; a human-readable template OR a
# spec-conformant portable-memory JSON file, meant to be decrypted and
# used with a different AI — see PORTABLE_MEMORY_SPEC.md. Distinct from
# the settings-only backup above, since this one's whole purpose is
# carrying memories/important-people content) ---

DEFAULT_CONTEXT_PATH = os.path.join(CONFIG_DIR, "context.curantcontext")
CPMF_VERSION = "1.0"  # see PORTABLE_MEMORY_SPEC.md — bump only for a
                       # breaking schema change, per that document's own
                       # versioning policy


def build_context_template(config, memories, people):
    """
    Builds the plain-language, pasteable context block (the "text"
    format). Deliberately contains nothing that grants access to
    anything (no API key, no license key, no device id) and no verbatim
    proprietary persona wording (uses PERSONA_STYLE_SUMMARY, not
    PERSONAS) — so this template is safe to exist even decrypted: worst
    case if it leaked, someone reads the customer's own stated
    preferences and memories, the same thing they'd be pasting into a
    third-party chat window themselves.
    """
    style = PERSONA_STYLE_SUMMARY.get(config.get("persona", "curant"), PERSONA_STYLE_SUMMARY["curant"])
    lines = ["--- Personal Assistant Context ---", ""]
    lines.append(f"Style: {style}")
    if config.get("instructions"):
        lines.append(f"Standing instructions: {config['instructions']}")
    lines.append("")
    lines.append("Preferences:")
    lines.append(f"- Reply format: {config.get('reply_format', 'text')}")
    lines.append(f"- Proactive check-ins: {'on' if config.get('proactivity_enabled') else 'off'}")
    lines.append("")
    lines.append("Things to remember about me:")
    if memories:
        for m in memories:
            lines.append(f"- {m}")
    else:
        lines.append("- (none yet)")
    lines.append("")
    lines.append("People who matter to me:")
    if people:
        for p in people:
            lines.append(f"- {p['name']} ({p['relationship']}): {p['note']}")
    else:
        lines.append("- (none yet)")
    lines.append("")
    lines.append("--- End context ---")
    return "\n".join(lines)


def build_cpmf_json(config, memories, people):
    """
    Builds a Curant Portable Memory Format (CPMF) v1.0 document — see
    PORTABLE_MEMORY_SPEC.md for the full schema and design rationale.
    This is the machine-readable counterpart to build_context_template():
    same underlying data, same safety properties (no secrets, no
    vendor-specific wording), but structured so any tool — not just a
    human pasting text — can parse it and build a working system prompt,
    regardless of which model that tool talks to.
    """
    import datetime
    style = PERSONA_STYLE_SUMMARY.get(config.get("persona", "curant"), PERSONA_STYLE_SUMMARY["curant"])
    return {
        "cpmf_version": CPMF_VERSION,
        "generated_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "persona": {
            "style_summary": style,
            "instructions": config.get("instructions", ""),
        },
        "preferences": {
            "reply_format": config.get("reply_format", "text"),
            "proactivity_enabled": bool(config.get("proactivity_enabled", False)),
        },
        "memories": [{"content": m} for m in memories],
        "people": [
            {"name": p["name"], "relationship": p["relationship"], "note": p["note"]}
            for p in people
        ],
    }


def validate_cpmf_json(data):
    """
    Minimal structural validation of a CPMF document — checked on every
    context_show(..., format='json') so a corrupted or malformed file
    fails with a clear message rather than a confusing downstream error.
    Deliberately lenient about unknown/extra fields (per the spec's own
    versioning policy: consumers should tolerate fields they don't
    recognize) — only the required shape is enforced.
    """
    if not isinstance(data, dict):
        return False, "not a JSON object"
    if "cpmf_version" not in data:
        return False, "missing cpmf_version"
    if not isinstance(data.get("memories", []), list):
        return False, "memories must be a list"
    if not isinstance(data.get("people", []), list):
        return False, "people must be a list"
    for m in data.get("memories", []):
        if not isinstance(m, dict) or "content" not in m:
            return False, "each memory needs a content field"
    for p in data.get("people", []):
        if not isinstance(p, dict) or "name" not in p:
            return False, "each person needs a name field"
    return True, None


def context_export(path=None, fmt="text"):
    """
    Builds the pasteable context (either the human-readable template, or
    a spec-conformant CPMF JSON document — see PORTABLE_MEMORY_SPEC.md)
    and writes it to disk ENCRYPTED — the plaintext never touches disk,
    only your terminal (via context_show()) and wherever you choose to
    paste/use it. Includes memories and important people, unlike
    backup-now/-restore, since carrying that content is the entire point
    of this export.
    """
    import base64
    import getpass
    from cryptography.fernet import Fernet

    config = load_config()
    if not config.get("license_key"):
        print("Not activated. Run: curant-cli activate <your-license-key>")
        sys.exit(1)

    passphrase = getpass.getpass("Choose a passphrase to encrypt this context file (input hidden): ")
    if not passphrase:
        print("Passphrase can't be empty.")
        sys.exit(1)
    confirm = getpass.getpass("Confirm passphrase: ")
    if passphrase != confirm:
        print("Passphrases didn't match — nothing was written.")
        sys.exit(1)

    memories = get_memories()
    people = get_important_people()
    if fmt == "json":
        plaintext = json.dumps(build_cpmf_json(config, memories, people), indent=2)
    else:
        plaintext = build_context_template(config, memories, people)

    salt = os.urandom(16)
    print("Deriving encryption key (this takes a couple seconds by design — "
          "it should be similarly slow for anyone trying to guess your passphrase)...")
    derived_key = _derive_backup_key(passphrase, salt)
    ciphertext = Fernet(derived_key).encrypt(plaintext.encode())
    blob = base64.b64encode(salt).decode() + ":" + ciphertext.decode()

    target = os.path.expanduser(path) if path else DEFAULT_CONTEXT_PATH
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "w") as f:
        f.write(blob)
    os.chmod(target, 0o600)

    print(f"Encrypted context written to {target} (format: {fmt})")
    if fmt == "json":
        print("This is a Curant Portable Memory Format (CPMF) v" + CPMF_VERSION + " file — "
              "see PORTABLE_MEMORY_SPEC.md. Any tool that speaks CPMF can use it, not just Curant.")
    print("Nothing in it grants access to anything (no API key, no license key): worst case "
          "if this file leaked, someone reads the same preferences/memories you'd be pasting elsewhere yourself.")
    print("Run `curant-cli context-show` (add --format json if you exported as json) to decrypt "
          "and print it when you want to copy it out.")


def context_show(path=None, fmt="text"):
    """Decrypts the context file and prints it to the terminal — never
    writes the decrypted plaintext back to disk. Copy it from the
    terminal output when you want to paste/use it elsewhere. For JSON,
    also validates the structure (see PORTABLE_MEMORY_SPEC.md) so a
    corrupted file fails clearly rather than confusingly downstream."""
    import base64
    import getpass
    from cryptography.fernet import Fernet, InvalidToken

    source = os.path.expanduser(path) if path else DEFAULT_CONTEXT_PATH
    if not os.path.exists(source):
        print(f"No context file found at {source}. Run `curant-cli context-export` first, "
              "or pass --path if it's somewhere else.")
        sys.exit(1)
    with open(source) as f:
        blob = f.read().strip()

    passphrase = getpass.getpass("Enter your context passphrase: ")
    print("Verifying (this takes a couple seconds by design)...")

    try:
        salt_b64, ciphertext = blob.split(":", 1)
        salt = base64.b64decode(salt_b64)
        derived_key = _derive_backup_key(passphrase, salt)
        plaintext = Fernet(derived_key).decrypt(ciphertext.encode())
    except (InvalidToken, ValueError):
        print("Could not decrypt — wrong passphrase, or the file is corrupted.")
        sys.exit(1)

    if fmt == "json":
        try:
            data = json.loads(plaintext.decode())
        except json.JSONDecodeError:
            print("Decrypted, but this doesn't look like valid JSON — was it exported with --format json?")
            sys.exit(1)
        valid, error = validate_cpmf_json(data)
        if not valid:
            print(f"Decrypted, but this isn't a valid CPMF document: {error}")
            sys.exit(1)
        print()
        print(json.dumps(data, indent=2))
        return

    print()
    print(plaintext.decode())


def context_import(path, apply_persona=False):
    """
    Import a CPMF document into local storage — from a different Curant
    install, a backup, or in principle any tool that produces valid CPMF
    JSON (see PORTABLE_MEMORY_SPEC.md). This is the other half of
    "portable": not just exporting for use elsewhere, but bringing a
    file made anywhere into this install.

    Auto-detects plaintext CPMF JSON vs. an encrypted Curant context file
    (salt:ciphertext) — no separate flag needed for that. Memories and
    people are merged additively (existing exact duplicates skipped,
    nothing is ever deleted by an import). Persona/instructions/
    preferences are left untouched UNLESS --apply-persona is passed —
    silently overwriting how someone's Curant is configured just because
    they imported someone else's memory file would be a bad surprise.
    """
    import base64
    import getpass
    from cryptography.fernet import Fernet, InvalidToken

    source = os.path.expanduser(path)
    if not os.path.exists(source):
        print(f"No file found at {source}.")
        sys.exit(1)
    with open(source) as f:
        raw = f.read().strip()

    data = None
    looked_like_json = False
    try:
        candidate = json.loads(raw)
        if isinstance(candidate, dict):
            looked_like_json = True
            data = candidate
    except json.JSONDecodeError:
        pass

    if not looked_like_json:
        # Only fall through to "maybe it's an encrypted Curant context
        # file" when the content didn't parse as JSON at all. (Valid JSON
        # missing cpmf_version should be rejected as invalid CPMF below,
        # not treated as ciphertext just because JSON syntax happens to
        # contain colons.)
        if ":" not in raw:
            print("This doesn't look like a plaintext CPMF file or an encrypted Curant context file.")
            sys.exit(1)
        passphrase = getpass.getpass("Enter the passphrase for this file: ")
        print("Verifying (this takes a couple seconds by design)...")
        try:
            salt_b64, ciphertext = raw.split(":", 1)
            salt = base64.b64decode(salt_b64)
            derived_key = _derive_backup_key(passphrase, salt)
            plaintext = Fernet(derived_key).decrypt(ciphertext.encode())
        except (InvalidToken, ValueError):
            print("Could not decrypt — wrong passphrase, or the file is corrupted.")
            sys.exit(1)
        try:
            data = json.loads(plaintext.decode())
        except json.JSONDecodeError:
            print("Decrypted, but this isn't valid JSON — was it exported with --format json?")
            sys.exit(1)

    valid, error = validate_cpmf_json(data)
    if not valid:
        print(f"This isn't a valid CPMF document: {error}")
        sys.exit(1)

    init_local_db()
    existing_memories = get_memories()
    added_memories = 0
    for m in data.get("memories", []):
        content = (m.get("content") or "").strip()
        if content and content not in existing_memories:
            save_memory(content)
            added_memories += 1

    existing_people = get_important_people()
    added_people = 0
    for p in data.get("people", []):
        name = (p.get("name") or "").strip()
        if not name:
            continue
        already = any(
            ep["name"] == name and ep.get("relationship") == p.get("relationship", "")
            for ep in existing_people
        )
        if not already:
            with closing(get_local_db()) as conn:
                conn.execute(
                    "INSERT INTO important_people (name, relationship, note) VALUES (?, ?, ?)",
                    (name, p.get("relationship", ""), p.get("note", "")),
                )
                conn.commit()
            added_people += 1

    print(f"Imported {added_memories} new memories and {added_people} new people "
          f"from a CPMF v{data.get('cpmf_version')} file.")

    if apply_persona:
        config = load_config()
        persona_block = data.get("persona", {})
        style = persona_block.get("style_summary", "")
        instructions = persona_block.get("instructions", "")
        combined = instructions
        if style:
            combined = (combined + f"\nAdopt this style: {style}").strip()
        config["instructions"] = combined
        prefs = data.get("preferences", {})
        if "reply_format" in prefs:
            config["reply_format"] = prefs["reply_format"]
        if "proactivity_enabled" in prefs:
            config["proactivity_enabled"] = prefs["proactivity_enabled"]
        save_config(config)
        print("Also applied this file's persona/instructions/preferences.")
    else:
        print("Persona/instructions were NOT changed — pass --apply-persona to also adopt "
              "this file's style and preferences, not just memories/people.")


def mcp_add_cmd(name, command):
    if not command:
        print("Need a command to launch the server, e.g.: curant-cli mcp-add gmail npx -y @some/gmail-mcp-server")
        sys.exit(1)
    add_mcp_server(name, command)
    print(f"Added MCP server '{name}'. Verifying it actually starts and lists tools...")
    server = next(s for s in get_mcp_servers() if s["name"] == name)
    tools = list_tools_from_server(name, server)
    if tools:
        print(f"Connected — {len(tools)} tool(s) available: {', '.join(t['name'] for t in tools)}")
    else:
        print("Added, but couldn't list any tools from it just now — check the command is correct. "
              "It'll be retried automatically on next use.")


def connect_email_cmd(name):
    """
    Real feature added 2026-08-14 ("make sure customer can add emails
    without me") -- lets a customer connect their own Gmail account
    end-to-end with ONE command, no Google Cloud Console, no manual
    gcp-oauth.keys.json handling, no separate mcp-add call. Fetches the
    shared OAuth client from Curant's own server (see
    /v1/gmail-oauth-config in server/app.py), writes it into a
    per-connection config directory, runs the real (unavoidable, and
    correctly so) browser login/consent step, then registers the
    connection via mcp-add automatically.

    Currently Gmail-specific (@shinzolabs/gmail-mcp is the only email
    MCP server this file knows how to wire up automatically) -- a
    customer wanting a different provider still needs the manual
    mcp-add path.
    """
    config = load_config()
    key = config.get("license_key")
    if not key:
        print("Activate first with `curant-cli activate YOUR-LICENSE-KEY` before connecting an email account.")
        sys.exit(1)

    print("Fetching connection details from Curant...")
    try:
        import requests
        resp = requests.get(
            f"{SERVER_BASE}/v1/gmail-oauth-config",
            headers={"Authorization": f"Bearer {key}"},
            timeout=15,
        )
    except Exception as e:
        print(f"Couldn't reach Curant's server: {e}")
        sys.exit(1)

    if resp.status_code == 404:
        print("Your license isn't active — check `curant-cli status`.")
        sys.exit(1)
    if resp.status_code == 503:
        print("Email connection isn't set up on Curant's end yet — this is a one-time thing the "
              "Curant team needs to configure server-side, not something you can fix locally.")
        sys.exit(1)
    if resp.status_code != 200:
        print(f"Couldn't get connection details (status {resp.status_code}). Try again shortly.")
        sys.exit(1)

    oauth_config = resp.json()
    config_dir = os.path.expanduser(f"~/.gmail-mcp-{name}")
    os.makedirs(config_dir, exist_ok=True)
    keys_path = os.path.join(config_dir, "gcp-oauth.keys.json")
    with open(keys_path, "w") as f:
        json.dump({
            "installed": {
                "client_id": oauth_config["client_id"],
                "project_id": oauth_config.get("project_id", ""),
                "auth_uri": "https://accounts.google.com/o/oauth2/auth",
                "token_uri": "https://oauth2.googleapis.com/token",
                "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
                "client_secret": oauth_config["client_secret"],
                "redirect_uris": ["http://localhost"],
            }
        }, f)
    os.chmod(keys_path, 0o600)

    print(f"\nOpening your browser to connect '{name}' -- sign in with the Gmail account you want "
          f"Curant to use, and approve the permissions. If you see an 'unverified app' warning, "
          f"click Advanced, then 'Go to (unsafe)' -- that's expected.\n")
    env = os.environ.copy()
    env["MCP_CONFIG_DIR"] = config_dir
    result = subprocess.run(["npx", "-y", "@shinzolabs/gmail-mcp", "auth"], env=env)
    if result.returncode != 0:
        print(f"\nSomething went wrong during sign-in (exit code {result.returncode}). "
              f"Common cause: another process is already using port 3000 -- close it and try "
              f"`curant-cli connect-email {name}` again.")
        sys.exit(1)

    creds_path = os.path.join(config_dir, "credentials.json")
    if not os.path.exists(creds_path):
        print("\nSign-in didn't complete (no credentials saved) -- try again.")
        sys.exit(1)

    print(f"\nSigned in. Registering '{name}' with Curant...")
    mcp_add_cmd(name, ["env", f"MCP_CONFIG_DIR={config_dir}", "npx", "-y", "@shinzolabs/gmail-mcp"])


def mcp_add_http_cmd(name, url, header_pairs):
    """header_pairs: list of 'Key: Value' strings from the CLI, for
    servers that need their own auth (an API key, a bearer token)."""
    headers = {}
    for pair in header_pairs or []:
        if ":" not in pair:
            print(f"Skipping malformed header '{pair}' — expected 'Key: Value'")
            continue
        key, _, value = pair.partition(":")
        headers[key.strip()] = value.strip()

    add_mcp_http_server(name, url, headers)
    print(f"Added HTTP MCP server '{name}' at {url}. Verifying it actually connects and lists tools...")
    server = next(s for s in get_mcp_servers() if s["name"] == name)
    tools = list_tools_from_server(name, server)
    if tools:
        print(f"Connected — {len(tools)} tool(s) available: {', '.join(t['name'] for t in tools)}")
    else:
        print("Added, but couldn't list any tools from it just now — check the URL/headers are correct. "
              "It'll be retried automatically on next use.")


