<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.curant.proactive</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Homebrew python3.12, NOT /usr/bin/python3 (Apple's system
             Python), same reasoning as com.curant.watcher.plist and
             com.curant.facetime.plist: this run sends its result via
             osascript/Messages.app when there is something to report,
             and macOS ties Automation/AppleEvents permission to the
             exact requesting binary. Apple's system python3 was never
             granted that permission; the Homebrew one already was. -->
        <string>/opt/homebrew/opt/python@3.12/bin/python3.12</string>
        <string>-u</string>
        <string>/usr/local/bin/curant-watcher.py</string>
        <string>--proactive-check</string>
    </array>

    <!-- Runs once a day at 8:00am. This is a StartCalendarInterval job, not
         KeepAlive — it should run, exit, and be done, not loop like the
         message watcher. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>


    <!-- launchd does not source .zshrc/.zprofile, so curant-cli
         (installed to this Mac's personal ~/bin) is not found on the
         default PATH. Without this, this script's own internal
         subprocess.run(["curant-cli", ...]) calls fail outright with
         "No such file or directory", same bug already confirmed live
         and fixed in com.curant.watcher.plist and com.curant.facetime.plist. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/AbhyudayDhundhel/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Dev/testing bypass, matching com.curant.watcher.plist.
             Remove once a real license is activated via curant-cli
             activate. Without it every relay()/status check fails
             closed with not_activated on a Mac with no manual shell
             export backing it. -->
        <key>CURANT_DEV_UNLICENSED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/curant-proactive.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/curant-proactive-error.log</string>
</dict>
</plist>
<!--
Install with:
  cp com.curant.proactive.plist ~/Library/LaunchAgents/
  launchctl load ~/Library/LaunchAgents/com.curant.proactive.plist

This is opt in on the server side (customers.proactivity_enabled defaults
to 0), so loading this job is harmless even for customers who haven't
turned proactivity on: the server will just say should_send is false.

To test immediately rather than waiting for 8am, run curant-watcher.py
with the proactive check flag directly (see ProgramArguments above).

Logs land at /tmp/curant-proactive.log and /tmp/curant-proactive-error.log.
-->
