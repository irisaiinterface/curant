<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.curant.meetingprep</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Homebrew python3.12, NOT /usr/bin/python3 (Apple's system
             Python), same reasoning as com.curant.watcher.plist and
             com.curant.facetime.plist: this run sends its result via
             osascript/Messages.app when there is something to report,
             and macOS ties Automation/AppleEvents permission to the
             exact requesting binary. Apple's system python3 was never
             granted that permission; the Homebrew one already was. -->
        <string>/opt/homebrew/opt/python@3.12/bin/python3.12</string>
        <string>-u</string>
        <string>/usr/local/bin/curant-watcher.py</string>
        <string>--meeting-prep-check</string>
    </array>

    <!-- Unlike the other scheduled jobs (fixed daily/weekly clock
         times), this needs to run frequently throughout the day to
         catch a meeting starting soon , StartInterval (every 900
         seconds = 15 minutes) rather than StartCalendarInterval.
         Grace-exclusive (curant-cli's meeting_prep_check() checks the
         tier) and dedup'd per-event server-side, so running this often
         doesn't mean repeat notifications for the same meeting. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <false/>


    <!-- launchd does not source .zshrc/.zprofile, so curant-cli
         (installed to this Mac's personal ~/bin) is not found on the
         default PATH. Without this, this script's own internal
         subprocess.run(["curant-cli", ...]) calls fail outright with
         "No such file or directory", same bug already confirmed live
         and fixed in com.curant.watcher.plist and com.curant.facetime.plist. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/AbhyudayDhundhel/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Dev/testing bypass, matching com.curant.watcher.plist.
             Remove once a real license is activated via curant-cli
             activate. Without it every relay()/status check fails
             closed with not_activated on a Mac with no manual shell
             export backing it. -->
        <key>CURANT_DEV_UNLICENSED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/curant-meetingprep.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/curant-meetingprep-error.log</string>
</dict>
</plist>
<!--
Install with:
  cp com.curant.meetingprep.plist ~/Library/LaunchAgents/
  launchctl load ~/Library/LaunchAgents/com.curant.meetingprep.plist

Grace-exclusive, gated in curant-cli's meeting_prep_check() function.
Safe to load on every Mac regardless of tier , it just always results
in should_send=false for non-Grace customers.

To test immediately, run curant-watcher.py directly with the flag
shown in ProgramArguments above.

Logs land at /tmp/curant-meetingprep.log and /tmp/curant-meetingprep-error.log.
-->
