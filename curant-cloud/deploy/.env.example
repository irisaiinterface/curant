# Curant Cloud — environment variables template.
# Copy this to .env in the same folder, then fill in real values.
# .env itself should NEVER be committed to git — see .gitignore.

# ── Database encryption key (SQLCipher AES-256) ──────────────────────────
# Encrypts the entire DB file at rest — required before real customer data
# is stored. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CLOUD_DB_KEY=

# ── Flask session signing key (generate once, keep it stable) ───────────
# Regenerating this logs everyone out. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CLOUD_SECRET_KEY=

# ── Server-side API key encryption (Option A customers) ──────────────────
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUD_ENCRYPTION_KEY=

# ── Owner dashboard password ──────────────────────────────────────────────
# No default on purpose — if unset, owner login is disabled entirely rather
# than falling back to anything guessable. Pick something long and random,
# not reused anywhere else.
CLOUD_ADMIN_PASSWORD=

# ── Telnyx ─────────────────────────────────────────────────────────────────
# Your Telnyx API key (from telnyx.com/account/api-keys)
TELNYX_API_KEY=
# Your Telnyx webhook signature secret (from your Telnyx webhook profile)
# Set your webhook URL to: https://yourdomain.com/webhooks/sms
TELNYX_WEBHOOK_SECRET=

# ── Google Workspace (utility account — optional) ─────────────────────────
# Gives Curant full control of a Workspace account per customer: Gmail,
# Calendar, Drive, Docs, Sheets, Tasks, Contacts. Requires owning a Workspace
# domain (see README's "Google Workspace utility email" section for how to
# actually get one — direct Google Reseller Program applications need 100+
# seats already, so start via an authorized distributor instead).
# The service account needs domain-wide delegation enabled in the Admin
# Console for ALL of these scopes (not just Gmail's), since the utility
# account now uses the whole suite:
#   admin.directory.user, gmail.modify, calendar, drive, documents,
#   spreadsheets, tasks, contacts
# Leave these unset and signup/provisioning still works fine — this is a
# non-blocking enhancement, not a requirement.
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_ADMIN_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Vapi (optional — for voice prototype) ─────────────────────────────────
# Your Vapi API key (from app.vapi.ai)
# Set your Vapi webhook URL to: https://yourdomain.com/webhooks/vapi
VAPI_API_KEY=
# This server's own real public URL — required for voice calls to work
# at all. Vapi's Custom LLM provider calls back to
# {CLOUD_PUBLIC_URL}/vapi-llm/<customer_id> to get each customer's reply,
# using that customer's own API key rather than a shared Vapi-account
# key. Without this set to a real, Vapi-reachable URL, voice calls will
# fail for every customer.
CLOUD_PUBLIC_URL=

# ── Server config ─────────────────────────────────────────────────────────
# Set to "true" once this is behind real HTTPS (enables Secure cookie flag)
CLOUD_HTTPS=false
# Set to "1" for development (auto-reloads, verbose errors)
FLASK_DEBUG=0
